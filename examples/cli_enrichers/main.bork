import "bork/codec"

import "bork/cli"
import "bork/process"
use codec.Defaults
type Options = { host: String = "localhost", port: Int = 8080 } derive (codec.Decode)
fn teamNames(previous: List[cli.FieldSpec], field: cli.FieldSpec): cli.FieldSpec {
  field.copy(long: cli.Mapping.Named { name: s"team-${field.field}" })
}
fn fieldDocs(previous: List[cli.FieldSpec], field: cli.FieldSpec): cli.FieldSpec {
  field.copy(description: s"Configure ${field.field}; ${previous.length()} fields precede it.")
}
fn policy(): cli.Settings { .{ enrichers: [teamNames, fieldDocs] } }
fn main(): Ok | process.ExitCode {
  match (cli.Run[Options]("enrichers", "Compose reusable metadata policies", (options, s) => {
    println(s"${options.host}:${options.port}")
    }, settings: policy())) {
    error: cli.Error => { return process.ExitCode { code: 2, message: error.Render("enrichers") } }
    Ok => {}
  }
}
test "enrichers compose in declaration order" {
  match (cli.Parse[Options]("enrichers", "", ["--help"], settings: policy())) {
    help: cli.Help => {
      assert(help.text.contains("--team-host"))
      assert(help.text.contains("Configure port; 1 fields precede it."))
    }
    other => { panic(s"Expected help, got ${other}") }
  }
}
