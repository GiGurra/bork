import "bork/fs"

// signup validates sign-up requests, one JSON object per line:
//
//   bork run examples/signup -- requests.jsonl
//
// The request type derives its decoder. The decoder checks every where
// clause, so a decoded request is proven: register can rely on its
// facts without checking them again.

pred nonEmpty(s: String) { s.byteLength() > 0 }
pred maxBytes(s: String, n: Int) { s.byteLength() <= n }
pred between(x: Int, lo: Int, hi: Int) { x >= lo && x <= hi }

type UserName = String where nonEmpty and maxBytes(20)

type Plan = sealed {
  Free,
  Paid { seats: Int where between(1, 500) },
} derive (Decode, Encode)

type SignUp = {
  name: UserName,
  age: Option[Int where between(13, 150)],
  plan: Plan,
} derive (Decode, Encode)

type Account = { id: Int, name: UserName, seats: Int } derive (Encode)

fn seatsOf(plan: Plan): Int {
  match (plan) {
    Plan.Free => 1
    Plan.Paid { seats: n } => n
  }
}

// register needs a valid name; a decoded SignUp has one.
fn register(id: Int, req: SignUp): Account {
  Account { id: id, name: req.name, seats: seatsOf(req.plan) }
}

fn handle(id: Int, line: String): String {
  r: SignUp | JsonError | DecodeError = decodeJson(line)
  match (r) {
    req: SignUp => s"ok    ${encodeJson(register(id, req))}"
    e: JsonError => s"bad   line ${toString(id)}: not JSON: ${e.message}"
    e: DecodeError => s"bad   line ${toString(id)}: ${e.path}: ${e.message}"
  }
}

// handleAll handles lines, numbering them from id.
fn handleAll(lines: List[String], id: Int): List[String] {
  match (lines) {
    [line, ...rest] => prepend(handle(id, line), handleAll(rest, id + 1))
    [] => []
  }
}

fn readFile(path: String) uses io: String | fs.Error {
  scope s {
    fs.ReadAllText(fs.Open(path, s)?)
  }
}

fn main() {
  path = match (args()) {
    [p] => p
    _ => {
      eprintln("usage: signup FILE")
      exit(2)
    }
  }
  match (readFile(path)) {
    text: String => (handleAll(text.lines(), 1)).forEach(line => println(line))
    e: fs.Error => {
      detail = fs.ErrorInfo(e)
      eprintln(s"signup: ${detail.path}: ${detail.message}")
      exit(1)
    }
  }
}

test "decodes and registers a request" {
  assertEqual(handle(1, "{\"name\": \"ann\", \"plan\": \"Free\"}"), "ok    {\"id\":1,\"name\":\"ann\",\"seats\":1}")
}

test "rejects broken where clauses" {
  assertEqual(handle(2, "{\"name\": \"\", \"plan\": \"Free\"}"), "bad   line 2: .name: must be nonEmpty")
  assertEqual(handle(3, "{\"name\": \"bo\", \"plan\": {\"type\": \"Paid\", \"seats\": 0}}"), "bad   line 3: .plan.seats: must be between(1, 500)")
}
