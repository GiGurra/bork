import "bork/cli"
import "bork/process"
type Options = { serverHost: String = "localhost", internalToken: String = "development" } derive (Decode)
fn main() {
  match (cli.Run[Options]("env", "Opt into automatic environment bindings", (options, s) => {
    println(s"Connecting to ${options.serverHost}")
    }, flags: [.{ field: "internalToken", long: cli.Mapping.Disabled, envName: cli.Mapping.Disabled }], settings: .{ autoEnv: true, envPrefix: "BORK_EXAMPLE" })) {
    error: cli.Error => { println(error); process.Exit(2) }
    Ok => {}
  }
}
test "disabled sources keep record defaults" {
  match (cli.Parse[Options]("env", "", [], [.{ field: "internalToken", long: cli.Mapping.Disabled, envName: cli.Mapping.Disabled }], settings: .{ autoEnv: true, envPrefix: "BORK_EXAMPLE" })) {
    options: Options => { assertEqual(options.internalToken, "development") }
    other => { panic(s"Expected options, got ${other}") }
  }
}
