import "bork/tasks"

fn main() {
  scope app {
    pool = tasks.Open(app, maxTasks: 1)
    gate = channel[Bool](app, 0)
    match (tasks.TrySpawn(pool, app, () => { _ = receive(gate); "finished" })) {
      task: Task[String] => {
        match (tasks.TryLaunch(pool, app, () => println("second task"))) {
          overloaded: tasks.TaskLimitReached => println(s"pool full: limit ${overloaded.limit}")
          cancelled: Cancelled => println(cancelled)
          _ => {}
        }
        _ = send(gate, true)
        println(await(task))
      }
      error: tasks.TaskLimitReached | Cancelled => println(error)
    }
  }
}
