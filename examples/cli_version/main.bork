import "bork/cli"
import "bork/codec"
import "bork/process"
import "bork/test"
use codec.Defaults

type Options = { name: String } derive (codec.Decode)
fn main(): Ok | process.ExitCode {
  match (cli.Run[Options]("greet", "Version before decoding", (options, s) => {
    println(s"Hello, ${options.name}.")
    }, settings: .{ version: "1.2.3" })) {
    Ok => {}
    error: cli.Error => { return process.ExitCode { code: 2, message: error.Render("greet") } }
  }
}

test "version skips required fields and configuration reads" {
  help = test.AssertIs[cli.Help](cli.Parse[Options]("greet", "", ["--version"],
    configFiles: ["missing.json"], settings: .{ version: "1.2.3" }))
  assertEqual(help.text, "greet version 1.2.3\n")
}
