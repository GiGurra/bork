import "bork/process"
// bork run examples/http_routes
// curl 'localhost:8080/users/42'
import "bork/http"

pred positive(n: Int) { n > 0 }
type UserPath = { id: Int where positive } derive (Decode)
fn user(req: http.Request, rs: Scope): http.Response {
  match (http.PathAs[UserPath](req)) {
    path: UserPath => http.Text(200, s"user ${path.id}")
    error: DecodeError => http.Text(422, error.path + ": " + error.message)
  }
}
fn logged(handler: http.Handler): http.Handler {
  (req, rs) => {
    println(req.method, req.path)
    handler(req, rs)
  }
}
fn main() {
  scope app with cleanupTimeout(5000) {
    match (http.ListenRoutes(if (process.Args() == ["demo"]) { "127.0.0.1:0" } else { "localhost:8080" }, app, [
      .{ pattern: "GET /users/{id}", handler: logged(user) },
      .{ pattern: "GET /health", handler: (req, rs) => http.Text(200, "ok") },
    ])) {
      server: http.Server => {
        if (process.Args() == ["demo"]) {
          match (http.Get("http://" + http.Address(server) + "/users/42", app)) {
            response: http.Response => println(response.status, response.body)
            error => println(toString(error))
          }
        } else { println(http.Address(server)); http.Wait(server) }
      }
      error: IoError => println(error.message)
    }
  }
}
