import "bork/http"
import "bork/fs"
import "bork/encoding"

fn download(url: String, s: Scope, file: fs.File) uses io + net + clock + state: Ok | fs.Error | http.BodyTooLarge | http.DeadlineExceeded | Cancelled {
  response = http.GetStream(url, s, maxBodyBytes: .Some(1048576))?
  for {
    match (http.Read(response.body)) {
      bytes: Bytes => { _ = fs.WriteTo(file, bytes)? }
      _: http.Eof => break
      error: http.BodyTooLarge => return error
      error: http.DeadlineExceeded => return error
      error: Cancelled => return error
      error: IoError => return error
    }
  }
}
fn demo(s: Scope) uses io + net + clock + state: Ok | fs.Error | http.BodyTooLarge | http.DeadlineExceeded | Cancelled {
  server = http.Listen("127.0.0.1:0", s, (request, rs) => {
    if (request.method == "POST") { http.Text(200, request.body) } else { http.Text(200, "hello from a stream") }
  })?
  base = "http://" + http.Address(server)
  file = fs.TempFile(s)?
  download(base, s, file)?
  println("downloaded", (fs.Stat(fs.Path(file))?).size, "bytes")
  chunks = atom(0)
  body = http.OpenBody(s, producer => {
    count = update(chunks, n => n + 1)
    if (count == 1) { encoding.Utf8("hello ") } else if (count == 2) { encoding.Utf8("upload") } else { http.Eof {} }
  })
  response = http.SendStream("POST", base, { "Content-Type": ["text/plain"] }, s, body: .Some(body))?
  for {
    match (http.Read(response.body)) {
      bytes: Bytes => println(encoding.Hex(bytes))
      _: http.Eof => break
      error: http.BodyTooLarge => return error
      error: http.DeadlineExceeded => return error
      error: Cancelled => return error
      error: IoError => return error
    }
  }
}
fn main() {
  match (scope app { demo(app) }) {
    _: Ok => {}
    error => eprintln(toString(error))
  }
}
