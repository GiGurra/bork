// Run with: bork run examples/generators
import "bork/encoding"
import "bork/fs"

type Shelf = { name: String, scores: List[Option[Int]] }

// The same lazy squares sequence in two forms. [Int] is the element type.
fn squares(): Seq[Int] {
  generate[Int] {
    for n in [1, 2, 3] { yield n * n }
  }
}

fn squaresComprehension(): Seq[Int] {
  for { n in [1, 2, 3] } yield n * n
}

// A comprehension fits generators, filters, bindings, then one final yield.
// Use generate for state carried between values (such as Fibonacci), multiple
// or branching yields, a resource scope, or early return/continue logic.
// Here generate lets us trace execution before each yield.
fn numbers(): Seq[Int] uses io {
  generate[Int] {
    for n in Seq.range(1, 1_000_000) {
      println("produced:", n)
      yield n
    }
  }
}

// This generate owns a resource scope for the duration of consumption.
fn fileLines(path: String): Seq[String | fs.Error] uses io {
  generate[String | fs.Error] {
    scope producer {
      onClose(producer, () => println("file scope closed"))
      // Open inside the generator: its scope owns the file across yields.
      // Cleanup runs in reverse order, so the file closes before the message.
      match fs.Open(path, producer) {
        file: fs.File => {
          println("file opened")
          for line in fs.ReadLines(file) { yield line }
        }
        error: fs.Error => { yield error }
      }
    }
  }
}

fn files() uses io: Ok | fs.Error {
  scope app {
    directory = fs.TempDir(app, pattern: "bork-generators-")?
    path = fs.Join([fs.DirectoryPath(directory), "lines.txt"])
    fs.Write(path, encoding.Utf8("first\nsecond\nthird\n"))?

    lines = fileLines(path)
    println("file sequence created")
    for line in lines {
      println("line:", line)
      break
    }
    // The producer's scope has already closed, while app is still live.
    println("consumer continued")
  }
  Ok
}

fn main() {
  // Both forms create a lazy Seq[Int]; toList pulls all its values into a list.
  println("squares:", squares().toList())
  println("squares comprehension:", squaresComprehension().toList())

  values = numbers() // Creating the sequence runs none of the block.
  println("sequence created")
  // Each yield hands over one value; the block resumes only for the next request.
  // take is lazy too; toList consumes it and stops after the first yield.
  println("first:", values.take(1).toList())
  // Another traversal starts from the top: produced values are not cached.
  println("evens times ten:", values.filter(n => n % 2 == 0).map(n => n * 10).take(2).toList())

  // Each traversal starts over; break stops the large source immediately.
  for (i, n) in values.indexed() {
    println("indexed:", i, n)
    if i == 1 { break }
  }

  shelves = [
    Shelf { name: "fiction", scores: [Option.Some(3), Option.None, Option.Some(5)] },
    Shelf { name: "history", scores: [Option.Some(4)] },
  ]
  picks = for {
    (i, shelf) in shelves.indexed()
    .Some(score) in shelf.scores
    if score >= 4
    points = score * 10
  } yield (i, shelf.name, points)
  println("comprehension:", picks.toList())

  stock = { "pen": 2, "pad": 3 }
  for (name, count) in stock.pairs() { println("stock:", name, count) }

  match files() {
    _: Ok => {}
    error: fs.Error => println("file error:", error)
  }
}
