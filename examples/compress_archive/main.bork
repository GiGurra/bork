import "bork/encoding"
import "bork/compress"
import "bork/archive"

fn exercise() uses io: Ok | IoError {
  payload = encoding.Utf8("hello, archive")
  compressed = compress.Gzip(payload)?
  println(encoding.ParseUtf8(compress.Gunzip(compressed)?))
  members = [archive.Member { name: "hello.txt", data: payload, directory: false }]
  zipped = archive.Zip(members)?
  tarred = archive.Tar(members)?
  println((archive.ReadZip(zipped)?).map(member => member.name))
  println((archive.ReadTar(tarred)?).map(member => encoding.ParseUtf8(member.data)))
}

fn main() {
  match (exercise()) {
    _: Ok => {}
    error: IoError => println(error)
  }
}
