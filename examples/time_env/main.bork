import codec "bork/codec"

import "bork/process"
import "bork/test"
// APP_HOST=localhost APP_PORT=8080 bork run examples/time_env -- live
// The default demo injects both the environment and clock.
import "bork/env"
import "bork/time"
use codec.Defaults

pred validPort(n: Int) { n > 0 && n <= 65535 }
type Config = { host: String, port: Int where validPort } derive (codec.Decode)
fn report(result: Config | env.ConfigError, clock: time.Clock) uses io + clock {
  match (result) {
    config: Config => println(s"${time.Format(time.Read(clock), time.RFC3339())}: ${config.host}:${config.port}")
    error: env.ConfigError => error.errors.forEach(issue => eprintln(s"${issue.path}: ${issue.message}"))
  }
}
fn main() {
  if (process.Args().includes("live")) {
    report(env.Load[Config]("APP"), time.SystemClock())
  } else {
    values = { "APP_HOST": "localhost", "APP_PORT": "8080" }
    report(env.LoadWith[Config]("APP", name => values.get(name)), time.FixedClock(time.Instant { unixNanos: 0 }))
  }
}
test "config collects missing and invalid fields" {
  values = { "APP_PORT": "0" }
  result: Config | env.ConfigError = env.LoadWith("APP", name => values.get(name))
  errors = test.AssertIs[env.ConfigError](result)
  assertEqual(errors.errors.length(), 2)
}
test "fake clock remains fixed" {
  clock = time.FixedClock(time.Instant { unixNanos: 42 })
  assertEqual(time.Read(clock), time.Read(clock))
}
test "negative arithmetic overflow is checked" {
  assert(time.Add(time.Instant { unixNanos: -9223372036854775808 }, (-1).nanos()) is OutOfRange)
  assert(time.Between(time.Instant { unixNanos: 1 }, time.Instant { unixNanos: -9223372036854775808 }) is OutOfRange)
}
test "invalid duration and instant text is rejected" {
  assert(time.ParseDuration("nope") is ParseError)
  assert(time.Parse("nope", time.RFC3339()) is ParseError)
}
type Pair[A, B] = { first: A, second: B } derive (codec.Decode)
test "generic fields use instantiated decoder parsing kinds" {
  values = { "APP_FIRST": "hello", "APP_SECOND": "42" }
  result: Pair[String, Int] | env.ConfigError = env.LoadWith("APP", name => values.get(name))
  match (result) {
    pair: Pair[String, Int] => {
      assertEqual(pair.first, "hello")
      assertEqual(pair.second, 42)
    }
    _ => assert(false)
  }
}
pred present(value: Option[String]) { value.isSome() }
type RequiredOptions = {
  first: Option[String] where present,
  second: Option[String] where present,
  port: Int,
} derive (codec.Decode)
test "absent options still check every field fact" {
  result: RequiredOptions | env.ConfigError = env.LoadWith("APP", name => Option.None)
  match (result) {
    errors: env.ConfigError => assertEqual(errors.errors.map(issue => issue.path), ["APP_FIRST", "APP_SECOND", "APP_PORT"])
    _ => assert(false)
  }
}
test "generic Option fields may be absent" {
  values = { "APP_SECOND": "42" }
  result: Pair[Option[String], Int] | env.ConfigError = env.LoadWith("APP", name => values.get(name))
  match (result) {
    pair: Pair[Option[String], Int] => assert(pair.first.isNone())
    _ => assert(false)
  }
}
