import "bork/encoding"
import "bork/process"

fn run(s: Scope) uses io + state: Ok | IoError | Cancelled {
  result = process.Run(s, "echo", arguments: ["hello", "from", "a", "subprocess"])?
  println(result.code)
  println(encoding.ParseUtf8(result.stdout))
}
fn main() {
  result = scope app { run(app) }
  match result {
    _: Ok => {}
    error: IoError => eprintln(error.message)
    stopped: Cancelled => eprintln(stopped.reason)
  }
}
