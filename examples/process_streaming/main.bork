// Read a child's output line by line while it is still running.
import "bork/process"

fn run(s: Scope) uses io + state: Ok | IoError | Cancelled {
  script = "for step in fetch build test; do echo \"$step ok\"; sleep 0.1; done; echo 'all steps passed' >&2"
  // stderr: .Stdout merges both streams into the one Reader.
  child = process.Start(s, "/bin/sh", ["-c", script], stdout: .Pipe, stderr: .Stdout)?
  // Lines is a sequence: each line arrives as soon as the child writes it.
  // A read failure or cancellation is its last element.
  for (item in child.Stdout().Lines()) {
    match (item) {
      line: String => println(s"[child] $line")
      error: IoError => eprintln(error.message)
      stopped: Cancelled => eprintln(stopped.reason)
    }
  }
  println(s"exit code: ${child.Wait()?.code}")
  // NextLine reads one line at a time, then Closed at the end.
  greeter = process.Start(s, "/bin/sh", ["-c", "echo hello; echo world"], stdout: .Pipe)?
  output = greeter.Stdout()
  for (_ in[1, 2, 3]) {
    println(match (output.NextLine()) {
      line: String => s"line: $line"
      _: Closed => "end of output"
      error: IoError => error.message
      stopped: Cancelled => stopped.reason
    })
  }
  _ = greeter.Wait()?
  // Two piped streams must be read at the same time: a child blocks when a
  // pipe nobody reads fills up. Read stderr in a task, stdout here.
  both = process.Start(s, "/bin/sh", ["-c", "echo result; echo diagnostics >&2"], stdout: .Pipe, stderr: .Pipe)?
  diagnostics = spawn(s, () => both.Stderr().ReadAll())
  result = both.Stdout().ReadAll()?
  println(s"stdout: ${result.length()} bytes, stderr: ${await(diagnostics)?.length()} bytes")
  _ = both.Wait()?
}

fn main() {
  match (scope app { run(app) }) {
    _: Ok => {}
    error: IoError => eprintln(error.message)
    stopped: Cancelled => eprintln(stopped.reason)
  }
}
