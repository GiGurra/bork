import "bork/codec"
import "bork/cli"
import "bork/process"
use codec.Defaults
type Options = {
  // Database address.
  host: String = "localhost"
  // Database port.
  port: Int = 5432
  // Access token; read only from MANUAL_TOKEN. Env-only fields don't appear in help.
  token: Option[String]
} derive (codec.Decode)
// Automatic naming is off, so every flag, short and env name is written here.
fn settings(): cli.Settings { .{ autoLong: false, autoShort: false, autoEnv: false } }
fn flags(): List[cli.Flag] {
  [.{ field: "host", long: cli.Mapping.Named { name: "addr" }, short: "a", env: "MANUAL_ADDR" },
    .{ field: "port", long: cli.Mapping.Named { name: "port" }, short: "p", env: "MANUAL_PORT" },
    .{ field: "token", env: "MANUAL_TOKEN" }]
}
fn main(): Ok | process.ExitCode {
  match cli.Run[Options]("manual", "Every name written by hand", (options, s) => {
    println(s"${options.host}:${options.port}, token set: ${options.token.isSome()}")
    }, flags: flags(), settings: settings()) {
    error: cli.Error => { return process.ExitCode { code: 2, message: error.Render("manual") } }
    Ok => {}
  }
}
test "only the named flags exist" {
  match cli.Parse[Options]("manual", "", ["--help"], flags: flags(), settings: settings()) {
    help: cli.Help => {
      assert(help.text.contains("-a, --addr"))
      assert(help.text.contains("(env: MANUAL_ADDR)"))
      assert(help.text.contains("-p, --port"))
      assert(!help.text.contains("--host"))
      assert(!help.text.contains("--token"))
    }
    other => { panic(s"Expected help, got ${other}") }
  }
}
test "a field name is not a flag when automatic names are off" {
  match cli.Parse[Options]("manual", "", ["--host", "db.example"], flags: flags(), settings: settings()) {
    error: cli.Error => { assert(error.errors.filter(item => item.message.contains("unknown flag: --host")).length() == 1) }
    other => { panic(s"Expected an unknown flag error, got ${other}") }
  }
}
