// bork run examples/service_context
// A fixed root makes this example reproducible; forwarding does not create spans.
import "bork/http"
use http.TraceCodecs
propagated("traceparent") logged ambient trace: http.TraceParent
fn traceText() needs trace: String { trace }
fn root(): http.TraceParent {
  text = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
  if (http.ValidTraceParent(text)) { text } else { panic("invalid example root") }
}
fn server(result: http.Server | IoError): http.Server {
  match (result) { value: http.Server => value, error => panic(toString(error)) }
}
fn reply(result: http.Result): http.Response {
  match (result) { value: http.Response => value, error => panic(toString(error)) }
}
fn budget(headers: http.Headers): Int {
  match (http.HeaderOf(headers, "Bork-Timeout-Ns")) {
    Option.Some(value) => match (parseInt(value)) { n: Int => n, error => panic(toString(error)) }
    Option.None => panic("missing deadline budget")
  }
}
fn main() {
  scope app with cleanupTimeout(5000) {
    downstream = server(http.Listen("127.0.0.1:0", app, handler: (request, s) => {
      // Boundary labels forward automatically. Typed needs are bound explicitly.
      match (http.TraceParentOf(request.headers)) {
        Option.Some(value) => {
          with (trace: value) {
            http.Text(200, traceText()).copy(headers: {
              "seen-budget": [toString(budget(request.headers))]
            })
          }
        }
        _ => http.Text(400, "missing trace")
      }
      }, requestTimeoutMs: 1000))
    target = "http://" + http.Address(downstream)
    middle = server(http.Listen("127.0.0.1:0", app, handler: (request, s) => {
      result = reply(http.Get(target, s))
      http.Text(200, result.body).copy(headers: {
        "middle-budget": [toString(budget(request.headers))],
        "downstream-budget": [match (http.HeaderOf(result.headers, "seen-budget")) {
          Option.Some(value) => value
          Option.None => panic("missing downstream budget")
        }]
      })
      }, requestTimeoutMs: 2000))
    scope caller {
      cancelAfter(caller, 5000)
      with (trace: root()) {
        result = reply(http.Get("http://" + http.Address(middle), caller))
        middleBudget = budget({ "Bork-Timeout-Ns": [match (http.HeaderOf(result.headers, "middle-budget")) {
          Option.Some(value) => value
          Option.None => panic("missing middle budget")
        }] })
        downstreamBudget = budget({ "Bork-Timeout-Ns": [match (http.HeaderOf(result.headers, "downstream-budget")) {
          Option.Some(value) => value
          Option.None => panic("missing downstream budget")
        }] })
        println("trace continuity", result.body == traceText())
        println("caller budget", middleBudget > 0 && middleBudget <= 5000000000)
        println("budget shrank", downstreamBudget > 0 && downstreamBudget < middleBudget && downstreamBudget <= 2000000000)
      }
    }
  }
}
