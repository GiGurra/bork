import codec "bork/codec"

import "bork/process"
import "bork/cli"
use codec.Defaults
pred validPort(n: Int) { n > 0 && n < 65536 }
type Serve = {
  // Host to serve.
  host: String
  // Listening port.
  port: Int where validPort = 8080
} derive (codec.Decode)
type Echo = { words: List[String] } derive (codec.Decode)
fn main(): Ok | process.ExitCode {
  commands = [
    cli.Subcommand[Serve]("serve", "Serve a host", (options, s) => {
      onClose(s, () => { println("serve scope closed") })
      println(s"Serving ${options.host}:${options.port}")
      }, flags: [cli.Flag { field: "port", short: "p" }]),
    cli.Subcommand[Echo]("echo", "Echo words", (options, s) => {
      println(options.words)
      }, flags: [cli.Flag { field: "words", positional: true }])
  ]
  match (cli.RunCommands("app", "Typed subcommands", commands)) {
    error: cli.Error => { return process.ExitCode { code: 2, message: error.Render("app") } }
    Ok => {}
  }
}
