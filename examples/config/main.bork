import codec "bork/codec"
import "bork/json"
// Run with: bork run examples/config
// No server is started and certificate names are data; the output is deterministic.
import "example.com/config/settings"
use codec.Defaults
use settings.ConfigEncode
use settings.ConfigDecode

type Deployment = { name: String, config: settings.Config }

// The Config type carries this fact; callers need no extra guard.
fn configuredHost(config: settings.Config where settings.Configured): String {
  config.host
}

fn main() {
  local = settings.Defaults(host: "localhost")
  staging = settings.New(host: "staging.example", port: 8443,
    connectTimeout: 250.millis(), readTimeout: 3.seconds(),
    tls: .Files { cert: "staging.pem", key: "staging.key" },
    debug: "requests")
  production = settings.ForProduction(config: staging, host: "production.example",
    cert: "production.pem", key: "production.key")

  println(local)
  println(staging)
  println(production)
  println(configuredHost(production))
  println(json.Encode(production))
  // Decoding completes defaults and checks the same field/type invariants.
  println(json.Decode[settings.Config]("{\"host\":\"decoded.example\",\"connectTimeout\":\"100ms\",\"readTimeout\":\"500ms\",\"bodyLimitBytes\":4096}"))
  println(json.Decode[settings.Config]("{\"host\":\"invalid.example\",\"bodyLimitBytes\":512}"))

  deployment: Deployment = .{ name: "staging", config: staging }
  // Replacing the whole private-valued field with a valid Config is allowed.
  promoted = deployment.copy(name: "production", config: production)
  println(promoted)

  // These fail at compile time:
  // println(settings.New(host: "localhost", port: 0))
  // println(settings.New(host: "localhost", connectTimeout: 5.seconds(), readTimeout: 1.seconds()))
  // println(settings.New(host: "localhost", bodyLimitBytes: 512))
  // bad: settings.Config = .{ host: "outside its owning package" }
  // println(production.copy(port: 9000))
  // println(deployment.copy(config.port: 9000))
}
