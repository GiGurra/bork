import codec "bork/codec"

import "bork/math"
use codec.Defaults
use math.Codecs

type Invoice = { subtotal: math.Decimal, tax: math.Decimal, total: math.Decimal } derive (codec.Encode)

// Round tax once, after exact multiplication, using the invoice's currency scale.
fn invoice(subtotal: String, rate: String): Invoice | ParseError | OutOfRange {
  amount = math.ParseDecimal(subtotal)?
  percentage = math.ParseDecimal(rate)?
  tax = amount.Mul(percentage)?.Round(2, math.Rounding.HalfEven)?
  Invoice { subtotal: amount, tax: tax, total: amount.Add(tax) }
}
fn main() {
  println(invoice("123.45", "0.075"))
  a = math.ParseDecimal("1.0")
  b = math.ParseDecimal("1.00")
  match (a) {
    left: math.Decimal => match (b) {
      right: math.Decimal => {
        println(left == right) // false: scale is part of ==
        println(left.SameValue(right)) // true: numeric comparison
      }
      error: ParseError => println(error)
    }
    error: ParseError => println(error)
  }
  println(math.Integer(2).Pow(100))
  println(math.Rational(math.Integer(1), math.Integer(3)))
}
