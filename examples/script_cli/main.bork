#!/usr/bin/env -S bork script
import "bork/cli"
import "bork/codec"
import "bork/process"
use codec.Defaults

type Options = { name: String = "world" } derive (codec.Decode)
fn main(): Ok | process.ExitCode {
  match (cli.Run[Options]("greet", "A greeting script", (options, s) => {
    println(s"Hello, ${options.name}!")
  })) {
    error: cli.Error => { return process.ExitCode { code: 2, message: error.Render("greet") } }
    Ok => {}
  }
}
