import codec "bork/codec"
import "bork/process"
import "bork/yaml"
use codec.Defaults

// yaml_config loads a YAML configuration file into checked records and
// writes one back out:
//
//   bork run examples/yaml_config -- config.yaml
//
// yaml.DecodeFile and yaml.Encode use the same derived Decode and Encode
// instances as bork/json, so the where clauses are checked on load.

pred ValidPort(port: Int) { port >= 1 && port <= 65535 }
pred Positive(n: Int) { n > 0 }

type Service = {
  host: String,
  port: Int where ValidPort,
  workers: Int where Positive,
  tags: List[String],
} derive (codec.Decode, codec.Encode)

// Config is the whole file. Fields it doesn't name, like the defaults
// anchor, are ignored.
type Config = { environments: Map[String, Service] } derive (codec.Decode)

fn load(path: String) uses io: Ok | yaml.Error | IoError | codec.DecodeError {
  config = yaml.DecodeFile[Config](path)?
  config.environments.forEach((name, service) => println(s"$name: $service"))
  match config.environments.get("production") {
    Option.Some(production) => println(yaml.Encode(Service { host: production.host, port: 9090, workers: production.workers, tags: production.tags })?.trim())
    Option.None => println("no production environment")
  }
}

fn main() {
  match process.Args() {
    [path, ...] => match load(path) {
      error: yaml.Error => println(s"${error.path}:${error.line}:${error.column}: ${error.message}")
      error: IoError | codec.DecodeError => println(error)
      Ok => {}
    }
    [] => println("usage: yaml_config <file.yaml>")
  }
}
