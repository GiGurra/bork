import "bork/process"
import "bork/cli"
pred validPort(n: Int) { n > 0 && n < 65536 }
type Options = {
  // Optional JSON file below environment values and command-line flags.
  config: Option[String]
  // Name to greet.
  name: String
  // Server port.
  port: Int where validPort = 8080
  // Tags to print; repeat --tags for each value.
  tags: List[String] = []
} derive (Decode)
fn main() {
  result = cli.Run[Options]("greet", "A proven command-line configuration", (options, s) => {
    println(s"Hello ${options.name} on port ${options.port}")
    println(options.tags)
    }, flags: [.{ field: "port", short: "p" }, .{ field: "config", configFile: true }])
  match (result) {
    error: cli.Error => { println(error); process.Exit(2) }
    Ok => {}
  }
}
