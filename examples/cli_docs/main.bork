import "bork/codec"

import "bork/cli"
import "bork/process"
use codec.Defaults
type Options = {
  // Address of the server to contact.
  host: String = "localhost"
  // Keep the connection open after a request.
  keepAlive: Bool = false
} derive (codec.Decode)
fn main() {
  match (cli.Run[Options]("docs", "Field comments become help", (options, s) => {
    println(s"Connecting to ${options.host}; keep alive: ${options.keepAlive}")
    }, flags: [.{ field: "keepAlive", description: Option.Some("Reuse the connection.") }])) {
    error: cli.Error => { println(error); process.Exit(2) }
    Ok => {}
  }
}
test "comments and overrides reach help" {
  match (cli.Parse[Options]("docs", "", ["--help"], [.{ field: "keepAlive", description: Option.Some("Reuse the connection.") }])) {
    help: cli.Help => {
      assert(help.text.contains("Address of the server to contact."))
      assert(help.text.contains("Reuse the connection."))
      assert(!help.text.contains("Keep the connection open"))
      assert(help.text.contains("default localhost"))
    }
    other => { panic(s"Expected help, got ${other}") }
  }
}
