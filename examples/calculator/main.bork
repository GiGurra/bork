// A calculator: parses and evaluates arithmetic like "2 * (3 + 4)".
// The parser walks the input rune by rune; every failure is a value.

type Expr = sealed {
  Num { value: Int },
  Add { left: Expr, right: Expr },
  Sub { left: Expr, right: Expr },
  Mul { left: Expr, right: Expr },
  Div { left: Expr, right: Expr },
}

// Parsed is a parsed expression and the rune index after it.
type Parsed = { expr: Expr, next: Int }

type SyntaxError = { at: Int, message: String }
type DivisionByZero = { expr: Expr }

fn skipSpaces(src: String, i: Int) uses tailrec: Int {
  match (src.runeAt(i)) {
    Option.Some(r) => if (r.isSpace()) { skipSpaces(src, i + 1) } else { i }
    Option.None => i
  }
}

// expr = term { ("+" | "-") term }
fn parseExpr(src: String, i: Int): Parsed | SyntaxError {
  first = parseTerm(src, i)?
  parseExprRest(src, first)
}

fn parseExprRest(src: String, left: Parsed): Parsed | SyntaxError {
  at = skipSpaces(src, left.next)
  match (src.runeAt(at)) {
    Option.Some(r) => match (r) {
      '+' => {
        right = parseTerm(src, at + 1)?
        parseExprRest(src, Parsed { expr: Expr.Add { left: left.expr, right: right.expr }, next: right.next })
      }
      '-' => {
        right = parseTerm(src, at + 1)?
        parseExprRest(src, Parsed { expr: Expr.Sub { left: left.expr, right: right.expr }, next: right.next })
      }
      _ => left
    }
    Option.None => left
  }
}

// term = factor { ("*" | "/") factor }
fn parseTerm(src: String, i: Int): Parsed | SyntaxError {
  first = parseFactor(src, i)?
  parseTermRest(src, first)
}

fn parseTermRest(src: String, left: Parsed): Parsed | SyntaxError {
  at = skipSpaces(src, left.next)
  match (src.runeAt(at)) {
    Option.Some(r) => match (r) {
      '*' => {
        right = parseFactor(src, at + 1)?
        parseTermRest(src, Parsed { expr: Expr.Mul { left: left.expr, right: right.expr }, next: right.next })
      }
      '/' => {
        right = parseFactor(src, at + 1)?
        parseTermRest(src, Parsed { expr: Expr.Div { left: left.expr, right: right.expr }, next: right.next })
      }
      _ => left
    }
    Option.None => left
  }
}

// factor = number | "(" expr ")"
fn parseFactor(src: String, i: Int): Parsed | SyntaxError {
  at = skipSpaces(src, i)
  match (src.runeAt(at)) {
    Option.Some(r) => if (r == '(') {
      inner = parseExpr(src, at + 1)?
      close = skipSpaces(src, inner.next)
      match (src.runeAt(close)) {
        Option.Some(')') => Parsed { expr: inner.expr, next: close + 1 }
        _ => SyntaxError { at: close, message: "expected )" }
      }
    } else if (r.isDigit()) {
      parseNumber(src, at)
    } else {
      SyntaxError { at: at, message: s"unexpected ${toString(r)}" }
    }
    Option.None => SyntaxError { at: at, message: "unexpected end of input" }
  }
}

fn digitsEnd(src: String, i: Int) uses tailrec: Int {
  match (src.runeAt(i)) {
    Option.Some(r) => if (r.isDigit()) { digitsEnd(src, i + 1) } else { i }
    Option.None => i
  }
}

fn parseNumber(src: String, i: Int): Parsed | SyntaxError {
  end = digitsEnd(src, i)
  match (src.substring(i, end)) {
    digits: String => match (parseInt(digits)) {
      n: Int => Parsed { expr: Expr.Num { value: n }, next: end }
      e: ParseError => SyntaxError { at: i, message: s"bad number $digits: ${e.message}" }
    }
    _: OutOfRange => SyntaxError { at: i, message: "bad number" }
  }
}

fn parse(src: String): Expr | SyntaxError {
  parsed = parseExpr(src, 0)?
  end = skipSpaces(src, parsed.next)
  if (end == src.runeCount()) {
    parsed.expr
  } else {
    SyntaxError { at: end, message: "unexpected input after the expression" }
  }
}

fn eval(e: Expr): Int | DivisionByZero {
  match (e) {
    Expr.Num { value } => value
    Expr.Add { left, right } => eval(left)? + eval(right)?
    Expr.Sub { left, right } => eval(left)? - eval(right)?
    Expr.Mul { left, right } => eval(left)? * eval(right)?
    Expr.Div { left, right } => {
      divisor = eval(right)?
      if (divisor == 0) {
        DivisionByZero { expr: e }
      } else {
        eval(left)? / divisor
      }
    }
  }
}

fn show(e: Expr): String {
  match (e) {
    Expr.Num { value } => s"$value"
    Expr.Add { left, right } => s"(${show(left)} + ${show(right)})"
    Expr.Sub { left, right } => s"(${show(left)} - ${show(right)})"
    Expr.Mul { left, right } => s"(${show(left)} * ${show(right)})"
    Expr.Div { left, right } => s"(${show(left)} / ${show(right)})"
  }
}

fn calculate(src: String): String {
  match (parse(src)) {
    e: Expr => match (eval(e)) {
      n: Int => s"${show(e)} = $n"
      d: DivisionByZero => s"${show(e)}: division by zero in ${show(d.expr)}"
    }
    err: SyntaxError => s"\"$src\": ${err.message} at ${err.at}"
  }
}

fn main() {
  println(calculate("1 + 2 * 3"))
  println(calculate("(1 + 2) * 3"))
  println(calculate(" 100 / (7 - 2) - 4 "))
  println(calculate("10 / (5 - 5)"))
  println(calculate("2 * (3 + 4"))
  println(calculate("2 + x"))
  println(calculate("99999999999999999999"))
}
