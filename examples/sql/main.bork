// bork run examples/sql: scope-owned SQLite and rollback unless committed.
import "bork/sql"

pred nonEmpty(value: String) { value.byteLength() > 0 }
type User = { id: Int, name: String where nonEmpty, note: Option[String] } derive (Decode)
type Count = { count: Int } derive (Decode)
fn demo() uses io + net: Ok | sql.Error | DecodeError {
  scope app {
    db = sql.OpenSqlite(":memory:", app)?
    _ = sql.SQL"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT)".Exec(db)?
    scope transaction {
      tx = sql.Begin(db, transaction)?
      inserted = sql.SQL"INSERT INTO users(name, note) VALUES (${"Ada"}, ${sql.Null {}})".Exec(tx)?
      println(s"inserted ${inserted.rowsAffected}")
      sql.Commit(tx)?
    }
    scope transaction {
      tx = sql.Begin(db, transaction)?
      _ = sql.SQL"INSERT INTO users(name) VALUES (${"discarded"})".Exec(tx)?
    }
    users = sql.SQL"SELECT id, name, note FROM users ORDER BY id".Query[User](db)?
    println(users)
    count = sql.SQL"SELECT count(*) AS count FROM users".Query[Count](db)?
    println(count)
  }
}
fn main() {
  match (demo()) {
    error: sql.Error => eprintln(s"${error.operation}: ${error.message}")
    error: DecodeError => eprintln(s"${error.path}: ${error.message}")
    _ => {}
  }
}
test "commit persists and scope end rolls back" {
  scope app {
    opened = sql.OpenSqlite(":memory:", app)
    match (opened) {
      db: sql.Connection => {
        _ = sql.SQL"CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)".Exec(db)
        scope transaction {
          begun = sql.Begin(db, transaction)
          match (begun) {
            tx: sql.Transaction => {
              _ = sql.SQL"INSERT INTO users(name) VALUES (${"kept"})".Exec(tx)
              _ = sql.Commit(tx)
            }
            _ => assert(false)
          }
        }
        scope transaction {
          begun = sql.Begin(db, transaction)
          match (begun) {
            tx: sql.Transaction => { _ = sql.SQL"INSERT INTO users(name) VALUES (${"discarded"})".Exec(tx) }
            _ => assert(false)
          }
        }
        result: List[Count] | sql.Error | DecodeError = sql.SQL"SELECT count(*) AS count FROM users".Query[Count](db)
        match (result) {
          rows: List[Count] => assertEqual(rows, [Count { count: 1 }])
          _ => assert(false)
        }
      }
      _ => assert(false)
    }
  }
}
