import "bork/url"

fn example() uses io: Ok | ParseError {
  parsed = url.Parse("https://example.com/search?q=hello&q=world")?
  println(parsed.query)
  updated = parsed.copy(query: { "q": ["bork language"], "page": ["1"] })
  println(updated.String())
  println("one/two".PathEscape())
  println("hello world".QueryEscape())
}
fn main() { println(example()) }
