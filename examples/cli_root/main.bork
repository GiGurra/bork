import "bork/cli"
import "bork/codec"
import "bork/process"
use codec.Defaults

type Global = { region: String = "west", verbose: Bool } derive (codec.Decode)
type Deploy = { service: String, replicas: Int = 1 } derive (codec.Decode)

fn main() {
  commands = [cli.RootGroup[Global]("services", "Manage services", [
    cli.RootSubcommand[Global, Deploy]("deploy", "Deploy a service", (global, deploy, s) => {
      println(s"${global.region}: ${deploy.service} x ${deploy.replicas}, verbose=${global.verbose}")
    })
  ])]
  match (cli.RunRoot[Global]("fleet", "Shared root flags", commands,
    flags: [.{ field: "region", env: "FLEET_REGION" }])) {
    error: cli.Error => { eprintln(error.Render("fleet")); process.Exit(2) }
    Ok => {}
  }
}
