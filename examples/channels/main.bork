// Channels carry values from one task to another. A channel belongs to a
// scope, and operations that wait take the scope they wait in, so they
// report Closed or Cancelled as values instead of hanging.

// countdown sends n, n - 1, ..., 1. ? passes Closed or Cancelled on.
fn countdown(s: Scope, out: Channel[Int], n: Int) uses state: Ok | Closed | Cancelled {
  for (i in Seq.range(0, n)) {
    out.send(s, n - i)?
  }
  Ok
}

fn main() {
  scope s {
    // An unbuffered channel: each send waits until a receiver takes it.
    greetings = channel[String](s)
    launch(s, () => {
      for (name in ["Ada", "Grace", "Barbara"]) {
        _ = greetings.send(s, s"hello, $name")
      }
      greetings.close()
    })
    // A for loop receives until the channel is closed.
    for (greeting in greetings.values(s)) {
      println(greeting)
    }
    // After that, receive reports Closed.
    println(greetings.receive(s))

    // A buffered channel holds up to its capacity without a receiver.
    // trySend and tryReceive never wait.
    slots = channel[Int](s, 2)
    println(slots.trySend(1), slots.trySend(2), slots.trySend(3))
    println(s"${slots.length()} of ${slots.capacity().getOr(0)} slots used")
    println(slots.tryReceive())
    // Close is final: sends report Closed, receives drain what is left.
    slots.close()
    println(slots.trySend(4))
    println(slots.toList(s))

    // produce runs a task that fills a new channel, and closes it when
    // the task returns.
    launches = produce[Int](s, 0, out => countdown(s, out, 3))
    for (n in launches.values(s)) {
      println(s"$n...")
    }
    println("liftoff")
  }
}
