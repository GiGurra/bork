type User = { name: String codec { name: "user_name" } }
fn describe(user: User): String {
  result = match (user) {
    User { name } => s"hello $name"
  }
  result
}
fn raw(): String unsafe go {
  value := "}"
  if true { value += `{` }
  return value
}
fn (self: User) rename(): User {
  scope app {
    xs = [1, 2].map(value => value + 1)
    for (item in xs) { println(item) }
    for (step = 0; step < 2; step = step + 1) { println(step) }
    mock println(message) { message }
    match (xs) {
      [first, ...rest] => println(first, rest)
      [] => Ok
    }
    match (self) { User { name } => println(name) }
  }
  self
}
type Kind = sealed { caseName }
fn variant(state: Kind) { match (state) { Kind.caseName => Ok } }
fn contextVariant(state: Kind) { match (state) { .caseName => Ok } }

fn is(value: Int): Int { value }
fn contextTest(state: Kind): Bool { state is .caseName }
fn predicateTest(value: Int): Bool { value is Int where positive }

fn tupleTestPattern(value: (Int, String)): Bool { value is (Int, _) }
fn functionTestPattern(value: (Int) => Int): Bool { value is (Int) => Int }
