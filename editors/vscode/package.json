{
  "name": "bork",
  "displayName": "bork",
  "description": "Language support for bork: highlighting, diagnostics, navigation, completion and formatting.",
  "version": "0.1.0",
  "publisher": "gigurra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiGurra/bork"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bork",
        "aliases": [
          "bork",
          "Bork"
        ],
        "extensions": [
          ".bork"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bork",
        "scopeName": "source.bork",
        "path": "./syntaxes/bork.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.go": "go"
        }
      }
    ],
    "configuration": {
      "title": "bork",
      "properties": {
        "bork.serverPath": {
          "type": "string",
          "default": "bork",
          "scope": "machine",
          "description": "Path to the bork binary. Restart the extension after changing this setting."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The compiler may run compile-time code and Go tools."
    },
    "virtualWorkspaces": false
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
