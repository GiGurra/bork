{
  "name": "bork",
  "displayName": "bork",
  "description": "Language support for bork: highlighting, diagnostics, navigation, completion and formatting.",
  "version": "0.1.0",
  "publisher": "gigurra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GiGurra/bork",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bork",
        "aliases": [
          "bork",
          "Bork"
        ],
        "extensions": [
          ".bork"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bork",
        "scopeName": "source.bork",
        "path": "./syntaxes/bork.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.go": "go"
        }
      }
    ],
    "configuration": {
      "title": "bork",
      "properties": {
        "bork.serverPath": {
          "type": "string",
          "default": "bork",
          "scope": "machine",
          "description": "Path to the bork binary. Run bork: Restart Language Server after changing this setting."
        },
        "bork.delvePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional debugger executable override. Leave empty to use the debugger installed by bork."
        }
      }
    },
    "configurationDefaults": {
      "[bork]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "gigurra.bork",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      {
        "command": "bork.serverStatus",
        "title": "bork: Language Server Status"
      },
      {
        "command": "bork.restartServer",
        "title": "bork: Restart Language Server"
      },
      {
        "command": "bork.showOutput",
        "title": "bork: Show Language Server Output"
      },
      {
        "command": "bork.run",
        "title": "bork: Run"
      },
      {
        "command": "bork.runTest",
        "title": "bork: Run Test"
      }
    ],
    "debuggers": [
      {
        "type": "bork",
        "label": "bork",
        "languages": [
          "bork"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "A bork package directory or script to build and debug."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "bork",
            "request": "launch",
            "name": "Debug bork",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "bork: Launch",
            "body": {
              "type": "bork",
              "request": "launch",
              "name": "Debug bork",
              "program": "${workspaceFolder}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "package": "npm run validate && vsce package --baseContentUrl https://github.com/GiGurra/bork/blob/main/editors/vscode --baseImagesUrl https://github.com/GiGurra/bork/raw/main/editors/vscode",
    "validate": "node scripts/validate.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ovsx": "1.2.0"
  },
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The compiler may run compile-time code and Go tools."
    },
    "virtualWorkspaces": false
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "images/icon.png",
  "homepage": "https://gigurra.github.io/bork/",
  "bugs": {
    "url": "https://github.com/GiGurra/bork/issues"
  },
  "keywords": [
    "bork",
    "language",
    "backend",
    "go",
    "lsp",
    "immutable",
    "type-checking"
  ],
  "galleryBanner": {
    "color": "#103c36",
    "theme": "dark"
  }
}
