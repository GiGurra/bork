import "bork/net"

fn echo(conn: net.Connection, s: Scope) uses net + state + clock: Unit | IoError | Cancelled {
  line = net.Read(conn, 4096, 1000)
  match (line) {
    data: Bytes => { written = net.Write(conn, data, 1000)?; checkpoint(s) }
    end: net.Eof => checkpoint(s)
    error: IoError => error
    stopped: Cancelled => stopped
  }
}
fn lines(conn: net.Connection, s: Scope) uses net + state + clock: Unit | IoError | Cancelled {
  written = net.Write(conn, utf8Bytes("first\r\nlast\r"), 1000)?
  checkpoint(s)
}
fn quiet(conn: net.Connection, s: Scope) uses clock + state: Unit | IoError | Cancelled {
  delay(s, 60000)
}
fn broken(conn: net.Connection, s: Scope): Unit | IoError | Cancelled {
  panic("test handler panic")
}
fn partial(conn: net.Connection, s: Scope) uses net + state + clock: Unit | IoError | Cancelled {
  written = net.Write(conn, utf8Bytes("first"), 1000)?
  match (net.Read(conn, 1, 1000)) {
    data: Bytes => { sent = net.WriteLine(conn, "last", 1000)?; checkpoint(s) }
    end: net.Eof => checkpoint(s)
    error: IoError => error
    stopped: Cancelled => stopped
  }
}
fn sharedSocket(s: Scope) uses net + state: net.Socket | IoError | Cancelled {
  scope child { local = net.Bind("127.0.0.1:0", child)?; attach(local, s) }
}
fn sharedServer(s: Scope) uses net + state + clock: net.Server | IoError | Cancelled {
  scope child { server = net.Listen("127.0.0.1:0", child, echo)?; attach(server, s) }
}
fn sharedConnection(s: Scope, address: String) uses net + state + clock: net.Connection | IoError | Cancelled {
  scope child { conn = net.Dial(address, child, 1000)?; attach(conn, s) }
}
fn exercise(s: Scope) uses io + net + state + clock: Unit | IoError | Cancelled | ParseError {
  server = net.Listen("127.0.0.1:0", s, echo)?
  conn = net.Dial(net.Address(server), s, 1000)?
  println(net.RemoteAddress(conn) == net.Address(server))
  binary = bytes([toByte(0), toByte(255), toByte(42)])
  println(net.Write(conn, binary, 1000))
  println(net.Read(conn, 4096, 1000))
  println(net.Read(conn, 4096, 1000))
  lineServer = net.Listen("127.0.0.1:0", s, lines)?
  lineConn = net.Dial(net.Address(lineServer), s, 1000)?
  println(net.ReadLine(lineConn, 1000))
  println(net.ReadLine(lineConn, 1000))
  println(net.ReadLine(lineConn, 1000))
  socket = net.Bind("127.0.0.1:0", s)?
  sender = net.Bind("127.0.0.1:0", s)?
  println(net.Send(sender, net.SocketAddress(socket), binary, 1000))
  packet = net.Receive(socket, 1000)?
  println(packet.data == binary)
  println(packet.address == net.SocketAddress(sender))
  println(match (net.Receive(socket, 10)) { error: IoError => true; _ => false })
  println(net.SplitAddress("[::1]:80"))
  println(net.JoinAddress("::1", "80"))
  println(net.Resolve("127.0.0.1", s))
  partialServer = net.Listen("127.0.0.1:0", s, partial)?
  partialConn = net.Dial(net.Address(partialServer), s, 1000)?
  println(match (net.ReadLine(partialConn, 100)) { error: IoError => true; _ => false })
  ack = net.Write(partialConn, utf8Bytes("!"), 1000)?
  println(net.ReadLine(partialConn, 1000))
  mixedConn = net.Dial(net.Address(partialServer), s, 1000)?
  println(match (net.ReadLine(mixedConn, 100)) { error: IoError => true; _ => false })
  println(net.Read(mixedConn, 2, 1000))
  ack2 = net.Write(mixedConn, utf8Bytes("!"), 1000)?
  println(net.ReadLine(mixedConn, 1000))
  quietServer = net.Listen("127.0.0.1:0", s, quiet)?
  scope pending {
    blocked = net.Dial(net.Address(quietServer), pending, 1000)?
    println(match (net.Read(blocked, 8, 10)) { error: IoError => true; _ => false })
    cancelAfter(pending, 10)
    println(match (net.Read(blocked)) { stopped: Cancelled => true; _ => false })
  }
  scope waiting {
    blocked = net.Bind("127.0.0.1:0", waiting)?
    cancelAfter(waiting, 10)
    println(match (net.Receive(blocked)) { stopped: Cancelled => true; _ => false })
  }
  brokenServer = net.Listen("127.0.0.1:0", s, broken)?
  brokenConn = net.Dial(net.Address(brokenServer), s, 1000)?
  println(match (net.Read(brokenConn, 8, 1000)) { end: net.Eof => true; _ => false })
  attachedSocket = sharedSocket(s)?
  println(net.Send(sender, net.SocketAddress(attachedSocket), bytes([]), 1000))
  println(net.Receive(attachedSocket, 1000)?.data.isEmpty())
  attachedServer = sharedServer(s)?
  attachedConn = sharedConnection(s, net.Address(attachedServer))?
  sent = net.Write(attachedConn, binary, 1000)?
  println(net.Read(attachedConn, 4096, 1000) == binary)
  scope ended {
    cancelledSocket = net.Bind("127.0.0.1:0", ended)?
    cancel(ended)
    println(match (net.Resolve("127.0.0.1", ended)) { stopped: Cancelled => true; _ => false })
    println(match (net.Receive(cancelledSocket)) { stopped: Cancelled => true; _ => false })
  }
}
fn main() {
  result = scope app { exercise(app) }
  println(result)
}
