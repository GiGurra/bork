pred positive(n: Int) { n > 0 }
fn need(n: Int where positive) uses io { println(n) }
fn values(): Seq[Int where positive] {
  generate[Int where positive] { yield 1; yield 2 }
}
fn checked(n: Int where positive) uses io: Int { println(n); n }
fn identity[T](value: T): T { value }
fn main() {
  println(values().map(n => checked(n)).toList())
  println(values().map(identity).toList())
  for (n in values()) { need(n) }
  xs: List[Int where positive] = values().take(1).toList()
  for (n in xs) { need(n) }
  println(Seq.unfold(0, state => if (state < 3) {
    Option.Some { value: SeqStep { value: state, state: state + 1 } }
    } else { Option.None }).toList())
}
