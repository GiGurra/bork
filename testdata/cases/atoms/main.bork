fn main() {
  // Tasks update an atom concurrently; no update is lost.
  counter = atom(0)
  scope s {
    range(0, 100).forEach(i => fork(s, () => { _ = update(counter, n => n + 1) }))
  }
  println(current(counter))
  // update gives the new value, swap the one it replaced.
  names = atom(["ada"])
  println(update(names, xs => xs.append("bob")))
  println(swap(names, xs => xs.drop(1)))
  println(current(names))
}
