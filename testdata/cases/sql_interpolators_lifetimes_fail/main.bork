import codec "bork/codec"

import "bork/sql"
use codec.Defaults
fn leak() uses io + net: Seq[codec.Value | sql.Error] uses io + net {
  scope app {
    match (sql.OpenSqlite(":memory:", app)) {
      db: sql.Connection => sql.SQL"SELECT 1".RowsJson(db)
      error: sql.Error => generate[codec.Value | sql.Error] { yield error }
    }
  }
}
fn main() {}
