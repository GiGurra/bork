import codec "bork/codec"

import "example.com/private-records-derive-fail/settings"
use codec.Defaults
type Foreign = settings.Config derive (codec.Decode)
type ForeignGo = settings.Config derive (GoStruct)
type Plain = settings.Box[Int] derive (codec.Decode)
type Wrapped = { box: settings.Box[Int] } derive (codec.Decode)
type Container = { boxes: List[Option[settings.Box[Int]]] } derive (codec.Decode)
type LocalBox[T] = { value: T } derive (codec.Decode)
type Nested = LocalBox[settings.Box[Int]] derive (codec.Decode)
type GoWrapped = { secret: settings.Secret } derive (GoStruct)
type GoContainer = { secrets: List[settings.Secret] } derive (GoStruct)
fn main() {}
