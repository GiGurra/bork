// Free functions may share names with methods, and locals may use method names.
fn trim(s: String): String {
  s"[$s]"
}

fn find(id: Int): Option[Int] {
  if (id > 0) { Option.Some { value: id } } else { Option.None }
}

fn main() {
  count = 3
  last = trim(" x ")
  println(count, last, find(2), "still here".toUpper())
}
