// A package's own functions replace prelude functions of the same name,
// and locals may use prelude function names.
fn trim(s: String): String {
  s"[$s]"
}

fn find(id: Int): Option[Int] {
  if (id > 0) { Option.Some { value: id } } else { Option.None }
}

fn main() {
  count = 3
  last = " x ".trim()
  println(count, last, 2.find(), "still here".toUpper())
}
