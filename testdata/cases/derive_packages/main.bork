import codec "bork/codec"

import "bork/json"
import "example.com/tc/api"
use codec.Defaults

// Derived instances are used like any other package's instances.
use api.ItemDecode
use api.StatusDecode
use api.StatusEncode

fn main() {
  r: api.Item | json.JsonError | codec.DecodeError = json.Decode("{\"name\": \"pen\", \"qty\": 0}")
  println(r)
  s: api.Status | json.JsonError | codec.DecodeError = json.Decode("{\"type\": \"Closed\", \"reason\": \"done\"}")
  match (s) {
    st: api.Status => println(json.Encode(st))
    e: json.JsonError => println(e)
    e: codec.DecodeError => println(e)
  }
}
