import "bork/json"
import "example.com/tc/api"

// Derived instances are used like any other package's instances.
use api.ItemDecode
use api.StatusDecode
use api.StatusEncode

fn main() {
  r: api.Item | JsonError | DecodeError = json.Decode("{\"name\": \"pen\", \"qty\": 0}")
  println(r)
  s: api.Status | JsonError | DecodeError = json.Decode("{\"type\": \"Closed\", \"reason\": \"done\"}")
  match (s) {
    st: api.Status => println(json.Encode(st))
    e: JsonError => println(e)
    e: DecodeError => println(e)
  }
}
