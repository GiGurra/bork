fn WrongParam(s: Int): String unsafe go "net/url.QueryEscape"
fn NoGoError(s: String): Int unsafe go "strconv.Atoi"
fn ExtraGoError(s: String): String | GoError unsafe go "strings.ToUpper"
fn NoValueError(s: String): Int8 unsafe go "unicode/utf8.RuneCountInString"
fn ExtraValueError(s: String): Int | GoValueError unsafe go "unicode/utf8.RuneCountInString"
fn Count(a: String): Int unsafe go "strings.Count"
fn NotAFunc(): Float unsafe go "math.Pi"
fn Unexported(s: String): String unsafe go "strings.explode"
fn Method(s: String): String unsafe go "(*strings.Builder).String"
fn Generic(xs: List[Int]): Int unsafe go "slices.Max"
fn Missing(): Int unsafe go "example.com/nowhere.F"
fn Cut(s: String, sep: String): String unsafe go "strings.Cut"
fn NotOption(key: String): String unsafe go "os.LookupEnv"
fn Typed[T](s: String): String unsafe go "strings.ToUpper"
pred short(s: String) { byteLength(s) < 10 }
fn Promise(s: String): String where short unsafe go "strings.ToUpper"
fn Lossy(s: String, n: Int): String unsafe go "strings.Repeat32"
fn TooWide(x: Int): Int unsafe go "math/bits.Len32"
fn FloatNarrow(x: Float): Uint32 unsafe go "math.Float32bits"
fn Other(s: String): Int | OutOfRange unsafe go "strconv.Atoi"
fn NoResult(): Int unsafe go "os.Clearenv"
fn NotAName(): Int unsafe go "Atoi"

fn main() {}
