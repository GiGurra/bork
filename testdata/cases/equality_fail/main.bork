type F = { f: (Int) => Int }
type W = { x: Int } derive (Eq)
type V = { x: Int } derive (Show)

instance eqW: Eq[W] { fn equals(a: W, b: W): Bool { true } }

fn same[T](a: T, b: T): Bool { a == b }

fn main() {
  println([F { f: x => x }].includes(F { f: x => x }))
  println([(x: Int) => x] == [])
}
