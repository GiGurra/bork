pred positive(n: Int) { n > 0 }
pred atLeast(value: Int, minimum: Int) { value >= minimum }
type Interval = { lo: Int, hi: Int where atLeast(lo) = 10 }
type Bounded = { value: Int where positive }
type State = sealed { Valid { value: Int where positive } }
fn main() {
  _: Interval = .{ lo: 10, hi: 5 }
  _: Interval = .{ lo: 12 }
  _: Bounded = .{ value: 0 }
  _: State = .Valid { value: 0 }
}
