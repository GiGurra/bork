import "bork/codec"
import "bork/json"
import "bork/test"

use codec.Defaults

pred positive(n: Int) { n > 0 }
type Payload[T] = sealed { Pair(T, String), One((T, String)), Named { value: T }, Empty }
type Positive = sealed { Value(Int where positive), Empty }
derive codec.Encode for Payload
derive codec.Decode for Payload
derive codec.Encode for Positive
derive codec.Decode for Positive

type Defaults = { payload: Option[Int] = .Some(4), nested: Option[Option[Int]] = .Some(.Some(5)), tuple: Payload[Int] = Payload[Int].One((8, "default")) }
fn defaultOption(value: Option[Int] = Option[Int].Some(9)): Int { match(value) { .Some(n) => n, .None => 0 } }

type Bits = sealed { Pair(Bool, Bool), Empty }

fn read[T](value: Payload[T]): T | String {
  match (value) {
    .Pair(n, _) => n
    .One((n, _)) => n
    .Named { value: n } => n
    .Empty => "empty"
  }
}
fn explicitOption(value: Option[Int]): Int { match(value) { Option[Int].Some(n) => n, Option[Int].None => 0 } }
fn optional(): Option[Int] { n = Option.Some(7)?; .Some(n + 1) }
fn once(n: Int) uses io: Int { println(s"once $n"); n }
fn checked(n: Positive): Int { match (n) { .Value(value) => needsPositive(value), .Empty => 1 } }
fn needsPositive(n: Int where positive): Int { n }
fn inspectBits(x: Bits): Bool {
  match (x) { .Pair(true, _) => true, .Pair(false, true) => true, .Pair(false, false) => false, .Empty => false }
}
fn main() {
  defaults = Defaults {}
  assertEqual(defaults.payload, Option.Some(4))
  assertEqual(defaults.nested, Option.Some(Option.Some(5)))
  assertEqual(read(defaults.tuple), 8)
  assertEqual(defaultOption(), 9)
  value = Payload.Pair(2, "ok")
  tuple = Payload[Int].One((3, "tuple"))
  println(value, tuple, read(value), read(tuple), Payload[Int].Empty)
  println(match (value) { Payload[Int].Pair(n, _) => n, _ => 0 })
  println(value is .Pair(Int, "ok"), value is Payload[Int].Pair(Int, String), value is .Empty)
  println(test.AssertIs[Payload[Int]](value))
  println(value == Payload.Pair(2, "ok"), { value: "key" }.get(Payload.Pair(2, "ok")))
  println(Payload.Pair(once(4), { println("second"); "effect" }))
  println(comptime { Payload.One((5, "constant")) })
  println(optional(), Option[Int].Some(6), Option[Int].None, Option.Some(3).map(n => n + 1))
  println(explicitOption(Option[Int].Some(12)), explicitOption(Option[Int].None), Option[Int].None is Option[Int].None)
  println(inspectBits(.Pair(false, true)), checked(.Value(1)))
  println(json.Encode(value), json.Encode(tuple), json.Encode(Payload[Int].Named { value: 6 }))
  println(json.Decode[Payload[Int]]("{\"type\":\"Pair\",\"values\":[2,\"ok\"]}"))
  println(json.Decode[Payload[Int]]("{\"type\":\"Pair\",\"values\":[2]}"))
  println(json.Decode[Payload[Int]]("{\"type\":\"Pair\",\"values\":[2,\"ok\",3]}"))
  println(json.Decode[Payload[Int]]("{\"type\":\"Pair\",\"values\":3}"))
  println(json.Decode[Payload[Int]]("{\"type\":\"Pair\",\"values\":[\"bad\",\"ok\"]}"))
  println(json.Decode[Payload[Int]]("\"Pair\""))
  println(json.Decode[Positive]("{\"type\":\"Value\",\"values\":[0]}"))
  println(json.Encode(Option.Some(9)), json.Decode[Option[Int]]("9"), json.Decode[Option[Int]]("null"))
}
