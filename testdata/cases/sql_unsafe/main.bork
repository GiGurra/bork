import codec "bork/codec"

import "bork/sql"
use codec.Defaults
type Row = { name: String } derive (codec.Decode)
fn demo(text: String) uses io + net: Ok | sql.Error | codec.DecodeError {
  scope app {
    db = sql.OpenSqlite(":memory:", app)?
    _ = sql.Exec(db, sql.Unsafe(text), [])?
    _ = sql.Exec(db, sql.Unsafe("INSERT INTO users VALUES (?)"), ["O'Reilly"])?
    query = sql.Unsafe("SELECT name FROM users")
    println(sql.Query[Row](db, query, [])?)
    println(sql.QueryJson(db, query, [])?)
    println(sql.Rows[Row](db, query, []).toList())
    println(sql.RowsJson(db, query, []).toList())
    println(sql.Rows[Row](db, query, []).toList())
  }
}
fn main() {
  match (demo("CREATE TABLE users (name TEXT)")) {
    error: sql.Error => println(error.operation, error.message)
    error: codec.DecodeError => println(error.message)
    _ => {}
  }
}
