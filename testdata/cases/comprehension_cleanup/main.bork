type Handle = resource
type Stopped = {}

fn openHandle(s: Scope, closed: Atom[Int]) uses state: Handle unsafe go {
  return Handle{handle: int64(1), owner: s.Own(func() {
    closed.updateFn(func(n int64) int64 { return n + 1 })
  })}
}
fn readHandle(handle: Handle): Int unsafe go { return handle.handle.(int64) }

// Each inner sequence owns a handle, open across its yields.
fn numbers(base: Int, opened: Atom[Int], closed: Atom[Int]): Seq[Int] uses state {
  generate[Int] {
    scope producer {
      handle = openHandle(producer, closed)
      _ = update(opened, n => n + 1)
      for n in range(0, 3) {
        yield base + n * readHandle(handle)
      }
    }
  }
}

// The comprehension's inner generator depends on the outer one, so a
// handle is opened per outer value.
fn pairs(opened: Atom[Int], closed: Atom[Int]): Seq[(Int, Int)] uses state {
  for {
    base in [10, 20]
    n in numbers(base, opened, closed)
    if n % 2 == 0
  } yield (base, n)
}

fn stop(): Ok | Stopped { Stopped {} }
fn consume(mode: String, xs: Seq[(Int, Int)] uses state) uses io + state: Ok | Stopped {
  match mode {
    "break" => { for value in xs { println(value); break } }
    "take" => { println(xs.take(1).toList()) }
    "first" => { println(xs.first()) }
    "error" => { for value in xs { println(value); stop()? } }
    _ => { println(xs.toList()) }
  }
  Ok
}

fn main() {
  for mode in ["break", "take", "first", "error", "full"] {
    opened = atom(0)
    closed = atom(0)
    values = pairs(opened, closed)
    println(mode, "before", current(opened), current(closed))
    println(consume(mode, values))
    println(mode, "after", current(opened), current(closed))
  }
}
