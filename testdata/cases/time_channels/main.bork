import "bork/time"

fn ms(n: Int): time.Duration {
  (n * 1_000_000).nanos()
}

fn describe(r: time.Instant | Closed | Cancelled): String {
  match (r) {
    _: time.Instant => "an instant"
    _: Closed => "closed"
    c: Cancelled => s"cancelled: ${c.reason}"
  }
}

fn main() {
  scope s {
    // After fires once, then stays closed: a deadline made once stays
    // expired.
    deadline = time.After(s, ms(300))
    println(deadline.tryReceive())
    println(describe(deadline.receive(s)))
    println(describe(deadline.receive(s)))
    // Tick delivers until it is closed.
    ticks = time.Tick(s, ms(2))
    for (_ in Seq.range(0, 3)) {
      println(describe(ticks.receive(s)))
    }
    ticks.close()
    println(describe(ticks.receive(s)))
    // A timer that has not fired is stopped by close, and by its scope.
    never = time.After(s, ms(60_000))
    never.close()
    println(describe(never.receive(s)))
    println(withTimeout(s, 5.millis(), c => describe(time.After(c, ms(60_000)).receive(c))))
  }
}
