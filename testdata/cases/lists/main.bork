type User = { name: String, age: Int }

fn double(x: Int): Int { x * 2 }

fn adults(users: List[User]): List[String] {
  users.filter(u => u.age >= 18).map(u => u.name)
}

fn main() {
  xs = [1, 2, 3, 4]
  println(xs, xs.length(), xs.isEmpty())
  println(xs.map(x => x * 10), xs.map(double))
  println(xs.filter(x => x % 2 == 0))
  println(xs.fold(0, (sum, x) => sum + x))
  println(xs.get(1), xs.get(9), xs.head(), xs.last())
  println(xs.find(x => x > 2), xs.any(x => x > 3), xs.all(x => x > 0), xs.count(x => x > 1))
  println(xs.take(2), xs.drop(2), xs.reverse(), xs.concat([5]), xs.append(5), prepend(0, xs))
  println(range(0, 5), ["a", "b"].join("-"), "a,b,c".split(","))
  println([3, 1, 2].sortWith((a, b) => a < b))
  words: List[String] = []
  println(words, [1, 2].flatMap(x => [x, x]))
  ["x", "y"].forEach(w => println(s"item $w"))
  users = [User { name: "ann", age: 30 }, User { name: "bob", age: 12 }]
  println(users)
  piped()
}

fn piped() uses io {
  users = [User { name: "ann", age: 30 }, User { name: "bob", age: 12 }, User { name: "cy", age: 44 }]
  println(adults(users))
  total = users.map(u => u.age).fold(0, (sum, age) => sum + age)
  println(total)
}
