type User = { name: String, age: Int }

fn double(x: Int): Int { x * 2 }

fn adults(users: List[User]): List[String] {
  users
    |> filter(u => u.age >= 18)
    |> map(u => u.name)
}

fn main() {
  xs = [1, 2, 3, 4]
  println(xs, length(xs), isEmpty(xs))
  println(map(xs, x => x * 10), map(xs, double))
  println(filter(xs, x => x % 2 == 0))
  println(fold(xs, 0, (sum, x) => sum + x))
  println(get(xs, 1), get(xs, 9), head(xs), last(xs))
  println(find(xs, x => x > 2), any(xs, x => x > 3), all(xs, x => x > 0), count(xs, x => x > 1))
  println(take(xs, 2), drop(xs, 2), reverse(xs), concat(xs, [5]), append(xs, 5), prepend(0, xs))
  println(range(0, 5), join(["a", "b"], "-"), split("a,b,c", ","))
  println(sortWith([3, 1, 2], (a, b) => a < b))
  words: List[String] = []
  println(words, flatMap([1, 2], x => [x, x]))
  forEach(["x", "y"], w => println(s"item $w"))
  users = [User { name: "ann", age: 30 }, User { name: "bob", age: 12 }]
  println(users)
  piped()
}

fn piped() {
  users = [User { name: "ann", age: 30 }, User { name: "bob", age: 12 }, User { name: "cy", age: 44 }]
  println(adults(users))
  total = users
    |> map(u => u.age)
    |> fold(0, (sum, age) => sum + age)
  println(total)
}
