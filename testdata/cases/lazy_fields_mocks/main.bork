type Lazy = { lazy value: Int }
fn fetch() uses io: Int unsafe go { return 7 }
test "shared fields force once in the reader context" {
  value = Lazy { value: fetch() }
  shared = value.copy()
  calls = mock fetch() { 11 }
  calls.expect(times: 1)
  scope s {
    tasks = [1, 2, 3].map(n => spawn(s, () => shared.value))
    assertEqual(tasks.map(t => await(t)), [11, 11, 11])
  }
  assertEqual(value.value, 11)
}
test "a stored field does not carry mocks" {
  value = scope s {
    calls = mock fetch() { 11 }
    calls.expect(times: 0)
    Lazy { value: fetch() }
  }
  assertEqual(value.value, 7)
}
