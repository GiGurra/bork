import codec "bork/codec"
use codec.Defaults

pred positive(x: Int) { x > 0 }
pred small(x: Int) { x < 100 }

// Must promise positive for its Int result.
instance decodePositive: codec.Decode[Int where positive] {
  fn decode(json: codec.Value): Int | codec.DecodeError { 1 }
}

// The promise is checked against the body.
instance decodeSmall: codec.Decode[Int where small] {
  fn decode(json: codec.Value): Int where small | codec.DecodeError { 500 }
}

instance encodeOptions: codec.Encode[Option[Int where positive]] {
  fn encode(x: Option[Int]): codec.Value { codec.Value.Null }
}

instance encodeBad: codec.Encode[String] {
  fn encode(x: String where positive): codec.Value { codec.Value.Null }
}

// Both constrained instances fit a field that is positive and small,
// and neither is more specific.
type Both = { n: Int where positive and small } derive (codec.Decode)

fn main() {}
