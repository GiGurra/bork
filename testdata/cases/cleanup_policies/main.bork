// Finalizers that fail do not stop the others; their failures are
// raised together once the scope has closed.
test "every finalizer runs, and failures are raised together" {
  scope s {
    onClose(s, () => println("finalizer 1 ran"))
    onClose(s, () => panic("finalizer 2 failed"))
    onClose(s, () => println("finalizer 3 ran"))
    onClose(s, () => panic("finalizer 4 failed"))
    onClose(s, () => println("finalizer 5 ran"))
  }
}

test "a task's failure is raised with the finalizers'" {
  scope s {
    onClose(s, () => panic("the finalizer failed"))
    fork(s, () => panic("the task failed"))
  }
}
