fn main() {
  words = ["a", "b"]
  // Nothing decides what these hold.
  println(words.fold([], (acc, w) => acc))
  println(words.fold(Option.None, (b, w) => b))
  // Once the body decides, the rest must agree.
  println(words.fold([], (acc, w) => acc.append(1)).concat(["x"]))
  println(words.fold([], (acc, w) => if (w == "a") { acc.append(1) } else { acc.append(w) }))
  println(words.fold({:}, (m, w) => m.put(w, 1)).getOr(1, 0))
  println(words.fold([], (acc, w) => acc.first()))
}
