pred positive(n: Int) { n > 0 }
fn promise(n: Int where positive): Int where positive { n }
fn scenario(n: Int) uses io {
  println(n)
  if (positive(n)) { println(n) }
  println(promise(1))
  println(7)
  println(0)
}
fn main() {}
fn producer() uses state {
  scope s {
    _ = forkProducer[Int](s, capacity: 1, work: out => out.send(s, 1))
  }
}
