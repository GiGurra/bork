import "bork/url"
import "bork/http"

fn exercise() uses io: Unit | ParseError {
  parsed = url.Parse("https://user:p%40ss@[::1]:8443/a%2Fb?q=one&q=two&space=hello+world#f%2Fg")?
  println(parsed.scheme)
  println(parsed.host)
  println(parsed.Hostname())
  println(parsed.Port())
  println(parsed.path)
  println(parsed.query)
  println(parsed.fragment)
  println(parsed.user)
  println(parsed.String())
  println(parsed.copy(path: "/new path", fragment: "new fragment").String())
  println(url.Url { scheme: "https", host: "example.com", path: "/hello world", query: { "q": ["a+b", "é"], "flag": [""] }, fragment: "a b" }.String())
  println(url.ParseQuery("b=2&a=1&a=3&flag"))
  println({ "z": ["2", "1"], "a": ["hello world"], "empty": [] }.EncodeQuery())
  println(url.Parse("../a%2Fb?x=1#two"))
  opaque = url.Parse("mailto:user@example.com")?
  println(opaque)
  println(opaque.String())
  relative = url.Parse("../a%2Fb?x=1#two")?
  println(relative.String())
  noPassword = url.Parse("https://user@example.com/")?
  println(noPassword.user)
  println(noPassword.String())
  networkPath = url.Parse("//example.com/a")?
  println(networkPath.String())
  emptyPassword = url.Parse("https://user:@example.com/")?
  println(emptyPassword.user)
  println(emptyPassword.String())
  hostless = url.Parse("https:/path")?
  println(hostless.omitHost)
  println(hostless.String())
  forced = url.Parse("https://example.com?")?
  println(forced)
  println(forced.String())
  println("a/b +é".PathEscape())
  println("a/b +é".QueryEscape())
  println("a%2Fb+%20".PathUnescape() == "a/b+ ")
  println("a%2Fb+%20".QueryUnescape() == "a/b  ")
  println("%xx".PathUnescape())
  println("%".QueryUnescape())
  println(url.Parse("https://example.com/%xx"))
  println(url.Parse("https://example.com/?valid=1&bad=%xx"))
  println(url.ParseQuery("valid=1&bad=%xx"))
  println(url.ParseQuery("a=1;b=2"))
  println(http.Query(http.Request { method: "GET", path: "/test", query: "a=1&a=2", params: {:}, headers: {:}, body: "" }))
  println(http.Query(http.Request { method: "GET", path: "/test", query: "good=1&bad=%xx", params: {:}, headers: {:}, body: "" }))
}
fn main() { println(exercise()) }
