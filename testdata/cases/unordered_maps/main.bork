fn count(words: List[String]): Map[String, Int] {
  initial: Map[String, Int] = {:}
  words.fold(initial.unordered(), (m, w) => m.put(w, m.getOr(w, 0) + 1))
}

fn main() {
  counts = count("the cat and the dog and the bird".split(" "))
  // Printing is sorted even though traversal keeps hash order.
  println(counts)
  println(counts.get("the"))
  println(counts.size())
  // Equal to an ordered map with the same entries.
  println(counts == { "the": 3, "cat": 1, "and": 2, "dog": 1, "bird": 1 })
  // Everything keeps it unordered; InOrder takes the order it has.
  fewer = counts.remove("the").filter((w, n) => n == 1)
  println(fewer)
  println(fewer.inOrder().size())
  println(counts.mapValues(n => n * 100))
}
