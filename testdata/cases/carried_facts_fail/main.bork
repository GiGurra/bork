pred nonNegative(n: Int) { n >= 0 }

// The value an iteration passes on must have the facts the name
// declares.
fn nextValue(xs: List[Int]) uses io {
  i: Int where nonNegative = 0
  for (x in xs) {
    i = i - x
  }
  println(i)
}

// So must the value a break passes on.
fn breakValue(xs: List[Int]) uses io {
  i: Int where nonNegative = 0
  for (x in xs) {
    if (x < 0) {
      i = x
      break
    }
  }
  println(i)
}

// A value passed on by several paths has only what it has on all of
// them: here the post clause's i may be negative.
fn severalPaths() uses io {
  k = 0
  for (i: Int where nonNegative = 0; k < 4; i = i) {
    println(i)
    k = k + 1
    i = 0 - k
    if (k == 2) {
      continue
    }
    if (nonNegative(i)) {
      continue
    }
    break
  }
}

fn main() uses io {
  nextValue([1])
  breakValue([1])
  severalPaths()
}
