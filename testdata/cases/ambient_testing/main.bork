ambient traceId: String
logged propagated("x-request") ambient requestId: String

// What boundary code would send (effectful, as boundary code is).
fn Sent() uses io: String unsafe go {
  out := ""
  for _, h := range _borkPropagated() {
    out += h.Name + "=" + h.Value
  }
  return out
}

fn Label() uses io: String {
  "real"
}

fn Tag(msg: String) uses io needs traceId: String {
  s"[${traceId}] ${msg}"
}

fn Report() uses io needs traceId: String {
  Tag("r")
}

pred positive(x: Int) {
  x > 0
}

// unsafe go code that promises a fact is checked in tests.
fn limit() needs traceId: Int where positive unsafe go {
  return int64(len(traceId))
}

fn main() uses io {
  println(with (traceId: "m") { Report() })
}

test "unsafe go with a fact" {
  assertEqual(with (traceId: "abc") { limit() }, 3)
}

// Tests bind the values the code reads.
test "binds" {
  assertEqual(with (traceId: "t") { Report() }, "[t] r")
}

// A mock reads its target's needs: the values the call passes.
test "mock sees needs" {
  mock Tag(msg) { s"mocked ${traceId} ${msg}" }
  assertEqual(with (traceId: "t") { Report() }, "mocked t r")
}

// The target's name in a mock passes them on.
test "real" {
  calls = mock Tag(msg) { Tag(msg) }
  assertEqual(with (traceId: "t") { Report() }, "[t] r")
  assertEqual(calls.count(), 1)
}

// Mocks stay in force inside a with that publishes values, and a mock
// pushed inside one keeps them.
test "mocks and published values" {
  mock Label() { "outer" }
  with (requestId: "r1") {
    assertEqual(Label(), "outer")
    assertEqual(Sent(), "x-request=r1")
    mock Label() { s"inner ${Sent()}" }
    assertEqual(Label(), "inner x-request=r1")
    with (requestId: "r2") {
      assertEqual(Label(), "inner x-request=r2")
    }
    assertEqual(Label(), "inner x-request=r1")
  }
  assertEqual(Label(), "outer")
  assertEqual(Sent(), "")
}

// A mock in a generator passes calls on to the mock around it.
test "mock in generate" {
  mock Label() { "outer" }
  g = generate[String] {
    mock Label() { s"inner ${Label()}" }
    yield Label()
  }
  for (x in g) {
    assertEqual(x, "inner outer")
  }
  assertEqual(Label(), "outer")
}

// Tasks see both.
test "tasks see mocks and published values" {
  mock Label() { "mocked" }
  with (requestId: "r") {
    scope s {
      t = fork(s, () => s"${Label()} ${Sent()}")
      assertEqual(await(t), "mocked x-request=r")
    }
  }
}
