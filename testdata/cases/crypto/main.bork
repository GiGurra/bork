import "bork/crypto"
import "bork/encoding"
fn legacyHash() uses random: String unsafe go {
  import "golang.org/x/crypto/bcrypt"
  hash, err := bcrypt.GenerateFromPassword([]byte("secret"), 4)
  if err != nil { panic(err) }
  return string(hash)
}
fn entropyFailures(draw: () uses random => Bool, token: () uses random => Bool, password: () uses random => Bool) uses random + state: Bool unsafe go {
  import "crypto/rand"
  import "strings"
  previous := rand.Reader
  rand.Reader = strings.NewReader("")
  defer func() { rand.Reader = previous }()
  return draw() && token() && password()
}
fn exercise() uses io + random + state: Ok | crypto.Error | ParseError {
  println(crypto.SHA256Hex(encoding.Utf8("abc")))
  println(crypto.SHA512Hex(encoding.Utf8("abc")))
  key = encoding.ParseHex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")?
  data = encoding.Utf8("Hi There")
  signature = crypto.HMAC256(key, data)
  println(encoding.Hex(signature))
  println(encoding.Hex(crypto.HMAC512(key, data)))
  println(crypto.VerifyHMAC256(key, data, signature))
  println(crypto.VerifyHMAC256(key, encoding.Utf8("changed"), signature))
  println(crypto.Equal(signature, [].toBytes()))
  println(crypto.RandomBytes(0))
  random = crypto.RandomBytes(16)?
  println(random.length() == 16)
  token = crypto.Token()?
  println(token.byteLength() == 43 && !token.contains("=") && !token.contains("+"))
  hashed = crypto.HashPassword("secret")?
  println(hashed.startsWith("$argon2id$v=19$m=19456,t=2,p=1$"))
  println(crypto.VerifyPassword("secret", hashed))
  println(crypto.VerifyPassword("wrong", hashed))
  println(crypto.NeedsRehash(hashed))
  custom = crypto.PasswordParams { memoryKiB: 1024, iterations: 1, parallelism: 1 }
  weak = crypto.HashPassword("secret", custom)?
  println(crypto.VerifyPassword("secret", weak))
  println(crypto.NeedsRehash(weak))
  println(crypto.NeedsRehash(weak, custom))
  long = "x".repeat(100)
  longHash = crypto.HashPassword(long, custom)?
  println(crypto.VerifyPassword(long, longHash))
  legacy = legacyHash()
  println(crypto.VerifyPassword("secret", legacy))
  println(crypto.VerifyPassword("wrong", legacy))
  println(crypto.NeedsRehash(legacy))
  println(match (crypto.VerifyPassword("secret", "bad")) { error: crypto.Error => true; _ => false })
  oversized = hashed.replaceAll("m=19456", "m=4294967295")
  println(match (crypto.VerifyPassword("secret", oversized)) { error: crypto.Error => true; _ => false })
  println(crypto.NeedsRehash("bad"))
  println(entropyFailures(() => match (crypto.RandomBytes(1)) { error: crypto.Error => true; _ => false }, () => match (crypto.Token()) { error: crypto.Error => true; _ => false }, () => match (crypto.HashPassword("secret")) { error: crypto.Error => true; _ => false }))
  // Fixed vector produced by the reference libargon2 C implementation.
  imported = "$argon2id$v=19$m=1024,t=2,p=1$c29tZXNhbHQ$7FfsnA6vUe7qLpL/3Kqc3uR48ZJyFbUVt7jWZlf0Htk"
  println(crypto.VerifyPassword("password", imported))
  println(crypto.VerifyPassword("wrong", imported))
  println(crypto.VerifyPassword("password", imported.replaceAll("m=1024,t=2,p=1", "p=1,m=1024,t=2")))
  println(crypto.NeedsRehash(imported))
  duplicated = imported.replaceAll("m=1024,t=2,p=1", "m=1024,m=1024,p=1")
  println(match (crypto.VerifyPassword("password", duplicated)) { error: crypto.Error => true; _ => false })
  println(match (crypto.VerifyPassword("password", imported + "=")) { error: crypto.Error => true; _ => false })

}
fn main() { println(exercise()) }
