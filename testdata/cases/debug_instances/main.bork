import codec "bork/codec"

import "bork/json"
use codec.Defaults
pred positive(x: Int) { x > 0 }
type Pos = Int where positive
type Config = { port: Pos }
instance encodePos: codec.Encode[Pos] {
  fn encode(x: Pos): codec.Value { codec.Value.String { value: s":$x" } }
}
fn encodeParam(x: Pos): String | json.JsonError { json.Encode(dbg(x)) }
fn main() {
  p: Pos = 1
  println(json.Encode(p))
  println(json.Encode(dbg(p)))
  c = Config { port: 2 }
  println(json.Encode(dbg(c.port)))
  println(encodeParam(3))
  println(json.Encode(dbg(4)))
}
