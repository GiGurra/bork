import "bork/json"
type Handler = { name: String, run: (Int) => Int } derive (Decode)
type Wrapper = { inner: Handler } derive (Encode)
type Bad = { x: Int } derive (Show)
type Unknown = { x: Int } derive (Nope)

class Show[T] { fn show(x: T): String }

type Plain = { x: Int }

fn main() {
  // Plain has no Decode instance: the hint says how to derive one.
  p: Plain | JsonError | DecodeError = json.Decode("{}")
  println(p)
}
