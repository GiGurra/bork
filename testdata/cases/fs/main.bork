import "bork/encoding"
import "bork/fs"

fn exercise(s: Scope) uses io: Ok | fs.Error {
  directory = fs.TempDir(s)?
  root = fs.DirectoryPath(directory)
  early = failAfterCreating(root)
  println(match (early) { _: Ok => false, _: fs.Error => true })
  println((fs.ReadDir(root)?).length())
  println(recovered(() => panicAfterCreating(root)))
  println((fs.ReadDir(root)?).length())
  path = fs.Join([root, "data.bin"])
  fs.Write(path, [toByte(0), toByte(255)].toBytes())?
  fs.Append(path, encoding.Utf8("!"))?
  println(fs.Read(path)?)
  println(match (fs.CreateNew(path, s)) {
    _: fs.File => false
    _: fs.Exists => true
    _: fs.NotFound => false
    _: fs.PermissionDenied => false
    _: IoError => false
  })
  file = fs.Open(path, s)?
  println(fs.ReadAll(file)?)
  println((fs.Stat(path)?).size)
  println((fs.Stat(path)?).kind)
  fs.MkdirAll(fs.Join([root, "nested"]))?
  println((fs.ReadDir(root)?).map(entry => entry.name))
  println((fs.Walk(root)?).map(entry => entry.kind))
  lines = fs.Create(fs.Join([root, "lines.txt"]), s)?
  _ = fs.WriteText(lines, "a\r\nb\nlast")?
  reader = fs.Open(fs.Path(lines), s)?
  fs.ForEachLine(reader, line => println(line))?
  temporary = fs.TempFile(s, root)?
  _ = fs.WriteTo(temporary, encoding.Utf8("temp"))?
  println((fs.Stat(fs.Path(temporary))?).size)
  endingsPath = fs.Join([root, "endings.txt"])
  fs.Write(endingsPath, encoding.Utf8("\n\r\nlast\r"))?
  endings = fs.Open(endingsPath, s)?
  fs.ForEachLine(endings, line => println(line.byteLength()))?
  linkPath = fs.Join([root, "link"])
  symlink(fs.Join([root, "nested"]), linkPath)?
  println((fs.Stat(linkPath)?).kind)
  println(((fs.Walk(root)?).filter(entry => entry.kind == "directory")).length())
  println(fs.Base(path))
  println(fs.Ext(path))
  println(fs.Dir(path) == root)
  println((fs.Abs(path)?).startsWith(root))
  longFile = fs.Create(fs.Join([root, "long.txt"]), s)?
  _ = fs.WriteText(longFile, "x".repeat(100000))?
  longReader = fs.Open(fs.Path(longFile), s)?
  fs.ForEachLine(longReader, line => println(line.byteLength()))?
  fs.Rename(path, fs.Join([root, "renamed.bin"]))?
  fs.Remove(fs.Join([root, "renamed.bin"]))?
  println(match (fs.Read(path)) {
    _: Bytes => false
    _: fs.NotFound => true
    _: fs.PermissionDenied => false
    _: fs.Exists => false
    _: IoError => false
  })
}

fn main() {
  result = scope s { exercise(s) }
  println(errorKinds())
  paths = scope cleanup { temporaryPaths(cleanup) }
  match (paths) {
    names: List[String] => names.forEach(name => println(match (fs.Stat(name)) {
      _: fs.Info => false
      _: fs.NotFound => true
      _: fs.PermissionDenied => false
      _: fs.Exists => false
      _: IoError => false
    }))
    error: fs.Error => println(error)
  }
  match (result) {
    _: Ok => println("ok")
    error: fs.Error => println(error)
  }
}

fn temporaryPaths(s: Scope) uses io: List[String] | fs.Error {
  directory = fs.TempDir(s)?
  root = fs.DirectoryPath(directory)
  file = fs.TempFile(s, root)?
  [root, fs.Path(file)]
}
fn errorKinds(): List[String] unsafe go {
  import "errors"
  import "os"
  kinds := []string{}
  for _, err := range []error{os.ErrNotExist, os.ErrPermission, os.ErrExist, errors.New("other")} {
    kind, _ := _borkIoFailure(&os.PathError{Op: "read", Path: "test", Err: err})
    kinds = append(kinds, kind)
  }
  return kinds
}

fn failAfterCreating(parent: String) uses io: Ok | fs.Error {
  scope s {
    directory = fs.TempDir(s, parent)?
    _ = fs.Read(fs.Join([fs.DirectoryPath(directory), "missing"]))?
  }
}
fn panicAfterCreating(parent: String) uses io: Ok | fs.Error {
  scope s {
    _ = fs.TempDir(s, parent)?
    panic("cleanup probe")
  }
}
fn recovered(work: () => (Ok | fs.Error)): Bool unsafe go {
  return func() (panicked bool) {
    defer func() { if recover() != nil { panicked = true } }()
    work()
    return false
  }()
}
fn symlink(target: String, path: String) uses io: Ok | IoError unsafe go {
  import "os"
  if err := os.Symlink(target, path); err != nil { return IoError{path: path, message: err.Error()} }
  return _borkOk()
}
