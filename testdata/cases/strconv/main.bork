test "Int boundaries and round trips" {
  match ("-9223372036854775808".ParseInt()) {
    n: Int => {
      assertEqual(n.Format(10), "-9223372036854775808")
      assertEqual(n.Hex(prefix: true).ParseInt(0), n)
      assertEqual(n.Binary(prefix: true).ParseInt(0), n)
      assertEqual(n.Octal(prefix: true).ParseInt(0), n)
    }
    error: ParseError => panic(error.message)
  }
  match ("9223372036854775807".ParseInt()) {
    n: Int => {
      assertEqual(n.Format(10), "9223372036854775807")
      assertEqual(n.Hex(prefix: true).ParseInt(0), n)
      assertEqual(n.Binary(prefix: true).ParseInt(0), n)
      assertEqual(n.Octal(prefix: true).ParseInt(0), n)
    }
    error: ParseError => panic(error.message)
  }
  match ("-9223372036854775809".ParseInt()) {
    n: Int => panic("overflow accepted")
    error: ParseError => assertEqual(error.input, "-9223372036854775809")
  }
  match ("9223372036854775808".ParseInt()) {
    n: Int => panic("overflow accepted")
    error: ParseError => assertEqual(error.input, "9223372036854775808")
  }
}

test "Uint8 boundaries and round trips" {
  match ("0".ParseUint8()) {
    n: Uint8 => {
      assertEqual(n.Format(10), "0")
      assertEqual(n.Hex(prefix: true).ParseUint8(0), n)
      assertEqual(n.Binary(prefix: true).ParseUint8(0), n)
      assertEqual(n.Octal(prefix: true).ParseUint8(0), n)
    }
    error: ParseError => panic(error.message)
  }
  match ("255".ParseUint8()) {
    n: Uint8 => {
      assertEqual(n.Format(10), "255")
      assertEqual(n.Hex(prefix: true).ParseUint8(0), n)
      assertEqual(n.Binary(prefix: true).ParseUint8(0), n)
      assertEqual(n.Octal(prefix: true).ParseUint8(0), n)
    }
    error: ParseError => panic(error.message)
  }
  match ("-1".ParseUint8()) {
    n: Uint8 => panic("overflow accepted")
    error: ParseError => assertEqual(error.input, "-1")
  }
  match ("256".ParseUint8()) {
    n: Uint8 => panic("overflow accepted")
    error: ParseError => assertEqual(error.input, "256")
  }
  match ("+255".ParseUint8()) {
    n: Uint8 => assertEqual(n.Format(10), "255")
    error: ParseError => panic(error.message)
  }
}

