  match ("-32768".ParseInt16()) {
    n: Int16 => {
      assertEqual(n.Format(10), "-32768")
      assertEqual(n.Hex(prefix: true).ParseInt16(0), n)
      assertEqual(n.Binary(prefix: true).ParseInt16(0), n)
      assertEqual(n.Octal(prefix: true).ParseInt16(0), n)
