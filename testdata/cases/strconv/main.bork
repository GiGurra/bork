    error: ParseError => panic(error.message)
  }
  match ("32767".ParseInt16()) {
    n: Int16 => {
      assertEqual(n.Format(10), "32767")
      assertEqual(n.Hex(prefix: true).ParseInt16(0), n)
      assertEqual(n.Binary(prefix: true).ParseInt16(0), n)
      assertEqual(n.Octal(prefix: true).ParseInt16(0), n)
    }
    error: ParseError => panic(error.message)
  }
  match ("-32769".ParseInt16()) {
    n: Int16 => panic("overflow accepted")
