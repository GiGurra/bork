fn label(value: Int | String | Closed): String {
  match (value) {
    n: Int => toString(n)
    text: String => text
    _ => "end"
  }
}

fn loser(child: Scope, started: Channel[Int], finished: Atom[Bool]) uses clock + state: Int | Cancelled {
  assertEqual(started.send(child, 1), {})
  waited = delay(child, 10000)
  assertEqual(update(finished, old => true), true)
  match (waited) { c: Cancelled => c; _ => 999 }
}

test "race cancels and joins losers without cancelling the parent" {
  scope s {
    started = channel[Int](s, 1)
    finished = atom(false)
    result = race[Int | Cancelled](s, [
      child => { assertEqual(started.receive(s), 1); 7 },
      child => loser(child, started, finished),
    ])
    match (result) {
      Option.Some(value) => assertEqual(value, 7)
      _ => panic("expected a race winner")
    }
    assertEqual(current(finished), true)
    assertEqual(cancelled(s), false)
  }
}

test "awaitFirst leaves losing tasks in their owner scope" {
  scope s {
    gate = channel[Int](s, 0)
    pending = fork(s, () => gate.receive(s))
    ready = fork(s, () => 7)
    // Both tasks have the same result type for this wait.
    immediate = fork(s, () => { value: Int | Cancelled | Closed = await(ready); value })
    result = [pending, immediate].awaitFirst(s)
    match (result) { Option.Some(value) => assertEqual(value, 7); _ => panic("expected ready task") }
    assertEqual(gate.send(s, 9), {})
    assertEqual(await(pending), 9)
  }
}

test "timeout includes callback-spawned tasks and preserves parent cancellation" {
  scope s {
    finished = atom(false)
    result = withTimeout(s, 100, child => {
      fork(child, () => {
        waited = delay(child, 10000)
        match (waited) { c: Cancelled => assertEqual(c.reason, "deadline exceeded"); _ => panic("expected deadline") }
        assertEqual(update(finished, old => true), true)
      })
      7
    })
    match (result) { c: Cancelled => assertEqual(c.reason, "deadline exceeded"); _ => panic("expected timeout") }
    assertEqual(current(finished), true)
    assertEqual(cancelled(s), false)
  }
}

test "successful timeout resources remain open until the parent closes" {
  scope s {
    result = withTimeout(s, 1000000, child => channel[Int](child, 1))
    match (result) {
      ch: Channel[Int] => assertEqual(ch.send(s, 3), {})
      _ => panic("expected a channel")
    }
  }
}

test "selection does not consume losing channels and drains closed buffers" {
  scope s {
    a = channel[Int](s, 1)
    b = channel[String](s, 1)
    assertEqual(a.send(s, 4), {})
    assertEqual(b.send(s, "hello"), {})
    chosen = select {
      n = a.receive(s) => label(n)
      text = b.receive(s) => label(text)
    }
    match (chosen) {
      value: String => if (value == "hello") { assertEqual(a.receive(s), 4) } else { assertEqual(value, "4"); assertEqual(b.receive(s), "hello") }
      _ => panic("expected selected value")
    }
    assertEqual(a.send(s, 5), {})
    a.close()
    assertEqual(select { n = a.receive(s) => label(n) }, "5")
    assertEqual(select { n = a.receive(s) => label(n) }, "end")
  }
}

test "selection receives from an unbuffered channel" {
  scope s {
    ch = channel[Int](s, 0)
    task = fork(s, () => ch.send(s, 8))
    assertEqual(select { n = ch.receive(s) => n }, 8)
    assertEqual(await(task), {})
  }
}

test "selection is cancelled by an arm's channel scope and by the wait scope" {
  scope outer {
    scope source {
      ch = channel[Int](source, 0)
      cancel(source)
      match (select { n = ch.receive(outer) => n }) { c: Cancelled => assertEqual(c.reason, "cancelled"); _ => panic("expected cancellation") }
    }
    ch = channel[Int](outer, 0)
    scope wait {
      cancel(wait)
      match (select { n = ch.receive(wait) => n }) { c: Cancelled => assertEqual(c.reason, "cancelled"); _ => panic("expected cancellation") }
    }
  }
}
