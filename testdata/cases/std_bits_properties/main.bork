import "bork/bits"

test "Int8 bit operations preserve width" (value: Int8, count: Int) {
  assertEqual(value.Reverse().Reverse(), value)
  assertEqual(value.ReverseBytes().ReverseBytes(), value)
  assertEqual(value.RotateLeft(count).RotateLeft(-count), value)
  assertEqual(value.RotateLeft(8), value)
  assert(value.Extract(0, 8) == value)
  assert(value.Insert(0, 8, value) == value)
  assert(value.Insert(8, 0, 0) == value)
  assert(value.Extract(8, 0) == toInt8(0))
  match (value.Extract(0, 4)) {
    field: Int8 => match (value.Insert(4, 4, field)) {
      inserted: Int8 => {
        assert(inserted.Extract(4, 4) == field)
        assertEqual(inserted.Extract(0, 4), value.Extract(0, 4))
      }
      _: OutOfRange => assert(false)
    }
    _: OutOfRange => assert(false)
  }
  set = value.SetBit(7)
  clear = value.ClearBit(7)
  match (set) { n: Int8 => assert(n.TestBit(7) == true), _: OutOfRange => assert(false) }
  match (clear) { n: Int8 => assert(n.TestBit(7) == false), _: OutOfRange => assert(false) }
}

