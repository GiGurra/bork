pred atMost(a: Int, b: Int) { a <= b }
fn ordered(lo: Int, hi: Int) where lo <= hi: Int { needs(lo, hi) }
fn needs(lo: Int, hi: Int) where atMost(lo, hi): Int { lo }
fn declared(lo: Int, hi: Int) where atMost(lo, hi): Int { ordered(lo, hi) }
fn guard(lo: Int, hi: Int): Int { if (lo <= hi) { ordered(hi: hi, lo: lo) } else { 0 } }
fn defaulted(lo: Int, hi: Int = 10) where lo <= hi: Int { lo }
fn forwarded(lo: Int where atMost(hi), hi: Int): Int { ordered(lo, hi) }
fn either(lo: Int, hi: Int) where (lo <= hi or atMost(lo, hi)): Int { ordered(lo, hi) }
fn (lo: Int) before(hi: Int) where lo <= hi: Int { lo }
pred different[T: Eq](a: T, b: T) { a != b }
fn generic[T: Eq](a: T, b: T) where different(a, b): T { a }
fn early(lo: Int, hi: Int): Int { if (lo > hi) { return 0 }; ordered(lo, hi) }
fn main() {
  println(requiresPositive(1), jointPositive(2))
  println(paired([1, 2], ["a", "b"]), forwardedLists([1], [true]), guardedLists([1], ["a", "b"]))
  println(bounded(Bounds { lo: 1, hi: 2 }))
  scope s { println(assemble[Product](s, product, provide)) }
  println(ordered(1, 2), guard(2, 1), defaulted(1), forwarded(1, 2), either(1, 1))
  println(1.before(2), generic("a", "b"), early(1, 3))
}

type Bounds = { lo: Int, hi: Int }
fn bounded(b: Bounds) where b.lo <= b.hi: Int { ordered(b.lo, b.hi) }
pred positive(n: Int) { n > 0 }
type Product = { n: Int }
fn provide(): Int where positive { 1 }
fn product(n: Int) where positive(n): Product { Product { n: n } }

pred sameLength[A, B](xs: List[A], ys: List[B]) { xs.length() == ys.length() }
fn paired[A, B](xs: List[A], ys: List[B]) where sameLength(xs, ys): Int { xs.length() }
fn forwardedLists[A, B](xs: List[A], ys: List[B]) where sameLength(xs, ys): Int { paired(xs, ys) }
fn guardedLists[A, B](xs: List[A], ys: List[B]): Int { if (sameLength(xs, ys)) { paired(xs, ys) } else { 0 } }

pred positiveInput(n: Int where positive) { n > 0 }
fn requiresPositive(n: Int where positive) where positiveInput(n): Int { n }
fn jointPositive(n: Int) where positive(n) and positiveInput(n): Int { n }
