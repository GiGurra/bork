// Type classes: behaviour attached to types through named instances.
// A call picks the instance from the types; generic functions get the
// instances their bounds ask for.

class Show[T] {
  fn show(x: T): String
}

class Monoid[T] {
  fn empty(): T
  fn combine(a: T, b: T): T
}

type Point = { x: Int, y: Int }

type Tree = sealed { Leaf, Node { left: Tree, value: Int, right: Tree } }

instance showInt: Show[Int] {
  fn show(x: Int): String { toString(x) }
}

instance showPoint: Show[Point] {
  fn show(p: Point): String { s"(${show(p.x)}, ${show(p.y)})" }
}

instance showList[T: Show]: Show[List[T]] {
  fn show(xs: List[T]): String { "[" + xs.map(show).join("; ") + "]" }
}

instance showTree: Show[Tree] {
  fn show(t: Tree): String {
    match (t) {
      Tree.Leaf => "."
      Tree.Node { left, value, right } => s"(${show(left)} ${show(value)} ${show(right)})"
    }
  }
}

instance sumInt: Monoid[Int] {
  fn empty(): Int { 0 }
  fn combine(a: Int, b: Int): Int { a + b }
}

instance joinString: Monoid[String] {
  fn empty(): String { "" }
  fn combine(a: String, b: String): String { a + b }
}

fn sum[T: Monoid](xs: List[T]): T {
  xs.fold(empty[T](), combine)
}

fn describe[T: Show](label: String, x: T): String {
  s"$label: ${show(x)}"
}

fn main() {
  println(show(42))
  println(show(Point { x: 1, y: 2 }))
  println(show([Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]))
  println(show([[1, 2], [3]]))
  println(describe("tree", Tree.Node { left: Tree.Leaf, value: 5, right: Tree.Node { left: Tree.Leaf, value: 7, right: Tree.Leaf } }))
  println(sum([1, 2, 3, 4]))
  println(sum(["a", "b", "c"]))
  shown = [1, 2, 3].map(show)
  println(shown)
  println(empty[String]() == "", empty[Int]())
}
