// A fact named after a function argument needs a pure one: keep that
// prints may answer differently next time, so "keep holds" can go stale.

fn keepPure(xs: List[Int], keep: (Int) => Bool): List[Int where keep] { xs.filter(keep) }

fn keepImpure(xs: List[Int], keep: (Int) uses io => Bool) uses io: List[Int where keep] {
  xs.filter(keep)
}

fn main() {
  println(keepPure([1, -1], x => x > 0))
}
