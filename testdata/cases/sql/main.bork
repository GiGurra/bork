import codec "bork/codec"

import "bork/encoding"
import "bork/json"
import "bork/sql"
use codec.Defaults

pred named(value: String) { value.byteLength() > 0 }
type Row = {
  id: Int,
  name: String where named,
  note: Option[String],
  active: Bool,
  score: Float,
  data: List[Int],
} derive (codec.Decode)
type Count = { count: Int } derive (codec.Decode)
fn count(db: sql.Connection) uses io + net: Int | sql.Error | codec.DecodeError {
  rows = sql.Query[Count](db, sql.Unsafe("SELECT count(*) AS count FROM users"), [])?
  rows.get(0).getOr(Count { count: -1 }).count
}
fn showError(result: codec.Value | sql.Error) uses io {
  match (result) {
    error: sql.Error => println(error.operation)
    value: codec.Value => println(json.Render(value))
  }
}
fn rollbackPanic(db: sql.Connection) uses io + net: Ok | sql.Error {
  scope transaction {
    tx = sql.Begin(db, transaction)?
    _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users(id, name) VALUES (10, 'panic')"), [])?
    panic("rollback test")
  }
}
fn protect(work: () => Ok): Bool unsafe go {
  recovered := false
  func() {
    defer func() { recovered = recover() == "rollback test" }()
    work()
  }()
  return recovered
}
fn demo() uses io + net + state: Ok | sql.Error | codec.DecodeError {
  scope app {
    db = sql.OpenSqlite(":memory:", app)?
    _ = sql.Exec(db, sql.Unsafe("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, note TEXT, active BOOLEAN, score REAL, data BLOB)"), [])?
    inserted = sql.Exec(db, sql.Unsafe("INSERT INTO users VALUES (?, ?, ?, ?, ?, ?)"), [1, "Ada", sql.Null {}, true, 1.25, encoding.Utf8("ab")])?
    println(inserted.rowsAffected, inserted.lastInsertId)
    rows = sql.Query[Row](db, sql.Unsafe("SELECT id, name, note, active, score, data FROM users ORDER BY id"), [])?
    println(rows)
    empty = sql.Query[Row](db, sql.Unsafe("SELECT id, name, note, active, score, data FROM users WHERE id = ?"), [99])?
    println(empty)
    showError(sql.QueryJson(db, sql.Unsafe("SELECT 9223372036854775807 AS exact"), []))
    showError(sql.QueryJson(db, sql.Unsafe("SELECT 1 AS duplicate, 2 AS duplicate"), []))
    showError(sql.QueryJson(db, sql.Unsafe("SELECT missing FROM users"), []))
    scope transaction {
      tx = sql.Begin(db, transaction)?
      _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users(id, name) VALUES (?, ?)"), [2, "discarded"])?
    }
    println(count(db))
    scope transaction {
      tx = sql.Begin(db, transaction)?
      _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users(id, name) VALUES (?, ?)"), [3, "quote' OR 1=1 --"])?
      sql.Commit(tx)?
    }
    println(count(db))
    matched = sql.Query[Count](db, sql.Unsafe("SELECT count(*) AS count FROM users WHERE name = ?"), ["quote' OR 1=1 --"])?
    println(matched)
    scope transaction {
      tx = sql.Begin(db, transaction)?
      _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users(id, name) VALUES (?, ?)"), [4, "rollback"])?
      sql.Rollback(tx)?
      sql.Rollback(tx)?
    }
    println(count(db))
    println(protect(() => { match (rollbackPanic(db)) { error: sql.Error => println(error); _ => {} } }))
    println(count(db))
    _ = sql.Exec(db, sql.Unsafe("UPDATE users SET name = '' WHERE id = 1"), [])?
    result: List[Row] | sql.Error | codec.DecodeError = sql.Query(db, sql.Unsafe("SELECT id, name, note, active, score, data FROM users WHERE id = 1"), [])
    match (result) {
      error: codec.DecodeError => println(s"${error.path}: ${error.message}")
      _ => println("unexpected")
    }
    scope transaction {
      tx = sql.Begin(db, transaction)?
      cancel(transaction)
      match (sql.Commit(tx)) { error: sql.Error => println(error.operation); _ => println("unexpected") }
    }
    scope stopped {
      cancel(stopped)
      match (sql.OpenSqlite(":memory:", stopped)) { error: sql.Error => println(error.operation); _ => println("unexpected") }
      match (sql.Begin(db, stopped)) { error: sql.Error => println(error.operation); _ => println("unexpected") }
    }
    cancel(app)
    showError(sql.QueryJson(db, sql.Unsafe("SELECT 1"), []))
    match (sql.Exec(db, sql.Unsafe("DELETE FROM users"), [])) { error: sql.Error => println(error.operation); _ => println("unexpected") }
  }
}
fn attachments() uses io + net + state: Ok | sql.Error | codec.DecodeError {
  scope outer {
    db = scope original {
      opened = sql.OpenSqlite(":memory:", original)?
      attach(opened, outer)
    }
    _ = sql.Exec(db, sql.Unsafe("CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)"), [])?
    scope owner {
      tx = scope original {
        started = sql.Begin(db, original)?
        attach(started, owner)
      }
      _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users VALUES(1, 'attached')"), [])?
      showError(sql.QueryJson(tx, sql.Unsafe("SELECT count(*) AS count FROM users"), []))
    }
    println(count(db))
    scope owner {
      tx = scope original {
        started = sql.Begin(db, original)?
        attach(started, owner)
      }
      _ = sql.Exec(tx, sql.Unsafe("INSERT INTO users VALUES(2, 'committed')"), [])?
      sql.Commit(tx)?
    }
    println(count(db))
    scope owner {
      tx = scope original {
        started = sql.Begin(db, original)?
        attach(started, owner)
      }
      cancel(owner)
      match (sql.Exec(tx, sql.Unsafe("INSERT INTO users VALUES(3, 'cancelled')"), [])) { error: sql.Error => println(error.operation); _ => println("unexpected") }
    }
    cancel(outer)
    showError(sql.QueryJson(db, sql.Unsafe("SELECT 1"), []))
  }
}
fn main() {
  match (attachments()) { error: sql.Error => println(error); error: codec.DecodeError => println(error); _ => {} }
  match (demo()) {
    error: sql.Error => println(error)
    error: codec.DecodeError => println(error)
    _ => {}
  }
}
