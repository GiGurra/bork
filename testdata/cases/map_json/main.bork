import codec "bork/codec"

import "bork/json"
use codec.Defaults
type Prices = { currency: String, items: Map[String, Int] } derive (codec.Decode, codec.Encode)

fn main() {
  p = Prices { currency: "SEK", items: { "apple": 5, "pear": 7 } }
  println(json.Encode(p))
  println(json.Decode[Prices]("{\"currency\": \"EUR\", \"items\": {\"b\": 2, \"a\": 1}}"))
  println(json.Decode[Prices]("{\"currency\": \"EUR\", \"items\": {\"b\": \"two\"}}"))
  println(json.Decode[Map[String, List[Int]]]("{\"x\": [1, 2], \"y\": []}"))
  println(json.Encode({ "nested": { "deep": true } }))
}
