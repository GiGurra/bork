pred positive(x: Int) { x > 0 }
pred atLeast(x: Int, n: Int) { x >= n }
pred small(x: Int) { x < 1000 && x > -1000 }
pred rare(x: Int) { x % 7919 == 1234 && x > 5000 }
pred short(s: String) { byteLength(s) <= 3 }

type Item = { name: String where short, qty: Int where positive }
type Tree = sealed { Leaf, Node { left: Tree, value: Int, right: Tree } }

fn size(t: Tree): Int {
  match (t) {
    Tree.Leaf => 0
    Tree.Node { left: l, value: _, right: r } => size(l) + 1 + size(r)
  }
}

fn total(items: List[Item]): Int { fold(items, 0, (acc, i) => acc + i.qty) }

fn divide(a: Int, b: Int): Int { a / b }

fn fromUser(raw: Int): Int {
  trust positive(raw)
  raw
}

fn main() {}

test "facts hold for every generated value" (n: Int where positive, m: Int where atLeast(n), xs: List[Int where small]) {
  assert(m >= n)
  assert(m > 0)
  assert(filter(xs, (x) => x >= 1000).isEmpty())
}

test "a field's facts hold" (items: List[Item]) {
  assert(filter(items, (i) => !short(i.name) || i.qty <= 0).isEmpty())
}

// Found: the sum overflows.
test "totals are at least the count" (items: List[Item]) {
  assert(total(items) >= length(items))
}

test "or facts" (n: Int where positive or atLeast(-5)) {
  assert(n >= -5)
}

test "a failure is shrunk" (xs: List[Int where positive]) {
  assert(length(xs) < 3)
}

test "a failing tree is shrunk" (t: Tree) {
  assert(size(t) < 3)
}

test "panics fail" (a: Int where small, b: Int where small) {
  println(divide(a, b))
}

test "trusted facts are checked" (raw: Int where small) {
  println(fromUser(raw))
}

test "constants in facts guide generation" (n: Int where atLeast(9223372036854775000)) {
  assert(n > 0)
}

test "values that are hard to find are reported" (n: Int where rare) {
  assert(n > 0)
}

test "no values for functions" (f: (Int) => Int) {
  assert(f(1) == 1)
}

test "generated values cannot be snapshotted" (n: Int) {
  assertSnapshot(n)
}
