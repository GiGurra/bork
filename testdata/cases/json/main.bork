fn main() {
  j = parseJson("{\"a\": [1, 2.5, true, null, \"x\"], \"b\": {}}")
  println(j)
  match (j) {
    v: Json => println(renderJson(v))
    e: JsonError => println(e)
  }
  println(parseJson("{bad"))
  xs: List[Int] | JsonError | DecodeError = decodeJson("[1, 2, 3]")
  println(xs)
  ys: List[Int] | JsonError | DecodeError = decodeJson("[1, \"two\", 3]")
  println(ys)
  zs: List[Option[String]] | JsonError | DecodeError = decodeJson("[\"a\", null]")
  println(zs)
  println(encodeJson([Option.Some { value: 1 }, Option.None]))
  escapes()
}

fn escapes() {
  match (parseJson("{\"s\": \"a\\\"b\\n\\u00e9\", \"n\": -1.5e3, \"z\": 0}")) {
    v: Json => println(renderJson(v))
    e: JsonError => println(e)
  }
  b: Bool | JsonError | DecodeError = decodeJson("1")
  println(b)
  i: Int | JsonError | DecodeError = decodeJson("1.5")
  println(i)
}
