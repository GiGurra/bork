pred positive(n: Int) { n > 0 }
pred zero(n: Int) { n == 0 }
pred small(n: Int where positive) { n < 10 }
pred between(n: Int, low: Int, high: Int) { n >= low && n <= high }
pred checkedPositive(n: Int) { if (n <= 0) { panic("later guard evaluated") }; true }
pred unexpected(n: Int) { panic(s"unexpected predicate $n") }
pred same[T: Eq](value: T, other: T) { value == other }
pred hasValue[T, U: Eq](xs: List[T], other: U) { other == other && !xs.isEmpty() }
type PosInt = Int where positive
type AnotherPos = PosInt

type Box = { value: Int }
pred boxPositive(box: Box) { positive(box.value) }
type PositiveBox = Box where boxPositive

fn requiresPositive(n: Int where positive): Int { n }
fn classify(x: Int | String): String {
  match (x) {
    n: PosInt => s"positive ${requiresPositive(n)}"
    n: Int where zero => "zero"
    n: Int => s"other $n"
    s: String => s"text $s"
  }
}
fn inside(n: Int, low: Int, high: Int): Bool {
  match (n) {
    v: Int where between(low, high) => true
    _ => false
  }
}
fn accepted(n: Int): Int where positive {
  match (n) { v: AnotherPos => v; _ => 1 }
}
fn onlyPure(n: Int, keep: (Int) uses nothing => Bool): Bool {
  match (n) { v: Int where keep => true; _ => false }
}
fn kept(n: Int, keep: (Int) uses nothing => Bool): Int where keep {
  match (n) { v: Int where keep => v; _ => panic("not kept") }
}
fn once() uses io: Int { println("subject"); -1 }
fn main() {
  println(classify(4), classify(0), classify(-2), classify("hello"))
  println(inside(3, 1, 4), inside(7, 1, 4), accepted(-1), accepted(2))
  println(onlyPure(2, positive), onlyPure(-2, positive), kept(2, positive))
  println(match (once()) { n: Int where positive and checkedPositive => 10; _ => 20 })
  println(match (0) { n: Int where positive or zero => "nonnegative"; _ => "negative" })
  println(match (3) { n: Int where positive or unexpected => 30; _ => 0 })
  println(match ("ok") { s: String where same("ok") => s; _ => "no" })
  println(match ([1]) { xs: List[Int] where hasValue("yes") => 1; _ => 0 })
  println(match (3) { n: Int where positive and small => requiresPositive(n); _ => 0 })
  println(match ([7]) { xs: List[Int] where notEmpty => xs.first(); _ => 0 })
  empty: List[Int] = []
  println(match (empty) { xs: List[Int] where notEmpty => xs.first(); _ => 0 })
  println(match (Box { value: 8 }) { box: PositiveBox => box.value; _ => 0 })
  println(match (Box { value: -8 }) { Box { value: n: PosInt } => n; _ => 0 })
}
