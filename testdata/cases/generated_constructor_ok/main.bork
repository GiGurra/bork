pred positive(n: Int) { n > 0 }
pred atLeast(n: Int, minimum: Int) { n >= minimum }
pred budget(n: Int) { n >= 1024 }
type Config = private {
  host: String
  hi: Int where atLeast(lo) = 10
  lo: Int = 0
  limit: Int where positive = 2048
} where configured
pred configured(c: Config) { c.lo <= c.hi && budget(c.limit) }
fn New = Config.new
fn guarded(lo: Int, hi: Int, limit: Int where positive): Config {
  if (lo <= hi && budget(limit)) { New(host: "guarded", lo: lo, hi: hi, limit: limit) } else { New(host: "fallback") }
}
type Box[T] = { value: T, items: List[T] = [] }
fn NewBox = Box.new
type GenericRange[T] = { tag: T, lo: Int, hi: Int where atLeast(lo) } where genericOrdered
pred genericOrdered[T](r: GenericRange[T]) { r.lo <= r.hi }
fn NewGenericRange = GenericRange.new
type Mixed = { optional: Int = 7, required: String }
fn NewMixed = Mixed.new
type Ordered = { hi: Int, lo: Int }
fn NewOrdered = Ordered.new
type Shadow = { positive: Int where positive }
fn NewShadow = Shadow.new
fn emit(label: String, value: Int) uses io: Int { println(label); value }
fn main() {
  println(New(host: "default"))
  println(guarded(3, 8, 4096))
  println(NewBox(value: "inferred"), NewBox[Int](value: 3))
  println(NewGenericRange(tag: "range", lo: 2, hi: 3))
  println(NewMixed(required: "named"), NewMixed(8, "positional"))
  println(NewOrdered(lo: emit("lo", 2), hi: emit("hi", 9)))
  println(NewShadow(positive: 3))
}
