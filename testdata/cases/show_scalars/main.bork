instance stringShow: Show[String] {
  fn show(x: String): String { "text(" + x + ")" }
}

pred positive(x: Int) { x > 0 }
type Positive = Int where positive

instance positiveShow: Show[Positive] {
  fn show(x: Positive): String { "positive" }
}

fn main() {
  println("raw", ["a", "b"], { "key": "value" })
  println(toString("raw"))
  n: Positive = 1
  println(n, 1, 0)
  println([n])
}
