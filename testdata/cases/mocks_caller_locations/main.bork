fn Fetch(url: String) uses net: String { url }

fn Saved[A](m: Mock[A], expect: (Mock[A], Option[Int], Option[Int], Option[Int]) uses state => Ok) uses state {
  expect(m, 2, .None, .None)
}

test "saved helper captures its reference" {
  calls = mock Fetch(url) { url }
  Saved(calls, Mock.expect)
  _ = Fetch("one")
}

test "task expectation keeps the task call site" {
  scope s {
    calls = mock Fetch(url) { url }
    task = fork(s, () => { calls.expect(times: 1); 0 })
    _ = await(task)
  }
}

test "waitForWhere keeps its call site" {
  calls = mock Fetch(url) { url }
  calls.waitForWhere(c => c.url == "missing", 1, ms: 0)
}
