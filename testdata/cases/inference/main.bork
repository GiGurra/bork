// Type arguments are solved by unification: what `[]`, `{:}`, or
// `Option.None` holds is decided by what comes after, also inside
// lambdas' bodies.
fn main() {
  words = ["a", "b", "a"]
  // The branches decide each other's types.
  println(words.fold([], (acc, w) => if (w == "a") { acc } else { acc.append(w) }))
  println(words.fold([], (acc, w) => if (w == "b") { [] } else { acc.append(w) }))
  // A call in the body, given a value of the body's own unknown type.
  println(words.fold({:}, (m, w) => m.put(w, m.getOr(w, []).append(1))))
  // An operator decides its unknown operand from the other one.
  println(words.fold(Option.None, (best, w) => match (best) {
    Option.Some { value } => Option.Some { value: value + w }
    Option.None => Option.Some { value: w }
  }))
  println(words.fold(Option.None, (b, w) => if (w == "b") { Option.Some { value: w } } else { b }))
  println(words.fold([], (acc, w) => [w].concat(acc)).length())
  laterChecks()
}

type Bag = { items: List[Int] }
type Tree[T] = sealed { Leaf, Node { v: T, l: Tree[T] } }
type Box[T] = { v: T, rest: List[T] }

// Checks against a known type decide unknowns too: bindings, fields,
// arguments of function values, and comparisons.
fn laterChecks() {
  xs = [1, 2, 3]
  println(xs.fold([], (acc, x) => {
    y: List[Int] = acc
    y.append(x)
  }))
  println(xs.fold([], (acc, x) => {
    b = Bag { items: acc }
    acc.append(x)
  }))
  g = (ys: List[Int]) => ys.length()
  println(xs.fold([], (acc, x) => {
    n = g(acc)
    acc.append(x)
  }))
  println(xs.fold(Tree.Leaf, (t, x) => Tree.Node { v: x, l: t }))
  println(xs.fold([], (acc, x) => Box { v: x, rest: acc }.rest.append(x)))
  ws = ["a", "b", "b"]
  println(ws.fold([], (acc, w) => if (acc.last() == Option.Some { value: w }) { acc } else { acc.append(w) }))
  println(ws.fold([], (acc, w) => if (acc == ["a"]) { acc } else { acc.append(w) }))
}
