type Conn = resource

fn connect(name: String, s: Scope) uses io: Conn unsafe go {
  import "fmt"
  fmt.Println("open " + name)
  return Conn{handle: name, owner: s.Own(func() { fmt.Println("close " + name) })}
}

fn nameOf(c: Conn): String unsafe go {
  return c.handle.(string)
}

// A generic function cannot make a value of its type parameters' types:
// the elements forEach passes its lambda are those of xs, so a lambda
// may send them to a channel xs outlives.
fn sendAll(s: Scope, ch: Channel[Conn], xs: List[Conn] in ch) uses state {
  xs.forEach(c => { _ = ch.send(s, c) })
}

// So may a lambda of a generic function of the program's own.
fn each[T](xs: List[T], f: (T) uses state => Ok) uses state {
  match (xs) {
    [x, ...rest] => {
      f(x)
      each(rest, f)
    }
    _ => {}
  }
}

// Entries of a map, and the values of an option, are its arguments' too.
fn ifSome[T](o: Option[T], f: (T) uses state => Ok) uses state {
  match (o) {
    Option.Some(v) => f(v)
    _ => {}
  }
}

// What comes out of a channel lives as long as the channel.
fn drain[T](s: Scope, from: Channel[T], f: (T) uses state => Ok) uses state {
  for (x in from.values(s)) {
    f(x)
  }
}

fn main() uses io + state {
  scope app {
    ch = channel[Conn](app, 8)
    conns = [connect("a", app), connect("b", app)]
    conns.forEach(c => { _ = ch.send(app, c) })
    sendAll(app, ch, [connect("c", app)])
    each([connect("d", app)], c => { _ = ch.send(app, c) })
    byName = { "e": connect("e", app) }
    byName.forEach((k, c) => { _ = ch.send(app, c) })
    ifSome(Option.Some(connect("f", app)), c => { _ = ch.send(app, c) })
    store = atom([connect("g", app)])
    conns.forEach(c => { _ = update(store, cs => cs.append(c)) })
    first = channel[Conn](app, 1)
    _ = first.send(app, connect("h", app))
    first.close()
    drain(app, first, c => { _ = ch.send(app, c) })
    ch.close()
    println(ch.values(app).toList().map(nameOf))
    println(current(store).map(nameOf))
  }
}
