import codec "bork/codec"
use codec.Defaults

pred nonempty[T](xs: List[T]) { xs.length() > 0 }
type Box[T] = { xs: List[T] where nonempty = [] } derive (codec.Decode)
fn Schema[T: codec.Decode]() unsafe go {
 fields, ok := _borkDecodeFields(_d_T_Decode)
 if ok { for _, f := range fields { if f.HasDefault { _ = f.Default() } } }
}
fn Wrapper[T: codec.Decode](value: T) { Schema[Box[T]]() }
fn main() { Wrapper(1) }
