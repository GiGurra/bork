pred positive(x: Int) { x > 0 }

fn transfer(amount: Int where positive): Int { amount * 100 }

fn unchecked(amounts: List[Int]): List[Int] {
  amounts.map(a => transfer(a))
}

// Calls through a function value could not be checked.
fn asValue(amounts: List[Int]): List[Int] {
  amounts.map(transfer)
}

// Filtering by something else proves nothing about positive.
pred small(x: Int) { x < 10 }

fn otherCheck(xs: List[Int]): List[Int] {
  checked = xs.filter(x => small(x))
  checked.map(y => transfer(y))
}

fn main() {
  println(unchecked([1]), asValue([1]), otherCheck([1]))
}
