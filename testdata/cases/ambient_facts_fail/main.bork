ambient traceId: String

fn tag(msg: String) needs traceId: String {
  s"[${traceId}] ${msg}"
}

// Facts from a predicate that binds its own value are still checked at
// compile time.
pred tiny(s: String) {
  with (traceId: "p") {
    tag(s).byteLength() < 8
  }
}

fn small(s: String where tiny): String {
  s
}

pred positive(x: Int) {
  x > 0
}

fn needPositive(x: Int where positive): Int {
  x
}

ambient count: Int

fn counted() needs count: Int {
  needPositive(count)
}

// An ambient type's facts are known where the value is needed, and a
// with must prove them.
ambient attempt: Int where positive

fn attempted() needs attempt: Int {
  needPositive(attempt)
}

fn bindAttempt(n: Int): Int {
  a = with (attempt: 0) { attempted() }
  b = with (attempt: n) { attempted() }
  c = with (attempt: 2) { attempted() }
  a + b + c
}

fn main() uses io {
  println(small("ok"))
  println(small("long enough"))
  println(bindAttempt(1))
}
