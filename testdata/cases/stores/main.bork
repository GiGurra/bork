type Conn = resource

fn connect(name: String, s: Scope) uses io: Conn unsafe go {
  import "fmt"
  fmt.Println("open " + name)
  return Conn{handle: name, owner: s.Own(func() { fmt.Println("close " + name) })}
}

fn nameOf(c: Conn): String unsafe go {
  return c.handle.(string)
}

// put stores c in ch, which it declares c belongs to.
fn put(s: Scope, ch: Channel[Conn], c: Conn in ch) uses state {
  _ = ch.send(s, c)
}

// handOver opens the next connection in a new owned scope, hands it to
// the consumer through the channel (attached to app, which outlives the
// channel, so it stays open), and closes the previous generation.
fn handOver(prev: OwnedScope, ch: Channel[Conn], app: Scope in ch, n: Int) uses io + state {
  next = openScope(app)
  c = connect(s"gen$n", next.scope)
  put(app, ch, attach(c, app))
  closeScope(prev)
  if (n > 1) {
    handOver(next, ch, app, n - 1)
  } else {
    closeScope(next)
  }
}

// Generic helpers can store what is declared in the channel.
fn sendAll[T](s: Scope, ch: Channel[T], xs: List[T] in ch) uses state {
  match (xs) {
    [x, ...rest] => {
      _ = ch.send(s, x)
      sendAll(s, ch, rest)
    }
    _ => {}
  }
}

fn apply[A, B, C](f: (A, B) uses state => C, a: A, b: B) uses state: C {
  f(a, b)
}

fn main() uses io + state {
  scope app {
    ch = channel[Conn](app, 3)
    first = openScope(app)
    handOver(first, ch, app, 3)
    ch.close()
    println("channel gives:")
    names = ch.values(app).toList().map(nameOf)
    println(names)
    // An atom lives as long as its first value: one of app keeps
    // values of app.
    kept = connect("kept", app)
    latest = atom(Option.Some { value: kept })
    newer = connect("newer", app)
    _ = update(latest, old => Option.Some { value: newer })
    match (current(latest)) {
      Option.Some { value } => println(s"atom holds ${nameOf(value)}")
      Option.None => println("empty")
    }
    // A channel of channels of the same scope.
    chs = channel[Channel[Conn]](app, 1)
    _ = chs.send(app, ch)
    pending = channel[Conn](app, 2)
    sendAll(app, pending, [connect("x", app), connect("y", app)])
    pending.close()
    println(pending.values(app).toList().map(nameOf))
    // update can be a function value where nothing can escape.
    counter = atom(1)
    println(apply(update, counter, n => n + 1))
    println("app ends")
  }
}
