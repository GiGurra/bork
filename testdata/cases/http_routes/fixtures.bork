import codec "bork/codec"

import "bork/encoding"
import "bork/http"
use codec.Defaults

type Fixture = resource
fn fixture(s: Scope) uses io + clock + random: Fixture unsafe go {
  import "os"
  import "crypto/rand"
  import "crypto/rsa"
  import "crypto/x509"
  import "crypto/x509/pkix"
  import "encoding/pem"
  import "math/big"
  import "path/filepath"
  import "time"
  dir, err := os.MkdirTemp("", "bork-http-")
  if err != nil { panic(err) }
  key, err := rsa.GenerateKey(rand.Reader, 2048)
  if err != nil { panic(err) }
  template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "localhost"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, DNSNames: []string{"localhost"}}
  cert, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
  if err != nil { panic(err) }
  os.WriteFile(filepath.Join(dir, "cert.pem"), pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: cert}), 0600)
  os.WriteFile(filepath.Join(dir, "key.pem"), pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)}), 0600)
  os.WriteFile(filepath.Join(dir, "asset.txt"), []byte("static asset"), 0600)
  os.WriteFile(filepath.Join(dir, "a%?#.txt"), []byte("reserved filename"), 0600)
  return Fixture{handle: dir, owner: s.Own(func() { os.RemoveAll(dir) })}
}
fn root(f: Fixture): String unsafe go { return f.handle.(string) }
fn tlsCall(address: String) uses net: String unsafe go {
  import "crypto/tls"
  import "io"
  import "net/http"
  client := &http.Client{Transport: &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}}
  defer client.CloseIdleConnections()
  response, err := client.Get("https://"+address+"/users/7")
  if err != nil { panic(err) }
  defer response.Body.Close()
  data, err := io.ReadAll(response.Body)
  if err != nil { panic(err) }
  return string(data)
}
fn makeRequest(body: String, contentType: String): http.Request {
  http.Request { method: "POST", path: "/", query: "", params: {:}, headers: { "Content-Type": [contentType] }, body: body }
}
fn more(s: Scope) uses io + net + clock + random + state {
  files = fixture(s)
  path = root(files)
  println(http.LoadCertificate(path + "/cert.pem", path + "/key.pem"))
  println(match (http.ParseCertificate(encoding.Utf8("invalid"), encoding.Utf8("invalid"))) { _: IoError => true; _ => false })
  println(http.Static(makeRequest("", "").copy(method: "GET", path: "/assets/asset.txt"), path, "/assets").body)
  println(http.Static(makeRequest("", "").copy(method: "GET", path: "/assets/a%?#.txt"), path, "/assets").body)
  match (http.ListenTLS("127.0.0.1:0", s, [http.Route { pattern: "GET /users/{id}", handler: (req, rs) => endpoint(0, req, rs) }], path + "/cert.pem", path + "/key.pem", admission: Option.Some { value: http.Admission { maxInFlight: 1 } })) {
    server: http.Server => println(tlsCall(http.Address(server)))
    error: IoError => println("unexpected", error.message)
  }
  body = "--boundary\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nalice\r\n--boundary\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"photo.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n--boundary--\r\n"
  match (http.Multipart(makeRequest(body, "multipart/form-data; boundary=boundary"))) {
    form: http.MultipartForm => {
      println(form.values.get("name"))
      form.files.forEach(file => println(file.field, file.filename, file.data.length()))
    }
    error: IoError => println("unexpected", error.message)
  }
  println(match (http.Multipart(makeRequest(body, "multipart/form-data; boundary=boundary"), 0)) { _: IoError => true; _ => false })
  println(match (http.Multipart(makeRequest("bad", "multipart/form-data"))) { _: IoError => true; _ => false })
  println(match (http.Body[Path](makeRequest("{\"id\":0}", "application/json"))) { _: codec.DecodeError => true; _ => false })
}
