type NotFound = { id: Int }
type DbError = { reason: String }

fn find(id: Int): Int | NotFound | DbError {
  if (id > 0) { id } else { NotFound { id: id } }
}

fn onlyNotFound(id: Int): Int | NotFound {
  id.find()? + 1
}

fn notUnion(x: Int): Int {
  x?
}

fn optionInPlainFn(o: Option[Int]): Int {
  o?
}

fn main() {
  x = 1.find()?
  println(x, onlyNotFound(1), notUnion(1), optionInPlainFn(Option.None))
}
