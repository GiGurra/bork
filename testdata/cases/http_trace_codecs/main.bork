import codec "bork/codec"

import "bork/http"
use codec.Defaults
use http.TraceCodecs
fn main() {
  root = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
  println(http.TraceParentOf({ "TraceParent": [root] }))
  println(http.TraceStateOf({ "traceparent": [root], "Tracestate": ["vendor=first", "tenant@system=two"] }))
  println(http.TraceParentOf({:}))
  println(http.TraceParentOf({ "traceparent": ["bad"] }))
  println(http.TraceParentOf({ "traceparent": [root, root] }))
  println(http.TraceStateOf({ "tracestate": ["vendor=first"] }))
  println(http.TraceStateOf({ "traceparent": [root], "tracestate": ["vendor=one,vendor=two"] }))
  println(codec.decode[http.TraceParent](codec.Value.String { value: root }))
  println(codec.decode[http.TraceParent](codec.Value.String { value: "bad" }))
  println(codec.decode[http.TraceState](codec.Value.String { value: "" }))
  println(http.ValidTraceState(" , \t, vendor=value, "))
}
