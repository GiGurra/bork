import "bork/sql"
type Row = { n: Int } derive (Decode)
fn raw(db: sql.Connection, text: String) uses io + net {
  _ = sql.Exec(db, text, [])
  _ = sql.Query[Row](db, text, [])
  _ = sql.QueryJson(db, text, [])
  _ = sql.Rows[Row](db, text, [])
  _ = sql.RowsJson(db, text, [])
  query = sql.QueryJson
  _ = query(db, text, [])
  forged = sql.UnsafeQuery { text: text }
}
fn main() {}
