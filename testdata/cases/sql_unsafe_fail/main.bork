import "bork/sql"
type Row = { n: Int } derive (Decode)
fn raw(db: sql.Connection, text: String) uses io + net {
  exec = sql.Exec(db, text, [])
  rows = sql.Query[Row](db, text, [])
  json = sql.QueryJson(db, text, [])
  stream = sql.Rows[Row](db, text, [])
  streamJson = sql.RowsJson(db, text, [])
  query = sql.QueryJson
  indirect = query(db, text, [])
  forged = sql.UnsafeQuery { text: text }
}
fn main() {}
