test "writer snapshots remain independent" (value: Uint64) {
  empty = binary.NewWriter(binary.ByteOrder.LittleEndian)
  match (empty.WriteUint64(value)) {
    first: binary.Writer => {
      snapshot = first.Bytes()
      match (first.WriteByte(17)) {
        second: binary.Writer => {
          assertEqual(empty.Length(), 0)
          assertEqual(empty.Bytes().length(), 0)
          assertEqual(first.Length(), 8)
          assertEqual(first.Bytes(), snapshot)
          assertEqual(second.Length(), 9)
          assert(second.Bytes().ReadUint64(0, binary.ByteOrder.LittleEndian) == value)
          assert(second.Bytes().ReadByte(8) == 17)
          match (first.WriteByte(34)) {
            branch: binary.Writer => {
              assert(branch.Bytes().ReadByte(8) == 34)
              assert(second.Bytes().ReadByte(8) == 17)
              assertEqual(first.Bytes(), snapshot)
            }
            _: binary.BinaryError => assert(false)
          }
          emptyData: List[Byte] = []
          assert(first.WriteBytes(emptyData.toBytes()) == first)
        }
        _: binary.BinaryError => assert(false)
      }
    }
    _: binary.BinaryError => assert(false)
  }
}

test "reader cursors are immutable" (value: Uint64) {
  writer = binary.NewWriter(binary.ByteOrder.LittleEndian)
  match (writer.WriteUint64(value)) {
    written: binary.Writer => {
      reader = binary.NewReader(written.Bytes(), binary.ByteOrder.LittleEndian)
      match (reader.ReadUint64()) {
        pair: Uint64Read => {
          (actual, next) = pair
          assertEqual(actual, value)
          assertEqual(reader.Offset(), 0)
          assertEqual(reader.Remaining(), 8)
          assertEqual(next.Offset(), 8)
          assertEqual(next.Remaining(), 0)
          assert(next.Skip(0) == next)
          match (next.ReadBytes(9223372036854775807)) {
            _: BytesRead => assert(false)
            error: binary.BinaryError => { assertEqual(error.offset, 8); assertEqual(error.length, 8) }
          }
          match (next.Skip(9223372036854775807)) {
            _: binary.Reader => assert(false)
            error: binary.BinaryError => { assertEqual(error.offset, 8); assertEqual(error.length, 8) }
          }
          match (next.ReadUint64()) {
            _: Uint64Read => assert(false)
            _: binary.BinaryError => assertEqual(next.Offset(), 8)
          }
          match (next.ReadBytes(0)) {
            bytesResult: BytesRead => { assert(bytesResult.0.isEmpty()); assertEqual(bytesResult.1, next) }
            _: binary.BinaryError => assert(false)
          }
        }
        _: binary.BinaryError => assert(false)
      }
    }
    _: binary.BinaryError => assert(false)
  }
}
