import "bork/http"
import "bork/time"
fn busy(hint: Int = 0): http.Result {
  http.Overloaded { retryAfter: .Some(time.Duration { nanos: hint }), response: http.Text(503, "busy") }
}
fn kind(result: http.Result): String {
  match (result) {
    _: http.Overloaded => "overloaded"
    _: http.Response => "response"
    _: http.BodyTooLarge => "too large"
    _: http.DeadlineExceeded => "deadline"
    _: Cancelled => "cancelled"
    _: IoError => "io"
  }
}
fn fixedBudget(s: Scope, capacity: http.RetryCount) uses clock + state: http.RetryBudget {
  http.OpenRetryBudget(s, capacity: capacity, refill: 60000.millis(), clock: .Some(time.FixedClock(.{ unixNanos: 0 })))
}
// Simulate the resource finalizer for closed-budget races independently of the
// static borrow rule that correctly forbids closing an owner's borrowed scope.
fn finalizer(budget: http.RetryBudget) uses state unsafe go { budget.owner.closeFn() }
type Marker = resource
fn marker(s: Scope, onClose: () => Ok) uses state: Marker unsafe go {
  return Marker{handle:nil,owner:s.Own(onClose)}
}
fn panicCaught(work: () => http.Result): Bool unsafe go {
  run := func()(caught bool) {
    defer func(){caught=recover()!=nil}()
    work()
    return false
  }
  return run()
}
fn waitCancelled(s: Scope) uses state: http.Result unsafe go {
  import "context"
  ctx := _borkScopeContext(s)
  <-ctx.Done()
  return Cancelled{reason:context.Cause(ctx).Error()}
}
fn elapsed(start: time.Instant) uses clock: Int { time.Now().unixNanos - start.unixNanos }
fn main() {
  scope s {
    budget = fixedBudget(s, 2)
    calls = atom(0)
    result = http.Retry(s, budget, operation: attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("shared tokens", current(calls), kind(result))
    result2 = http.Retry(s, budget, operation: attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("free next initial", current(calls), kind(result2))
  }
  scope s {
    budget = fixedBudget(s, 7)
    calls = atom(0)
    jobs = (range(0, 30)).map(i => fork(s, () => http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 100, baseDelay: 0.millis(), maxDelay: 0.millis())))
    results = jobs.map(task => kind(await(task)))
    println("concurrent", current(calls) == 37, results.all(value => value == "overloaded"))
  }
  scope s {
    budget = fixedBudget(s, 10)
    calls = atom(0)
    responses: List[http.Result] = [http.Text(200, "ok"), http.BodyTooLarge { limit: 1 }, IoError { path: "", message: "network" }, Cancelled { reason: "operation cancelled" }, http.DeadlineExceeded { message: "operation timeout" }]
    println("terminal", responses.map(response => kind(http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); response }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis()))), current(calls))
    result = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 1, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("attempt cap", kind(result), current(calls))
  }
  scope s {
    budget = fixedBudget(s, 10)
    calls = atom(0)
    result = http.Retry(s, budget, attempt => { n = update(calls, n => n + 1); if (n == 3) { http.Text(200, "ok") } else { busy() } }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("eventual success", kind(result), current(calls))
  }
  scope s {
    budget = fixedBudget(s, 10)
    ceilings = atom([0].take(0))
    result = http.Retry(s, budget, attempt => busy(), maxAttempts: 5, baseDelay: 1.millis(), maxDelay: 4.millis(), jitter: .Some(ceiling => { _ = update(ceilings, xs => xs.append(ceiling.nanos)); 9223372036854775807.nanos() }))
    println("capped jitter", kind(result), current(ceilings))
    result2 = http.Retry(s, budget, attempt => busy(), maxAttempts: 4, baseDelay: 9223372036854.millis(), maxDelay: 9223372036854.millis(), jitter: .Some(ceiling => (-1).nanos()))
    println("negative jitter and maximum backoff", kind(result2))
    result3 = http.Retry(s, budget, attempt => busy(9223372036854775807), maxAttempts: 3, baseDelay: 1.millis(), maxDelay: 1.millis(), jitter: .Some(ceiling => ceiling))
    println("wait overflow", kind(result3))
  }
  scope s {
    budget = fixedBudget(s, 10)
    start = time.Now()
    calls = atom(0)
    result = http.Retry(s, budget, attempt => { n = update(calls, n => n + 1); if (n == 1) { busy(20000000) } else { http.Text(200, "ok") } }, maxAttempts: 2, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("server minimum", kind(result), current(calls), elapsed(start) >= 20000000)
  }
  scope app {
    budget = fixedBudget(app, 10)
    scope request {
      cancelAfter(request, 60000.millis())
      calls = atom(0)
      result = http.Retry(request, budget, attempt => { _ = update(calls, n => n + 1); busy(120000000000) }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
      println("hint exceeds deadline", kind(result), current(calls))
      cancelAfter(request, 0.millis())
      result2 = http.Retry(request, budget, attempt => { _ = update(calls, n => n + 1); busy() })
      println("already expired", kind(result2), current(calls))
    }
    scope request {
      cancel(request)
      calls = atom(0)
      result = http.Retry(request, budget, attempt => { _ = update(calls, n => n + 1); busy() })
      println("already cancelled", kind(result), current(calls))
    }
    scope request {
      ready = channel[Bool](app, 1)
      fork(request, () => { _ = ready.receive(request); cancel(request) })
      calls = atom(0)
      result = http.Retry(request, budget, attempt => { _ = update(calls, n => n + 1); busy() }, baseDelay: 60000.millis(), maxDelay: 60000.millis(), jitter: .Some(ceiling => { _ = ready.send(request, true); ceiling }))
      println("cancel wait", kind(result), current(calls))
    }
  }
  scope s {
    budget = fixedBudget(s, 10)
    ready = channel[Bool](s, 1)
    fork(s, () => { _ = ready.receive(s); finalizer(budget) })
    calls = atom(0)
    result = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() }, baseDelay: 60000.millis(), maxDelay: 60000.millis(), jitter: .Some(ceiling => { _ = ready.send(s, true); ceiling }))
    println("budget close wait", kind(result), current(calls))
    result2 = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() })
    println("closed budget", kind(result2), current(calls))
  }
  scope s {
    budget = fixedBudget(s, 10)
    ready = channel[Bool](s, 1)
    fork(s, () => { _ = ready.receive(s); finalizer(budget) })
    result = http.Retry(s, budget, attempt => { _ = ready.send(s, true); waitCancelled(attempt) })
    println("budget cancels operation", kind(result))
  }
  scope s {
    budget = fixedBudget(s, 10)
    cleaned = atom(0)
    result = panicCaught(() => http.Retry(s, budget, attempt => {
      _ = marker(attempt, () => { _ = update(cleaned, n => n + 1) })
      panic("operation panic")
    }))
    println("panic cleanup", result, current(cleaned))
    result2 = http.Retry(s, budget, attempt => {
      _ = marker(attempt, () => { _ = update(cleaned, n => n + 1) })
      busy()
      }, maxAttempts: 3, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("normal finalizers", kind(result2), current(cleaned))
  }
  scope app {
    budget = fixedBudget(app, 10)
    scope request {
      cancelAfter(request, 10.millis())
      result = http.Retry(request, budget, attempt => waitCancelled(attempt))
      println("deadline during operation", kind(result))
    }
  }
  scope s {
    budget = fixedBudget(s, 2)
    calls = atom(0)
    cleaned = atom(0)
    result = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); fork(attempt, () => { _ = update(cleaned, n => n + 1) }); busy() }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("attempt cleanup", kind(result), current(calls), current(cleaned))
  }
  scope app {
    original = openScope(app)
    budget = fixedBudget(original.scope, 2)
    retained = attach(budget, app)
    closeScope(original)
    calls = atom(0)
    result = http.Retry(app, retained, attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 10, baseDelay: 0.millis(), maxDelay: 0.millis())
    println("attached ownership", kind(result), current(calls))
  }
}
