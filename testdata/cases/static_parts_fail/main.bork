import codec "bork/codec"
use codec.Defaults

type Alias = StaticParts
type Wrapper = { parts: StaticParts }
type Data = { values: List[String] }
fn bad(values: List[String], parts: StaticParts, wrapper: Wrapper) {
  direct = StaticParts { values: values }
  alias = Alias { values: values }
  _ = parts.copy(values: values)
  _ = wrapper.copy(parts.values: values)
  converted = Data { values: values }.into[StaticParts]()
  decoded = codec.decode[StaticParts](codec.Value.Object { fields: [] })
}
fn main() {}
