pred positive(x: Int) { x > 0 }
type Failed = {}
ambient label: String

fn work(n: Int) uses io: Int { println(s"force $n"); n }
fn bad() uses io: Int | Failed { println("failure"); Failed {} }
fn generic[T](value: T): T { lazy saved = value; saved }
fn named() needs label: String { label }

fn main() {
  lazy never = work(99)
  _ = () => never
  lazy value = work(7)
  reader = () => value
  println("before")
  println(reader()); println(value)
  alias = value; println(alias)

  lazy failed = bad()
  println(failed); println(failed)

  lazy early: Int where positive = {
    if (true) { return 3 }
    work(4)
  }
  println(early)
  lazy inferred = { if (true) { return 5 }; 6 }
  println(inferred)
  lazy propagate: Int | Failed = match (bad()) { number: Int => number + 1; failure: Failed => failure }
  println(propagate)
  lazy inferredUnion: Int | Failed = match (bad()) { number: Int => number + 1; failure: Failed => failure }
  println(inferredUnion)
  lazy optional: Option[Int] = match (Option.Some(8)) { Option.Some(number) => Option.Some(number + 1); Option.None => Option.None }
  println(optional)

  with (label: "captured") {
    lazy name = named()
    with (label: "reader") { println(name) }
  }

  lazy lazy = 10
  println(lazy)
  println(generic("generic"))
  scope s {
    tasks = [1, 2, 3].map(n => fork(s, () => reader()))
    println(tasks.map(t => await(t)))
  }
  for (n in [1, 2]) {
    lazy item = work(n)
    println(item); println(item)
  }
}
