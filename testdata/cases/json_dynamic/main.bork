import codec "bork/codec"

import "bork/json"
use codec.Defaults
fn main() {
  match (json.Parse("{\"items\":[{\"name\":\"bork\",\"nothing\":null}],\"exact\":12345678901234567890}")) {
    value: codec.Value => {
      println(json.At(value, ["items", 0, "name"]))
      println(json.At(value, ["items", 0, "nothing"]))
      println(json.At(value, ["items", -1]))
      println(json.At(value, ["items", 1]))
      println(json.At(value, ["missing"]))
      println(json.At(value, ["exact", "x"]))
      println(json.At(value, []))
      println(json.Pretty(value))
      println(json.Pretty(codec.Value.Array { items: [codec.Value.Bool { value: true }] }, 0))
    }
    error: json.JsonError => println(error.message)
  }
  println(match (json.Pretty(codec.Value.Number { text: "invalid" })) { _: json.JsonError => true; _ => false })
  println(match (json.Pretty(codec.Value.Array { items: [codec.Value.Number { text: "1,2" }] })) { _: json.JsonError => true; _ => false })
  println(match (json.Pretty(codec.Value.Number { text: "true" })) { _: json.JsonError => true; _ => false })
  println(json.Field(codec.Value.Object { fields: [codec.Field { name: "x", value: codec.Value.Null }, codec.Field { name: "x", value: codec.Value.Bool { value: true } }] }, "x"))
}
