type Conn = resource
fn connect(s: Scope): Conn unsafe go { return Conn{owner: s.Own(func() {})} }
fn use(c: Conn) uses io { println(c) }
providers Wiring = { connection: connect }
fn main() {
  scope app {
    child = openScope(app)
    value = assemble[Conn](child.scope, Wiring)
    closeScope(child)
    use(value)
  }
}
