import "bork/fs"

fn leak(): Task[Int] {
  scope s {
    spawn(s, () => 1)
  }
}

fn late(): Int {
  t = scope s { spawn(s, () => 1) }
  await(t)
}

fn inner(path: String) uses io: Int {
  scope outer {
    scope s {
      f = fs.Open(path, s)
      _ = spawn(outer, () => match (f) { _: fs.File => 1, _: fs.Error => 0 })
      0
    }
  }
}

fn main() {}
