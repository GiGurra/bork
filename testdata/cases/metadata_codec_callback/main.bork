import "bork/codec"
use codec.Defaults
use decodeLegacy

type Legacy = { value: String }
instance decodeLegacy: codec.Decode[Legacy] {
  metadata codec.RecordSchema = codec.RecordSchema {
    fields: [codec.RecordField {
      name: "value", typeName: "String", doc: "", facts: [], kind: "string", optional: false, hasDefault: false, defaultValue: Option.None,
      validate: input => match (codec.decode[String](input)) {
        String => Ok
        error: codec.DecodeError => codec.DecodeError { path: ".value" + error.path, message: error.message }
      }
    }]
  }
  fn decode(input: codec.Value): Legacy | codec.DecodeError {
    match (codec.decode[String](input)) {
      value: String => Legacy { value: value }
      error: codec.DecodeError => error
    }
  }
}
fn main() {
  match (codec.Schema[Legacy]()) {
    Option.Some(schema) => match (schema.fields.get(0)) {
      Option.Some(field) => {
        println(field.validate(codec.Value.String { value: "valid" }))
        println(field.validate(codec.Value.Null))
      }
      Option.None => panic("missing field")
    }
    Option.None => panic("missing schema")
  }
}
