fn cleanup(s: Scope, text: String) uses io unsafe go {
  import "fmt"
  s.Defer(func() { fmt.Println(text) })
}
fn producer(): Seq[Int] uses io {
  generate[Int] {
    scope outer {
      cleanup(outer, "producer closed")
      for (n in Seq.range(1000, 1003)) {
        scope inner {
          cleanup(inner, "inner closed")
          yield n
          println("resumed")
        }
      }
    }
  }
}
fn early(xs: Seq[Int] uses io) uses io: Int {
  for (n in xs) { return n }
  0
}
fn failed(xs: Seq[Int] uses io) uses io: Ok | OutOfRange {
  for (n in xs) { println(toInt8(n)?) }
}
fn protect(work: () => Ok): Bool unsafe go {
  recovered := false
  func() { defer func() { recovered = recover() != nil }(); work() }()
  return recovered
}
fn failClose(s: Scope) uses io unsafe go { s.Defer(func() { panic("cleanup failed") }) }
fn give(parent: Scope) uses io: OwnedScope {
  for (n in Seq.range(0, 1)) {
    owner = openScope(parent)
    cleanup(owner.scope, "returned owner closed")
    scope failing { failClose(failing); return owner }
  }
  openScope(parent)
}
fn captured(s: Scope): Seq[Int] uses io {
  generate[Int] {
    scope local {
      cleanup(local, "captured producer closed")
      cleanup(s, "captured finalizer")
      yield 1
    }
  }
}
fn capturedReturn() uses io: Int {
  scope enclosing {
    cleanup(enclosing, "enclosing closed")
    for (n in captured(enclosing)) { scope consumer { cleanup(consumer, "return consumer closed"); return n } }
    0
  }
}
fn main() {
  scope parent {
    println(protect(() => { closeScope(give(parent)) }))
    println("after failed owner return")
  }
  println(capturedReturn())
  println(protect(() => {
    for (n in producer()) { scope consumer { cleanup(consumer, "panic consumer closed"); println(n); panic("stop") } }
  }))
  println(producer().take(0).toList())
  println(producer().take(1).toList())
  for (n in producer()) {
    scope consumer { cleanup(consumer, "consumer closed"); println(n); break }
  }
  println(early(producer()))
  println(failed(producer()))
  println(protect(() => { for (n in producer()) { println(n); panic("stop") } }))
  println(Seq.range(0, 3).flatMap(n => generate[Int] {
    println("outer", n)
    for (value in Seq.range(0, 9223372036854775807)) { yield value }
    }).take(1).toList())
}
