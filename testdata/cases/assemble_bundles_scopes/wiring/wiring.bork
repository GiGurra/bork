type Conn = resource
type App = { first: Conn, second: Conn }
fn connect(s: Scope) uses io: Conn unsafe go {
  import "fmt"
  fmt.Println("open")
  return Conn{handle: "connection", owner: s.Own(func() { fmt.Println("close") })}
}
fn Application(conn: Conn in s, s: Scope): App { App { first: conn, second: conn } }
Wiring = (connect,)
