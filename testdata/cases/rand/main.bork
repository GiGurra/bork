import "bork/rand"
fn main() {
  generator = rand.Seed(1, 2)
  println(generator)
  first = rand.IntFrom(generator, -10, 10)
  again = rand.IntFrom(generator, -10, 10)
  println(first == again)
  println(first.value >= -10 && first.value < 10)
  println(first.next != generator)
  println(rand.FloatFrom(first.next).value >= 0.0 && rand.FloatFrom(first.next).value < 1.0)
  values = [1, 2, 3, 4]
  shuffled = rand.ShuffleFrom(generator, values)
  println(shuffled == rand.ShuffleFrom(generator, values))
  println(values == [1, 2, 3, 4])
  println(shuffled.value.length() == values.length())
  println(rand.PickFrom(generator, [42]).value)
  println(rand.PickFrom[Int](generator, []).next == generator)
  println(rand.PickFrom[Int](generator, []).value)
  large = rand.IntFrom(generator, -9223372036854775808, 9223372036854775807)
  println(large.value < 9223372036854775807)
  println(rand.IntBetween(-10, 10) >= -10)
  println(rand.Float01() >= 0.0)
  println(rand.Pick([42]))
  println(rand.Pick[Int]([]))
  println(rand.Shuffle([42]))
}
