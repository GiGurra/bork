import "bork/http"
import "bork/time"
fn instantFor(s: Scope) uses clock: time.Instant unsafe go { return instant() }
fn instant(): time.Instant { time.Instant { unixNanos: 0 } }
fn main() {
  scope app {
    scope short {
      budget = http.OpenRetryBudget(short, capacity: 1, refillMs: 1)
      _ = http.Retry(app, budget, attempt => http.Text(200, "ok"))
      clock = time.Clock { now: () => instantFor(short) }
      _ = http.OpenRetryBudget(app, capacity: 1, refillMs: 1, clock: .Some { value: clock })
    }
  }
}
