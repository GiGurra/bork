import "bork/encoding"

type Packet = { data: Bytes }

fn discriminate(value: Bytes | List[Byte]): String {
  match (value) {
    data: Bytes => "bytes"
    data: List[Byte] => "list"
  }
}

// Go boundaries must isolate values from both source and returned slices.
fn isolated(): Bytes unsafe go {
  source := []byte{1, 2}
  data := _borkBytesFrom(source)
  source[0] = 99
  out := _borkBytesData(data)
  out[1] = 99
  return data
}

fn nilBytes(): Bytes unsafe go { return nil }

fn main() {
  data = encoding.Utf8("hé\x00")
  println(data)
  println(data.length())
  println(data.get(0))
  println(data.get(-1))
  println(data.get(99))
  println(data.toList())
  println(data.slice(0, 1))
  println(data.slice(-1, 0))
  println(data.concat(encoding.Utf8("!")))
  println(match (encoding.ParseUtf8(data)) {
    text: String => text == "hé\x00"
    error: ParseError => false
  })
  println([].toBytes().isEmpty())
  println([].toBytes() == encoding.Utf8(""))
  println(data == encoding.Utf8("hé\x00"))
  println(Packet { data: data } == Packet { data: encoding.Utf8("hé\x00") })
  println(discriminate(data))
  println(discriminate(data.toList()))
  println({ data: "found" }.get(encoding.Utf8("hé\x00")))
  println(isolated())
  println(encoding.Hex(data))
  println(encoding.ParseHex("00Ff"))
  println(encoding.ParseHex("0"))
  println(encoding.ParseHex("gg"))
  println(encoding.Base64(data))
  println(encoding.ParseBase64(encoding.Base64(data)))
  binary = [toByte(251), toByte(255)].toBytes()
  println(encoding.Base64(binary))
  println(encoding.Base64URL(binary))
  println(encoding.ParseBase64URL(encoding.Base64URL(binary)))
  println(encoding.ParseBase64("!!!!"))
  println(encoding.ParseBase64("Zh=="))
  println(encoding.ParseBase64URL("+/8="))
  println(encoding.ParseUtf8(binary))
  println(nilBytes() == [].toBytes())
  println(nilRoundTrip())
  println(encoding.ParseHex(""))
  println(encoding.ParseBase64(""))
  println(encoding.ParseBase64URL(""))
  println(encoding.ParseHex("0011gg"))
  println(encoding.ParseBase64("YQ==!!!!"))
  println(encoding.ParseBase64("YQ==\r\n"))
  println(encoding.ParseBase64URL("YQ==\r\n"))
  mixed: Map[Bytes | List[Byte], String] = { binary: "bytes", binary.toList(): "list" }
  println(mixed.size())
  println(mixed.get(binary))
  println(mixed.get(binary.toList()))
  println(mixedEqual(binary, binary.toList()))
  println(binary.concat(binary))
  println(binary)
  println(binary.slice(2, 2))
  println(binary.slice(1, 0))
  println(binary.slice(0, 3))
}

fn nilRoundTrip(): Bytes unsafe go {
  return _borkBytesFrom(_borkBytesData(_borkBytesFrom(nil)))
}

fn mixedEqual(a: Bytes | List[Byte], b: Bytes | List[Byte]): Bool { a == b }
