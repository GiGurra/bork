import "bork/encoding"

type Packet = { data: Bytes }

fn discriminate(value: Bytes | List[Byte]): String {
  match (value) {
    data: Bytes => "bytes"
    data: List[Byte] => "list"
  }
}

// Go boundaries must isolate values from both source and returned slices.
fn isolated(): Bytes unsafe go {
  source := []byte{1, 2}
  data := _borkBytesFrom(source)
  source[0] = 99
  out := _borkBytesData(data)
  out[1] = 99
  return data
}

fn main() {
  data = utf8Bytes("hé\x00")
  println(data)
  println(data.length())
  println(data.get(0))
  println(data.get(-1))
  println(data.get(99))
  println(data.toList())
  println(data.slice(0, 1))
  println(data.slice(-1, 0))
  println(data.concat(utf8Bytes("!")))
  println(utf8String(data))
  println(bytes([]).isEmpty())
  println(bytes([]) == utf8Bytes(""))
  println(data == utf8Bytes("hé\x00"))
  println(Packet { data: data } == Packet { data: utf8Bytes("hé\x00") })
  println(discriminate(data))
  println(discriminate(data.toList()))
  println({ data: "found" }.get(utf8Bytes("hé\x00")))
  println(isolated())
  println(encoding.Hex(data))
  println(encoding.ParseHex("00Ff"))
  println(encoding.ParseHex("0"))
  println(encoding.ParseHex("gg"))
  println(encoding.Base64(data))
  println(encoding.ParseBase64(encoding.Base64(data)))
  binary = bytes([toByte(251), toByte(255)])
  println(encoding.Base64(binary))
  println(encoding.Base64URL(binary))
  println(encoding.ParseBase64URL(encoding.Base64URL(binary)))
  println(encoding.ParseBase64("!!!!"))
  println(encoding.ParseBase64("Zh=="))
  println(encoding.ParseBase64URL("+/8="))
  println(utf8String(binary))
}
