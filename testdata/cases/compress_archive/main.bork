import "bork/encoding"
import "bork/compress"
import "bork/archive"
import "bork/fs"
import "bork/time"

fn codecs() uses io: Ok | IoError {
  data = [toByte(0), toByte(255), toByte(65)].toBytes()
  zipped = compress.Gzip(data)?
  println(compress.Gunzip(zipped)? == data)
  println(compress.Gunzip(zipped, 3)? == data)
  println(match (compress.Gunzip(zipped, 2)) { _: Bytes => false, _: IoError => true })
  println(match (compress.Gunzip(zipped, -1)) { _: Bytes => false, _: IoError => true })
  println(match (compress.Gunzip(encoding.Utf8("bad"))) { _: Bytes => false, _: IoError => true })
  println(match (compress.Gunzip(corruptGzip(zipped))) { _: Bytes => false, _: IoError => true })
  println(match (compress.Gunzip(concat(zipped, zipped), 5)) { _: Bytes => false, _: IoError => true })
  println((compress.Gunzip(concat(zipped, zipped), 6)?).length())
  empty = compress.Gzip([].toBytes())?
  println((compress.Gunzip(empty, 0)?).length())
  entries = [archive.Member { name: "nested/", data: [].toBytes(), directory: true }, archive.Member { name: "nested/a.bin", data: data, directory: false }, archive.Member { name: "empty", data: [].toBytes(), directory: false }]
  zip = archive.Zip(entries)?
  tar = archive.Tar(entries)?
  println(archive.ReadZip(zip)? == entries)
  println(archive.ReadTar(tar)? == entries)
  println(archive.ReadZip(zip, 3)? == entries)
  println(archive.ReadTar(tar, 3)? == entries)
  println(match (archive.ReadZip(zip, 2)) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadTar(tar, 2)) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadZip(encoding.Utf8("bad"))) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadTar(encoding.Utf8("bad"))) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadZip(corruptZip(rawZip("data", false)))) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadTar(truncateTar(rawTar("hello", false)))) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadZip(rawZip("link", true))) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadTar(rawTar("link", true))) { _: List[archive.Member] => false, _: IoError => true })
  double = [archive.Member { name: "one", data: data, directory: false }, archive.Member { name: "two", data: data, directory: false }]
  println(match (archive.ReadZip(archive.Zip(double)?, 5)) { _: List[archive.Member] => false, _: IoError => true })
  println(match (archive.ReadTar(archive.Tar(double)?, 5)) { _: List[archive.Member] => false, _: IoError => true })
  println(match (compress.Gunzip(defaultLimitGzip())) { _: Bytes => false, _: IoError => true })
  println(match (archive.ReadZip(defaultLimitZip())) { _: List[archive.Member] => false, error: IoError => error.message.contains("maxBytes") })
  println(match (archive.ReadTar(defaultLimitTar())) { _: List[archive.Member] => false, error: IoError => error.message.contains("maxBytes") })
  ["hardlink", "device", "fifo"].forEach(kind => {
    println(match (archive.ReadTar(specialTar(kind))) { _: List[archive.Member] => false, _: IoError => true })
  })
  println(match (archive.ReadZip(specialZip())) { _: List[archive.Member] => false, _: IoError => true })
  nulMember = [archive.Member { name: "bad\u0000name", data: [].toBytes(), directory: false }]
  println(match (archive.Zip(nulMember)) { _: Bytes => false, _: IoError => true })
  println(match (archive.Tar(nulMember)) { _: Bytes => false, _: IoError => true })
  println(match (archive.ReadZip(rawZip("bad\u0000name", false))) { _: List[archive.Member] => false, _: IoError => true })
  names = ["../escape", "/absolute", "a/../escape", "a\\escape", "C:/escape", ".", ""]
  names.forEach(name => {
    println(match (archive.ReadZip(rawZip(name, false))) { _: List[archive.Member] => false, _: IoError => true })
    println(match (archive.ReadTar(rawTar(name, false))) { _: List[archive.Member] => false, _: IoError => true })
    bad = [archive.Member { name: name, data: data, directory: false }]
    println(match (archive.Zip(bad)) { _: Bytes => false, _: IoError => true })
    println(match (archive.Tar(bad)) { _: Bytes => false, _: IoError => true })
  })
}

fn files(s: Scope) uses io + clock: Ok | fs.Error {
  source = fs.TempFile(s)?
  _ = fs.WriteTo(source, encoding.Utf8("file stream"))?
  input = fs.Open(fs.Path(source), s)?
  zipped = fs.TempFile(s)?
  println(compress.GzipTo(input, zipped)?)
  zipInput = fs.Open(fs.Path(zipped), s)?
  output = fs.TempFile(s)?
  println(compress.GunzipTo(zipInput, output)?)
  println(fs.Read(fs.Path(output))? == encoding.Utf8("file stream"))
  entries = [archive.Member { name: "hello", data: encoding.Utf8("archive stream"), directory: false }]
  zipFile = fs.TempFile(s)?
  archive.WriteZip(zipFile, entries)?
  // ZIP needs random access and reads the whole file, regardless of offset.
  archive.ForEachZip(zipFile, entry => println(entry.name))?
  archive.ForEachZip(zipFile, entry => println(time.Now().unixNanos > 0))?
  bad = [archive.Member { name: "bad\u0000name", data: [].toBytes(), directory: false }]
  println(match (archive.WriteZip(zipFile, bad)) { _: Ok => false, _: IoError => true })
  malicious = fs.TempFile(s)?
  _ = fs.WriteTo(malicious, rawZip("bad\u0000name", false))?
  println(match (archive.ForEachZip(malicious, entry => println("unexpected"))) { _: Ok => false, _: IoError => true })
  cappedInput = fs.Open(fs.Path(zipped), s)?
  cappedOutput = fs.TempFile(s)?
  println(match (compress.GunzipTo(cappedInput, cappedOutput, 4)) { _: Int => false, _: IoError => true })
  println((fs.Read(fs.Path(cappedOutput))?).length())
  println(match (archive.ForEachZip(zipFile, entry => println("unexpected"), 1)) { _: Ok => false, _: IoError => true })
  tarFile = fs.TempFile(s)?
  archive.WriteTar(tarFile, entries)?
  tarInput = fs.Open(fs.Path(tarFile), s)?
  archive.ForEachTar(tarInput, entry => println(encoding.ParseUtf8(entry.data)))?
  clockTar = fs.Open(fs.Path(tarFile), s)?
  archive.ForEachTar(clockTar, entry => println(time.Now().unixNanos > 0))?
  println(match (archive.WriteTar(tarFile, bad)) { _: Ok => false, _: IoError => true })
  cappedTar = fs.Open(fs.Path(tarFile), s)?
  println(match (archive.ForEachTar(cappedTar, entry => println("unexpected"), 1)) { _: Ok => false, _: IoError => true })
}

fn main() {
  println(match (codecs()) { _: Ok => "codecs ok", error: IoError => error.message })
  result = scope s { files(s) }
  println(match (result) { _: Ok => "files ok", error: fs.Error => fs.ErrorInfo(error).message })
}
