// What `[]` or `{:}` holds is decided by what the lambda's body gives.
fn main() {
  words = "b a b c".split(" ")
  println(words.fold([], (acc, w) => acc.append(w.toUpper())))
  println(words.fold({:}, (m, w) => m.put(w, m.getOr(w, 0) + 1)))
  initial: Map[String, Int] = {:}
  println(words.fold(initial.sorted(), (m, w) => m.put(w, w.byteLength())))
  println([1, 2, 3].fold(Option.None, (best, x) => Option.Some { value: x }))
  // Nested: the inner call waits for the outer one to know.
  sizes: Map[String, Int] = initial.unordered().sorted()
  println(sizes)
}
