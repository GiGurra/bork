import "bork/http"
import "bork/time"
import "bork/rand"
fn busy(): http.Result { http.Overloaded { retryAfter: .None, response: http.Text(503, "busy") } }
fn attempts(s: Scope, budget: http.RetryBudget in s) uses clock + random + state: Int {
  calls = atom(0)
  _ = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() }, maxAttempts: 100, baseDelay: 0.millis(), maxDelay: 0.millis())
  current(calls)
}
fn main() {}
test "an injected SystemClock uses native time mocks and preserves refill phase" {
  now = atom(0)
  mock time.Now() { time.Instant { unixNanos: current(now) } }
  scope s {
    budget = http.OpenRetryBudget(s, capacity: 2, refill: 1.millis(), clock: .Some(time.SystemClock()))
    assertEqual(attempts(s, budget), 3)
    _ = update(now, n => 2500000)
    assertEqual(attempts(s, budget), 3)
    _ = update(now, n => 3000000)
    assertEqual(attempts(s, budget), 2)
    _ = update(now, n => 1000000)
    assertEqual(attempts(s, budget), 1)
    _ = update(now, n => 4000000)
    assertEqual(attempts(s, budget), 2)
    _ = update(now, n => 100000000000)
    assertEqual(attempts(s, budget), 3)
  }
}
test "FixedClock holds a budget steady" {
  scope s {
    budget = http.OpenRetryBudget(s, capacity: 1, refill: 1.millis(), clock: .Some(time.FixedClock(.{ unixNanos: 0 })))
    assertEqual(attempts(s, budget), 2)
    assertEqual(attempts(s, budget), 1)
  }
}
test "default jitter uses the standard random source and can be mocked" {
  draws = mock rand.IntBetween(lo, hi) { lo }
  scope s {
    budget = http.OpenRetryBudget(s, capacity: 2, refill: 60000.millis())
    _ = http.Retry(s, budget, attempt => busy(), maxAttempts: 3, baseDelay: 2.millis(), maxDelay: 4.millis())
    assertEqual(draws.count(), 2)
    assertEqual(draws.calls(), ["rand.IntBetween(0, 2000001)", "rand.IntBetween(0, 4000001)"])
  }
}

test "default jitter includes both endpoints at the maximum duration" {
  high = atom(false)
  calls = atom(0)
  draws = mock rand.IntBetween(lo, hi) { if (current(high)) { hi - 1 } else { lo } }
  scope s {
    cancelAfter(s, 10.seconds())
    budget = http.OpenRetryBudget(s, capacity: 2, refill: 1.hours())
    _ = http.Retry(s, budget, attempt => { _ = update(calls, n => n + 1); busy() },
      maxAttempts: 3, baseDelay: 9223372036854775807.nanos(), maxDelay: 9223372036854775807.nanos())
    assertEqual(current(calls), 3)
    assertEqual(draws.count(), 2)
    _ = update(high, value => true)
    other = http.OpenRetryBudget(s, capacity: 2, refill: 1.hours())
    _ = http.Retry(s, other, attempt => { _ = update(calls, n => n + 1); busy() },
      maxAttempts: 3, baseDelay: 9223372036854775807.nanos(), maxDelay: 9223372036854775807.nanos())
    // Maximum jitter cannot fit the scope deadline, so no second attempt starts.
    assertEqual(current(calls), 4)
    assertEqual(draws.calls(), ["rand.IntBetween(-9223372036854775808, 0)", "rand.IntBetween(-9223372036854775808, 0)", "rand.IntBetween(-9223372036854775808, 0)"])
  }
}
