import "bork/time"
// A worker that ticks until its scope is cancelled, and says why it
// stopped.
fn ticker(s: Scope, name: String, n: Int) uses io + clock + state: Int {
  match (delay(s, 5.millis())) {
    c: Cancelled => {
      println(s"$name stopped: ${c.reason}")
      n
    }
    _ => ticker(s, name, n + 1)
  }
}

fn main() {
  // An explicit cancel; the scope still waits for its tasks.
  r = scope s {
    t = fork(s, () => ticker(s, "a", 0))
    _ = time.Sleep(s, ((20) * 1000000).nanos())
    cancel(s)
    await(t) >= 1
  }
  println(r)
  // When a scope ends, it cancels itself and waits for its tasks: how
  // each one stops is its own business. This worker stops at once...
  scope s {
    b = fork(s, () => ticker(s, "b", 0))
    // ...and this one observes b finishing before completing its work.
    fork(s, () => {
      _ = await(b)
      _ = time.Sleep(s, ((10) * 1000000).nanos())
      println("d finished its work")
    })
  }
  // A deadline.
  scope s {
    cancelAfter(s, 15.millis())
    println(delay(s, 1000.millis()))
  }
  // Nested scopes are cancelled with the scope around them.
  scope outer {
    scope inner {
      println(cancelled(inner))
      cancel(outer)
      println(cancelled(inner))
      println(checkpoint(inner))
    }
  }
  // Work that is done before the deadline is not cancelled.
  scope s {
    cancelAfter(s, 1000.millis())
    println(delay(s, 1.millis()))
  }
}
