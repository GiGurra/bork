import codec "bork/codec"
import "bork/json"
use codec.Defaults
pred positive(x: Int) { x > 0 }

type Pos = Int where positive

fn pick[T](a: T, b: T): T { a }

fn main() {
  // decodeInt does not promise positive.
  println(json.Decode[Pos]("1"))
  // map's B values come from the lambda, which is not checked.
  println([1].map[Int, Pos](x => x))
}
