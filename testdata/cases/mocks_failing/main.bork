fn Fetch(url: String) uses net: String {
  s"real $url"
}

fn main() {
  println(Fetch("x"))
}

test "a failing test with a task waiting in a mock fails, and does not hang" {
  scope s {
    ch = channel[Int](s, 0)
    mock Fetch(url) {
      r = receive(ch)
      s"got $r"
    }
    launch(s, () => println(Fetch("a")))
    sleep(30)
    assertEqual(1, 2)
  }
}

test "the next test sees no mocks" {
  assertEqual(Fetch("b"), "real b")
}
