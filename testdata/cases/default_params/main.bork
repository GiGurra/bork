fn greet(name: String, greeting: String = "Hello", times: Int = 1) {
  forEach(range(0, times), i => println(s"$greeting, $name!"))
}

fn tags(name: String, extra: Map[String, Int] = {:}): String {
  s"$name $extra"
}

fn firstOr[T](xs: List[T], fallback: List[T] = []): List[T] {
  if (isEmpty(xs)) { fallback } else { take(xs, 1) }
}

fn scale(x: Float, by: Float = -1.5): Float { x * by }

fn main() {
  greet("ada")
  greet("bob", "Hi")
  greet("cy", "Hey", 2)
  println(tags("a"))
  println(tags("b", { "x": 1 }))
  // The default takes its type from each call.
  println(firstOr([1, 2]))
  println(firstOr(["a"]))
  println(scale(2.0))
  "dee" |> greet("Yo")
  more()
}

type Level = sealed { Low, High }
type Retry = { times: Int, backoff: Option[Int] }

fn send(msg: String, level: Level = Level.Low, retry: Retry = Retry { times: 3, backoff: Option.None }): String {
  s"$msg $level $retry"
}

fn more() {
  println(send("a"))
  println(send("b", Level.High))
  println(send("c", Level.High, Retry { times: 1, backoff: Option.Some { value: 50 } }))
}
