type Row = { value: Int }
pred positive(n: Int) { n > 0 }
fn keep(n: Int where positive): Int { n }
fn main() {
  n = 3
  if n > 0 { println(keep(n)) }
  if (n) > 0 { println("grouped operand") }
  println(match n { 3 => "three", _ => "other" })
  println(match (Row { value: 7 }) { Row { value } => value })
  for item in [1, 2] { println(item) }
  remaining = 2
  for remaining > 0 {
    println(keep(remaining))
    remaining = remaining - 1
  }
  for i = 1; i < 3; i = i + 1 { println(i) }
  for ; false; {}
  if (true) { println("parentheses still work") }
}
