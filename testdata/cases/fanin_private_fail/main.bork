fn main() {
  scope s {
    task = spawn(s, () => 1)
    _: Task[String] = Task { native: task.native, wait: () => "fake" }
    _ = task.copy(wait: () => 2)
    _: Channel[Int] = Channel {}
    existing = channel[Int](s, 1)
    arm = existing.receiveCase(value => 1)
    _: ReceiveCase[Int] = ReceiveCase { native: arm.native, decode: arm.decode }
  }
}
