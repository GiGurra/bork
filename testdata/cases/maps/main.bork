type Point = { x: Int, y: Int }

fn main() {
  ages = { "ada": 36, "bob": 41 }
  println(ages)
  empty: Map[String, Int] = {:}
  println(empty)
  // A key given twice keeps the later value.
  println({ "a": 1, "b": 2, "a": 3 })
  // Entries over several lines; values from the context.
  attrs: Map[String, String | Int | Bool] = {
    "user": "ada",
    "age": 36,
    "admin": false,
  }
  println(attrs)
  // Keys of any comparable type.
  names = { Point { x: 1, y: 2 }: "a", Point { x: 0, y: 0 }: "origin" }
  println(names)
  byList = { [1, 2]: "a", [3]: "b" }
  println(byList.get([1, 2]))
  // Equality ignores order.
  println({ "a": 1, "b": 2 } == { "b": 2, "a": 1 })
  println({ "a": 1 } == { "a": 2 })
  // A block is still a block.
  x = {
    y = 1
    y + 1
  }
  println(x)
  useMaps()
}

fn useMaps() uses io {
  ages = { "ada": 36, "bob": 41 }
  println(ages.get("ada"))
  println(ages.get("cy"))
  println(ages.getOr("cy", 0))
  older = ages.put("cy", 29).put("ada", 37)
  println(older)
  println(older.remove("bob"))
  println(ages)
  println(s"${older.size()} ${older.has("cy")} ${ages.isEmpty()}")
  println(older.keys())
  println(older.values())
  println(ages.entries())
  println([Entry { key: 1, value: "one" }, Entry { key: 2, value: "two" }].toMap())
  println(ages.merge({ "bob": 0, "dee": 50 }))
  println(ages.mapValues(a => a * 2))
  println(older.filter((name, age) => age > 30))
  ages.forEach((name, age) => println(s"$name is $age"))
}
