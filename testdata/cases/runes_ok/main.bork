// Counts the digits in s, from rune index i on.
fn countDigits(s: String, i: Int): Int {
  match (s.runeAt(i)) {
    Option.Some(r) => if (r.isDigit()) { 1 + countDigits(s, i + 1) } else { countDigits(s, i + 1) }
    Option.None => 0
  }
}

fn describe(r: Rune): String {
  match (r) {
    'a' => "the letter a"
    '\n' => "a newline"
    _ => if (r.isUpper()) { "upper " + toString(r) } else { "other " + toString(r) }
  }
}

fn main() {
  s = "Grüße 2024"
  println(s.byteLength(), s.runeCount(), countDigits(s, 0))
  println(s.runeAt(2), s.runeAt(99))
  println(s.substring(0, 5), s.substring(3, 2))
  r = 'ü'
  next = (r.code() + 1).rune()
  println(r, next, toString(next), toString('A'))
  println(describe('a'), describe('\n'), describe('Q'), describe('å'))
  println('x'.isLetter(), ' '.isSpace(), 'X'.isLower())
}
