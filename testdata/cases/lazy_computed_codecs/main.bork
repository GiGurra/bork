import codec "bork/codec"

import "bork/json"
import "example.com/lazy_computed_codecs/settings"
import "bork/env"
import "bork/encoding"
use codec.Defaults
pred positive(n: Int) { n > 0 }
fn double(n: Int where positive): Int { if (n <= 0) { panic("recipe ran before dependency validation") }; n * 2 }
type Config = { lazy doubled: Int = double(n), n: Int where positive, tag: String = "default" } derive (codec.Decode, codec.Encode, GoStruct)
type PrivateComputed = { n: Int, lazy secret: settings.Secret = settings.New(n) } derive (codec.Decode, codec.Encode, GoStruct)
type Callback = { n: Int, lazy call: () => Int = () => n } derive (codec.Decode, codec.Encode, GoStruct)
type Choice = sealed { Item { n: Int, lazy doubled: Int = n * 2 }, Empty } derive (codec.Decode, codec.Encode)
fn round[T: GoStruct](value: T): T | GoValueError unsafe go {
 result,errs:=_d_T_GoStruct.FromGo(_d_T_GoStruct.ToGo(value))
 if len(errs)>0{return errs[0]};return result
}
fn zero[T: GoStruct](): T | GoValueError unsafe go {
 result,errs:=_d_T_GoStruct.FromGo(_d_T_GoStruct.New())
 if len(errs)>0{return errs[0]};return result
}
fn fields[T: GoStruct](): Int unsafe go {return int64(len(_d_T_GoStruct.Fields()))}
fn decoders[T: GoStruct](): Int unsafe go {
 var count int64
 for _,field:=range _d_T_GoStruct.Fields(){if field.Decode!=nil{count++}}
 return count
}
fn decode(text: String) uses io {
  result: Config | json.JsonError | codec.DecodeError = json.Decode(text)
  match (result) { c: Config => { println(c.doubled); println(json.Encode(c)) }, e: json.JsonError => println(e), e: codec.DecodeError => println(s"error ${e.path}: ${e.message}") }
}
fn main() {
  c = Config { n: 3 }; println(json.Encode(c))
  match (round(c)) { v: Config => println(v.doubled), e: GoValueError => println(e) }
  println(fields[Config]()); println(decoders[Config]())
  println(zero[Config]())
  decode("{\"n\":5}")
  decode("{\"n\":0}")
  decode("{\"n\":1,\"doubled\":9}")
  choice: Choice = .Item { n: 7 }; println(json.Encode(choice))
  loaded = env.LoadWith[Config]("", name => if (name == "N") { .Some("8") } else { .None })
  match (loaded) { v: Config => println(v.doubled), e: env.ConfigError => println(e) }
  rows = encoding.DecodeCsv[Config]("n,tag\n6,row\n")
  match (rows) { values: List[Config] => println(values.map(row => row.doubled)), e: encoding.CsvError => println(e), e: encoding.CsvErrors => println(e) }
  println(fields[Callback]())
  cb: Callback | codec.DecodeError | json.JsonError = json.Decode("{\"n\":4}")
  match (cb) { value: Callback => { println(value.call()); println(json.Encode(value)) }, e: codec.DecodeError => println(e), e: json.JsonError => println(e) }
  privateResult: PrivateComputed | codec.DecodeError | json.JsonError = json.Decode("{\"n\":7}")
  match (privateResult) { value: PrivateComputed => { println(value.secret.value); println(json.Encode(value)) }, e: codec.DecodeError => println(e), e: json.JsonError => println(e) }
}
