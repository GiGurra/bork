import codec "bork/codec"

import "bork/json"
use codec.Defaults
pred nonEmpty(s: String) { s.byteLength() > 0 }
pred between(x: Int, lo: Int, hi: Int) { x >= lo && x <= hi }

type CreateUser = {
  name: String where nonEmpty,
  age: Option[Int where between(0, 150)],
  tags: List[String],
} derive (codec.Decode, codec.Encode)

type Shape = sealed {
  Circle { radius: Float },
  Square { side: Float },
  Empty,
} derive (codec.Decode, codec.Encode)

// A decoded record is proven: its where clauses were checked.
fn greet(name: String where nonEmpty): String { s"hello $name" }

fn user(s: String) uses io {
  r: CreateUser | json.JsonError | codec.DecodeError = json.Decode(s)
  match (r) {
    u: CreateUser => println(s"${greet(u.name)}: ${json.Encode(u)}")
    e: json.JsonError => println(e)
    e: codec.DecodeError => println(s"error at ${e.path}: ${e.message}")
  }
}

fn shape(s: String) uses io {
  r: Shape | json.JsonError | codec.DecodeError = json.Decode(s)
  match (r) {
    sh: Shape => println(json.Encode(sh))
    e: json.JsonError => println(e)
    e: codec.DecodeError => println(s"error at ${e.path}: ${e.message}")
  }
}

fn main() {
  user("{\"name\": \"ann\", \"age\": 30, \"tags\": [\"a\"]}")
  user("{\"name\": \"bob\", \"tags\": []}")
  user("{\"name\": \"\", \"tags\": []}")
  user("{\"name\": \"cy\", \"age\": 200, \"tags\": []}")
  user("{\"name\": \"cy\", \"tags\": [1]}")
  user("{\"tags\": []}")
  user("[1]")
  shape("{\"type\": \"Circle\", \"radius\": 2}")
  shape("\"Empty\"")
  shape("{\"type\": \"Hex\"}")
  shape("{\"radius\": 2}")
  orders()
}

// Generic types derive generic instances; fields of derived types use
// their derived instances.
type Pair[A, B] = { first: A, second: B } derive (codec.Decode, codec.Encode)
type Order = { id: Int, items: List[Pair[String, Int]], shape: Shape } derive (codec.Decode, codec.Encode)

fn order(s: String) uses io {
  r: Order | json.JsonError | codec.DecodeError = json.Decode(s)
  match (r) {
    o: Order => println(json.Encode(o))
    e: json.JsonError => println(e)
    e: codec.DecodeError => println(s"error at ${e.path}: ${e.message}")
  }
}

fn orders() uses io {
  order("{\"id\": 1, \"items\": [{\"first\": \"pen\", \"second\": 2}], \"shape\": \"Empty\"}")
  order("{\"id\": 1, \"items\": [{\"first\": \"pen\", \"second\": 2}, {\"first\": \"ink\"}], \"shape\": \"Empty\"}")
  order("{\"id\": 1, \"items\": [], \"shape\": {\"type\": \"Square\", \"side\": \"big\"}}")
}
