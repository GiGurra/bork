fn empty[T](): List[T] { [] }
fn same[T](a: T, b: T): Bool { a == b }
fn dup[T, T](x: T): T { x }

fn main() {
  // Nothing says what T is.
  e = empty()
  println([])
  f = x => x
  // Wrong argument types.
  println([1, 2].map("nope"), [1].filter(x => x + 1))
  println([1].map((a, b) => a))
  // Lists of different element types.
  mixed = [1, "a"]
  // Lists compare by their elements.
  println([1] == [1])
  // return and ? stay in their function.
  g = [1].map(x => { return 1 })
  h = ["1"].map(s => parseInt(s)?)
  // Calling things that are not functions.
  n = 1
  println(n(2))
  // Generic functions as values need a known type.
  i = empty
}
