type Box[T] = { values: List[T] }
type A = { value: Int }
type B = { value: Int }
type First = sealed { Ready, Fields { value: Int }, Auto { value: Int = 1 } }
type Second = sealed { Ready, Fields { value: Int } }
fn unknown[T](value: Option[T] = .None): Option[T] { value }
fn union[T](first: A | T, other: T) {}
fn main() {
  missing = .{ value: 1 }
  bare = .Ready
  all = [.{ value: 1 }, .{ value: 2 }]
  _: Int = .{ value: 1 }
  _: Box[Int] | Box[String] = .{ values: [] }
  _: A | B = .{ value: 1 }
  _: First | Second = .Ready
  _: First = .Reedy
  _: First | Second = .Reedy
  _: First = .Fields
  _: First = .Auto
  _: Option[Int] = .Some(1)
  _: First = .Fields {}
  _: A = .{ value: 1, value: 2 }
  union(first: .{ value: 1 }, other: B { value: 2 })
}
