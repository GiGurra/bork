type Box[T] = { values: List[T] }
type A = { value: Int }
type B = { value: Int }
type First = sealed { Ready, Fields { value: Int }, Auto { value: Int = 1 } }
type Second = sealed { Ready, Fields { value: Int } }
fn unknown[T](value: Option[T] = .None): Option[T] { value }
fn union[T](first: A | T, other: T) {}
fn main() {
  missing = .{ value: 1 }
  bare = .Ready
  all = [.{ value: 1 }, .{ value: 2 }]
  wrong: Int = .{ value: 1 }
  specialized: Box[Int] | Box[String] = .{ values: [] }
  ambiguous: A | B = .{ value: 1 }
  variants: First | Second = .Ready
  typo: First = .Reedy
  typoUnion: First | Second = .Reedy
  fields: First = .Fields
  defaults: First = .Auto
  call: Option[Int] = .Some(1)
  missingField: First = .Fields {}
  duplicate: A = .{ value: 1, value: 2 }
  union(first: .{ value: 1 }, other: B { value: 2 })
}
