type Problem = { code: Int }
pred Approved(x: Problem) { x.code > 0 }
fn bad(flag: Bool): Int | Problem { if (flag) { Problem { code: 0 } } else { 1 } }
fn approvedSource(): Int | Problem where Approved { 1 }
type Box = { lazy value: Int | Problem }
fn fieldFailure(flag: Bool): Int | Problem where Approved {
  box = Box { value: { _ = bad(flag)?; 1 } }
  box.value?
}
fn fieldReturn(flag: Bool): Int | Problem where Approved {
  box = Box { value: { if (flag) { return Problem { code: 0 } }; 1 } }
  box.value?
}
fn fieldTailPromise(flag: Bool): Int | Problem where Approved {
  box = Box { value: { if (flag) { return Problem { code: 0 } }; approvedSource() } }
  box.value?
}
pred NumericExit(x: Int | Ok) { match (x) { _: Int => true; _: Ok => false } }
fn emptyExit(): Int | Ok {}
type ExitBox = { lazy value: Int | Ok }
fn fieldEmpty(): (Int | Ok) where NumericExit {
  box = ExitBox { value: { _ = emptyExit()?; 1 } }
  box.value?
}
type GenericBox[T] = { lazy value: Int | T | Problem }
fn genericFailure[T](value: T, flag: Bool): Int | T | Problem where Approved {
  box = GenericBox[T] { value: { operand: Int | T | Problem = if (flag) { value } else { 1 }; operand? } }
  box.value?
}
fn main() {}
