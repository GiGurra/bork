import codec "bork/codec"

import "bork/json"
use codec.Defaults
type Empty = {} derive (codec.Decode, codec.Encode)
type Box = { empty: Empty } derive (codec.Decode, codec.Encode)
type EmptyGeneric[T] = {} derive (codec.Decode, codec.Encode)

fn main() {
  println(json.Decode[Empty]("{}"))
  println(json.Decode[Empty]("{\"extra\": 1}"))
  println(json.Decode[Empty]("null"))
  println(json.Decode[Empty]("[]"))
  println(json.Decode[Empty]("1"))
  println(json.Decode[Empty]("\"text\""))
  println(json.Decode[Empty]("true"))
  println(json.Encode(Empty {}))
  println(json.Decode[Empty](match (json.Encode(Empty {})) { text: String => text; error: json.JsonError => { println(error); return } }))
  println(json.Decode[Box]("{\"empty\": {}}"))
  println(json.Decode[Box]("{\"empty\": null}"))
  println(json.Decode[EmptyGeneric[Int]]("{}"))
}
