type Failure = { message: String }
type Success = Int | String
fn checked(x: Int): Success | Failure { Failure { message: "failed" } }
fn listFailure(x: Int): Int | List[Int] { [99] }
fn main() {
  scope s {
    println([spawn(s, () => checked(1))].awaitAllUntil[Success, Failure](s))
    println([spawn(s, () => listFailure(1))].awaitAllUntil[Int, List[Int]](s))
    println(withTimeout(s, 1, child => {}))
  }
}
