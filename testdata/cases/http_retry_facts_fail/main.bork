import "bork/http"
fn main() {
  scope s {
    _ = http.OpenRetryBudget(s, capacity: 0, refill: 1.millis())
    _ = http.OpenRetryBudget(s, capacity: 1, refill: 0.millis())
    budget = http.OpenRetryBudget(s, capacity: 1, refill: 1.millis())
    _ = http.Retry(s, budget, attempt => http.Text(200, "ok"), maxAttempts: 0)
    _ = http.Retry(s, budget, attempt => http.Text(200, "ok"), baseDelay: (-1).millis())
    _ = http.Retry(s, budget, attempt => http.Text(200, "ok"), baseDelay: 20.millis(), maxDelay: 10.millis())
    _ = http.Retry(s, budget, attempt => http.Text(200, "ok"), baseDelay: 2000.millis())
  }
}
