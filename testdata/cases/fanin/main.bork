type Failure = { message: String }
type Event = sealed { Number { value: Int }, Text { value: String }, End, Stopped { reason: String } }

fn numberEvent(value: Int | Cancelled | Closed): Event {
  match (value) {
    n: Int => Event.Number { value: n }
    c: Cancelled => Event.Stopped { reason: c.reason }
    _ => Event.End
  }
}
fn textEvent(value: String | Cancelled | Closed): Event {
  match (value) {
    text: String => Event.Text { value: text }
    c: Cancelled => Event.Stopped { reason: c.reason }
    _ => Event.End
  }
}
fn work(s: Scope, n: Int) uses clock + state: Int | Cancelled {
  delay(s, n)?
  n
}
fn checked(n: Int): Int | Failure {
  if (n == 2) { Failure { message: "two" } } else { n }
}
fn canceledValue(s: Scope): Cancelled { Cancelled { reason: "callback" } }
fn genericUnion[T](value: T): T | Cancelled { value }

fn main() {
  scope s {
    tasks = [spawn(s, () => 1), spawn(s, () => 2)]
    println(tasks.awaitAll())
    empty: List[Task[Int]] = []
    println(empty.awaitAll())
    println(empty.awaitFirst(s))
    fast = spawn(s, () => 7)
    println([fast].awaitFirst(s))
    checkedTasks = [spawn(s, () => checked(1)), spawn(s, () => checked(2))]
    println(checkedTasks.awaitAllUntil[Int, Failure](s))
    println([spawn(s, () => checked(3))].awaitAllUntil[Int, Failure](s))
    println(race(s, [child => 7]))
    println(withTimeout(s, 1000000, child => work(child, 1)))
    println(withTimeout(s, 0, child => 1))
    println(withTimeoutDo(s, 1000000, child => {}))
    println(genericUnion(withTimeout(s, 1000000, canceledValue)).reason)
    timeout: (Scope, Int, (Scope) uses nothing => Cancelled) uses clock + state => Cancelled = withTimeout
    println(timeout(s, 1000000, canceledValue).reason)
    numbers = channel[Int](s, 1)
    words = channel[String](s, 1)
    assertEqual(words.send(s, "hello"), {})
    arms = [numbers.receiveCase(numberEvent), words.receiveCase(textEvent)]
    println(arms.select(s))
    assertEqual(numbers.send(s, 42), {})
    println(arms.select(s))
    words.close()
    println([words.receiveCase(textEvent)].select(s))
    none: List[ReceiveCase[Event]] = []
    println(none.select(s))
  }
}
