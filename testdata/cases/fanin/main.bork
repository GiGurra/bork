type Failure = { message: String }
fn work(s: Scope, n: Int) uses clock + state: Int | Cancelled {
  delay(s, (n).millis())?
  n
}
fn checked(n: Int): Int | Failure {
  if (n == 2) { Failure { message: "two" } } else { n }
}
fn canceledValue(s: Scope): Cancelled { Cancelled { reason: "callback" } }
fn genericUnion[T](value: T): T | Cancelled { value }

fn main() {
  scope s {
    tasks = [fork(s, () => 1), fork(s, () => 2)]
    println(tasks.awaitAll())
    empty: List[Task[Int]] = []
    println(empty.awaitAll())
    println(empty.awaitFirst(s))
    fast = fork(s, () => 7)
    println([fast].awaitFirst(s))
    checkedTasks = [fork(s, () => checked(1)), fork(s, () => checked(2))]
    println(checkedTasks.awaitAllUntil[Int, Failure](s))
    println([fork(s, () => checked(3))].awaitAllUntil[Int, Failure](s))
    println(race(s, [child => 7]))
    println(withTimeout(s, 1000000.millis(), child => work(child, 1)))
    println(withTimeout(s, 0.millis(), child => 1))
    println(withTimeoutDo(s, 1000000.millis(), child => {}))
    println(genericUnion(withTimeout(s, 1000000.millis(), canceledValue)).reason)
    timeout: (Scope, Duration, (Scope) uses nothing => Cancelled) uses clock + state => Cancelled = withTimeout
    println(timeout(s, 1000000.millis(), canceledValue).reason)
  }
}
