import "example.com/assemble-bundles/wiring"
type Config = { name: String }
fn config(): Config { Config { name: "caller config must not be used" } }
fn fake(c: wiring.Config): wiring.Database { wiring.Database { name: s"fake ${c.name}" } }
fn extra(): wiring.Worker { wiring.Worker { name: "standalone" } }
fn recipe(label: String) uses io: () => wiring.Config {
  println(s"evaluate $label")
  () => wiring.Config { name: label }
}
fn databaseRecipe(label: String) uses io: (wiring.Config) => wiring.Database {
  println(s"evaluate $label")
  (c: wiring.Config) => wiring.Database { name: s"$label ${c.name}" }
}
type EvaluationFailure = { name: String }
fn failedRecipe(label: String) uses io: (() => wiring.Config) | EvaluationFailure {
  println(s"evaluate $label")
  EvaluationFailure { name: label }
}
fn evaluate(s: Scope) uses io: wiring.Worker | EvaluationFailure {
  databaseProvider = databaseRecipe("before failure")
  configurationProvider = failedRecipe("failure")?
  assemble[wiring.Worker](s, (configurationProvider, databaseProvider, wiring.Wiring.2))
}
pred positive(n: Int) { n < 0 }
type DbAlias = wiring.Database
fn alias(c: wiring.Config): DbAlias { fake(c) }
fn main() {
  scope app {
    println(assemble[wiring.Secret](app, wiring.Secrets).value)
    println(assemble[wiring.Worker](app, wiring.Wiring))
    println(assemble[wiring.Worker](app, wiring.Wiring))
    println(assembleRecord[wiring.App](app, (wiring.Wiring.0, fake, wiring.Wiring.2)))
    println(assemble[wiring.Worker](app, wiring.Wiring))
    println(assemble[wiring.Worker](app, (wiring.Wiring.0, alias, wiring.Wiring.2)))
    println(assemble[wiring.Good](app, wiring.Facts))
    println(assembleAll[wiring.Worker](app, wiring.RepeatedWorkers, wiring.RepeatedWorkers))
    fixture = wiring.Config { name: "fixture" }
    println(assemble[wiring.Worker](app, (() => fixture, wiring.Wiring.1, wiring.Wiring.2)))
    provider = fake
    println(assemble[wiring.Worker](app, (wiring.Wiring.0, provider, wiring.Wiring.2)))
    println(assembleAll[wiring.Worker](app, wiring.Infrastructure, wiring.Workers, wiring.Extra, extra))
    databaseProvider = databaseRecipe("db")
    configurationProvider = recipe("cfg")
    println(assemble[wiring.Worker](app, (configurationProvider, databaseProvider, wiring.Wiring.2)))
    println(evaluate(app))
  }
}
