import codec "bork/codec"

import "bork/json"
import "bork/env"
import "bork/encoding"
use codec.Defaults
pred positive(x: Int) { x > 0 }
type Level = sealed { Quiet, Loud } derive (codec.Decode, codec.Encode)
type Child = { name: String = "child" } derive (codec.Decode, codec.Encode)
type Options = {
  // Port for incoming traffic.
  // Uses the application default when omitted.
  port: Int where positive = 8080
  verbose: Bool = false
  names: List[String] = ["one", "two"]
  labels: Map[String, Int] = {:}
  child: Child = Child {}
  level: Level = Level.Quiet
  optional: Option[Int] = Option.Some(7)
  required: String
} derive (codec.Decode, codec.Encode)
type Box[T] = { value: T, extras: List[T] = [] } derive (codec.Decode, codec.Encode)
type Choice = sealed { Item { count: Int = 1 }, Empty } derive (codec.Decode, codec.Encode)
fn Schema[T: codec.Decode](): List[String] {
  match (codec.Schema[T]()) {
    Option.Some(info) => info.fields.flatMap(field => {
      docs = if (field.doc != "") { [field.name + ": " + field.doc] } else { [] }
      defaults = match (field.defaultValue) {
        Option.Some(provider) => [field.name + ": " + provider().display]
        Option.None => []
      }
      docs.concat(defaults)
    })
    Option.None => []
  }
}
type CsvDefault = { name: String = "default", value: Int } derive (codec.Decode, codec.Encode)
fn main() uses io {
  println(Options { required: "input" })
  println(Options { required: "input", port: 9090 })
  println(json.Decode[Options]("{\"required\":\"json\"}"))
  println(json.Decode[Options]("{\"required\":\"json\",\"optional\":null}"))
  println(json.Decode[Options]("{\"required\":\"json\",\"port\":0}"))
  println(json.Decode[Box[Int]]("{\"value\":1}"))
  println(Box { value: "generic" })
  println(Choice.Item {})
  println(Schema[Options]())
  println(Schema[Box[Int]]())
  println(env.LoadWith[Child]("", (name) => Option.None))
  println(encoding.DecodeCsv[CsvDefault]("name,value\n,1\n"))
  println(encoding.DecodeCsv[Options]("required\nfrom-csv\n"))
}
