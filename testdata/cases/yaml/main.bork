import codec "bork/codec"
import "bork/encoding"
import "bork/fs"
import "bork/yaml"
use codec.Defaults

type Server = { name: String, port: Int, tags: List[String] } derive (codec.Decode)

fn show(result: codec.Value | yaml.Error) uses io {
  match (result) {
    value: codec.Value => println(value)
    error: yaml.Error => println(s"error ${error.line}:${error.column}: ${error.message}")
  }
}

fn render(result: String | yaml.Error) uses io {
  match (result) {
    text: String => println(text.trim())
    error: yaml.Error => println(s"error: ${error.message}")
  }
}

fn files(s: Scope) uses io: Ok | IoError | fs.NotFound | fs.PermissionDenied | fs.Exists | yaml.Error {
  root = fs.DirectoryPath(fs.TempDir(s)?)
  path = fs.Join([root, "config.yaml"])
  yaml.WriteFile(path, codec.Value.Object { fields: [codec.Field { name: "name", value: codec.Value.String { value: "bork" } }, codec.Field { name: "port", value: codec.Value.Number { text: "8080" } }, codec.Field { name: "tags", value: codec.Value.Array { items: [] } }] })?
  value = yaml.ReadFile(path)?
  println(codec.decode[Server](value))
  match (yaml.ReadAllFile(fs.Join([root, "missing.yaml"]))) {
    IoError => println("missing file is an IoError")
    _ => println("unexpected")
  }
  match (yaml.WriteFile(path, codec.Value.Number { text: "x" })) {
    error: yaml.Error => println(error.path == path && error.message == "invalid number text \"x\"")
    _ => println("unexpected")
  }
  bad = fs.Join([root, "bad.yaml"])
  fs.Write(bad, encoding.Utf8("a: [1\n"))?
  match (yaml.ReadFile(bad)) {
    error: yaml.Error => println(error.path == bad && error.line == 2)
    _ => println("unexpected")
  }
}

fn main() {
  config = "name: bork\nport: 0x1F90\nratio: .5\ntags: [a, 'b']\nenabled: true\nnothing: ~\nwhen: 2026-10-05\nbig: 12345678901234567890\n"
  show(yaml.Parse(config))
  match (yaml.Parse(config)) {
    value: codec.Value => {
      println(yaml.At(value, ["tags", 1]))
      println(yaml.Field(value, "missing"))
      render(yaml.Render(value))
      render(yaml.Render(value, 4))
    }
    error: yaml.Error => println(error)
  }
  // Aliases, merge keys and multiple documents.
  show(yaml.Parse("base: &b {x: 1, y: 2}\nderived:\n  <<: *b\n  y: 3\n  z: *b\n"))
  match (yaml.ParseAll("a: 1\n---\n- 2\n---\n")) {
    values: List[codec.Value] => {
      println(values)
      render(yaml.RenderAll(values))
    }
    error: yaml.Error => println(error)
  }
  show(yaml.Parse(""))
  show(yaml.Parse("one\n---\ntwo\n"))
  // Rejected input.
  show(yaml.Parse("a: 1\nb: [x, y\n"))
  show(yaml.Parse("a: 1\na: 2\n"))
  show(yaml.Parse("a: !!binary aGk=\n"))
  show(yaml.Parse("a: !custom x\n"))
  show(yaml.Parse("a: .inf\n"))
  show(yaml.Parse("? [1]\n: x\n"))
  show(yaml.Parse("&a [*a]\n"))
  show(yaml.Parse("a: &a [x, x, x, x, x, x, x, x, x, x]\nb: &b [*a, *a, *a, *a, *a, *a, *a, *a, *a, *a]\nc: &c [*b, *b, *b, *b, *b, *b, *b, *b, *b, *b]\nd: &d [*c, *c, *c, *c, *c, *c, *c, *c, *c, *c]\ne: [*d, *d, *d, *d, *d, *d, *d, *d, *d, *d]\n"))
  // Merges through a sequence alias count toward the alias bound.
  show(yaml.Parse("&s [{<<: *s}]\n"))
  show(yaml.Parse(range(1, 40).map(k => s"s$k: &s$k [{<<: *s${k - 1}}, {<<: *s${k - 1}}]").fold("s0: &s0 [{a: 1}]", (text, line) => text + "\n" + line)))
  // Merge precedence: own keys, then earlier merges.
  show(yaml.Parse("a: &a {x: 1, y: 1}\nb: &b {x: 2, z: 2}\nc: &c [*a, *b]\nd:\n  y: 3\n  <<: *c\n"))
  show(yaml.Parse("a: &a {x: 1}\nb:\n  <<: *a\n  <<: *a\n"))
  show(yaml.Parse("a: &a [1]\nb:\n  <<: *a\n"))
  show(yaml.Parse("k: &k name\n*k : 1\n"))
  show(yaml.Parse("&s {<<: *s}\n"))
  show(yaml.Parse("b:\n  <<: {a: 1}\n  \"\\0merge\": 2\n  \"<<\": 3\n"))
  show(yaml.Parse("a: {<<: {}}\n"))
  show(yaml.Parse("a: {<<: []}\n"))
  show(yaml.Parse("!!int abc: 1\n"))
  // Integer and float forms.
  show(yaml.Parse("[0o17, 0b101, 1_000, -0x1F, 017, -.5, 1., -0, 1e-400, 1_0.5, +0x1F]\n"))
  show(yaml.Parse("0x10: a\n16: b\n.inf: c\n"))
  show(yaml.Parse("!!float 1e400\n"))
  show(yaml.Parse("!!int 0x-1\n"))
  show(yaml.Parse(".NaN\n"))
  show(yaml.Parse("[!!int -0, !!float .5e-400]\n"))
  show(yaml.Parse("!!float 0x1p3\n"))
  show(yaml.Parse("!!int _1\n"))
  show(yaml.Parse("!!float 1__0\n"))
  show(yaml.Parse("# only a comment\n"))
  show(yaml.Parse("---\n"))
  match (yaml.ParseAll("a: 1\n---\nb: [\n")) {
    values: List[codec.Value] => println(values)
    error: yaml.Error => println(s"error ${error.line}:${error.column}: ${error.message}")
  }
  // Rendered numbers read back unchanged.
  numbers = codec.Value.Array { items: ["1e5", "-0", "1E+5", "-1.5e-300", "12345678901234567890", "0.1"].map(text => codec.Value.Number { text: text }) }
  match (yaml.Render(numbers)) {
    text: String => show(yaml.Parse(text))
    error: yaml.Error => println(error)
  }
  render(yaml.Render(codec.Value.Number { text: "-1e400" }))
  // Strings that look like other scalars are quoted on output.
  render(yaml.Render(codec.Value.Array { items: [codec.Value.String { value: "true" }, codec.Value.String { value: "1.5" }, codec.Value.String { value: "" }, codec.Value.String { value: "line\nbreak\n" }, codec.Value.Object { fields: [] }] }))
  render(yaml.Render(codec.Value.Object { fields: [codec.Field { name: "n", value: codec.Value.Array { items: [codec.Value.Number { text: "1,2" }] } }] }))
  render(yaml.Render(codec.Value.Object { fields: [codec.Field { name: "x", value: codec.Value.Null }, codec.Field { name: "x", value: codec.Value.Null }] }))
  scope s { println(files(s)) }
}
