type Failed = { why: String }

fn step(ok: Bool) uses io: Ok | Failed {
  if (ok) { println("step ok") } else { Failed { why: "nope" } }
}

fn both(a: Bool, b: Bool) uses io: Ok | Failed {
  step(a)?
  step(b)?
}

fn scoped() uses io: Ok | Failed {
  scope s {
    step(true)?
    println("in scope")
  }
}

fn main() {
  println(both(true, true))
  println(both(true, false))
  r = both(false, true)
  match (r) {
    f: Failed => println(s"failed: ${f.why}")
    _ => println("fine")
  }
  println(scoped())
}
