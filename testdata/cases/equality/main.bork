type NotFound = { key: String }
fn find(k: String): Int | NotFound { if (k == "a") { 1 } else { NotFound { key: k } } }
fn unions() uses io {
  println(find("a") == 1)
  println(1 == find("a"))
  println(find("b") == NotFound { key: "b" })
  println(find("b") != 1)
  r: List[Int] | NotFound = [1]
  println(r == [1])
}

// Lists, and records holding them, compare structurally.
type P = { xs: List[Int], name: String }
type S = sealed { A { xs: List[Int] }, B }

fn same[T: Eq](a: T, b: T): Bool { a == b }

fn main() {
  unions()
  println([1, 2] == [1, 2])
  println([1, 2] != [1, 3])
  println(P { xs: [1], name: "a" } == P { xs: [1], name: "a" })
  println(same(S.A { xs: [] }, S.A { xs: [] }))
  println(same(Option.Some { value: [1] }, Option.None))
  println(distinct([3, 1, 3, 2, 1]))
  println(includes([[1], [2]], [2]))
  println(equals(1, 1))
}

test "lists compare by their elements" {
  assertEqual([[1, 2], []], [[1, 2], []])
  assert(P { xs: [], name: "a" } != P { xs: [1], name: "a" })
}
