type User = { name: String, age: Int }

// Generic predicates apply to every type they fit.
pred shortList[T](xs: List[T]) { length(xs) <= 3 }
pred adult(u: User) { u.age >= 18 }

fn firstOfFew[T](xs: List[T] where shortList and notEmpty): T { first(xs) }

fn greet(u: User where adult): String { s"hello ${u.name}" }

// The prelude's notEmpty and first: no Option needed once it is known.
fn biggest(xs: List[Int] where notEmpty): Int {
  fold(xs, first(xs), (best, x) => if (x > best) { x } else { best })
}

fn describe(xs: List[Int]): String {
  if (notEmpty(xs)) { s"biggest ${biggest(xs)}" } else { "empty" }
}

// A package's own isEmpty does not change what the prelude's notEmpty
// means.
fn isEmpty(s: String): Bool { byteLength(s) == 0 }

fn main() {
  // Literals are checked at compile time, also lists and records.
  println(firstOfFew([1, 2]), firstOfFew(["a"]), biggest([3, 9, 4]))
  println(greet(User { name: "ann", age: 30 }))
  println(describe([]), describe([5, 1]), isEmpty(""))
  // Lists built by prepend, append, and split are known not to be empty.
  println(first(prepend(0, [])), first(split("a,b", ",")))
}
