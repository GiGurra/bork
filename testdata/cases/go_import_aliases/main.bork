import "bork/rand"
import "bork/crypto"
fn integer() uses io: Int unsafe go {
  import other "strconv"
  n, _ := other.ParseInt("42", 10, 64)
  return n
}
// A body's alias remains visible to the rest of its Bork file.
fn formatted(): String unsafe go { return other.FormatInt(7,10) }
fn shadowed(): Int unsafe go {
  other := struct { ParseInt func(string,int,int)(int64,error) }{ParseInt:func(string,int,int)(int64,error){return 99,nil}}
  n,_ := other.ParseInt("",10,64)
  return n
}
fn main() {
  println(integer(), formatted(), shadowed(), otherFile(), declaredName(), parameter(Number { value: 88 }), with (timer: Number { value: 89 }) { needed() })
  println(rand.IntBetween(0, 1))
  match (crypto.RandomBytes(0)) { bytes: Bytes => println(bytes.length()), error => panic(toString(error)) }
}
fn declaredName(): Int unsafe go {
  import "example.com/bindtest/pathname"
  return differentlyNamed.Value
}

type Number = { value: Int }
fn parameter(other: Number): Int unsafe go { return other.value }

ambient timer: Number
fn needed() needs timer: Int unsafe go { return timer.value }

fn stamped() uses clock: Int unsafe go {
  import timer "time"
  return timer.Now().UnixNano()
}
