import codec "bork/codec"
use codec.Defaults

type NativeDuration = go "time.Duration"
type Box[T] = { value: T }
instance encodeBox[T]: codec.Encode[Box[T]] {
  fn encode(x: Box[T]): codec.Value { codec.Value.Null }
}
fn EncodeIt(v: NativeDuration): codec.Value { codec.encode(Box { value: v }) }
fn main() {}
