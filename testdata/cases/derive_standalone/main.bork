import "bork/codec"

import "bork/json"
use codec.Defaults

derive codec.Decode for Alias
derive codec.Encode for Config
derive codec.Decode for Box
derive codec.Encode for Box
derive codec.Decode for Special[Int]
derive codec.Encode for Mode
derive codec.Decode for Mode

fn main() {
  println(json.Decode[Alias]("{}"))
  println(json.Decode[Alias]("{\"port\":0}"))
  println(json.Encode(Config { port: 42 }))
  println(json.Decode[Box[String]]("{\"value\":\"ok\"}"))
  println(json.Encode(Box { value: 3 }))
  println(json.Decode[Special[Int]]("{\"value\":9}"))
  println(json.Decode[Mode](json.Encode(Mode.Slow { delay: 2 })))
}
