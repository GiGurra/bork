import "bork/tasks"

fn mustTask[T](result: Task[T] | tasks.TaskLimitReached | Cancelled): Task[T] {
  match (result) {
    task: Task[T] => task
    error: tasks.TaskLimitReached | Cancelled => panic(toString(error))
  }
}
fn main() {
  okTaskRan = atom(false)
  scope app {
    pool = tasks.Open(app, maxTasks: 1)
    gate = channel[Bool](app, 0)
    calls = atom(0)
    first = mustTask(tasks.TryFork(pool, app, () => {
      _ = gate.receive(app)
      42
    }))
    println(tasks.TryFork(pool, app, () => update(calls, n => n + 1)))
    println(tasks.TryFork(pool, app, () => { _ = update(calls, n => n + 1) }))
    println("rejected callbacks", current(calls))
    scope cancelledRequest {
      cancel(cancelledRequest)
      println(tasks.TryFork(pool, cancelledRequest, () => 1))
    }
    _ = gate.send(app, true)
    println("joined", await(first))
    second = mustTask(tasks.TryFork(pool, app, () => toString(tasks.TryFork(pool, app, () => {}))))
    println("nested submission", await(second))
    match (tasks.TryFork(pool, app, () => { _ = update(okTaskRan, old => true) })) {
      e: tasks.TaskLimitReached | Cancelled => panic(toString(e))
      _ => {}
    }
    // Joining this ordinary task does not consume pool capacity.
    println(await(fork(app, () => "ordinary fork unchanged")))
  }
  println("Ok task joined", current(okTaskRan))
  scope app {
    pool = scope setup { attach(tasks.Open(setup, 1), app) }
    scope request {
      println("attached pool", await(mustTask(tasks.TryFork(pool, request, () => 7))))
    }
    scope failed with logFailures() {
      _ = tasks.TryFork(pool, failed, () => panic("task failed"))
    }
    scope afterFailure {
      println("slot after panic", await(mustTask(tasks.TryFork(pool, afterFailure, () => 9))))
    }
  }
  scope app {
    pool = tasks.Open(app, 3)
    gate = channel[Bool](app, 0)
    submitters = range(0, 20).map(i => fork(app, () => {
      match (tasks.TryFork(pool, app, () => { _ = gate.receive(app); i })) {
        _: Task[Int] => true
        _: tasks.TaskLimitReached => false
        error: Cancelled => panic(toString(error))
      }
    }))
    admitted = submitters.map(await).count(x => x)
    println("concurrent capacity", admitted)
    range(0, admitted).forEach(i => { _ = gate.send(app, true) })
  }

  scope app {
    pool = tasks.Open(app, 1)
    gate = channel[Bool](app, 0)
    scope request {
      // The callback ignores request cancellation: only the parent-scoped
      // gate releases it, so it must retain its slot until the explicit send.
      task = mustTask(tasks.TryFork(pool, request, () => { _ = gate.receive(app); 11 }))
      cancel(request)
      println("cancelled task holds slot", tasks.TryFork(pool, app, () => {}))
      _ = gate.send(app, true)
      println("uncooperative task joined", await(task))
    }
    println("slot after cancellation", await(mustTask(tasks.TryFork(pool, app, () => 12))))
  }

}
