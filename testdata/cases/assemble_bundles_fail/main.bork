type Config = { name: String }
type Database = { name: String }
fn config(): Config { Config { name: "real" } }
fn database(c: Config): Database { Database { name: c.name } }
fn fake(): Database { Database { name: "fake" } }
fn number(): Int { 1 }
Wiring = (config, database)
Configs = (config,)
type A = {}
type B = {}
fn a(dependency: B): A { A {} }
fn b(dependency: A): B { B {} }
Cycle = (a, b)
fn main() {
  scope app {
    println(assemble[Database](app, (Wiring.0, fake)))
    println(assemble[Database](app, Wiring(unknown: fake)))
    println(assemble[Database](app, Wiring(database: fake, database: database)))
    println(assemble[Database](app, Wiring(database)))
    println(assemble[Database](app, Wiring[Int]()))
    println(assemble[Database](app, (Wiring.0, number)))
    println(assemble[Database](app, Wiring, Configs))
    value = Wiring
    println(value)
    Wiring
    println(assemble[A](app, Cycle))
  }
}
