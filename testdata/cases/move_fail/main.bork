type Conn = resource

fn connect(name: String, s: Scope) uses io: Conn unsafe go {
  return Conn{handle: name, owner: s.Own(func() {})}
}

fn query(c: Conn, q: String): String unsafe go {
  return q
}

fn other(a: Conn, b: Conn): Conn { b }

fn pair(a: Conn, b: Conn): String unsafe go {
  return ""
}

fn keep(c: Conn in ch, ch: Channel[Conn]) uses state {
  _ = send(ch, c)
}

fn rewrap(c: Conn, s: Scope): Conn { c }

fn pumped(s: Scope) uses io: Conn {
  c = connect("p", s)
  launch(s, () => println(query(c, "pump")))
  c
}

type Holder = { conn: Conn }

// It may make a new value of T with make: what it gives is borrowed.
fn made[T](make: () => T): T {
  make()
}

fn borrowed(c: Conn, w: Scope) {
  _ = move(c, w)
}

fn main() {
  scope app {
    scope s {
      a = connect("a", s)
      holder = Holder { conn: a }
      f = () => query(a, "f")
      moved = move(a, app)
      println(query(a, "after"))
      println(query(holder.conn, "holder"))
      println(f())
      println(query(moved, "ok"))
    }
    scope s {
      b = connect("b", s)
      if (query(b, "x") != "") {
        _ = move(b, app)
      }
      println(query(b, "maybe"))
    }
    scope s {
      c = connect("c", s)
      launch(s, () => println(query(c, "task")))
      _ = move(c, app)
    }
    scope s {
      ch = channel[Conn](s, 1)
      d = connect("d", s)
      _ = send(ch, d)
      _ = move(d, app)
      e = connect("e", s)
      keep(e, ch)
      _ = move(e, app)
      got = receive(ch)
      match (got) {
        r: Conn => { _ = move(r, app) }
        _ => {}
      }
    }
    scope s {
      decoy = connect("decoy", s)
      g = connect("g", app)
      x = other(decoy, g)
      _ = move(x, s)
      y = rewrap(decoy, s)
      _ = move(y, app)
      w = made(() => decoy)
      _ = move(w, app)
      z = pumped(s)
      _ = move(z, app)
    }
    scope s {
      h = connect("h", s)
      _ = move(h, s)
      i = connect("i", s)
      j = connect("j", app)
      k = if (query(i, "") != "") { i } else { j }
      _ = move(k, app)
      l = connect("l", s)
      later = () => move(l, app)
      [1, 2].forEach(n => {
        _ = move(l, app)
      })
      m = connect("m", s)
      for (n in [1, 2]) {
        _ = move(m, app)
      }
      o = connect("o", s)
      mv: (Conn, Scope) => Conn = move
      println(pair(o, move(o, app)))
      p = connect("p", s)
      println(pair(b: p, a: move(p, app)))
    }
  }
}
