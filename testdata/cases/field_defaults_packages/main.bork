import codec "bork/codec"
import "bork/json"
import "example.com/defaults/api"
use codec.Defaults
use api.ItemDecode
use api.BoxDecode
fn main() uses io {
  println(api.Item {})
  println(json.Decode[api.Item]("{}"))
  println(api.Box { value: 1 })
  println(json.Decode[api.Box[String]]("{\"value\":\"generic\"}"))
}
