import "bork/process"
import "bork/env"

fn executable() uses io: String unsafe go {
  import "os"
  path, err := os.Executable()
  if err != nil { panic(err) }
  return path
}
fn input() uses io: String unsafe go {
  import "io"
  import "os"
  data, err := io.ReadAll(os.Stdin)
  if err != nil { panic(err) }
  return string(data)
}
fn childSleep() uses clock unsafe go {
  import "time"
  time.Sleep(time.Hour)
}
fn marker(s: Scope) uses io: String unsafe go {
  import "os"
  f, err := os.CreateTemp("", "bork-process-ready-*")
  if err != nil { panic(err) }
  f.Close()
  s.Defer(func() { os.Remove(f.Name()) })
  return f.Name()
}
fn ready(path: String) uses io unsafe go {
  import "os"
  if err := os.WriteFile(path, []byte("ready"), 0600); err != nil { panic(err) }
}
fn waitReady(path: String) uses io + clock unsafe go {
  import "os"
  import "time"
  for i := 0; i < 500; i++ {
    if data, _ := os.ReadFile(path); len(data) > 0 { return }
    time.Sleep(10*time.Millisecond)
  }
  panic("child readiness timeout")
}
fn signalChild(pid: Int, interrupt: Bool) uses io unsafe go {
  import "os"
  import "syscall"
  p, err := os.FindProcess(int(pid))
  if err != nil { panic(err) }
  signal := syscall.SIGTERM
  if interrupt { signal = syscall.SIGINT }
  if err := p.Signal(signal); err != nil { panic(err) }
}
fn signalTest(s: Scope, interrupt: Bool) uses io + state + clock: Ok | IoError | Cancelled {
  path = marker(s)
  child = process.Start(s, executable(), ["signal-server", path])?
  waitReady(path)
  signalChild(process.Pid(child), interrupt)
  output = process.Await(child)?
  expected = if (interrupt) { 130 } else { 143 }
  println(output.code == expected)
  println(utf8String(output.stdout))
}
fn server(path: String) uses io + state + clock {
  scope child {
    onClose(child, () => println("closed"))
    ready(path)
    println(match (delay(child, 60000)) {
      done: Ok => false
      stopped: Cancelled => true
    })
  }
}
fn cwd() uses io: String unsafe go {
  import "os"
  path, err := os.Getwd()
  if err != nil { panic(err) }
  return path
}
fn markerDir(path: String): String unsafe go {
  import "path/filepath"
  return filepath.Dir(path)
}
fn gone(pid: Int) uses io: Bool unsafe go {
  import "os"
  import "syscall"
  p, err := os.FindProcess(int(pid))
  return err != nil || p.Signal(syscall.Signal(0)) != nil
}
fn abandoned() uses io + state: Int | IoError | Cancelled {
  scope child {
    proc = process.Start(child, executable(), ["sleep"])?
    process.Pid(proc)
  }
}
fn attached(s: Scope) uses io + state: process.Process | IoError | Cancelled {
  scope child {
    proc = process.Start(child, executable(), ["sleep"])?
    attach(proc, s)
  }
}
fn millis() uses clock: Int unsafe go {
  import "time"
  return time.Now().UnixMilli()
}
fn inheritedPipes(s: Scope) uses io + state + clock: Ok | IoError | Cancelled {
  path = marker(s)
  child = process.Start(s, "/bin/sh", ["-c", "sleep 3 & echo ready > \"$1\"; wait", "bork-test", path])?
  waitReady(path)
  start = millis()
  process.Stop(child)
  println(match (process.Await(child)) {
    stopped: Cancelled => true
    _ => false
  })
  println(millis() - start < 2500)
  start2 = millis()
  println(match (process.Run(s, "/bin/sh", ["-c", "sleep 3 & exit 0"])) {
    error: IoError => error.path == "/bin/sh"
    _ => false
  })
  println(millis() - start2 < 2500)
  println(match (process.Run(s, "/bin/sh", ["-c", "sleep 3 & exit 7"])) {
    result: process.Result => result.code == 7
    _ => false
  })
}
fn descendantPid(path: String) uses io: Int unsafe go {
  import "os"
  import "strconv"
  import "strings"
  data, err := os.ReadFile(path)
  if err != nil { panic(err) }
  pid, err := strconv.ParseInt(strings.TrimSpace(string(data)), 10, 64)
  if err != nil { panic(err) }
  return pid
}
fn descendantGone(pid: Int) uses io + clock: Bool unsafe go {
  import "os"
  import "strconv"
  import "strings"
  import "syscall"
  import "time"
  for i := 0; i < 500; i++ {
    if syscall.Kill(int(pid), 0) == syscall.ESRCH { return true }
    // On Linux an orphan can remain a zombie until the host's init reaps it.
    data, err := os.ReadFile("/proc/" + strconv.FormatInt(pid, 10) + "/stat")
    if err == nil {
      _, state, found := strings.Cut(string(data), ") ")
      if found && strings.HasPrefix(state, "Z ") { return true }
    }
    time.Sleep(10*time.Millisecond)
  }
  syscall.Kill(int(pid), syscall.SIGKILL)
  return false
}
fn groupCancellation(s: Scope) uses io + state + clock: Ok | IoError | Cancelled {
  path = marker(s)
  child = process.Start(s, "/bin/sh", ["-c", "sleep 60 & echo $! > \"$1\"; wait", "bork-test", path])?
  waitReady(path)
  pid = descendantPid(path)
  process.Stop(child)
  _ = process.Await(child)
  println(descendantGone(pid))
  path2 = marker(s)
  pid2 = scope owner {
    _ = process.Start(owner, "/bin/sh", ["-c", "sleep 60 & echo $! > \"$1\"; wait", "bork-test", path2])?
    waitReady(path2)
    descendantPid(path2)
  }
  println(descendantGone(pid2))
}
fn parentEnv() uses io unsafe go {
  import "os"
  if err := os.Setenv("BORK_PROCESS_TEST", "parent"); err != nil { panic(err) }
}
fn exercise(s: Scope) uses io + state + clock: Ok | IoError | Cancelled {
  parentEnv()
  output = process.Run(s, executable(), ["child"], Option.Some { value: ["BORK_PROCESS_TEST=ok"] }, "", Option.Some { value: utf8Bytes("input") })?
  println(output.code)
  println(utf8String(output.stdout))
  println(utf8String(output.stderr))
  child = process.Start(s, executable(), ["child"], Option.Some { value: [] })?
  first = process.Await(child)?
  second = process.Await(child)?
  println(first == second)
  println(process.Pid(child) > 0)
  directory = markerDir(marker(s))
  located = process.Run(s, executable(), ["cwd"], Option.None, directory)?
  println(utf8String(located.stdout) == directory + "\n")
  inherit = process.Run(s, executable(), ["child"])?
  println(utf8String(inherit.stdout) == "Option.Some { value: \"parent\" }\n\n")
  println(utf8String(first.stdout) == "Option.None\n\n")
  abandonedPid = abandoned()?
  println(gone(abandonedPid))
  shared = attached(s)?
  println(!gone(process.Pid(shared)))
  process.Stop(shared)
  println(match (process.Await(shared)) {
    result: process.Result => false
    error: IoError => false
    stopped: Cancelled => true
  })
  inheritedPipes(s)?
  groupCancellation(s)?
  signalTest(s, false)?
  signalTest(s, true)?
  stopped = process.Start(s, executable(), ["sleep"])?
  process.Stop(stopped)
  println(match (process.Await(stopped)) {
    result: process.Result => false
    error: IoError => false
    cancelled: Cancelled => true
  })
  println(match (process.Run(s, "/definitely/no/bork-executable")) {
    result: process.Result => false
    error: IoError => error.path == "/definitely/no/bork-executable"
    cancelled: Cancelled => false
  })
}
fn main() {
  match (process.Args()) {
    ["child"] => {
      println(env.Get("BORK_PROCESS_TEST"))
      println(input())
      eprintln("stderr")
      process.Exit(7)
    }
    ["sleep"] => childSleep()
    ["cwd"] => println(cwd())
    ["signal-server", path] => server(path)
    _ => {
      result = scope s { exercise(s) }
      match (result) {
        done: Ok => println("ok")
        error: IoError => println(error)
        cancelled: Cancelled => println(cancelled)
      }
    }
  }
}
