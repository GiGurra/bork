import "bork/regex"

fn accepted(re: regex.Regex, text: String where regex.Matches(re)): String { text }
fn checked(pattern: String): regex.Regex | ParseError {
  if (regex.ValidPattern(pattern)) { regex.Compile(pattern) } else { ParseError { input: pattern, message: "invalid pattern" } }
}
fn main() {
  re = regex.Compile("(?P<word>[a-z]+)([0-9]+)?")
  println(re.Pattern())
  println(re.Matches("abc123"))
  println(re.Find("12"))
  println(re.FindAll("é abc123 xyz"))
  println(re.FindAll("abc xyz", 1))
  println(re.FindAll("abc xyz", 0))
  println(re.Replace("abc123 xyz", "${word}!"))
  println(re.ReplaceLiteral("abc123 xyz", "$word"))
  println(regex.Compile(",").Split("a,b,c"))
  println(regex.Compile(",").Split("a,b,c", 2))
  println(regex.Compile(",").Split("a,b,c", 0))
  println(regex.Compile("(?P<absent>a)?(?P<empty>)").Find(""))
  println(regex.Compile("(?P<same>a)(?P<same>b)").Find("ab"))
  println(regex.Compile("(a)(b)").Replace("ab", "${2}${1}"))
  println(regex.Compile("").FindAll("éa"))
  println(match (regex.Parse("[")) { error: ParseError => error.input == "["; _ => false })
  println(checked("[a-z]+"))
  println(checked("["))
  text = "abc"
  if (regex.Matches(text, re)) { println(accepted(re, text)) }
}
