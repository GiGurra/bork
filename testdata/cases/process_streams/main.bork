import "bork/encoding"
import "bork/fs"
import "bork/process"
import "bork/time"

fn shell(s: Scope, script: String, stdin: process.Input in s = .Empty, stdout: process.Output = .Capture, stderr: process.ErrorOutput = .Capture) uses io + state: process.Result | IoError | Cancelled {
  process.Run(s, "/bin/sh", ["-c", script], stdin: stdin, stdout: stdout, stderr: stderr)
}

fn waitReady(path: String) uses io + clock unsafe go {
  import "os"
  import "time"
  // The marker file is the readiness signal; the deadline only guards hangs.
  for deadline := time.Now().Add(time.Minute); time.Now().Before(deadline); {
    if data, _ := os.ReadFile(path); len(data) > 0 { return }
    time.Sleep(10*time.Millisecond)
  }
  panic("child readiness timeout")
}

fn streams(s: Scope, directory: String) uses io + state: Ok | IoError | Cancelled | fs.Error {
  separate = shell(s, "echo out; echo err >&2; echo out2")?
  println(separate.StdoutText() == "out\nout2\n" && separate.StderrText() == "err\n")
  combined = shell(s, "echo one; echo two >&2; echo three; echo four >&2", stderr: .Stdout)?
  println(combined.StdoutText() == "one\ntwo\nthree\nfour\n" && combined.StderrText() == "")
  // Forwarded output goes straight to this program's stdout and stderr.
  _ = shell(s, "echo forwarded out; echo forwarded err >&2", stdin: .Inherit, stdout: .Inherit, stderr: .Inherit)?
  _ = shell(s, "echo merged err >&2", stdout: .Inherit, stderr: .Stdout)?
  quiet = shell(s, "echo hidden; echo shown >&2", stdout: .Discard, stderr: .Inherit)?
  println(quiet.StdoutText() == "" && quiet.StderrText() == "")
  sorted = process.Run(s, "sort", stdin: .Text { text: "b\nc\na\n" })?
  println(sorted.StdoutText() == "a\nb\nc\n")
  counted = process.Run(s, "wc", ["-c"], stdin: .Data { data: encoding.Utf8("12345") })?
  println(counted.StdoutText().trim() == "5")
  path = fs.Join([directory, "log.txt"])
  _ = shell(s, "echo first", stdout: .File { path: path })?
  _ = shell(s, "echo second; echo third >&2", stdout: .Append { path: path }, stderr: .Stdout)?
  println(encoding.ParseUtf8(fs.Read(path)?))
  copied = process.Run(s, "cat", stdin: .File { path: path })?
  println(copied.StdoutText() == "first\nsecond\nthird\n")
  errors = fs.Join([directory, "errors.txt"])
  _ = shell(s, "echo kept; echo logged >&2", stderr: .File { path: errors })?
  println(encoding.ParseUtf8(fs.Read(errors)?))
  println(match (shell(s, "true", stdin: .File { path: fs.Join([directory, "missing"]) })) {
    error: IoError => error.path.endsWith("missing")
    _ => false
  })
  println(match (shell(s, "true", stdout: .File { path: fs.Join([directory, "no", "such", "dir"]) })) {
    error: IoError => error.path.endsWith("dir")
    _ => false
  })
}

fn statuses(s: Scope) uses io + state: Ok | IoError | Cancelled {
  failed = shell(s, "echo partial; echo first problem >&2; echo bad input >&2; exit 3")?
  println(failed.code)
  println(failed.status)
  println(failed.Success())
  println(match (failed.Check()) {
    error: process.ExitError => error.message
    _: process.Result => "unexpected"
  })
  ok = shell(s, "echo fine")?.Check()
  println(match (ok) {
    result: process.Result => result.StdoutText()
    error: process.ExitError => error.message
  })
  killed = shell(s, "kill -9 $$")?
  println(killed.code)
  println(killed.status)
  println(match (killed.Check()) {
    error: process.ExitError => error.message
    _: process.Result => "unexpected"
  })
}

fn handles(s: Scope, directory: String) uses io + state + clock: Ok | IoError | Cancelled {
  slow = process.Start(s, "/bin/sh", ["-c", "sleep 5"])?
  println(slow.TryWait() == .None)
  slow.Kill()
  println(slow.Wait()?.status)
  println(match (slow.TryWait()) {
    Option.Some { value: _ } => true
    Option.None => false
  })
  ready = fs.Join([directory, "ready"])
  trapped = process.Start(s, "/bin/sh", ["-c", "trap 'echo got usr1; exit 4' USR1; echo ready > \"$1\"; while true; do sleep 0.05; done", "sh", ready])?
  waitReady(ready)
  trapped.Signal(.User1)?
  done = trapped.Wait()?
  println(done.code)
  println(done.StdoutText())
  graceful = fs.Join([directory, "graceful"])
  terminated = process.Start(s, "/bin/sh", ["-c", "trap 'echo cleaned up; exit 0' TERM; echo ready > \"$1\"; while true; do sleep 0.05; done", "sh", graceful])?
  waitReady(graceful)
  terminated.Stop()
  println(terminated.Wait()?.StdoutText())
  // Signals after exit do nothing.
  println(match (terminated.Signal(.User1)) {
    _: Ok => true
    _: IoError => false
  })
}

fn settle(s: Scope, child: process.Process) uses io + state + clock: process.Result | IoError | Cancelled {
  match (child.TryWait()) {
    Option.Some { value } => value
    Option.None => {
      delay(s, 10)?
      settle(s, child)
    }
  }
}

fn millis() uses clock: Int unsafe go {
  import "time"
  return time.Now().UnixMilli()
}

// Captured output drains without a reader, and stubborn children are killed.
fn robustness(s: Scope, directory: String) uses io + state + clock: Ok | IoError | Cancelled | fs.Error {
  loud = process.Start(s, "head", ["-c", "1048576", "/dev/zero"])?
  println(settle(s, loud)?.stdout.length())
  both = process.Start(s, "/bin/sh", ["-c", "head -c 1048576 /dev/zero; head -c 1048576 /dev/zero >&2"], stderr: .Stdout)?
  println(settle(s, both)?.stdout.length())
  big = process.Run(s, "wc", ["-c"], stdin: .Text { text: "x".repeat(1048576) })?
  println(big.StdoutText().trim())
  silent = shell(s, "echo out; echo err >&2", stdout: .Discard, stderr: .Stdout)?
  println(silent.stdout.length() + silent.stderr.length())
  path = fs.Join([directory, "errors-append.txt"])
  _ = shell(s, "echo one >&2", stderr: .Append { path: path })?
  _ = shell(s, "echo two >&2", stderr: .Append { path: path })?
  println(encoding.ParseUtf8(fs.Read(path)?))
  ready = fs.Join([directory, "stubborn"])
  stubborn = process.Start(s, "/bin/sh", ["-c", "trap '' TERM; echo ready > \"$1\"; while true; do sleep 0.05; done", "sh", ready])?
  waitReady(ready)
  start = millis()
  stubborn.Stop(time.Duration { nanos: 200_000_000 })
  println(stubborn.Wait()?.status)
  // Without escalation the child would never exit; the bound only guards that.
  println(millis() - start < 10000)
  // Cancel only once the child ignores SIGTERM, so SIGKILL is what ends it.
  deaf = fs.Join([directory, "deaf"])
  escalated = scope patient {
    launch(patient, () => {
      waitReady(deaf)
      cancelAfter(patient, 0)
    })
    process.Run(patient, "/bin/sh", ["-c", "trap '' TERM; echo ready > \"$1\"; while true; do sleep 0.05; done", "sh", deaf], cancelGrace: time.Duration { nanos: 200_000_000 })
  }
  println(match (escalated) {
    stopped: Cancelled => stopped.reason
    _ => "unexpected"
  })
  // The direct child exits on SIGTERM; the SIGKILL timer must not reach a
  // descendant that outlives it while still holding the captured pipe. Stop
  // signals the whole group, so first wait until the descendant ignores SIGTERM.
  survivor = fs.Join([directory, "survivor"])
  marker = fs.Join([directory, "outer"])
  inner = fs.Join([directory, "inner"])
  release = fs.Join([directory, "release"])
  outer = process.Start(s, "/bin/sh", ["-c", "sh -c 'trap \"\" TERM; echo ready > \"$2\"; until [ -s \"$3\" ]; do sleep 0.05; done; echo survived > \"$1\"' sh \"$1\" \"$3\" \"$4\" & trap 'exit 0' TERM; echo ready > \"$2\"; wait", "sh", survivor, marker, inner, release], cancelGrace: time.Duration { nanos: 3_000_000_000 })?
  waitReady(marker)
  waitReady(inner)
  outer.Stop(time.Duration { nanos: 2_000_000_000 })
  // The descendant holds the pipe, so Wait gives IoError only once the pipe
  // bound (cancelGrace plus a second) passes, after the SIGKILL timer fired.
  _ = outer.Wait()
  fs.Write(release, encoding.Utf8("go"))?
  waitReady(survivor)
  println(encoding.ParseUtf8(fs.Read(survivor)?))
}

fn adopted(s: Scope) uses io + state: process.Process | IoError | Cancelled {
  scope child {
    proc = process.Start(child, "sleep", ["5"])?
    attach(proc, s)
  }
}

fn cancellation(directory: String) uses io + state + clock: Ok | IoError | Cancelled {
  limited = scope limited {
    cancelAfter(limited, 100)
    process.Run(limited, "sleep", ["5"])
  }
  println(match (limited) {
    stopped: Cancelled => stopped.reason
    _ => "unexpected"
  })
  moved = scope deadline {
    cancelAfter(deadline, 100)
    adopted(deadline)?.Wait()
  }
  println(match (moved) {
    stopped: Cancelled => stopped.reason
    _ => "unexpected"
  })
  path = fs.Join([directory, "grace.txt"])
  // Cancel only once the child's TERM trap is installed.
  trapping = fs.Join([directory, "trapping"])
  graced = scope patient {
    launch(patient, () => {
      waitReady(trapping)
      cancelAfter(patient, 0)
    })
    process.Run(patient, "/bin/sh", ["-c", "trap 'echo graceful exit; exit 3' TERM; echo ready > \"$1\"; while true; do sleep 0.05; done", "sh", trapping], stdout: .File { path: path }, cancelGrace: time.Duration { nanos: 2_000_000_000 })
  }
  println(match (graced) {
    _: Cancelled => true
    _ => false
  })
  println(match (fs.Read(path)) {
    data: Bytes => encoding.ParseUtf8(data)
    _ => "missing"
  })
}

fn exercise(s: Scope) uses io + state + clock: Ok | IoError | Cancelled | fs.Error {
  directory = fs.DirectoryPath(fs.TempDir(s)?)
  streams(s, directory)?
  statuses(s)?
  handles(s, directory)?
  robustness(s, directory)?
  cancellation(directory)?
}

fn main() {
  result = scope s { exercise(s) }
  match (result) {
    _: Ok => println("ok")
    other => println(other)
  }
}
