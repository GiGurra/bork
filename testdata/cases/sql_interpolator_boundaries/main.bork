import "bork/sql"

fn rejects(label: String, statement: sql.Statement, dialect: sql.Dialect) uses io {
  result = statement.Render(dialect)
  println(label, match (result) { error: sql.Error => true, _ => false })
}
fn accepts(label: String, statement: sql.Statement, dialect: sql.Dialect) uses io {
  result = statement.Render(dialect)
  println(label, match (result) { rendered: sql.Rendered => true, _ => false })
}
fn main() {
  value = "hostile"
  sqlite = sql.Dialect.Sqlite
  postgres = sql.Dialect.Postgres
  rejects("single quote", sql.SQL"SELECT '$value'", sqlite)
  rejects("double quote", sql.SQL"SELECT \"$value\"", sqlite)
  rejects("backtick", sql.SQL"SELECT `$value`", sqlite)
  rejects("bracket", sql.SQL"SELECT [$value]", sqlite)
  rejects("line comment", sql.SQL"SELECT 1 -- $value", sqlite)
  rejects("SQLite CR comment", sql.SQL"SELECT 1 -- text\r$value", sqlite)
  rejects("block comment", sql.SQL"SELECT 1 /* $value */", sqlite)
  rejects("nested block comment", sql.SQL"SELECT 1 /* outer /* inner */ $value */", postgres)
  rejects("dollar quote", sql.SQL"SELECT $$$$ $value $$$$", postgres)
  rejects("tagged dollar quote", sql.SQL"SELECT $$tag$$ $value $$tag$$", postgres)
  rejects("unicode dollar quote", sql.SQL"SELECT $$å$$ $value $$å$$", postgres)
  rejects("escape string", sql.SQL"SELECT E'escaped\\' $value'", postgres)
  rejects("ambiguous ordinary string", sql.SQL"SELECT 'back\\slash', $value", postgres)
  rejects("prefix token", sql.SQL"SELECT prefix$value", sqlite)
  rejects("suffix token", sql.SQL"SELECT ${value}suffix", sqlite)
  rejects("adjacent holes", sql.SQL"SELECT $value$value", sqlite)
  rejects("value after dot", sql.SQL"SELECT x.$value", sqlite)
  rejects("manual question placeholder", sql.SQL"SELECT ?, $value", sqlite)
  rejects("manual numeric placeholder", sql.SQL"SELECT ?42, $value", sqlite)
  rejects("manual named placeholder", sql.SQL"SELECT :name, $value", sqlite)
  rejects("manual at placeholder", sql.SQL"SELECT @name, $value", sqlite)
  rejects("manual dollar placeholder", sql.SQL"SELECT $$name, $value", sqlite)
  rejects("manual pg placeholder", sql.SQL"SELECT $$1, $value", postgres)
  rejects("NUL text", sql.SQL"SELECT \u0000, $value", sqlite)
  rejects("unterminated quote", sql.SQL"SELECT 'oops", sqlite)
  rejects("unterminated comment", sql.SQL"SELECT /* oops", postgres)
  rejects("unterminated dollar quote", sql.SQL"SELECT $$$$ oops", postgres)
  left = sql.SQL"SELECT /*"
  right = sql.SQL"*/"
  rejects("composed comment", sql.SQL"$left $value $right", postgres)
  slash = sql.SQL"/"
  star = sql.SQL"*"
  rejects("split comment delimiter", sql.SQL"SELECT $slash$star $value */", postgres)
  quote = sql.SQL"'"
  rejects("composed quotes", sql.SQL"SELECT $quote$value$quote", sqlite)
  word = sql.SQL"prefix"
  rejects("composed token", sql.SQL"SELECT $word$value", sqlite)
  accepts("quoted manual placeholders", sql.SQL"SELECT '? $$1 :name', $value", sqlite)
  accepts("comment placeholders", sql.SQL"SELECT $value /* ? $$1 */", sqlite)
  accepts("escaped quote literal", sql.SQL"SELECT E'escaped\\' quote', $value", postgres)
  accepts("ordinary sqlite backslash", sql.SQL"SELECT 'back\\slash', $value", sqlite)
  accepts("pg cast after hole", sql.SQL"SELECT $value::text", postgres)
  accepts("pg identifier dollar tag", sql.SQL"SELECT a$$tag$$ FROM t", postgres)
  accepts("pg identifier dollar digit", sql.SQL"SELECT a$$1 FROM t", postgres)
  accepts("pg JSON operator", sql.SQL"SELECT '{} '::jsonb ? $value", postgres)
  accepts("pg CR ends comment", sql.SQL"SELECT 1 -- text\r, $value", postgres)
  accepts("newline ends comment", sql.SQL"SELECT 1 -- text\n, $value", sqlite)
  println("empty identifier", match (sql.Name("")) { error: sql.Error => true, _ => false })
  println("NUL identifier", match (sql.Name("a\u0000b")) { error: sql.Error => true, _ => false })
}
