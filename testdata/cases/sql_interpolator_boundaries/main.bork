import "bork/sql"

fn rejects(label: String, statement: sql.Statement, dialect: sql.Dialect) uses io {
  result = statement.Render(dialect)
  println(label, match (result) { _: sql.Error => true, _ => false })
}
fn accepts(label: String, statement: sql.Statement, dialect: sql.Dialect) uses io {
  result = statement.Render(dialect)
  println(label, match (result) { _: sql.Rendered => true, _ => false })
}
fn main() {
  value = "hostile"
  dynamic = sql.SQL""
  sqlite = sql.Dialect.Sqlite
  postgres = sql.Dialect.Postgres
  rejects("single quote", sql.SQL"${dynamic}SELECT '$value'", sqlite)
  rejects("double quote", sql.SQL"${dynamic}SELECT \"$value\"", sqlite)
  rejects("backtick", sql.SQL"${dynamic}SELECT `$value`", sqlite)
  rejects("bracket", sql.SQL"${dynamic}SELECT [$value]", sqlite)
  rejects("line comment", sql.SQL"${dynamic}SELECT 1 -- $value", sqlite)
  rejects("SQLite CR comment", sql.SQL"${dynamic}SELECT 1 -- text\r$value", sqlite)
  rejects("block comment", sql.SQL"${dynamic}SELECT 1 /* $value */", sqlite)
  rejects("nested block comment", sql.SQL"${dynamic}SELECT 1 /* outer /* inner */ $value */", postgres)
  rejects("dollar quote", sql.SQL"${dynamic}SELECT $$$$ $value $$$$", postgres)
  rejects("tagged dollar quote", sql.SQL"${dynamic}SELECT $$tag$$ $value $$tag$$", postgres)
  rejects("unicode dollar quote", sql.SQL"${dynamic}SELECT $$å$$ $value $$å$$", postgres)
  rejects("escape string", sql.SQL"${dynamic}SELECT E'escaped\\' $value'", postgres)
  rejects("ambiguous ordinary string", sql.SQL"${dynamic}SELECT 'back\\slash', $value", postgres)
  rejects("prefix token", sql.SQL"${dynamic}SELECT prefix$value", sqlite)
  rejects("suffix token", sql.SQL"${dynamic}SELECT ${value}suffix", sqlite)
  rejects("adjacent holes", sql.SQL"${dynamic}SELECT $value$value", sqlite)
  rejects("value after dot", sql.SQL"${dynamic}SELECT x.$value", sqlite)
  rejects("manual question placeholder", sql.SQL"${dynamic}SELECT ?, $value", sqlite)
  rejects("manual numeric placeholder", sql.SQL"${dynamic}SELECT ?42, $value", sqlite)
  rejects("manual named placeholder", sql.SQL"${dynamic}SELECT :name, $value", sqlite)
  rejects("manual at placeholder", sql.SQL"${dynamic}SELECT @name, $value", sqlite)
  rejects("manual dollar placeholder", sql.SQL"${dynamic}SELECT $$name, $value", sqlite)
  rejects("manual pg placeholder", sql.SQL"${dynamic}SELECT $$1, $value", postgres)
  rejects("NUL text", sql.SQL"${dynamic}SELECT \u0000, $value", sqlite)
  rejects("unterminated quote", sql.SQL"${dynamic}SELECT 'oops", sqlite)
  rejects("unterminated comment", sql.SQL"${dynamic}SELECT /* oops", postgres)
  rejects("unterminated dollar quote", sql.SQL"${dynamic}SELECT $$$$ oops", postgres)
  left = sql.SQL"SELECT /*"
  right = sql.SQL"*/"
  rejects("composed comment", sql.SQL"${dynamic}$left $value $right", postgres)
  slash = sql.SQL"/"
  star = sql.SQL"*"
  rejects("split comment delimiter", sql.SQL"${dynamic}SELECT $slash$star $value */", postgres)
  quote = sql.SQL"'"
  rejects("composed quotes", sql.SQL"${dynamic}SELECT $quote$value$quote", sqlite)
  word = sql.SQL"prefix"
  rejects("composed token", sql.SQL"${dynamic}SELECT $word$value", sqlite)
  accepts("quoted manual placeholders", sql.SQL"SELECT '? $$1 :name', $value", sqlite)
  accepts("comment placeholders", sql.SQL"SELECT $value /* ? $$1 */", sqlite)
  accepts("escaped quote literal", sql.SQL"SELECT E'escaped\\' quote', $value", postgres)
  accepts("ordinary sqlite backslash", sql.SQL"SELECT 'back\\slash', $value", sqlite)
  accepts("pg array constructor", sql.SQL"SELECT ARRAY[$value]", postgres)
  accepts("pg cast after hole", sql.SQL"SELECT $value::text", postgres)
  accepts("pg identifier dollar tag", sql.SQL"SELECT a$$tag$$ FROM t", postgres)
  accepts("pg identifier dollar digit", sql.SQL"SELECT a$$1 FROM t", postgres)
  accepts("pg JSON operator", sql.SQL"SELECT '{} '::jsonb ? $value", postgres)
  accepts("pg CR ends comment", sql.SQL"SELECT 1 -- text\r, $value", postgres)
  accepts("newline ends comment", sql.SQL"SELECT 1 -- text\n, $value", sqlite)
  println("empty identifier", match (sql.Name("")) { _: sql.Error => true, _ => false })
  println("NUL identifier", match (sql.Name("a\u0000b")) { _: sql.Error => true, _ => false })
}
