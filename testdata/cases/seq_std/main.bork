import codecs "bork/json"
import "bork/fs"
import "bork/sql"
type Row = { n: Int } derive (Decode)
fn demo() uses io + net: Ok | fs.Error | sql.Error {
  scope app {
    directory = fs.TempDir(app, pattern: "seq-")?
    path = fs.Join([fs.DirectoryPath(directory), "lines.txt"])
    fs.Write(path, utf8Bytes("one\ntwo\nthree\n"))?
    println(fs.Lines(path).take(1).toList())
    println(fs.Lines(path).toList())
    println(fs.Entries(fs.DirectoryPath(directory)).map(entry => match (entry) {
      value: fs.DirEntry => value.name
      error: fs.Error => "error"
      }).toList())
    db = sql.OpenSqlite(":memory:", app)?
    rows = sql.Rows[Row](db, "SELECT 1 AS n UNION ALL SELECT 2 AS n", [])
    println(rows.take(1).toList())
    println(rows.toList())
    println(sql.RowsJson(db, "SELECT 3 AS n", []).toList())
    println(sql.RowsJson(db, "SELECT missing FROM missing", []).map(value => match (value) {
      error: sql.Error => error.operation
      json: Json => codecs.Render(json)
      }).toList())
  }
}
fn main() { println(demo()) }
