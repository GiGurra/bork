fn escapedTimeout() uses clock + state: Channel[Int] | Cancelled {
  scope s { withTimeout(s, 1000000, child => channel[Int](child, 1)) }
}
fn escapedSelection(wait: Scope) uses state: Option[Channel[Int] | Cancelled | Closed] | Cancelled {
  scope source {
    values = channel[Channel[Int]](source, 1)
    _ = values.send(source, channel[Int](source, 1))
    arm = values.receiveCase(value => value)
    [arm].select(wait)
  }
}
fn escapedTaskResult(wait: Scope) uses state: Option[Channel[Int]] | Cancelled {
  scope source {
    ch = channel[Int](source, 1)
    task = spawn(source, () => ch)
    [task].awaitFirst(wait)
  }
}
fn main() {}
// A receive arm keeps what its mapper captures.
fn leakedMapper(outer: Scope): ReceiveCase[Channel[Int]] {
  values = channel[Int](outer, 1)
  scope inner {
    short = channel[Int](inner, 1)
    values.receiveCase(v => short)
  }
}
// A channel's values wait in the scope they are given.
fn escapedValues(outer: Scope): Seq[Int] uses state {
  ch = channel[Int](outer)
  scope inner {
    ch.values(inner)
  }
}
