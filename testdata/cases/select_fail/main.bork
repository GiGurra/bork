fn shapes(s: Scope, ch: Channel[Int]) uses state {
  _ = select {
    x = ch.length() => x
  }
  _ = select {
    _ => 1
  }
  _ = select {
    x = ch.receive(s) => 1
    _ => 2
    _ => 3
  }
  _ = select {
    ch.send(s: s, x: 1) => 1
  }
}

fn types(s: Scope, ch: Channel[Int], n: Int) uses state {
  _ = select {
    ch.send(s, "text") => 1
  }
  _ = select {
    x = n.receive(s) => 1
  }
}

// A select's value includes Cancelled.
fn value(s: Scope, ch: Channel[Int]) uses state: Int {
  select {
    ch.receive(s) => 1
  }
}

type Conn = resource

type Other = resource

// A handoff's arm hands over and a channel's sends, and the resource must
// be the handoff's type.
fn arms(s: Scope, conns: Handoff[Conn], numbers: Channel[Int], c: Conn, o: Other) uses state {
  _ = select {
    conns.send(s, c) => {}
    numbers.handOver(s, 1) => {}
    conns.handOver(s, o) => {}
    _ => {}
  }
}

fn main() {}

fn scopes(ch: Channel[Int]) uses state {
  _ = select {
    ch.receive(1) => 1
  }
}
