fn fetch() uses io: Int unsafe go { return 7 }
test "first forcing goroutine determines cached mocked result" {
  lazy value = fetch()
  calls = mock fetch() { 11 }
  calls.expect(times: 1)
  reader = () => value
  scope s {
    tasks = [1, 2, 3].map(n => fork(s, () => reader()))
    assertEqual(tasks.map(t => await(t)), [11, 11, 11])
  }
  assertEqual(value, 11)
}
test "an escaping cell does not carry mocks" {
  reader = scope s {
    calls = mock fetch() { 11 }
    calls.expect(times: 0)
    lazy value = fetch()
    () => value
  }
  assertEqual(reader(), 7)
}
