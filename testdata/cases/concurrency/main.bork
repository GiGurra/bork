import "bork/time"
fn slow(s: Scope, n: Int, ms: Int) uses clock + state: Int {
  _ = time.Sleep(s, time.Nanoseconds((ms) * 1000000))
  n * n
}

fn main() {
  total = scope s {
    a = spawn(s, () => slow(s, 3, 30))
    b = spawn(s, () => slow(s, 4, 10))
    launch(s, () => {
      _ = time.Sleep(s, time.Nanoseconds((5) * 1000000))
      println("launched task ran")
    })
    await(a) + await(b)
  }
  println(total)
  squares = scope s {
    tasks = range(1, 6).map(n => spawn(s, () => slow(s, n, 10 - n)))
    tasks.map(t => await(t))
  }
  println(squares)
}

test "tasks run concurrently, and await gives their results" {
  r = scope s {
    a = spawn(s, () => slow(s, 2, 5))
    b = spawn(s, () => slow(s, 3, 5))
    await(a) * await(b)
  }
  assertEqual(r, 36)
}
