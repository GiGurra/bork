type Config = {}
type Db = {}
type Server = {}
type A = {}
type B = {}
type Failure = {}
fn config(): Config { Config {} }
fn other(): Config { Config {} }
fn server(d: Db, c: Config): Server { Server {} }
fn a(value: B): A { A {} }
fn b(value: A): B { B {} }
fn failed(): Config | Db { Db {} }
fn id[T](x: T): T { x }
fn main() {
  scope s {
    println(assemble[Server](s, server, config))
    println(assemble[Server](s, config))
    println(assemble[Config](s, config, other))
    println(assemble[A](s, a, b))
    println(assemble[Config](s, config, () => 3))
    println(assembleAll[Db](s, config))
    println(assembleRecord[Int](s, config))
    println(assemble[Config](s, 3))
    println(assemble[Config](s, id))
    println(assemble[Config](s, failed, () => Db {}))
    println(assemble[Scope](s, () => s))
    println(assemble[Config](3, config))
    println(assemble[Config]())
    println(assemble(s, config))
    println(assemble[Config](scope: s, config))
    callback = assemble
  }
}
