pred positive(x: Int) { x > 0 }
type Failed = {}
ambient label: String
fn bad(): Int | Failed { Failed {} }
fn named() needs label: String { label }
fn async(n: Int): Int { n }
fn generic[T](s: Scope, value: T in s): T { async(s) saved = value; saved }
fn owner(s: Scope) uses io: Scope { println("owner evaluated"); s }
fn earlyOwner(): Int { scope s { async({ if (true) { return 9 }; s }) value = 99; value } }
fn failedScope(s: Scope): Scope | Failed { Failed {} }
fn earlyTry(): Int | Failed { scope s { async(failedScope(s)?) value = 99; value } }
fn unconditionalOwner(): Int { scope s { async(return 12) value = 99 } }
fn main() {
  scope s {
    ready = channel[Int](s, 2)
    release = channel[Int](s, 2)
    async(owner(s)) first = { _ = ready.send(s, 1); _ = release.receive(s); 11 }
    async(s) second = { _ = ready.send(s, 2); _ = release.receive(s); 22 }
    _ = ready.receive(s); _ = ready.receive(s)
    println("both started")
    _ = release.send(s, 1); _ = release.send(s, 2)
    reader = () => first
    tasks = [1, 2, 3].map(n => spawn(s, () => reader()))
    println(tasks.map(t => await(t)))
    println(reader()); println(first); println(second)
    alias = first; println(alias)
    async(s) failed = bad()
    println(failed); println(failed)
    async(s) early: Int where positive = { if (true) { return 3 }; 4 }
    println(early)
    async(s) inferred = { if (true) { return 5 }; 6 }
    println(inferred)
    async(s) propagate = { number = bad()?; number + 1 }
    println(propagate)
    async(s) optional: Option[Int] = { number = Option.Some(8)?; number + 1 }
    println(optional)
    with (label: "captured") {
      async(s) name = named()
      with (label: "reader") { println(name) }
    }
    async(s) keyword = async(10)
    println(keyword); println(generic(s, "generic"))
    for (n in [1, 2]) { async(s) item = n; println(item); println(item) }
    done = atom(0)
    scope child { async(child) unused = update(done, n => n + 1); _ = () => unused }
    println(current(done))
    async(s) checked: Int where positive = 7
    println(positive(checked))
  }
  println(earlyOwner()); println(earlyTry()); println(unconditionalOwner())
  scope outer {
    ch = channel[Int](outer, 1)
    copy = scope inner { async(inner) value = ch; value }
    _ = copy.send(outer, 7)
    println(copy.receive(outer))
  }
}
