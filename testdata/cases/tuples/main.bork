import "bork/json"

type Labeled = (Int, String) derive (Encode, Decode)
type Box = { pair: (Int, String) } derive (Encode, Decode)

fn mark(n: Int) uses io: Int { println(n); n }

fn pair(n: Int): (Int, String) { (n, "hello") }
fn first[A, B](p: (A, B)): A { p.0 }
fn main() {
  p = pair(7)
  println(p)
  println(json.Encode(Box { pair: p }))
  println([(1, [2]), (3, [4])])
  values = { (1, [2]): "tuple key" }
  println(values.get((1, [2])))
  (_, _) = (mark(20), mark(21))
  (_, _) = (mark(22), mark(23))
  println(json.Decode[Labeled]("[]"))
  println(json.Decode[Labeled]("[1, false]"))
  println(json.Decode[((Int,),)]("[[1]]"))
  println(comptime { (2, "compile time") })
  println(json.Encode(p))
  println(json.Decode[(Int, String)]("[7,\"hello\"]"))
  (number, word) = p
  println(number)
  println(word)
  (single,) = (10,)
  println(single)
  (_, (nested,)) = (false, (11,))
  println(nested)
  println(p.0)
  println(p.1)
  println(first((8, true)))
  println(((9,), "nested").0.0)
  println((1, "a") == (1, "a"))
  println(match ((true, 3)) {
    (true, n) => n
    (false, _) => 0
  })
}
