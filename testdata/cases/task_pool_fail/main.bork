import "bork/time"
import "bork/tasks"
fn pure(pool: tasks.Pool, s: Scope): Task[Int] | tasks.TaskLimitReached | Cancelled {
  tasks.TryFork(pool, s, () => 1)
}
fn badCallback(pool: tasks.Pool, s: Scope) uses state: Task[Int] | tasks.TaskLimitReached | Cancelled {
  tasks.TryFork(pool, s, () => { _ = time.Sleep(s, ((1) * 1000000).nanos()); 1 })
}
fn main() {}
