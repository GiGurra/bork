import "bork/fs"

fn use(f: fs.File) {}

fn noAttach(path: String) uses io: Ok | fs.Error {
  scope app {
    scope job {
      f = fs.Create(path, job)?
      fork(app, () => use(f))
      Ok
    }
  }
}

fn tooLate(path: String) uses io: Ok | fs.Error {
  scope app {
    f = scope job { fs.Create(path, job)? }
    _ = attach(f, app)
  }
}

fn main() {}
