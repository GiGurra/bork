import "bork/fs"

fn use(f: fs.File) {}

fn noAttach(path: String): Unit | fs.Error {
  scope app {
    scope job {
      f = fs.Create(path, job)?
      launch(app, () => use(f))
    }
  }
}

fn tooLate(path: String): Unit | fs.Error {
  scope app {
    f = scope job { fs.Create(path, job)? }
    shared = attach(f, app)
  }
}

fn main() {}
