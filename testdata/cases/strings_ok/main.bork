fn sum(a: String, b: String): Int | ParseError {
  x = parseInt(a)?
  y = parseInt(b)?
  x + y
}

fn main() {
  println(sum("40", "2"))
  println(sum("40", "two"))
  println(parseFloat("2.5"), parseBool("true"), parseBool("yes"))
  println(parseInt("99999999999999999999"))
  s = "  Hello, bork  "
  t = s.trim()
  println(t, t.byteLength(), "åäö".byteLength())
  println(t.contains("bork"), t.startsWith("Hello"), t.endsWith("!"))
  println(t.indexOf("bork"), t.indexOf("go"))
  println(t.toUpper(), t.toLower(), t.replaceAll("bork", "world"))
  println("ab".repeat(3), "ab".repeat(-1) == "")
}
