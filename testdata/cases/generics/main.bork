type NotFound = { key: String }

// Generic functions: type parameters are inferred from the arguments.
fn identity[T](x: T): T { x }

fn twice[T](x: T, f: (T) => T): T { f(f(x)) }

fn pairUp[A, B](xs: List[A], ys: List[B], combine: (A, B) => String): List[String] {
  if (xs.isEmpty() || ys.isEmpty()) {
    []
  } else {
    match (xs.head()) {
      Option.Some(x) => match (ys.head()) {
        Option.Some(y) => prepend(combine(x, y), pairUp(xs.drop(1), ys.drop(1), combine))
        Option.None => []
      }
      Option.None => []
    }
  }
}

// A union with a type parameter: T is what remains.
fn orElse[T](x: T | NotFound, fallback: T): T {
  match (x) {
    _: NotFound => fallback
    v: T => v
  }
}

fn lookup(key: String): Int | NotFound {
  if (key == "one") { 1 } else { NotFound { key: key } }
}

fn firstOr[T](xs: List[T], fallback: T): T {
  match (xs.head()) {
    Option.Some(v) => v
    Option.None => fallback
  }
}

// Functions are values: returned, passed, stored in bindings.
fn adder(n: Int): (Int) => Int { x => x + n }

fn compose[A, B, C](f: (A) => B, g: (B) => C): (A) => C { x => g(f(x)) }

fn applyAll(fs: List[(Int) => Int], x: Int): List[Int] { fs.map(f => f(x)) }

fn main() {
  println(identity(5), identity("s"), twice(3, x => x * x), twice("ab", s => s + s))
  println(pairUp([1, 2, 3], ["a", "b"], (n, s) => s"$s$n"))
  println(orElse(lookup("one"), 0), orElse(lookup("two"), 0))
  println(firstOr([7, 8], 0), firstOr([], "none"))
  add2 = adder(2)
  println(add2(40), adder(1)(1))
  toText = compose(adder(10), x => s"<$x>")
  println(toText(5), applyAll([adder(1), x => x * 100, identity], 3))
  printer: (String) uses io => Ok = s => println(s"> $s")
  printer("hello")
}
