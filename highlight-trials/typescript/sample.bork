// bork in TypeScript syntax: `function`, `const`, type predicates
// (`s is Title`) for preds, branded types, discriminated unions for
// sealed types, `this` parameters for methods, arrow functions,
// template literals, the Hack-style pipe proposal (`|> f(%)`), `using`
// declarations for scopes, the TC39 pattern matching proposal
// (`match (x) { when ... }`), and a tagged template for unsafe Go.
import * as http from "bork/http";
import * as log from "bork/log";

function nonEmpty(s: string): s is Title {
  return byteLength(s) > 0;
}

type Title = string & { readonly __where: "nonEmpty" };

type Todo = { id: number; title: Title; done: boolean } & Derive<Encode>;

type Discount =
  | { kind: "None" }
  | { kind: "Percent"; percent: number }
  | { kind: "FixedOff"; cents: number };

function discountFor(coupon: string | undefined): Discount | InvalidDiscount {
  return match (coupon) {
    when (undefined): { kind: "None" };
    when ("TENOFF"): { kind: "Percent", percent: 10 };
    when (code): { reason: `unknown coupon ${code.toUpperCase()}` };
  };
}

function second<T>(this: List<T>): Option<T> {
  return this.get(1);
}

function summary(users: List<User>, minAge = 18): string {
  const adults = users.filter(u => u.age >= minAge);
  const names = adults.map(u => u.name).sorted();
  const counts = names.reduce((m, n) => m.put(n, m.getOr(n, 0) + 1), new Map<string, number>());
  const total = [1, 2, 3] |> map(%, x => x * 10) |> fold(%, 0, (a, b) => a + b);
  log.info("summary", { adults: adults.length, total });
  return names.isEmpty() ? "nobody" : `${total}: ${names.join(", ")}`;
}

function serve(addr: string): void | IoError {
  using s = scope({ taskTimeout: 100, cleanupTimeout: 500 });
  const store = atom(new Map<string, Todo>());
  const server = http.listen(addr, s, (req, rs) => http.text(200, "ok"));
  if (server instanceof IoError) return server;
  s.launch(() => { s.delay(1000); });
  server.wait();
}

const now = unsafe.go<() => number>`
  import "time"
  return time.Now().UnixMilli()
`;

test("summary counts adults", () => {
  assertEqual(summary([]), "nobody");
});
