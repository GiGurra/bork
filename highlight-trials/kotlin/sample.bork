// bork in Kotlin syntax: `fun`, `val`, `data class`, `sealed
// interface`, `when`, nullable types for Option, extension functions,
// trailing `{ it }` lambdas, `to` pairs, `$` templates, and the
// `?:` operator. Kotlin has no union types, so `|` stays bork's.
import bork.http
import bork.log

pred fun nonEmpty(s: String) = s.byteLength > 0

typealias Title = String where nonEmpty

@Derive(Encode::class)
data class Todo(val id: Int, val title: Title, val done: Boolean)

sealed interface Discount {
    data object None : Discount
    data class Percent(val percent: Int) : Discount
    data class FixedOff(val cents: Int) : Discount
}

fun discountFor(coupon: String?): Discount | InvalidDiscount = when (coupon) {
    null -> Discount.None
    "TENOFF" -> Discount.Percent(percent = 10)
    else -> InvalidDiscount(reason = "unknown coupon ${coupon.uppercase()}")
}

fun <T> List<T>.second(): T? = getOrNull(1)

fun summary(users: List<User>, minAge: Int = 18): String {
    val adults = users.filter { it.age >= minAge }
    val names = adults.map { it.name }.sorted()
    val counts = names.fold(mapOf<String, Int>()) { m, n -> m + (n to (m[n] ?: 0) + 1) }
    val total = listOf(1, 2, 3).map { it * 10 }.fold(0) { a, b -> a + b }
    log.info("summary", mapOf("adults" to adults.size, "total" to total))
    return if (names.isEmpty()) "nobody" else "$total: ${names.joinToString(", ")}"
}

fun serve(addr: String): Unit | IoError = scope(taskTimeout(100), cleanupTimeout(500)) { s ->
    val store = atom(mapOf<String, Todo>())
    val server = http.listen(addr, s) { req, rs -> http.text(200, "ok") }.bind()
    s.launch { delay(1000) }
    server.await()
}

unsafe fun now(): Int = go(
    """
    import "time"
    return time.Now().UnixMilli()
    """
)

@Test
fun `summary counts adults`() {
    assertEquals("nobody", summary(emptyList()))
}
