// A sample of bork syntax, to compare borrowed GitHub highlighting.
import "bork/http"
import "bork/log"

pred nonEmpty(s: String) { byteLength(s) > 0 }

type Title = String where nonEmpty

type Todo = { id: Int, title: Title, done: Bool } derive (Encode)

type Discount = sealed {
  None,
  Percent { percent: Int },
  FixedOff { cents: Int },
}

fn discountFor(coupon: Option[String]): Discount | InvalidDiscount {
  match (coupon) {
    Option.None => Discount.None
    Option.Some { value: "TENOFF" } => Discount.Percent { percent: 10 }
    Option.Some { value: code } => InvalidDiscount { reason: s"unknown coupon ${toUpper(code)}" }
  }
}

fn (xs: List[T]) second[T](): Option[T] { xs.get(1) }

fn summary(users: List[User], minAge: Int = 18): String {
  adults = users.filter(u => u.age >= minAge)
  names = adults.map(u => u.name).sorted()
  counts = names.fold({:}, (m, n) => m.put(n, m.getOr(n, 0) + 1))
  total = [1, 2, 3] |> map(x => x * 10) |> fold(0, (a, b) => a + b)
  log.Info("summary", {"adults": adults.length(), "total": total})
  if (names.isEmpty()) { "nobody" } else { s"$total: ${names.join(", ")}" }
}

fn serve(addr: String): Unit | IoError {
  scope s with taskTimeout(100), cleanupTimeout(500) {
    store = atom({:})
    server = http.Listen(addr, s, (req, rs) => http.Text(200, "ok"))?
    launch(s, () => { _ = delay(s, 1000) })
    http.Wait(server)
  }
}

fn now(): Int unsafe go {
  import "time"
  return time.Now().UnixMilli()
}

test "summary counts adults" {
  assertEqual(summary([]), "nobody")
}
