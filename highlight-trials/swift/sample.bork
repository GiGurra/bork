// bork in Swift syntax: `func`, `let`, `->` results, `enum` with
// associated values, `switch` with `case let`, optionals (`String?`),
// extensions, trailing closures with `$0`, `\(...)` interpolation,
// typed `throws` for errors, and Swift Testing's `@Test`/`#expect`.
// Swift has no union types, so `|` stays bork's.
import bork.http
import bork.log

@pred func nonEmpty(_ s: String) -> Bool { s.byteLength > 0 }

typealias Title = String where nonEmpty

struct Todo: Encodable {
    let id: Int
    let title: Title
    let done: Bool
}

enum Discount {
    case none
    case percent(percent: Int)
    case fixedOff(cents: Int)
}

func discountFor(_ coupon: String?) -> Discount | InvalidDiscount {
    switch coupon {
    case nil: .none
    case "TENOFF": .percent(percent: 10)
    case let code?: InvalidDiscount(reason: "unknown coupon \(code.uppercased())")
    }
}

extension List {
    func second() -> Element? { get(1) }
}

func summary(_ users: [User], minAge: Int = 18) -> String {
    let adults = users.filter { $0.age >= minAge }
    let names = adults.map(\.name).sorted()
    let counts = names.reduce([String: Int]()) { m, n in m.put(n, m.getOr(n, 0) + 1) }
    let total = [1, 2, 3].map { $0 * 10 }.reduce(0, +)
    log.info("summary", ["adults": adults.count, "total": total])
    return names.isEmpty ? "nobody" : "\(total): \(names.joined(separator: ", "))"
}

func serve(_ addr: String) throws(IoError) {
    try scope(.taskTimeout(100), .cleanupTimeout(500)) { s in
        let store = Atom([String: Todo]())
        let server = try http.listen(addr, s) { req, rs in http.text(200, "ok") }
        s.launch { _ = s.delay(1000) }
        server.wait()
    }
}

@unsafe func now() -> Int {
    #go("""
    import "time"
    return time.Now().UnixMilli()
    """)
}

@Test("summary counts adults") func summaryCountsAdults() {
    #expect(summary([]) == "nobody")
}
