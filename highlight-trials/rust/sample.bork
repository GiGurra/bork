// bork in Rust syntax: snake_case, `let` bindings, `->` results,
// `<T>` generics, attributes (`#[pred]`, `#[derive]`, `#[test]`),
// `enum`s, `impl` blocks for methods, `|x|` closures, `::` paths, and
// macros (`format!`, `map!`, `scope!`, `go!`). Rust has no unions or
// default parameters, so those stay bork's.
use bork::http;
use bork::log;

#[pred]
fn non_empty(s: &String) -> bool { s.byte_len() > 0 }

#[refine(non_empty)]
type Title = String;

#[derive(Encode)]
struct Todo { id: i64, title: Title, done: bool }

enum Discount {
    None,
    Percent { percent: i64 },
    FixedOff { cents: i64 },
}

fn discount_for(coupon: Option<String>) -> Discount | InvalidDiscount {
    match coupon {
        None => Discount::None,
        Some("TENOFF") => Discount::Percent { percent: 10 },
        Some(code) => InvalidDiscount { reason: format!("unknown coupon {}", code.to_upper()) },
    }
}

impl<T> List<T> {
    fn second(&self) -> Option<T> { self.get(1) }
}

fn summary(users: List<User>, min_age: i64 = 18) -> String {
    let adults = users.filter(|u| u.age >= min_age);
    let names = adults.map(|u| u.name).sorted();
    let counts = names.fold(map! {}, |m, n| m.put(n, m.get_or(n, 0) + 1));
    let total = list![1, 2, 3].map(|x| x * 10).fold(0, |a, b| a + b);
    log::info!("summary", map! { "adults" => adults.len(), "total" => total });
    if names.is_empty() { "nobody".into() } else { format!("{total}: {}", names.join(", ")) }
}

fn serve(addr: String) -> Result<(), IoError> {
    scope!(s, task_timeout = 100, cleanup_timeout = 500, {
        let store = Atom::new(map! {});
        let server = http::listen(&addr, s, |req, rs| http::text(200, "ok"))?;
        s.launch(|| { let _ = s.delay(1000); });
        server.wait();
    })
}

unsafe fn now() -> i64 {
    go! {
        import "time"
        return time.Now().UnixMilli()
    }
}

#[test]
fn summary_counts_adults() {
    assert_eq!(summary(list![]), "nobody");
}
