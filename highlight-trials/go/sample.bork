// bork in Go syntax: `func`, `:=` bindings, receivers, exported
// capitals, struct tags, union interfaces for sealed types, a type
// switch instead of match, `func` literals instead of lambdas, slog's
// key-value logging, `defer` for scopes, and Go's testing style. The
// unsafe Go body is just Go. Go has no unions in results or default
// parameters, so those stay bork's.
package main

import (
	"bork/http"
	"bork/log"
)

//bork:pred
func nonEmpty(s string) bool { return len(s) > 0 }

type Title string //bork:where nonEmpty

type Todo struct {
	ID    int   `json:"id"`
	Title Title `json:"title"`
	Done  bool  `json:"done"`
}

type NoDiscount struct{}
type Percent struct{ Percent int }
type FixedOff struct{ Cents int }
type Discount interface{ NoDiscount | Percent | FixedOff }

func discountFor(coupon Option[string]) Discount | InvalidDiscount {
	switch c := coupon.(type) {
	case None:
		return NoDiscount{}
	case Some[string]:
		if c.Value == "TENOFF" {
			return Percent{Percent: 10}
		}
		return InvalidDiscount{Reason: fmt.Sprintf("unknown coupon %s", strings.ToUpper(c.Value))}
	}
}

func (xs List[T]) Second() Option[T] { return xs.Get(1) }

func summary(users List[User], minAge int = 18) string {
	adults := users.Filter(func(u User) bool { return u.Age >= minAge })
	names := adults.Map(func(u User) string { return u.Name }).Sorted()
	counts := names.Fold(Map[string, int]{}, func(m Map[string, int], n string) Map[string, int] {
		return m.Put(n, m.GetOr(n, 0)+1)
	})
	total := List[int]{1, 2, 3}.Map(func(x int) int { return x * 10 }).Fold(0, func(a, b int) int { return a + b })
	log.Info("summary", "adults", len(adults), "total", total)
	if len(names) == 0 {
		return "nobody"
	}
	return fmt.Sprintf("%d: %s", total, strings.Join(names, ", "))
}

func serve(addr string) error {
	s := scope.New(scope.TaskTimeout(100), scope.CleanupTimeout(500))
	defer s.Close()
	store := atom(Map[string, Todo]{})
	server, err := http.Listen(addr, s, func(req http.Request, rs Scope) http.Response { return http.Text(200, "ok") })
	if err != nil {
		return err
	}
	s.Go(func() { s.Delay(1000) })
	server.Wait()
	return nil
}

//bork:unsafe
func now() int {
	return time.Now().UnixMilli()
}

func TestSummaryCountsAdults(t *testing.T) {
	assertEqual(t, summary(nil), "nobody")
}
