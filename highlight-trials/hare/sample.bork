// bork in Hare syntax: `use` imports, `let`/`const` bindings, `fn
// name(x: t) t = { ... };` with the result type after the
// parameters, tagged unions `(a | b)` (native in Hare, as in bork),
// `match (x) { case ... => }`, `void` for absence, struct literals
// with `=`, `@test` functions, and `defer`. Hare has no generics,
// lambdas, methods, or defaults: those become concrete types, named
// functions, and plain functions.
use bork::http;
use bork::log;

@pred fn nonempty(s: str) bool = len(s) > 0;

@where(nonempty) type title = str;

@derive(encode) type todo = struct {
	id: int,
	title: title,
	done: bool,
};

type nodiscount = void;
type percent = struct { percent: int };
type fixedoff = struct { cents: int };
type discount = (nodiscount | percent | fixedoff);

fn discount_for(coupon: (str | void)) (discount | invalid_discount) = {
	match (coupon) {
	case void =>
		return nodiscount;
	case let code: str =>
		if (code == "TENOFF") {
			return percent { percent = 10 };
		};
		return invalid_discount {
			reason = fmt::asprintf("unknown coupon {}", strings::toupper(code)),
		};
	};
};

fn second(xs: []user) (user | void) = {
	if (len(xs) < 2) return;
	return xs[1];
};

fn is_adult(u: user, min_age: int) bool = u.age >= min_age;

fn summary(users: []user, min_age: int) str = {
	const adults = filter(users, &is_adult, min_age);
	const names = sorted(names_of(adults));
	const counts = fold(names, map::empty(), &count_name);
	const total = fold([1, 2, 3], 0, &add_tenfold);
	log::info("summary", map::of(("adults", len(adults)), ("total", total)));
	if (len(names) == 0) return "nobody";
	return fmt::asprintf("{}: {}", total, strings::join(", ", names...));
};

fn serve(addr: str) (void | io_error) = {
	const s = scope::open(scope::task_timeout(100), scope::cleanup_timeout(500));
	defer scope::close(s);
	const store = atom::new(map::empty());
	const server = http::listen(addr, s, &handle)?;
	scope::launch(s, &wait_a_second);
	http::wait(server);
};

@unsafe("go") fn now() int = `
	import "time"
	return time.Now().UnixMilli()
`;

@test fn summary_counts_adults() void = {
	assert(summary([], 18) == "nobody");
};
