import codec "bork/codec"

import codecs "bork/json"
use codec.Defaults
// Package env reads environment variables and decodes proven configuration.
type Missing = { variable: String }
type ConfigError = { errors: List[codec.DecodeError] }

// Get distinguishes an unset variable from one set to an empty string.
fn Get(name: String) uses io: Option[String] unsafe go {
  import "os"
  value, found := os.LookupEnv(name)
  if !found { return _borkNone[string]() }
  return _borkSome(value)
}
fn Require(name: String) uses io: String | Missing {
  match (Get(name)) {
    Option.Some(value) => value
    Option.None => Missing { variable: name }
  }
}
// All takes an immutable snapshot in environment order.
fn All() uses io: Map[String, String] unsafe go {
  import "os"
  import "strings"
  keys, values := []string{}, []string{}
  for _, entry := range os.Environ() {
    key, value, found := strings.Cut(entry, "=")
    if found { keys = append(keys, key); values = append(values, value) }
  }
  return _borkMapOf(keys, values)
}
// LoadJson decodes a complete JSON document held in one environment variable.
fn LoadJson[T: codec.Decode](name: String) uses io: T | Missing | codecs.JsonError | codec.DecodeError {
  text = Require(name)?
  codecs.Decode[T](text)
}

// Load maps derived record fields to PREFIX_FIELD_NAME environment variables.
// Strings are literal; numbers and booleans use JSON syntax. Compound values
// use JSON. Absent Option fields become None. All field errors are reported.
fn Load[T: codec.Decode](prefix: String) uses io: T | ConfigError {
  LoadWith[T](prefix, Get)
}

// LoadWith supplies the environment reader, allowing isolated config tests.
fn LoadWith[T: codec.Decode](prefix: String, lookup: (String) => Option[String]): T | ConfigError {
  prepared = prepare[T](prefix, lookup, variableName, parseValue)
  match (prepared) {
    errors: ConfigError => errors
    json: codec.Value => match (codec.decode[T](json)) {
      value: T => value
      error: codec.DecodeError => ConfigError { errors: [error] }
    }
  }
}
fn parseValue(raw: String, kind: String): codec.Value | codecs.JsonError {
  if (kind == "string") { codec.Value.String { value: raw } } else { codecs.Parse(raw) }
}

fn variableName(prefix: String, field: String): String unsafe go {
  import "strings"
  name := _borkCodecJoinWords(_borkCodecWords(field), "ScreamingSnake")
  if prefix == "" { return name }
  return strings.TrimRight(prefix, "_") + "_" + name
}

fn prepare[T: codec.Decode](prefix: String, lookup: (String) => Option[String], makeName: (String, String) => String, parse: (String, String) => codec.Value | codecs.JsonError): codec.Value | ConfigError {
  prepareWithSchema[T](codec.Schema[T](), prefix, lookup, makeName, parse)
}
fn prepareWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], prefix: String, lookup: (String) => Option[String], makeName: (String, String) => String, parse: (String, String) => codec.Value | codecs.JsonError): codec.Value | ConfigError unsafe go {
  import "strings"
  record, supported := _borkOptionGet(recordSchema)
  schema := record.fields
  if !supported { return ConfigError{errors: []codec.DecodeError{{path: prefix, message: "field loading unsupported: expected a derived record decoder"}}} }
  fields := []codec.Field{}
  errors := []codec.DecodeError{}
  // Resolve all variable owners before invoking the environment reader.
  variables := make([][]string, len(schema))
  owners := map[string]int{}
  for index, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    basis := key
    if len(field.words) != 0 { basis = strings.Join(field.words, "_") }
    names := []string{basis}
    if prefix != "" { names = append(names, field.aliases...) }
    for _, name := range names {
      if len(_borkCodecWords(name)) == 0 {
        errors = append(errors, codec.DecodeError{path: key, message: "field has no words for an environment name"})
        continue
      }
      variable := makeName(prefix, name)
      if previous, duplicate := owners[variable]; duplicate {
        errors = append(errors, codec.DecodeError{path: variable, message: "environment name collides with field " + schema[previous].name})
      } else { owners[variable] = index }
      variables[index] = append(variables[index], variable)
    }
  }
  if len(errors) != 0 { return ConfigError{errors: errors} }
  for index, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    variable := variables[index][0]
    inputName := key
    raw, found := "", false
    duplicate := false
    for candidateIndex, candidate := range variables[index] {
      if value, present := _borkOptionGet(lookup(candidate)); present {
        if found {
          errors = append(errors, codec.DecodeError{path: candidate, message: "same field as " + variable})
          duplicate = true
        } else {
          raw, found, variable = value, true, candidate
          if candidateIndex > 0 { inputName = field.aliases[candidateIndex-1] }
        }
      }
    }
    if duplicate { continue }
    var json codec.Value = codec.Value_Null{}
    if !found {
      if field.hasDefault { continue }
      if !field.optional {
        errors = append(errors, codec.DecodeError{path: variable, message: "is missing"})
        continue
      }
    } else {
      parsed := parse(raw, field.kind)
      if error, failed := parsed.(codecs.JsonError); failed {
        errors = append(errors, codec.DecodeError{path: variable, message: error.message})
        continue
      }
      json = parsed.(codec.Value)
    }
    if error, failed := field.validate(json).(codec.DecodeError); failed {
      errors = append(errors, codec.DecodeError{path: variable + strings.TrimPrefix(error.path, "."+key), message: error.message})
      continue
    }
    fields = append(fields, codec.Field{name: inputName, value: json})
  }
  if len(errors) != 0 { return ConfigError{errors: errors} }
  return codec.Value_Object{fields: fields}
}
