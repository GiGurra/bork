import codecs "bork/json"
// Package env reads environment variables and decodes proven configuration.
type Missing = { variable: String }
type ConfigError = { errors: List[DecodeError] }

// Get distinguishes an unset variable from one set to an empty string.
fn Get(name: String) uses io: Option[String] unsafe go {
  import "os"
  value, found := os.LookupEnv(name)
  if !found { return _borkNone[string]() }
  return _borkSome(value)
}
fn Require(name: String) uses io: String | Missing {
  match (Get(name)) {
    Option.Some { value } => value
    Option.None => Missing { variable: name }
  }
}
// All takes an immutable snapshot in environment order.
fn All() uses io: Map[String, String] unsafe go {
  import "os"
  import "strings"
  keys, values := []string{}, []string{}
  for _, entry := range os.Environ() {
    key, value, found := strings.Cut(entry, "=")
    if found { keys = append(keys, key); values = append(values, value) }
  }
  return _borkMapOf(keys, values)
}
// LoadJson decodes a complete JSON document held in one environment variable.
fn LoadJson[T: Decode](name: String) uses io: T | Missing | JsonError | DecodeError {
  text = Require(name)?
  codecs.Decode[T](text)
}

// Load maps derived record fields to PREFIX_FIELD_NAME environment variables.
// Strings are literal; numbers and booleans use JSON syntax. Compound values
// use JSON. Absent Option fields become None. All field errors are reported.
fn Load[T: Decode](prefix: String) uses io: T | ConfigError {
  LoadWith[T](prefix, Get)
}

// LoadWith supplies the environment reader, allowing isolated config tests.
fn LoadWith[T: Decode](prefix: String, lookup: (String) => Option[String]): T | ConfigError {
  prepared = prepare[T](prefix, lookup, variableName, parseValue)
  match (prepared) {
    errors: ConfigError => errors
    json: Json => match (decode[T](json)) {
      value: T => value
      error: DecodeError => ConfigError { errors: [error] }
    }
  }
}
fn parseValue(raw: String, kind: String): Json | JsonError {
  if (kind == "string") { Json.String { value: raw } } else { codecs.Parse(raw) }
}

fn variableName(prefix: String, field: String): String unsafe go {
  import "strings"
  import "unicode"
  runes := []rune(field)
  var name strings.Builder
  for i, r := range runes {
    if i > 0 && unicode.IsUpper(r) && (unicode.IsLower(runes[i-1]) || unicode.IsDigit(runes[i-1]) || i+1 < len(runes) && unicode.IsLower(runes[i+1])) { name.WriteByte('_') }
    name.WriteRune(unicode.ToUpper(r))
  }
  if prefix == "" { return name.String() }
  return strings.TrimRight(prefix, "_") + "_" + name.String()
}

fn prepare[T: Decode](prefix: String, lookup: (String) => Option[String], makeName: (String, String) => String, parse: (String, String) => Json | JsonError): Json | ConfigError unsafe go {
  import "strings"
  schema, supported := _borkDecodeFields(_d_T_Decode)
  if !supported { return ConfigError{errors: []DecodeError{{path: prefix, message: "field loading unsupported: expected a derived record decoder"}}} }
  fields := []JsonField{}
  errors := []DecodeError{}
  for _, field := range schema {
    variable := makeName(prefix, field.Name)
    raw, found := _borkOptionGet(lookup(variable))
    var json Json = Json_Null{}
    if !found {
      if field.HasDefault { continue }
      if !field.Optional {
        errors = append(errors, DecodeError{path: variable, message: "is missing"})
        continue
      }
    } else {
      parsed := parse(raw, field.Kind)
      if error, failed := parsed.(JsonError); failed {
        errors = append(errors, DecodeError{path: variable, message: error.message})
        continue
      }
      json = parsed.(Json)
    }
    if error, failed := field.Decode(json).(DecodeError); failed {
      errors = append(errors, DecodeError{path: variable + strings.TrimPrefix(error.path, "."+field.Name), message: error.message})
      continue
    }
    fields = append(fields, JsonField{name: field.Name, value: json})
  }
  if len(errors) != 0 { return ConfigError{errors: errors} }
  return Json_Object{fields: fields}
}
