// Numeric-width codecs check decimal range before returning a typed value.

instance decodeInt8: Decode[Int8] {
  fn decode(json: Value): Int8 | DecodeError unsafe go {
    import "strconv"
    value, ok := json.(Value_Number)
    if !ok { return _decodeMismatch("an Int8 whole number", json) }
    number, err := strconv.ParseInt(value.text, 10, 8)
    if err != nil { return DecodeError{path: "", message: "expected an Int8 whole number, found " + value.text} }
    return int8(number)
  }
}
instance encodeInt8: Encode[Int8] {
  fn encode(value: Int8): Value { Value.Number { text: toString(value) } }
}

