import "bork/shape"

// Format-independent codecs and an ordered value tree.

// Value is a format-independent value tree. A number keeps its text, so that whole numbers
// of any size decode exactly.
type Value = sealed {
  Null
  Bool { value: Bool }
  Number { text: String }
  String { value: String }
  Array { items: List[Value] }
  Object { fields: List[Field] }
}

type Field = { name: String, value: Value }

// valueKind names the kind of a JSON value, for messages.
fn valueKind(j: Value): String {
  match (j) {
    Value.Null => "null"
    Value.Bool { value: _ } => "a boolean"
    Value.Number { text: _ } => "a number"
    Value.String { value: _ } => "a string"
    Value.Array { items: _ } => "an array"
    Value.Object { fields: _ } => "an object"
  }
}

// DecodeError says where in a value decoding failed (a path like
// ".items[2].name", "" for the whole value), and why. Transparent invariant
// comparisons name the first failed condition and its primary field path;
// other fields read by that condition appear in the message.
type DecodeError = { path: String, message: String }

// Decode reads typed values from the value tree. `derive (Decode)` on a record
// or sealed type gives it an instance that also checks every field's
// where clause, so decoded values arrive already proven.
class Decode[T] {
  fn decode(json: Value): T | DecodeError
}

// VariantSchema describes a canonical enum choice and its exact input aliases.
type VariantSchema = { name: String, doc: String, aliases: List[String] = [] }
// FieldSchema describes the input shape of the selected decoder. Container
// schemas delegate their element kind and variants to that decoder's dictionary.
type FieldSchema = { kind: String, optional: Bool, variants: List[VariantSchema] = [] }

fn FieldInfo[T: Decode](): FieldSchema {
  shape.metadata[T, Decode, FieldSchema]().getOr(FieldSchema { kind: "json", optional: false })
}

// RecordSchema contains declaration-order inputs of a named record. Its
// callbacks check an independent field; sibling facts require complete Decode.
type DefaultSchema = { display: String, configPath: Option[String], choices: List[String] }

// TagGroup carries a foreign package tag encoded by its own Encode instance.
type TagGroup = { package: String, value: Value }

type RecordField = {
  name: String
  wireName: String = ""
  aliases: List[String] = []
  words: List[String] = []
  tags: List[TagGroup] = []
  typeName: String
  doc: String
  facts: List[String]
  kind: String
  optional: Bool
  variants: List[VariantSchema] = []
  hasDefault: Bool
  defaultValue: Option[() => DefaultSchema]
  defaultInput: Option[() => Value | DecodeError] = Option.None
  recordSchema: Option[() => Option[RecordSchema]] = Option.None
  validate: (Value) => Ok | DecodeError
}
type RecordSchema = { fields: List[RecordField] }

// Schema follows the selected Decode instance. A hand-written decoder may
// publish RecordSchema directly; structural derivations use an optional value
// because tuples and sealed values do not have named record inputs.
fn Schema[T: Decode](): Option[RecordSchema] {
  match (shape.metadata[T, Decode, RecordSchema]()) {
    Option.Some(schema) => Option.Some(schema)
    Option.None => shape.metadata[T, Decode, Option[RecordSchema]]().getOr(Option.None)
  }
}

// Display preserves bork's readable list separators and quoted list elements.
// It is presentation text, not an encoding guaranteed to round-trip.
fn defaultInfo[T](value: T): DefaultSchema {
  defaultInfoWithDisplay(value, toString(value))
}
fn defaultInfoWithDisplay[T](value: T, display: String): DefaultSchema unsafe go {
  var path Option[string] = Option_None[string]{}
  choices := []string{}
  switch value := any(value).(type) {
  case string: path = Option_Some[string]{E0:value}; choices = []string{value}
  case []string: choices = value
  case Option_Some[string]: path = Option_Some[string]{E0:value.E0}; choices = []string{value.E0}
  case Option_Some[[]string]: choices = value.E0
  }
  return DefaultSchema{display:display,configPath:path,choices:choices}
}

// Encode writes typed values to the value tree; `derive (Encode)` gives
// records and sealed types an instance.
class Encode[T] {
  fn encode(x: T): Value
}

// RecordEncoding completes omitted object fields for consumers that require
// every column. Only a missing canonical wire name invokes the callback.
metadata type RecordEncoding[T] = { omittedField: (T, String) uses nothing => Option[Value] }

// Derived Encode publishes the family for every shape. This private marker
// preserves Encoding's None result for positional and sealed targets; custom
// encoders need only publish the family, without a marker.
type recordEncodingSupport = { supported: Bool }

// Encoding follows the selected Encode instance; custom encoders opt in by
// publishing RecordEncoding metadata explicitly.
fn Encoding[T: Encode](): Option[RecordEncoding[T]] {
  match (shape.metadata[T, Encode, recordEncodingSupport]()) {
    Option.Some(info) => if (info.supported) { shape.metadata[T, Encode, RecordEncoding[T]]() } else { Option.None }
    Option.None => shape.metadata[T, Encode, RecordEncoding[T]]()
  }
}

derive fn RecordEncodingSupported[T](): Bool {
  comptime match (shape.kind[T]()) {
    shape.Record => !shape.positional[T]()
    _ => false
  }
}

// RecordEncodingInfo reads only the requested field when its callback runs.
derive fn RecordEncodingInfo[T](): RecordEncoding[T] {
  comptime match (shape.kind[T]()) {
    shape.Record => {
      comptime if (shape.positional[T]()) {
        RecordEncoding { omittedField: (value, name) => Option.None }
      } else {
        RecordEncoding { omittedField: (value, name) => EncodeOmittedField[T](value, name) }
      }
    }
    _ => RecordEncoding { omittedField: (value, name) => Option.None }
  }
}

// Complete an omitted field from the actual typed row.
// Encode just that field, with the same selected dictionary as object encoding.
derive fn EncodeOmittedField[T](value: T.RawType, name: String): Option[Value] {
  _ = value
  _ = name
  comptime for (field in shape.fields[T]()) {
    comptime if (!field.computed) {
      comptime if (FieldOmit[T](field) != Omit.Never) {
        if (name == FieldWireName[T](field)) {
          return Option.Some(encode[field.Type](field.read(value)))
        }
      }
    }
  }
  Option.None
}

fn decodeMismatch(expected: String, json: Value): DecodeError {
  DecodeError { path: "", message: s"expected $expected, found ${valueKind(json)}" }
}

// atPath puts an error found inside a value under the given step of
// its path (".name", "[2]").
fn atPath(e: DecodeError, step: String): DecodeError {
  DecodeError { path: step + e.path, message: e.message }
}

instance decodeInt: Decode[Int] {
  metadata DefaultInput = Input[Int](value => Value.Number { text: toString(value) })
  metadata FieldSchema = FieldSchema { kind: "number", optional: false }
  fn decode(json: Value): Int | DecodeError {
    match (json) {
      Value.Number { text } => match (parseInt(text)) {
        n: Int => n
        ParseError => DecodeError { path: "", message: s"expected a whole number, found $text" }
      }
      other => decodeMismatch("a whole number", other)
    }
  }
}

instance decodeFloat: Decode[Float] {
  metadata DefaultInput = Input[Float](value => Value.Number { text: toString(value) })
  metadata FieldSchema = FieldSchema { kind: "number", optional: false }
  fn decode(json: Value): Float | DecodeError {
    match (json) {
      Value.Number { text } => match (parseFloat(text)) {
        f: Float => f
        ParseError => DecodeError { path: "", message: s"expected a number, found $text" }
      }
      other => decodeMismatch("a number", other)
    }
  }
}

instance decodeString: Decode[String] {
  metadata DefaultInput = Input[String](value => Value.String { value: value })
  metadata FieldSchema = FieldSchema { kind: "string", optional: false }
  fn decode(json: Value): String | DecodeError {
    match (json) {
      Value.String { value } => value
      other => decodeMismatch("a string", other)
    }
  }
}

instance decodeBool: Decode[Bool] {
  metadata DefaultInput = Input[Bool](value => Value.Bool { value: value })
  metadata FieldSchema = FieldSchema { kind: "bool", optional: false }
  fn decode(json: Value): Bool | DecodeError {
    match (json) {
      Value.Bool { value } => value
      other => decodeMismatch("a boolean", other)
    }
  }
}

// An Option is null (or a missing field) for None.
instance decodeOption[T: Decode]: Decode[Option[T]] {
  metadata DefaultInput = Input[Option[T]](value => optionDefaultInput(value))
  metadata Option[RecordSchema] = Schema[T]()
  metadata FieldSchema = FieldSchema { kind: FieldInfo[T]().kind, optional: true, variants: FieldInfo[T]().variants }
  fn decode(json: Value): Option[T] | DecodeError {
    match (json) {
      Value.Null => Option.None
      other => {
        value = decode[T](other)?
        Option.Some(value)
      }
    }
  }
}

instance decodeList[T: Decode]: Decode[List[T]] {
  metadata DefaultInput = Input[List[T]](value => listDefaultInput(value))
  metadata FieldSchema = FieldSchema { kind: "list:" + FieldInfo[T]().kind, optional: false, variants: FieldInfo[T]().variants }
  fn decode(json: Value): List[T] | DecodeError {
    match (json) {
      Value.Array { items } => decodeItems(items, 0, [])
      other => decodeMismatch("an array", other)
    }
  }
}

fn decodeItems[T: Decode](items: List[Value], index: Int, done: List[T]): List[T] | DecodeError {
  match (items.head()) {
    Option.None => done.reverse()
    Option.Some(item) => match (decode[T](item)) {
      e: DecodeError => atPath(e, s"[$index]")
      x: T => decodeItems(items.drop(1), index + 1, prepend(x, done))
    }
  }
}

// A Map with String keys is a JSON object; its fields keep their order.
instance decodeMap[V: Decode]: Decode[Map[String, V]] {
  metadata DefaultInput = Input[Map[String, V]](value => mapDefaultInput(value))
  metadata FieldSchema = FieldSchema { kind: "map:" + FieldInfo[V]().kind, optional: false }
  fn decode(json: Value): Map[String, V] | DecodeError {
    match (json) {
      Value.Object { fields } => decodeFields(fields, {:})
      other => decodeMismatch("an object", other)
    }
  }
}

fn decodeFields[V: Decode](fields: List[Field], done: Map[String, V]): Map[String, V] | DecodeError {
  match (fields.head()) {
    Option.None => done
    Option.Some(field) => match (decode[V](field.value)) {
      e: DecodeError => atPath(e, s".${field.name}")
      x: V => decodeFields(fields.drop(1), fieldPut(done, field.name, x))
    }
  }
}

fn fieldPut[V](m: Map[String, V], name: String, value: V): Map[String, V] unsafe go {
  return m.put(name, value)
}

instance decodeValue: Decode[Value] {
  metadata DefaultInput = Input[Value](value => value)
  metadata FieldSchema = FieldSchema { kind: "json", optional: false }
  fn decode(json: Value): Value | DecodeError { json }
}

instance encodeInt: Encode[Int] {
  fn encode(x: Int): Value { Value.Number { text: toString(x) } }
}

instance encodeFloat: Encode[Float] {
  fn encode(x: Float): Value { Value.Number { text: toString(x) } }
}

instance encodeString: Encode[String] {
  fn encode(x: String): Value { Value.String { value: x } }
}

instance encodeBool: Encode[Bool] {
  fn encode(x: Bool): Value { Value.Bool { value: x } }
}

instance encodeOption[T: Encode]: Encode[Option[T]] {
  fn encode(x: Option[T]): Value {
    match (x) {
      Option.None => Value.Null
      Option.Some(value) => encode(value)
    }
  }
}

instance encodeList[T: Encode]: Encode[List[T]] {
  fn encode(xs: List[T]): Value { Value.Array { items: xs.map(encode) } }
}

instance encodeMap[V: Encode]: Encode[Map[String, V]] {
  fn encode(m: Map[String, V]): Value {
    Value.Object { fields: fieldEntries(m).map(e => Field { name: e.key, value: encode(e.value) }) }
  }
}

fn fieldEntries[V](m: Map[String, V]): List[Entry[String, V]] unsafe go {
  import "slices"
  import "strings"
  out := make([]Entry[string, V], 0, m.len())
  m.each(func(k string, v V) bool {
    out = append(out, Entry[string, V]{key: k, value: v})
    return true
  })
  if _, unordered := m.impl().(*_hashCore); unordered {
    slices.SortFunc(out, func(a, b Entry[string, V]) int { return strings.Compare(a.key, b.key) })
  }
  return out
}

instance encodeValue: Encode[Value] {
  fn encode(x: Value): Value { x }
}

// A Rune encodes as one Unicode scalar in a JSON string.
instance encodeRune: Encode[Rune] {
  fn encode(x: Rune): Value { Value.String { value: toString(x) } }
}

instance decodeRune: Decode[Rune] {
  metadata DefaultInput = Input[Rune](value => Value.String { value: toString(value) })
  metadata FieldSchema = FieldSchema { kind: "string", optional: false }
  fn decode(json: Value): Rune | DecodeError {
    match (json) {
      Value.String { value } => if (validRuneString(value)) {
        match (value.runeAt(0)) {
          Option.Some(r) => r
          Option.None => DecodeError { path: "", message: "expected one Unicode scalar" }
        }
      } else { DecodeError { path: "", message: "expected one Unicode scalar" } }
      other => decodeMismatch("one Unicode scalar", other)
    }
  }
}

fn validRuneString(value: String): Bool unsafe go {
  import "unicode/utf8"
  return utf8.ValidString(value) && utf8.RuneCountInString(value) == 1
}

// Defaults selects the standard primitive and container codecs.
instances Defaults { decodeInt8, encodeInt8, decodeInt16, encodeInt16, decodeInt32, encodeInt32, decodeUint8, encodeUint8, decodeUint16, encodeUint16, decodeUint32, encodeUint32, decodeUint64, encodeUint64, decodeFloat32, encodeFloat32, decodeInt, decodeFloat, decodeString, decodeBool, decodeOption, decodeList, decodeMap, decodeValue, encodeInt, encodeFloat, encodeString, encodeBool, encodeOption, encodeList, encodeMap, encodeValue, encodeRune, decodeRune }

// Structural encoding is an ordinary source derivation. Positional payloads
// preserve slot order; named payloads preserve declaration-order object fields.
derive instance encodeShape[T]: Encode[T] {
  metadata recordEncodingSupport = recordEncodingSupport { supported: RecordEncodingSupported[T]() }
  metadata RecordEncoding[T] = RecordEncodingInfo[T.RawType]()
  fn encode(x: T): Value {
    comptime match (shape.kind[T]()) {
      shape.Record => {
        comptime if (shape.positional[T]()) {
          values: List[Value] = [comptime for (field in shape.fields[T]())
            encode[field.Type](field.read(x))]
          Value.Array { items: values }
        } else {
          CheckWireNames[T]()
          fieldChunks: List[List[Field]] = [comptime for (field in shape.fields[T]())
            comptime if (!field.computed) {
              if (ShouldOmit[T](field, field.read(x))) {
                empty: List[Field] = []
                empty
              } else { [Field { name: FieldWireName[T](field), value: encode[field.Type](field.read(x)) }] }
          }]
          Value.Object { fields: fieldChunks.flatMap(chunk => chunk) }
        }
      }
      shape.Sealed => {
        CheckWireNames[T]()
        comptime for (variant in shape.variants[T]()) {
          comptime if (!variant.positional) {
            comptime for (field in variant.fields) {
              comptime if (wireNamesHave(FieldNames[T](field), "type")) {
                shape.fail("named sealed payload field 'type' collides with the codec discriminator")
              }
            }
          }
          match (variant.project(x)) {
            Option.Some(payload) => {
              _ = payload
              comptime if (VariantFallback[T](variant)) {
                comptime for (field in variant.fields) {
                  return Value.String { value: field.read(payload) }
                }
              } else {
                comptime if (EnumShape[T]() && variant.fields.isEmpty()) {
                  return Value.String { value: VariantWireName[T](variant) }
                } else {
                  comptime if (variant.positional) {
                    values: List[Value] = [comptime for (field in variant.fields)
                      encode[field.Type](field.read(payload))]
                    return Value.Object { fields: [
                      Field { name: "type", value: Value.String { value: VariantWireName[T](variant) } },
                      Field { name: "values", value: Value.Array { items: values } }
                    ] }
                  } else {
                    fieldChunks: List[List[Field]] = [comptime for (field in variant.fields)
                      comptime if (!field.computed) {
                        if (ShouldOmit[T](field, field.read(payload))) {
                          empty: List[Field] = []
                          empty
                        } else { [Field { name: FieldWireName[T](field), value: encode[field.Type](field.read(payload)) }] }
                    }]
                    return Value.Object { fields: prepend(
                      Field { name: "type", value: Value.String { value: VariantWireName[T](variant) } }, fieldChunks.flatMap(chunk => chunk)) }
                  }
                }
              }
            }
            Option.None => {}
          }
        }
        shape.exhausted[T](x)
      }
      shape.Other => shape.fail("Encode requires a record or sealed target")
    }
  }
}

// RecordInfo expands typed callbacks for a named record without constructing
// that record. Default providers run only when explicitly requested by callers.
derive fn RecordInfo[T](): Option[RecordSchema] {
  CheckWireNames[T]()
  comptime match (shape.kind[T]()) {
    shape.Record => {
      comptime if (shape.positional[T]()) {
        Option.None
      } else {
        fields: List[RecordField] = [comptime for (field in shape.fields[T]())
          comptime if (!field.computed) {
            info = shape.metadata[field.RawType, Decode, FieldSchema]().getOr(FieldSchema { kind: "json", optional: false })
            provider: Option[() => DefaultSchema] = comptime if (field.hasDefault) {
              Option.Some(() => defaultInfo(field.default()))
            } else {
              Option.None
            }
            RecordField {
              name: field.name,
              wireName: FieldWireName[T](field),
              aliases: FieldAliases[T](field),
              words: Words(field.tagged[FieldTags]().getOr(FieldTags {}).name.getOr(field.name)),
              tags: [comptime for (tag in field.tagGroups) comptime if (tag.package != "bork/codec")
                TagGroup { package: tag.package, value: encode[tag.Type](tag.value()) }],
              typeName: shape.typeName[field.RawType](),
              doc: field.doc,
              facts: [comptime for (fact in field.facts) fact.text],
              kind: info.kind,
              optional: info.optional,
              variants: info.variants,
              hasDefault: field.hasDefault,
              defaultValue: provider,
              defaultInput: comptime if (field.hasDefault) {
                Option.Some(() => materializeDefault[field.RawType](field.default()))
              } else { Option.None },
              recordSchema: Option.Some(() => Schema[field.RawType]()),
              validate: input => match (decode[field.RawType](input)) {
                error: DecodeError => atPath(error, s".${FieldWireName[T](field)}")
                value: field.RawType => match (field.check(value)) {
                  error: shape.ValidationError => DecodeError { path: s".${FieldWireName[T](field)}" + error.path, message: error.message }
                  Ok => Ok
                }
              }
            }
        }]
        Option.Some(RecordSchema { fields: fields })
      }
    }
    shape.Sealed => Option.None
    shape.Other => Option.None
  }
}

fn inputField(fields: List[Field], name: String): Option[Value] {
  fields.find(field => field.name == name).map(field => field.value)
}

// DecodeRecord expands ordered input reads followed by the checked builder.
// The builder evaluates defaults and validates sibling and owner facts only
// after all independently decoded inputs have been stored.
derive fn DecodeRecord[T](json: Value): T | DecodeError {
  CheckWireNames[T]()
  initial = shape.builder[T]()
  comptime if (shape.positional[T]()) {
    match (json) {
      Value.Array { items } => {
        if (items.length() != shape.fields[T]().length()) {
          return DecodeError { path: "", message: s"expected an array of length ${shape.fields[T]().length()}" }
        }
        steps: List[(initial.Type) => initial.Type | DecodeError] = [comptime for (field in shape.fields[T]())
          (state: initial.Type) => match (items.get(field.index)) {
            Option.Some(input) => match (decode[field.RawType](input)) {
              error: DecodeError => atPath(error, s"[${field.index}]")
              value: field.RawType => state.set(field, value)
            }
            Option.None => DecodeError { path: s"[${field.index}]", message: "tuple element is missing" }
        }]
        start: initial.Type | DecodeError = initial
        assembled = steps.fold(start, (state, step) => match (state) {
          error: DecodeError => error
          pending: initial.Type => step(pending)
        })
        match (assembled) {
          error: DecodeError => error
          pending: initial.Type => match (pending.finish()) {
            error: shape.ValidationError => DecodeError { path: error.path, message: error.message }
            value: T => value
          }
        }
      }
      other => decodeMismatch("an array", other)
    }
  } else {
    match (json) {
      Value.Object { fields } => {
        match (checkInputNames(fields, [comptime for (field in shape.fields[T]()) FieldNames[T](field)], [], RejectUnknown[T]())) {
          error: DecodeError => return error
          Ok => {}
        }
        _ = fields
        steps: List[(initial.Type) => initial.Type | DecodeError] = [comptime for (field in shape.fields[T]())
          (state: initial.Type) => {
            comptime if (field.computed) {
              if (inputNamedField(fields, FieldNames[T](field)).isSome()) {
                DecodeError { path: s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}", message: "computed field is read-only" }
              } else { state }
            } else {
              input: Option[Value] | DecodeError = match (inputNamedField(fields, FieldNames[T](field))) {
                Option.Some(value) => Option.Some(value)
                Option.None => {
                  comptime if (field.hasDefault) { Option.None } else {
                    info = shape.metadata[field.RawType, Decode, FieldSchema]().getOr(FieldSchema { kind: "json", optional: false })
                    if (info.optional) { Option.Some(Value.Null) } else {
                      DecodeError { path: s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}", message: "is missing" }
                    }
                  }
                }
              }
              match (input) {
                error: DecodeError => error
                Option.None => state
                Option.Some(value) => match (decode[field.RawType](value)) {
                  error: DecodeError => atPath(error, s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}")
                  decoded: field.RawType => state.set(field, decoded)
                }
              }
            }
        }]
        start: initial.Type | DecodeError = initial
        assembled = steps.fold(start, (state, step) => match (state) {
          error: DecodeError => error
          pending: initial.Type => step(pending)
        })
        match (assembled) {
          error: DecodeError => error
          pending: initial.Type => match (pending.finish()) {
            error: shape.ValidationError => DecodeError { path: remapWirePath(error.path, [comptime for (field in shape.fields[T]())(field.name, inputWireName(fields, FieldWireName[T](field), FieldNames[T](field)))]), message: error.message }
            value: T => value
          }
        }
      }
      other => decodeMismatch("an object", other)
    }
  }
}

fn quoted(value: String): String unsafe go {
  import "strconv"
  return strconv.Quote(value)
}

// DecodeSealed selects a declared variant and constructs it through its
// checked builder. Positional payloads are arrays under the values member.
derive fn DecodeSealed[T](json: Value): T | DecodeError {
  CheckWireNames[T]()
  tag: String | DecodeError = match (json) {
    Value.String { value } => value
    Value.Object { fields } => match (inputField(fields, "type")) {
      Option.Some(value) => match (value) {
        Value.String { value: name } => name
        _ => DecodeError { path: ".type", message: "expected the variant's name, as a string" }
      }
      Option.None => DecodeError { path: ".type", message: "expected the variant's name, as a string" }
    }
    other => decodeMismatch("an object", other)
  }
  match (tag) {
    error: DecodeError => error
    name: String => {
      fields: List[Field] = match (json) { Value.Object { fields } => fields, _ => [] }
      _ = fields
      comptime for (variant in shape.variants[T]()) {
        comptime if (!VariantFallback[T](variant)) {
          comptime if (!variant.positional) {
            comptime for (field in variant.fields) {
              comptime if (wireNamesHave(FieldNames[T](field), "type")) {
                shape.fail("named sealed payload field 'type' collides with the codec discriminator")
              }
            }
          }
          if (VariantNames[T](variant).includes(name)) {
            comptime if (variant.positional) {
              match (checkInputNames(fields, [], ["type", "values"], RejectUnknown[T]())) { error: DecodeError => return error, Ok => {} }
            } else {
              match (checkInputNames(fields, [comptime for (field in variant.fields) FieldNames[T](field)], ["type"], RejectUnknown[T]())) { error: DecodeError => return error, Ok => {} }
            }
            initial = variant.builder()
            comptime if (variant.positional) {
              items: List[Value] | DecodeError = match (inputField(fields, "values")) {
                Option.Some(value) => match (value) {
                  Value.Array { items } => items
                  _ => DecodeError { path: ".values", message: "expected an array of payload values" }
                }
                Option.None => DecodeError { path: ".values", message: "expected an array of payload values" }
              }
              match (items) {
                error: DecodeError => return error
                values: List[Value] => {
                  if (values.length() != variant.fields.length()) {
                    return DecodeError { path: ".values", message: s"expected an array of length ${variant.fields.length()}" }
                  }
                  steps: List[(initial.Type) => initial.Type | DecodeError] = [comptime for (field in variant.fields)
                    (state: initial.Type) => match (values.get(field.index)) {
                      Option.Some(input) => match (decode[field.RawType](input)) {
                        error: DecodeError => atPath(error, s".values[${field.index}]")
                        value: field.RawType => state.set(field, value)
                      }
                      Option.None => DecodeError { path: s".values[${field.index}]", message: "is missing" }
                  }]
                  start: initial.Type | DecodeError = initial
                  assembled = steps.fold(start, (state, step) => match (state) {
                    error: DecodeError => error
                    pending: initial.Type => step(pending)
                  })
                  return match (assembled) {
                    error: DecodeError => error
                    pending: initial.Type => match (pending.finish()) {
                      error: shape.ValidationError => DecodeError { path: if (error.path.startsWith("[")) { ".values" + error.path } else { error.path }, message: error.message }
                      value: T => value
                    }
                  }
                }
              }
            } else {
              steps: List[(initial.Type) => initial.Type | DecodeError] = [comptime for (field in variant.fields)
                (state: initial.Type) => {
                  comptime if (field.computed) {
                    if (inputNamedField(fields, FieldNames[T](field)).isSome()) {
                      DecodeError { path: s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}", message: "computed field is read-only" }
                    } else { state }
                  } else {
                    input: Option[Value] | DecodeError = match (inputNamedField(fields, FieldNames[T](field))) {
                      Option.Some(value) => Option.Some(value)
                      Option.None => {
                        comptime if (field.hasDefault) { Option.None } else {
                          info = shape.metadata[field.RawType, Decode, FieldSchema]().getOr(FieldSchema { kind: "json", optional: false })
                          if (info.optional) { Option.Some(Value.Null) } else {
                            DecodeError { path: s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}", message: "is missing" }
                          }
                        }
                      }
                    }
                    match (input) {
                      error: DecodeError => error
                      Option.None => state
                      Option.Some(value) => match (decode[field.RawType](value)) {
                        error: DecodeError => atPath(error, s".${inputWireName(fields, FieldWireName[T](field), FieldNames[T](field))}")
                        decoded: field.RawType => state.set(field, decoded)
                      }
                    }
                  }
              }]
              start: initial.Type | DecodeError = initial
              assembled = steps.fold(start, (state, step) => match (state) {
                error: DecodeError => error
                pending: initial.Type => step(pending)
              })
              return match (assembled) {
                error: DecodeError => error
                pending: initial.Type => match (pending.finish()) {
                  error: shape.ValidationError => DecodeError { path: remapWirePath(error.path, [comptime for (field in variant.fields)(field.name, inputWireName(fields, FieldWireName[T](field), FieldNames[T](field)))]), message: error.message }
                  value: T => value
                }
              }
            }
          }
        }
      }
      comptime if ([comptime for (variant in shape.variants[T]()) comptime if (VariantFallback[T](variant)) true].isEmpty()) {
        expected: List[String] = [comptime for (variant in shape.variants[T]()) comptime if (!VariantFallback[T](variant)) VariantWireName[T](variant)]
        DecodeError { path: ".type", message: "unknown variant " + quoted(name) + " of " + shape.name[T]() + "; expected one of " + expected.join(", ") }
      } else {
        comptime for (variant in shape.variants[T]()) {
          comptime if (VariantFallback[T](variant)) {
            if (fields.length() > 1) {
              return DecodeError { path: "", message: "an unknown enum variant object must contain only its type name" }
            }
            initial = variant.builder()
            comptime for (field in variant.fields) {
              assembled = initial.set(field, name)
              return match (assembled.finish()) {
                error: shape.ValidationError => DecodeError { path: error.path, message: error.message }
                value: T => value
              }
            }
          }
        }
      }

    }
  }
}

// ShapeFieldInfo publishes the selected derivation's input kind and known choices.
derive fn ShapeFieldInfo[T](): FieldSchema {
  comptime if (EnumShape[T]()) {
    CheckWireNames[T]()
    FieldSchema {
      kind: "string",
      optional: false,
      variants: [comptime for (variant in shape.variants[T]()) comptime if (!VariantFallback[T](variant))
        VariantSchema { name: VariantWireName[T](variant), doc: variant.doc, aliases: VariantAliases[T](variant) }]
    }
  } else {
    FieldSchema { kind: "json", optional: false }
  }
}

// Structural decoding and schema construction share the selected instance's
// independent field dictionaries. Builders certify complete target values.
derive instance decodeShape[T]: Decode[T] {
  metadata DefaultInput = shapeInput[T]()
  metadata FieldSchema = ShapeFieldInfo[T]()
  metadata Option[RecordSchema] = RecordInfo[T]()
  fn decode(json: Value): T | DecodeError {
    comptime match (shape.kind[T]()) {
      shape.Record => DecodeRecord[T](json)
      shape.Sealed => DecodeSealed[T](json)
      shape.Other => shape.fail("Decode requires a record or sealed target")
    }
  }
}
