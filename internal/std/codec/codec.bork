// Format-independent codecs and an ordered value tree.

// Value is a format-independent value tree. A number keeps its text, so that whole numbers
// of any size decode exactly.
type Value = sealed {
  Null
  Bool { value: Bool }
  Number { text: String }
  String { value: String }
  Array { items: List[Value] }
  Object { fields: List[Field] }
}

type Field = { name: String, value: Value }

// valueKind names the kind of a JSON value, for messages.
fn valueKind (j: Value): String {
  match (j) {
    Value.Null => "null"
    Value.Bool { value: _ } => "a boolean"
    Value.Number { text: _ } => "a number"
    Value.String { value: _ } => "a string"
    Value.Array { items: _ } => "an array"
    Value.Object { fields: _ } => "an object"
  }
}

// DecodeError says where in a value decoding failed (a path like
// ".items[2].name", "" for the whole value), and why. Transparent invariant
// comparisons name the first failed condition and its primary field path;
// other fields read by that condition appear in the message.
type DecodeError = { path: String, message: String }

// Decode reads typed values from the value tree. `derive (Decode)` on a record
// or sealed type gives it an instance that also checks every field's
// where clause, so decoded values arrive already proven.
class Decode[T] {
  fn decode(json: Value): T | DecodeError
}

// Encode writes typed values to the value tree; `derive (Encode)` gives
// records and sealed types an instance.
class Encode[T] {
  fn encode(x: T): Value
}

fn decodeMismatch (expected: String, json: Value): DecodeError {
  DecodeError { path: "", message: s"expected $expected, found ${valueKind(json)}" }
}

// atPath puts an error found inside a value under the given step of
// its path (".name", "[2]").
fn atPath (e: DecodeError, step: String): DecodeError {
  DecodeError { path: step + e.path, message: e.message }
}

instance decodeInt: Decode[Int] {
  fn decode(json: Value): Int | DecodeError {
    match (json) {
      Value.Number { text } => match (parseInt(text)) {
        n: Int => n
        ParseError => DecodeError { path: "", message: s"expected a whole number, found $text" }
      }
      other => decodeMismatch ("a whole number", other)
    }
  }
}

instance decodeFloat: Decode[Float] {
  fn decode(json: Value): Float | DecodeError {
    match (json) {
      Value.Number { text } => match (parseFloat(text)) {
        f: Float => f
        ParseError => DecodeError { path: "", message: s"expected a number, found $text" }
      }
      other => decodeMismatch ("a number", other)
    }
  }
}

instance decodeString: Decode[String] {
  fn decode(json: Value): String | DecodeError {
    match (json) {
      Value.String { value } => value
      other => decodeMismatch ("a string", other)
    }
  }
}

instance decodeBool: Decode[Bool] {
  fn decode(json: Value): Bool | DecodeError {
    match (json) {
      Value.Bool { value } => value
      other => decodeMismatch ("a boolean", other)
    }
  }
}

// An Option is null (or a missing field) for None.
instance decodeOption[T: Decode]: Decode[Option[T]] {
  fn decode(json: Value): Option[T] | DecodeError {
    match (json) {
      Value.Null => Option.None
      other => {
        value = decode[T](other)?
        Option.Some { value: value }
      }
    }
  }
}

instance decodeList[T: Decode]: Decode[List[T]] {
  fn decode(json: Value): List[T] | DecodeError {
    match (json) {
      Value.Array { items } => decodeItems (items, 0, [])
      other => decodeMismatch ("an array", other)
    }
  }
}

fn decodeItems [T: Decode](items: List[Value], index: Int, done: List[T]): List[T] | DecodeError {
  match (items.head()) {
    Option.None => done.reverse()
    Option.Some { value: item } => match (decode[T](item)) {
      e: DecodeError => atPath (e, s"[$index]")
      x: T => decodeItems (items.drop(1), index + 1, prepend(x, done))
    }
  }
}

// A Map with String keys is a JSON object; its fields keep their order.
instance decodeMap[V: Decode]: Decode[Map[String, V]] {
  fn decode(json: Value): Map[String, V] | DecodeError {
    match (json) {
      Value.Object { fields } => decodeFields (fields, {:})
      other => decodeMismatch ("an object", other)
    }
  }
}

fn decodeFields [V: Decode](fields: List[Field], done: Map[String, V]): Map[String, V] | DecodeError {
  match (fields.head()) {
    Option.None => done
    Option.Some { value: field } => match (decode[V](field.value)) {
      e: DecodeError => atPath (e, s".${field.name}")
      x: V => decodeFields (fields.drop(1), fieldPut (done, field.name, x))
    }
  }
}

fn fieldPut [V](m: Map[String, V], name: String, value: V): Map[String, V] unsafe go {
  return m.put(name, value)
}

instance decodeValue: Decode[Value] {
  fn decode(json: Value): Value | DecodeError { json }
}

instance encodeInt: Encode[Int] {
  fn encode(x: Int): Value { Value.Number { text: toString(x) } }
}

instance encodeFloat: Encode[Float] {
  fn encode(x: Float): Value { Value.Number { text: toString(x) } }
}

instance encodeString: Encode[String] {
  fn encode(x: String): Value { Value.String { value: x } }
}

instance encodeBool: Encode[Bool] {
  fn encode(x: Bool): Value { Value.Bool { value: x } }
}

instance encodeOption[T: Encode]: Encode[Option[T]] {
  fn encode(x: Option[T]): Value {
    match (x) {
      Option.None => Value.Null
      Option.Some { value } => encode(value)
    }
  }
}

instance encodeList[T: Encode]: Encode[List[T]] {
  fn encode(xs: List[T]): Value { Value.Array { items: xs.map(encode) } }
}

instance encodeMap[V: Encode]: Encode[Map[String, V]] {
  fn encode(m: Map[String, V]): Value {
    Value.Object { fields: fieldEntries (m).map(e => Field { name: e.key, value: encode(e.value) }) }
  }
}

fn fieldEntries [V](m: Map[String, V]): List[Entry[String, V]] unsafe go {
  out := make([]Entry[string, V], 0, m.len())
  m.each(func(k string, v V) bool {
    out = append(out, Entry[string, V]{key: k, value: v})
    return true
  })
  return out
}

instance encodeValue: Encode[Value] {
  fn encode(x: Value): Value { x }
}

// A Rune encodes as one Unicode scalar in a JSON string.
instance encodeRune: Encode[Rune] {
  fn encode(x: Rune): Value { Value.String { value: toString(x) } }
}

instance decodeRune: Decode[Rune] {
  fn decode(json: Value): Rune | DecodeError {
    match (json) {
      Value.String { value } => if ( validRuneString (value)) {
        match (value.runeAt(0)) {
          Option.Some { value: r } => r
          Option.None => DecodeError { path: "", message: "expected one Unicode scalar" }
        }
      } else { DecodeError { path: "", message: "expected one Unicode scalar" } }
      other => decodeMismatch ("one Unicode scalar", other)
    }
  }
}

fn validRuneString (value: String): Bool unsafe go {
  import "unicode/utf8"
  return utf8.ValidString(value) && utf8.RuneCountInString(value) == 1
}

// Defaults selects the standard primitive and container codecs.
instances Defaults { decodeInt8, encodeInt8, decodeInt16, encodeInt16, decodeInt32, encodeInt32, decodeUint8, encodeUint8, decodeUint16, encodeUint16, decodeUint32, encodeUint32, decodeUint64, encodeUint64, decodeFloat32, encodeFloat32, decodeInt, decodeFloat, decodeString, decodeBool, decodeOption, decodeList, decodeMap, decodeValue, encodeInt, encodeFloat, encodeString, encodeBool, encodeOption, encodeList, encodeMap, encodeValue, encodeRune, decodeRune }
