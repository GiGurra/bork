fn (data: Bytes) ReadInt8(offset: Int): Int8 | BinaryError unsafe go {
  if !inBounds(data, offset, 1) { return boundsError(data, offset, 1) }
  return int8(data[offset])
}
fn (data: Bytes) WriteInt8(offset: Int, value: Int8): Bytes | BinaryError unsafe go {
  if !inBounds(data, offset, 1) { return boundsError(data, offset, 1) }
  result := _borkBytesFrom(data)
  result[offset] = byte(value)
  return result
}
