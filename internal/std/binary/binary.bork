fn (data: Bytes) ReadInt64(offset: Int, order: ByteOrder): Int | BinaryError unsafe go {
  import gobinary "encoding/binary"
  if !inBounds(data, offset, 8) { return boundsError(data, offset, 8) }
  if littleEndian(order) { return int64(gobinary.LittleEndian.Uint64(data[offset:])) }
  return int64(gobinary.BigEndian.Uint64(data[offset:]))
}
fn (data: Bytes) WriteInt64(offset: Int, value: Int, order: ByteOrder): Bytes | BinaryError unsafe go {
  import gobinary "encoding/binary"
