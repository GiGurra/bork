import "bork/codec"
import "bork/process"
import codecs "bork/json"
use codec.Defaults
// Command keeps typed handlers behind a closed effect bound. Construct leaves
// with Subcommand and branches with Group; metadata can be changed with copy.
type Command = {
  name: String
  description: String
  execute: (String, List[String], Scope) uses io + net + clock + random + state => Ok | Error | Help
  aliases: List[String] = []
  longDescription: String = ""
  examples: String = ""
  hidden: Bool = false
  children: List[Command] = []
  group: Bool = false
  factory: Option[(String, Scope) uses nothing => adapter | Error] = Option.None
  apply: Option[(parsedInput, Scope) uses io + net + clock + random + state => Ok | Error] = Option.None
}

// Subcommand keeps the handler typed; only validated options reach it.
fn Subcommand[T: codec.Decode](name: String, description: String, run: (T, Scope) uses io + net + clock + random + state => Ok, flags: List[Flag] = [], configFiles: List[String] = [], settings: Settings = .{}): Command {
  makeSubcommand[T](name, description, run, configFiles, resolve[T](flags, settings, name), inputFields[T](name), settings.completion, [])
}
fn makeSubcommand[T: codec.Decode](name: String, description: String, run: (T, Scope) uses io + net + clock + random + state => Ok, configFiles: List[String], resolved: List[FieldSpec] | Error, schema: List[inputField] | Error, completionEnabled: Bool, completions: List[Completion]): Command {
  factory = nativeFactory(description, configFiles, resolved, schema, completions, codecs.Parse, flagName, invokeCompletion, buildAdapter)
  apply: (parsedInput, Scope) uses io + net + clock + random + state => Ok | Error = (input, s) => match (codec.decode[T](input.value)) {
    error: codec.DecodeError => withWarnings(Error { errors: [error] }, input.warnings, input.path)
    options: T => {
      for (warning in input.warnings) { printError(s"${warning}\n") }
      run(options, s)
    }
  }
  Command {
    name: name
    description: description
    factory: Option.Some { value: factory }
    apply: Option.Some { value: apply }
    execute: (displayName, arguments, s) => match (factory(displayName, s)) {
      error: Error => error
      prepared: adapter => match (evaluate(prepared, arguments, completionEnabled, configureCompletion)) {
        error: Error => error
        help: Help => help
        input: parsedInput => apply(input, s)
      }
    }
  }
}

// The owner registers only a no-op native-handle finalizer. Captured metadata
// and callbacks live with the returned Command, and are not retained in owner.
// The trusted factory avoids charging their lifetime to that unrelated scope.
fn nativeFactory(description: String, configFiles: List[String], resolved: List[FieldSpec] | Error, schema: List[inputField] | Error, completions: List[Completion], parse: (String) uses nothing => codec.Value | codecs.JsonError, makeName: (String) uses nothing => String, invoke: (Completion, CompletionRequest) uses io + net + clock + random + state => Suggestions | Error, build: nativeBuilder): (String, Scope) uses nothing => adapter | Error unsafe go {
  return func(displayName string, owner *_Scope) any {
    if failure, bad := resolved.(Error); bad { return failure }
    if failure, bad := schema.(Error); bad { return failure }
    return build(displayName, description, resolved.([]FieldSpec), schema.([]inputField), configFiles, parse, makeName, completions, invoke, owner)
  }
}

// Group is a routing branch without options or a handler.
fn Group(name: String, description: String, children: List[Command]): Command {
  Command {
    name: name
    description: description
    group: true
    children: children
    execute: (displayName, arguments, s) => Dispatch(displayName, description, arguments, children)
  }
}

// Dispatch accepts explicit arguments without the executable name. Completion
// settings belong to this entrypoint, and apply to the entire command tree.
fn Dispatch(name: String, description: String, arguments: List[String], commands: List[Command], settings: Settings = .{}) uses io + net + clock + random + state: Ok | Error | Help {
  scope s { dispatch(name, description, arguments, commands, s, settings.completion, configureCompletion) }
}

fn dispatch(name: String, description: String, arguments: List[String], commands: List[Command], s: Scope, completion: Bool, configure: (nativeCommand, List[String], Bool) => Error | Ok) uses io + net + clock + random + state: Ok | Error | Help unsafe go {
  import "bytes"
  import "fmt"
  import "strings"
  import "unicode"
  import "github.com/spf13/cobra"
  failures := []codec.DecodeError{}
  validName := func(name string) bool {
    return name != "" && !strings.HasPrefix(name, "-") && strings.IndexFunc(name, func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '-' && r != '_' }) < 0
  }
  var validate func([]Command, string)
  validate = func(commands []Command, path string) {
    if len(commands) == 0 { failures = append(failures, codec.DecodeError{path: path, message: "CLI needs at least one subcommand"}) }
    seen := map[string]bool{}
    for i, command := range commands {
      at := fmt.Sprintf("%s[%d]", path, i)
      names := append([]string{command.name}, command.aliases...)
      for j, name := range names {
        field := at+".name"
        if j > 0 { field = fmt.Sprintf("%s.aliases[%d]", at, j-1) }
        if !validName(name) { failures = append(failures, codec.DecodeError{path: field, message: "subcommand name must contain only letters, digits, hyphens, or underscores and not start with a hyphen"}) }
        if name == "help" || name == "completion" || name == "__complete" || name == "__completeNoDesc" { failures = append(failures, codec.DecodeError{path: field, message: "subcommand name " + name + " is reserved"}) }
        if seen[name] { failures = append(failures, codec.DecodeError{path: field, message: "duplicate subcommand name " + name}) }
        seen[name] = true
      }
      if command.group { validate(command.children, at+".children") } else if len(command.children) != 0 { failures = append(failures, codec.DecodeError{path: at+".children", message: "only a Group can have children"}) }
    }
  }
  validate(commands, "commands")
  if len(failures) != 0 { return Error{errors: failures} }
  var output, diagnostics bytes.Buffer
  var result any
  ran := false
  root := &cobra.Command{Use: name, Short: description, SilenceUsage: true, SilenceErrors: true}
  root.SetOut(&output)
  root.SetErr(&diagnostics)
  warnings := func() []string {
    lines := []string{}
    for _, line := range strings.Split(strings.TrimSpace(diagnostics.String()), "\n") { if line != "" { lines = append(lines, line) } }
    return lines
  }
  var attach func(*cobra.Command, []Command) error
  attach = func(parent *cobra.Command, commands []Command) error {
    for _, command := range commands {
      var child *cobra.Command
      if command.group {
        child = &cobra.Command{Use: command.name}
        if err := attach(child, command.children); err != nil { return err }
      } else if factory, native := _borkOptionGet(command.factory); native {
        built := factory(command.name, s)
        if failure, bad := built.(Error); bad { result = failure; return fmt.Errorf("invalid options for %s", command.name) }
        prepared := built.(adapter)
        child = prepared.native.handle.(*cobra.Command)
        collect := child.RunE
        child.RunE = func(cmd *cobra.Command, args []string) error {
          if err := collect(cmd, args); err != nil { return err }
          ran = true
          value := prepared.result()
          if failure, bad := value.(Error); bad {
            for _, warning := range warnings() { failure.errors = append(failure.errors, codec.DecodeError{path: cmd.CommandPath(), message: warning}) }
            result = failure
            return nil
          }
          apply, supplied := _borkOptionGet(command.apply)
          if !supplied { result = Error{errors: []codec.DecodeError{{path: cmd.CommandPath(), message: "native command has no typed handler"}}}; return nil }
          result = apply(parsedInput{value: value.(codec.Value), warnings: warnings(), path: cmd.CommandPath()}, s)
          diagnostics.Reset()
          return nil
        }
      } else {
        // Preserve manually constructed execute callbacks without schema completion.
        child = &cobra.Command{Use: command.name, DisableFlagParsing: true}
        child.Run = func(cmd *cobra.Command, args []string) { ran = true; result = command.execute(cmd.CommandPath(), args, s) }
        child.SetHelpFunc(func(cmd *cobra.Command, _ []string) {
          value := command.execute(cmd.CommandPath(), []string{"--help"}, s)
          if help, ok := value.(Help); ok { _, _ = fmt.Fprint(cmd.OutOrStdout(), help.text); _, _ = fmt.Fprint(cmd.ErrOrStderr(), help.diagnostics) } else { ran = true; result = value }
        })
      }
      child.Short, child.Long, child.Example = command.description, command.longDescription, command.examples
      child.Aliases, child.Hidden = append([]string{}, command.aliases...), command.hidden
      child.SilenceUsage, child.SilenceErrors = true, true
      child.Flags().SetOutput(&diagnostics)
      parent.AddCommand(child)
    }
    return nil
  }
  if err := attach(root, commands); err != nil {
    if failure, ok := result.(Error); ok { return failure }
    return Error{errors: []codec.DecodeError{{path: name, message: err.Error()}}}
  }
  root.SetHelpCommand(&cobra.Command{
    Use: "help [command...]", Short: "Help about any command",
    RunE: func(_ *cobra.Command, args []string) error {
      target, remaining, err := root.Find(args)
      if err != nil { return err }
      if len(remaining) != 0 { return fmt.Errorf("unknown help target %q", strings.Join(args, " ")) }
      return target.Help()
    },
  })
  root.InitDefaultHelpFlag()
  root.InitDefaultHelpCmd()
  if failure, bad := configure(nativeCommand{handle: root, owner: s.Own(func() {})}, arguments, completion).(Error); bad { return failure }
  root.SetArgs(append([]string{}, arguments...))
  if err := root.Execute(); err != nil {
    failures := []codec.DecodeError{{path: name, message: err.Error()}}
    for _, warning := range warnings() { failures = append(failures, codec.DecodeError{path: name, message: warning}) }
    return Error{errors: failures}
  }
  if !ran { return Help{text: output.String(), diagnostics: diagnostics.String()} }
  return result
}

// RunCommands reads process arguments and prints help, scripts and protocol text.
fn RunCommands(name: String, description: String, commands: List[Command], settings: Settings = .{}) uses io + net + clock + random + state: Ok | Error {
  match (Dispatch(name, description, process.Args(), commands, settings)) {
    help: Help => { print(help.text); printError(help.diagnostics) }
    error: Error => error
    Ok => {}
  }
}
