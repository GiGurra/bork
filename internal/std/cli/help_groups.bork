// HelpGroup controls one native heading, separate from routing Groups.
type HelpGroup = { id: String, title: String }

fn configureHelpGroups(native: nativeCommand, groups: List[HelpGroup], children: List[Command]): Ok | Error unsafe go {
  import "strings"
  import "unicode"
  import "github.com/spf13/cobra"
  cmd := native.handle.(*cobra.Command)
  failures := []codec.DecodeError{}
  definitions := []*cobra.Group{}
  seen := map[string]bool{}
  validID := func(id string) bool {
    return id != "" && !strings.HasPrefix(id, "-") && strings.IndexFunc(id, func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '-' && r != '_' }) < 0
  }
  fail := func(message string) { failures = append(failures, codec.DecodeError{path: cmd.CommandPath(), message: message}) }
  for _, group := range groups {
    if !validID(group.id) { fail("help group id must contain only letters, digits, hyphens, or underscores and not start with a hyphen") }
    if strings.TrimSpace(group.title) == "" || strings.ContainsAny(group.title, "\r\n") { fail("help group title must be nonempty and contain no newlines") }
    if seen[group.id] { fail("duplicate help group id " + group.id) }
    seen[group.id] = true
    definitions = append(definitions, &cobra.Group{ID: group.id, Title: group.title})
  }
  // Read declaration order, before Cobra's Commands() sorts by command name.
  for _, child := range children {
    if child.helpGroup == "" { continue }
    if !validID(child.helpGroup) { fail("invalid help group id for command " + child.name) }
    if seen[child.helpGroup] { continue }
    seen[child.helpGroup] = true
    definitions = append(definitions, &cobra.Group{ID: child.helpGroup, Title: child.helpGroup+":"})
  }
  if len(failures) != 0 { return Error{errors: failures} }
  cmd.AddGroup(definitions...)
  return _Ok{}
}
