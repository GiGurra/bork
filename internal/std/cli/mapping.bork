import codec "bork/codec"
use codec.Defaults

// Mapping separates automatic policy, source disabling, and exact names.
type Mapping = sealed { Auto, Disabled, Named { name: String } }
type Choice = { value: String, description: String = "" }
type Settings = {
  version: String = ""
  helpGroups: List[HelpGroup] = []
  completion: Bool = true
  autoLong: Bool = true
  autoShort: Bool = false
  autoEnv: Bool = false
  flagPrefix: String = ""
  envPrefix: String = ""
  enrichers: List[Enricher] = []
}
// FieldAliases contains alternative derived names, visible to enrichers.
type FieldAliases = { long: List[String] = [], env: List[String] = [] }
// FieldSpec is the immutable metadata passed through each enricher.
type FieldSpec = {
  field: String
  aliases: FieldAliases = FieldAliases {}
  long: Mapping
  short: Mapping
  env: Mapping
  description: String
  positional: Bool
  position: Option[Int] = Option.None
  configFile: Bool
  config: Bool
  hidden: Bool
  deprecated: String
  collection: Collection = Collection.Repeat
  choices: List[Choice] = []
  strictChoices: Bool = false
  files: Bool = false
  directories: Bool = false
  keepOrder: Bool = false
}
type Enricher = (List[FieldSpec], FieldSpec) uses nothing => FieldSpec

fn resolve[T: codec.Decode](flags: List[Flag], settings: Settings, name: String): List[FieldSpec] | Error {
  resolveFields[T](flags, settings, name, flagName)
}
fn resolveFields[T: codec.Decode](flags: List[Flag], settings: Settings, name: String, makeName: (String) => String): List[FieldSpec] | Error {
  resolveFieldsWithSchema[T](codec.Schema[T](), flags, settings, name, makeName)
}
type resolvedFields = { fields: List[FieldSpec], automaticShorts: List[String] }
fn resolveFieldsWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], flags: List[Flag], settings: Settings, name: String, makeName: (String) => String): List[FieldSpec] | Error {
  match (resolveMetadataWithSchema[T](recordSchema, flags, settings, name, makeName)) {
    error: Error => error
    resolved: resolvedFields => resolved.fields
  }
}
fn resolveMetadataWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], flags: List[Flag], settings: Settings, name: String, makeName: (String) => String): resolvedFields | Error unsafe go {
  import "fmt"
  import "strings"
  import "unicode"
  flattened := flattenRecordSchema(recordSchema, name)
  if failure, bad := flattened.(Error); bad { return failure }
  cliRecord := flattened.(cliSchema)
  record, supported := _borkOptionGet(cliRecord.record)
  schema := record.fields
  parentDefaults := map[string]codec.Value{}
  for _, leaf := range cliRecord.leaves { if value, present := _borkOptionGet(leaf.defaultValue); present { parentDefaults[leaf.field] = value } }
  hasDefault := func(field codec.RecordField) bool { _, inherited := parentDefaults[field.name]; return field.hasDefault || inherited }
  if !supported { return Error{errors: []codec.DecodeError{{path: name, message: "CLI options require a derived record decoder"}}} }
  errors := []codec.DecodeError{}
  fail := func(field, message string) { errors = append(errors, codec.DecodeError{path: field, message: message}) }
  metadata := map[string]Flag{}
  for _, flag := range flags {
    found := false
    for _, field := range schema { if field.name == flag.field { found = true; break } }
    if !found {
      closest, distance := "", int(^uint(0)>>1)
      for _, field := range schema {
        left, right := []rune(flag.field), []rune(field.name)
        row := make([]int, len(right)+1)
        for j := range row { row[j] = j }
        for i, a := range left {
          prev := row[0]; row[0] = i+1
          for j, b := range right { old := row[j+1]; cost := 0; if a != b { cost = 1 }; row[j+1] = min(row[j]+1, row[j+1]+1, prev+cost); prev = old }
        }
        d := row[len(right)]
        if d < distance || d == distance && field.name < closest { closest, distance = field.name, d }
      }
      message := "unknown CLI field"
      if closest != "" { message += fmt.Sprintf("; closest field is %q", closest) }
      fail(flag.field, message); continue
    }
    if _, duplicate := metadata[flag.field]; duplicate { fail(flag.field, "duplicate CLI field metadata"); continue }
    if flag.short != "" {
      if _, auto := flag.shortName.(Mapping_Auto); !auto { fail(flag.field, "short and shortName cannot both be specified") }
      flag.shortName = Mapping_Named{name: flag.short}
    }
    if flag.env != "" {
      if _, auto := flag.envName.(Mapping_Auto); !auto { fail(flag.field, "env and envName cannot both be specified") }
      flag.envName = Mapping_Named{name: flag.env}
    }
    metadata[flag.field] = flag
  }
  if len(errors) != 0 { return Error{errors: errors} }
  nameOf := func(mapping Mapping) string {
    if named, ok := mapping.(Mapping_Named); ok { return named.name }
    return ""
  }
  prefix := func(prefix, separator, name string) string {
    if prefix == "" { return name }
    return prefix+separator+name
  }
  // Reserve explicit shorts even on later fields before assigning automatic ones.
  occupied := map[string]bool{"h": true}
  for _, flag := range metadata { if short := nameOf(flag.shortName); short != "" { occupied[short] = true } }
  specs := []FieldSpec{}
  automaticShorts := []string{}
  names, shorts, envs := map[string]string{}, map[string]string{}, map[string]string{}
  positional, configField := "", ""
  positions := map[int64]string{}
  positionalNames := map[string]string{}
  schemaIndex := map[string]int{}
  for i, field := range schema { schemaIndex[field.name] = i }
  isPositional := func(spec FieldSpec) bool { _, positioned := spec.position.(Option_Some[int64]); return spec.positional || positioned }
  validLong := func(name string) bool {
    return name != "" && !strings.HasPrefix(name, "-") && strings.IndexFunc(name, func(r rune) bool { return !unicode.IsLetter(r) && !unicode.IsDigit(r) && r != '-' && r != '_' }) < 0
  }
  validEnv := func(name string) bool {
    if name == "" { return false }
    for i, r := range name { if r != '_' && !(r >= 'A' && r <= 'Z') && !(r >= 'a' && r <= 'z') && !(i > 0 && r >= '0' && r <= '9') { return false } }
    return true
  }
  for _, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    words := field.words
    if len(words) == 0 { words = _borkCodecWords(key) }
    basis := strings.Join(words, "-")
    flag, exists := metadata[field.name]
    if !exists { flag = Flag{field: field.name, long: Mapping_Auto{}, shortName: Mapping_Auto{}, envName: Mapping_Auto{}, description: Option_None[string]{}, config: true, position: Option_None[int64]{}} }
    doc := field.doc
    if description, ok := flag.description.(Option_Some[string]); ok { doc = description.E0 }
    spec := FieldSpec{field: field.name, long: flag.long, short: flag.shortName, env: flag.envName, description: doc, positional: flag.positional, position: flag.position, configFile: flag.configFile, config: flag.config, hidden: flag.hidden, deprecated: flag.deprecated, choices: flag.choices, strictChoices: flag.strictChoices, files: flag.files, directories: flag.directories, keepOrder: flag.keepOrder}
    mode := fieldCollection(field)
    if failure, bad := mode.(codec.DecodeError); bad { fail(field.name, "invalid cli tag group: " + failure.message) } else { spec.collection = mode.(Collection) }
    if len(spec.choices) == 0 && (field.kind == "string" || field.kind == "list:string") { for _, variant := range field.variants { spec.choices = append(spec.choices, Choice{value:variant.name, description:strings.Join(strings.Fields(variant.doc), " ")}) } }
    automaticShort := false
    derive := func(spec FieldSpec) FieldSpec {
      if _, auto := spec.long.(Mapping_Auto); auto {
        spec.long = Mapping_Disabled{}
        if settings.autoLong && !isPositional(spec) { spec.long = Mapping_Named{name: prefix(settings.flagPrefix, "-", makeName(basis))} }
      }
      long := nameOf(spec.long)
      if _, auto := spec.short.(Mapping_Auto); auto {
        spec.short = Mapping_Disabled{}
        if settings.autoShort && long != "" && !isPositional(spec) && long[0] < 128 && unicode.IsLetter(rune(long[0])) && !occupied[long[:1]] {
          spec.short = Mapping_Named{name: long[:1]}
          automaticShort = true
        }
      }
      if _, auto := spec.env.(Mapping_Auto); auto {
        spec.env = Mapping_Disabled{}
        if settings.autoEnv && !isPositional(spec) {
          base := long
          if base == "" { base = makeName(basis) }
          spec.env = Mapping_Named{name: prefix(settings.envPrefix, "_", strings.ToUpper(strings.ReplaceAll(base, "-", "_")))}
        }
      }
      return spec
    }
    spec = derive(spec)
    for _, alias := range field.aliases {
      aliasBasis := alias
      for _, leaf := range flattened.(cliSchema).leaves { if leaf.field == field.name { for _, path := range leaf.aliases { if len(path) > 1 && strings.Join(path, ".") == alias { words := []string{}; for _, segment := range path { words = append(words, _borkCodecWords(segment)... ) }; aliasBasis = strings.Join(words, "-"); break } } } }
      aliasLong := makeName(aliasBasis)
      if nameOf(spec.long) != "" { aliasLong = prefix(settings.flagPrefix, "-", aliasLong); spec.aliases.long = append(spec.aliases.long, aliasLong) }
      if settings.envPrefix != "" && nameOf(spec.env) != "" {
        spec.aliases.env = append(spec.aliases.env, prefix(settings.envPrefix, "_", strings.ToUpper(strings.ReplaceAll(aliasLong, "-", "_"))))
      }
    }
    for _, enrich := range settings.enrichers {
      before := spec.short
      spec = enrich(append([]FieldSpec{}, specs...), spec)
      if spec.short != before { automaticShort = false }
    }
    if spec.field != field.name { fail(field.name, "enricher must preserve field identity") }
    spec = derive(spec)
    switch spec.collection.(type) {
    case Collection_Csv:
      if !strings.HasPrefix(field.kind, "list:") { fail(field.name, "Csv collection requires a List field") }
    case Collection_KeyValue:
      kind := strings.TrimPrefix(field.kind, "map:")
      if !strings.HasPrefix(field.kind, "map:") || kind != "string" && kind != "number" && kind != "bool" { fail(field.name, "KeyValue collection requires a Map[String, V] with string, number, or bool input values") }
    }
    for _, group := range flattened.(cliSchema).groups { if group.field == field.name && isPositional(spec) { fail(field.name, "record groups cannot be positional arguments") } }
    if spec.configFile && strings.Contains(field.name, ".") { fail(field.name, "nested configuration-file selectors are not supported") }
    long, short, env := nameOf(spec.long), nameOf(spec.short), nameOf(spec.env)
    if long == "" || isPositional(spec) { spec.aliases.long = nil }
    if env == "" || isPositional(spec) { spec.aliases.env = nil }
    if _, named := spec.long.(Mapping_Named); named {
      if !validLong(long) { fail(field.name, "long flag must contain letters, digits, hyphens, or underscores and not start with a hyphen") }
      if long == "help" { fail(field.name, "flag name is reserved for help") }
      if isPositional(spec) { fail(field.name, "positional field cannot have a long flag") }
      if previous, duplicate := names[long]; duplicate { fail(field.name, "flag name duplicates " + previous) }
      names[long] = field.name
    }
    for _, alias := range spec.aliases.long {
      if !validLong(alias) || alias == "help" { fail(field.name, "invalid or reserved alias flag name") }
      if previous, duplicate := names[alias]; duplicate { fail(field.name, "alias flag name duplicates " + previous) }
      names[alias] = field.name
    }
    if _, named := spec.short.(Mapping_Named); named {
      if len(short) != 1 || short[0] > 127 { fail(field.name, "short flag must be one ASCII character") }
      if short == "h" { fail(field.name, "short flag h is reserved for help") }
      if long == "" || isPositional(spec) { fail(field.name, "short flag requires an enabled long flag") }
      if previous, duplicate := shorts[short]; duplicate { fail(field.name, "short flag duplicates " + previous) }
      shorts[short] = field.name
      occupied[short] = true
    }
    if _, named := spec.env.(Mapping_Named); named {
      if !validEnv(env) { fail(field.name, "environment variable must be an identifier") }
      if previous, duplicate := envs[env]; duplicate { fail(field.name, "environment variable duplicates " + previous) }
      envs[env] = field.name
    }
    for _, alias := range spec.aliases.env {
      if !validEnv(alias) { fail(field.name, "alias environment variable must be an identifier") }
      if previous, duplicate := envs[alias]; duplicate { fail(field.name, "alias environment variable duplicates " + previous) }
      envs[alias] = field.name
    }
    if isPositional(spec) {
      display := makeName(basis)
      if !validLong(display) { fail(field.name, "positional name must contain letters, digits, hyphens, or underscores") }
      if previous, duplicate := positionalNames[display]; duplicate { fail(field.name, "positional name duplicates " + previous) }
      positionalNames[display] = field.name
    }
    if spec.positional {
      if positional != "" { fail(field.name, "positional field duplicates " + positional) }
      positional = field.name
    }
    if position, positioned := spec.position.(Option_Some[int64]); positioned {
      if spec.positional { fail(field.name, "position and positional cannot both be specified") }
      if position.E0 < 0 { fail(field.name, "position must be nonnegative") }
      if previous, duplicate := positions[position.E0]; duplicate { fail(field.name, "position duplicates " + previous) }
      positions[position.E0] = field.name
      spec.positional = true
    }
    if spec.configFile {
      if configField != "" { fail(field.name, "config-file field duplicates " + configField) }
      if field.kind != "string" || field.typeName != "String" && field.typeName != "Option[String]" { fail(field.name, "config-file field must be String or Option[String]") }
      configField = field.name
    }
    if spec.files && spec.directories { fail(field.name, "choose files or directories, not both") }
    for _, choice := range spec.choices {
      if choice.value == "" || strings.ContainsAny(choice.value+choice.description, "\t\n\r") { fail(field.name, "completion choices must be nonempty and contain no tabs or newlines") }
    }
    if spec.strictChoices {
      if field.typeName != "String" && field.typeName != "Option[String]" && field.typeName != "List[String]" && field.typeName != "Option[List[String]]" { fail(field.name, "strict choices require String or List[String], optionally wrapped in Option") }
      if len(spec.choices) == 0 { fail(field.name, "strict choices require at least one choice") }
      allowed := map[string]bool{}
      for _, choice := range spec.choices { allowed[choice.value] = true }
      if hasDefault(field) {
        defaults := []string{}
        if input, inherited := parentDefaults[field.name]; inherited {
          var choices func(codec.Value)
          choices = func(value codec.Value) {
            if text, ok := value.(codec.Value_String); ok { defaults = append(defaults, text.value) }
            if list, ok := value.(codec.Value_Array); ok { for _, item := range list.items { choices(item) } }
          }
          choices(input)
        } else if provider, found := _borkOptionGet(field.defaultValue); found { defaults = provider().choices }
        for _, value := range defaults { if !allowed[value] { fail(field.name, "default is not one of the allowed choices"); break } }
      }
    }
    specs = append(specs, spec)
    if automaticShort && short != "" { automaticShorts = append(automaticShorts, long) }
  }
  if len(positions) != 0 {
    if positional != "" { fail(positional, "cannot mix positional shorthand with indexed positions") }
    earlierOptional := ""
    for i := 0; i < len(positions); i++ {
      name, found := positions[int64(i)]
      if !found { fail("position", "positions must be contiguous starting at zero"); continue }
      field := schema[schemaIndex[name]]
      keyValue := false
      for _, positionalSpec := range specs { if positionalSpec.field == name { _, keyValue = positionalSpec.collection.(Collection_KeyValue); break } }
      list := strings.HasPrefix(field.kind, "list:") || keyValue
      if list && i != len(positions)-1 {
        if keyValue { fail(name, "a KeyValue positional must be last") } else { fail(name, "a List positional must be last") }
      }
      if !list && !field.optional && !hasDefault(field) && earlierOptional != "" { fail(name, "required positional cannot follow optional/default positional " + earlierOptional) }
      if !list && (field.optional || hasDefault(field)) { earlierOptional = name }
    }
  }
  if len(errors) != 0 { return Error{errors: errors} }
  return resolvedFields{fields: specs, automaticShorts: automaticShorts}
}
