import "bork/codec"
import codecs "bork/json"
use codec.Defaults
// The private adapter shares boa registration between parsing and command trees.
// Mutable native commands are private handles owned by the parse/dispatch scope.
type nativeCommand = resource
type inputField = {
  field: String
  kind: String
  optional: Bool
  hasDefault: Bool
  defaultFalse: Bool
  defaultText: String
  configDefault: String
  validate: (codec.Value) uses nothing => Ok | codec.DecodeError
}
type nativeBuilder = (String, String, List[FieldSpec], List[inputField], List[String], (String) uses nothing => codec.Value | codecs.JsonError, (String) uses nothing => String, List[Completion], (Completion, CompletionRequest) uses io + net + clock + random + state => Suggestions | Error, Scope) uses nothing => adapter | Error
type pending = {}
type inputCollection = { fields: List[codec.Field], errors: List[codec.DecodeError] }
type adapter = { native: nativeCommand, result: () uses io => codec.Value | Error | pending }
type parsedInput = { value: codec.Value, warnings: List[String], path: String }

fn inputFields[T: codec.Decode](name: String): List[inputField] | Error {
  inputFieldsWithSchema[T](codec.Schema[T](), name)
}
fn inputFieldsWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], name: String): List[inputField] | Error unsafe go {
  record, supported := _borkOptionGet(recordSchema)
  schema := record.fields
  if !supported { return Error{errors: []codec.DecodeError{{path: name, message: "CLI options require a derived record decoder"}}} }
  fields := []inputField{}
  for _, field := range schema {
    text, path := "", ""
    if provider, found := _borkOptionGet(field.defaultValue); found {
      value := provider()
      text = value.display
      path, _ = _borkOptionGet(value.configPath)
    }
    // CLI switches default to false independently of the record decoder.
    defaultFalse := field.kind == "bool" && !field.optional && !field.hasDefault
    if defaultFalse { text = "false" }
    fields = append(fields, inputField{field: field.name, kind: field.kind, optional: field.optional, hasDefault: field.hasDefault || defaultFalse, defaultFalse: defaultFalse, defaultText: text, configDefault: path, validate: func(value codec.Value) any {
      if err, bad := field.validate(value).(codec.DecodeError); bad { return err }
      return _Ok{}
    }})
  }
  return fields
}
fn parseInput(name: String, description: String, args: List[String], specs: List[FieldSpec], fields: List[inputField], configFiles: List[String], completion: Bool) uses io: parsedInput | Error | Help {
  scope s {
    match (buildAdapter(name, description, specs, fields, configFiles, codecs.Parse, flagName, [], invokeCompletion, s)) {
      error: Error => error
      prepared: adapter => evaluate(prepared, args, completion, configureCompletion)
    }
  }
}
fn buildAdapter(name: String, description: String, specs: List[FieldSpec], schema: List[inputField], configFiles: List[String], parse: (String) => codec.Value | codecs.JsonError, makeName: (String) => String, completions: List[Completion], invoke: (Completion, CompletionRequest) uses io + net + clock + random + state => Suggestions | Error, s: Scope): adapter | Error unsafe go {
  return buildCommandAdapter(name, description, specs, schema, configFiles, parse, makeName, completions, invoke, false, s)
}
fn buildRootAdapter(name: String, description: String, specs: List[FieldSpec], schema: List[inputField], configFiles: List[String], parse: (String) => codec.Value | codecs.JsonError, makeName: (String) => String, completions: List[Completion], invoke: (Completion, CompletionRequest) uses io + net + clock + random + state => Suggestions | Error, s: Scope): adapter | Error unsafe go {
  return buildCommandAdapter(name, description, specs, schema, configFiles, parse, makeName, completions, invoke, true, s)
}
fn buildCommandAdapter(name: String, description: String, specs: List[FieldSpec], schema: List[inputField], configFiles: List[String], parse: (String) => codec.Value | codecs.JsonError, makeName: (String) => String, completions: List[Completion], invoke: (Completion, CompletionRequest) uses io + net + clock + random + state => Suggestions | Error, persistent: Bool, s: Scope): adapter | Error unsafe go {
  import "fmt"
  import "path/filepath"
  import "reflect"
  import "sort"
  import "strconv"
  import "strings"
  import "github.com/GiGurra/boa/pkg/boa"
  import "github.com/spf13/cobra"
  mappingName := func(mapping Mapping) string {
    if named, ok := mapping.(Mapping_Named); ok { return named.name }
    return ""
  }
  configField := ""
  metadata := map[string]FieldSpec{}
  kinds := map[string]string{}
  for _, field := range schema { kinds[field.field] = field.kind }
  for _, spec := range specs {
    metadata[spec.field] = spec
    if spec.configFile { configField = spec.field }
  }
  positionalIndex := func(spec FieldSpec) int {
    if position, specified := spec.position.(Option_Some[int64]); specified { return int(position.E0) }
    return 0
  }
  schema = append([]inputField{}, schema...)
  indexed := false
  for _, spec := range specs { if _, positioned := spec.position.(Option_Some[int64]); positioned { indexed = true } }
  if indexed {
    sort.SliceStable(schema, func(i, j int) bool {
      left, right := metadata[schema[i].field], metadata[schema[j].field]
      if left.positional != right.positional { return left.positional }
      return left.positional && positionalIndex(left) < positionalIndex(right)
    })
  }
  dynamic := map[string]Completion{}
  for _, completion := range completions {
    spec, known := metadata[completion.field]
    if !known { return Error{errors: []codec.DecodeError{{path: completion.field, message: "unknown CLI completion field"}}} }
    if _, duplicate := dynamic[completion.field]; duplicate { return Error{errors: []codec.DecodeError{{path: completion.field, message: "duplicate CLI completion field"}}} }
    if !spec.positional && mappingName(spec.long) == "" { return Error{errors: []codec.DecodeError{{path: completion.field, message: "completion field needs an enabled flag or positional"}}} }
    dynamic[completion.field] = completion
  }
  fields := make([]reflect.StructField, len(schema))
  for i, field := range schema {
    typ := reflect.TypeFor[*string]()
    if field.kind == "bool" { typ = reflect.TypeFor[*bool]() }
    list := strings.HasPrefix(field.kind, "list:")
    if list { typ = reflect.TypeFor[*[]string]() }
    flag := metadata[field.field]
    doc := flag.description
    if field.hasDefault { doc += " (default " + field.defaultText + ")" } else if !field.optional { doc += " (required)" }
    tag := "optional:\"true\" descr:" + strconv.Quote(strings.TrimSpace(doc))
    if persistent { tag += " persistent:\"true\"" }
    if list { tag += " collection:\"array\"" }
    if short := mappingName(flag.short); short != "" { tag += " short:" + strconv.Quote(short) }
    policies := []string{}
    if env := mappingName(flag.env); env != "" { tag += " env:" + strconv.Quote(env) } else { policies = append(policies, "noenv") }
    if flag.positional { tag += " positional:\"true\"" }
    // Synthetic exported fields retain the original name as an explicit boa tag.
    long := mappingName(flag.long)
    if long == "" {
      if flag.positional { long = makeName(field.field) } else {
        long = fmt.Sprintf("bork-field-%d", i)
        policies = append(policies, "noflag")
      }
    }
    if len(policies) != 0 { tag += " boa:" + strconv.Quote(strings.Join(policies, ",")) }
    tag += " long:" + strconv.Quote(long)
    fields[i] = reflect.StructField{Name: fmt.Sprintf("Field%d", i), Type: typ, Tag: reflect.StructTag(tag)}
  }
  shadow := reflect.New(reflect.StructOf(fields))
  var result any = pending{}
  collect := func(arguments []string, partial bool) any {
      // Boa joins List positionals with commas. Keep original words, including
      // commas, whitespace and JSON compound elements, after its raw binding.
      for i, field := range schema {
        spec := metadata[field.field]
        if !spec.positional || !strings.HasPrefix(field.kind, "list:") { continue }
        index := positionalIndex(spec)
        if len(arguments) > index {
          values := append([]string{}, arguments[index:]...)
          shadow.Elem().Field(i).Set(reflect.ValueOf(&values))
        }
      }
      files := append([]string{}, configFiles...)
      for i, field := range schema {
        if field.field != configField { continue }
        path := ""
        value := shadow.Elem().Field(i)
        if !value.IsNil() { path = value.Elem().String() } else { path = field.configDefault }
        if path != "" { files = append(files, path) }
      }
      config := map[string]codec.Value{}
      var err error
      for _, path := range files {
        extension := strings.ToLower(filepath.Ext(path))
        isYaml := extension == ".yaml" || extension == ".yml"
        err = boa.LoadConfigFiles([]string{path}, &config, func(data []byte, target any) error {
          var parsed any
          if isYaml { parsed = parseYamlConfig(string(data)) } else { parsed = parse(string(data)) }
          if err, bad := parsed.(codecs.JsonError); bad { return fmt.Errorf("%s", err.message) }
          object, ok := parsed.(codec.Value_Object)
          if !ok { if isYaml { return fmt.Errorf("CLI config must be a YAML object") }; return fmt.Errorf("CLI config must be a JSON object") }
          values := target.(*map[string]codec.Value)
          for _, entry := range object.fields {
            known := false
            for _, field := range schema { if field.field == entry.name { known = true; break } }
            if !known { return fmt.Errorf("unknown CLI config field %q", entry.name) }
            if !metadata[entry.name].config { return fmt.Errorf("CLI config field %q is disabled", entry.name) }
            (*values)[entry.name] = entry.value
          }
          return nil
        })
        if err != nil { break }
      }
      if err != nil { return Error{errors: []codec.DecodeError{{path: name, message: err.Error()}}} }
      jsonFields := []codec.Field{}
      failures := []codec.DecodeError{}
      for i, field := range schema {
        value := shadow.Elem().Field(i)
        var json codec.Value
        if value.IsNil() {
          if configured, exists := config[field.field]; exists { json = configured } else if field.defaultFalse && !partial { json = codec.Value_Bool{value: false} } else {
            if partial || field.hasDefault { continue }
            if !field.optional { failures = append(failures, codec.DecodeError{path: "." + field.field, message: "is missing"}); continue }
            json = codec.Value_Null{}
          }
        } else if strings.HasPrefix(field.kind, "list:") {
          values := []codec.Value{}
          invalid := false
          for j, raw := range value.Elem().Interface().([]string) {
            if strings.TrimPrefix(field.kind, "list:") == "string" { values = append(values, codec.Value_String{value: raw}); continue }
            parsed := parse(raw)
            if err, bad := parsed.(codecs.JsonError); bad { failures = append(failures, codec.DecodeError{path: fmt.Sprintf(".%s[%d]", field.field, j), message: err.message}); invalid = true; continue }
            values = append(values, parsed.(codec.Value))
          }
          if invalid { continue }
          json = codec.Value_Array{items: values}
        } else if field.kind == "bool" { json = codec.Value_Bool{value: value.Elem().Bool()} } else {
          raw := value.Elem().String()
          if field.kind == "string" { json = codec.Value_String{value: raw} } else {
            parsed := parse(raw)
            if err, bad := parsed.(codecs.JsonError); bad { failures = append(failures, codec.DecodeError{path: "." + field.field, message: err.message}); continue }
            json = parsed.(codec.Value)
          }
        }
        spec := metadata[field.field]
        if spec.strictChoices {
          allowed := map[string]bool{}
          for _, choice := range spec.choices { allowed[choice.value] = true }
          invalid := false
          checkChoice := func(value codec.Value, path string) {
            if text, ok := value.(codec.Value_String); ok && !allowed[text.value] { failures = append(failures, codec.DecodeError{path: path, message: "must be one of the allowed choices"}); invalid = true }
          }
          if array, ok := json.(codec.Value_Array); ok { for j, item := range array.items { checkChoice(item, fmt.Sprintf(".%s[%d]", field.field, j)) } } else { checkChoice(json, "."+field.field) }
          if invalid { continue }
        }
        if !partial { if err, bad := field.validate(json).(codec.DecodeError); bad { failures = append(failures, err); continue } }
        jsonFields = append(jsonFields, codec.Field{name: field.field, value: json})
      }
      return inputCollection{fields: jsonFields, errors: failures}
  }
  command := boa.Cmd{
    Use: name, Short: description, Params: shadow.Interface(),
    ParamEnrich: boa.ParamEnricherNone,
    RunFunc: func(cmd *cobra.Command, remaining []string) {
      collected := collect(remaining, false)
      if failure, bad := collected.(Error); bad { result = failure; return }
      input := collected.(inputCollection)
      if len(input.errors) != 0 { result = Error{errors: input.errors}; return }
      result = codec.Value_Object{fields: input.fields}

    },
  }
  cmd, err := command.ToCobraE()
  if err != nil { return Error{errors: []codec.DecodeError{{path: name, message: err.Error()}}} }
  declaring := cmd
  configuredFlags := cmd.Flags()
  if persistent { configuredFlags = cmd.PersistentFlags() }
  positionalCompletions := map[int]func(*cobra.Command, []string, string) ([]string, cobra.ShellCompDirective){}
  listPosition := -1
  for _, spec := range specs {
    long := mappingName(spec.long)
    complete := func(cmd *cobra.Command, args []string, prefix string) ([]string, cobra.ShellCompDirective) {
      if spec.positional && len(args) > positionalIndex(spec) && !strings.HasPrefix(kinds[spec.field], "list:") { return nil, cobra.ShellCompDirectiveNoFileComp }
      if completion, supplied := dynamic[spec.field]; supplied && !spec.hidden && spec.deprecated == "" {
        fail := func(errors []codec.DecodeError) ([]string, cobra.ShellCompDirective) {
          for _, failure := range errors { _, _ = fmt.Fprintf(cmd.ErrOrStderr(), "%s: %s\n", failure.path, failure.message) }
          return nil, cobra.ShellCompDirectiveError
        }
        // Cobra parses successful completion flags twice (with and without a
        // trailing --). Array values append on both passes; keep one copy of
        // that parse before boa synchronizes its mirrors into the shadow.
        for _, field := range specs {
          flag := cmd.Flags().Lookup(mappingName(field.long))
          if flag == nil || !flag.Changed { continue }
          if value, list := flag.Value.(interface { GetSlice() []string; Replace([]string) error }); list {
            values := value.GetSlice()
            if len(values)%2 == 0 { if err := value.Replace(values[:len(values)/2]); err != nil { return fail([]codec.DecodeError{{path: "."+field.field, message: err.Error()}}) } }
          }
        }
        // Reuse boa's ordinary positional/env binding pipeline on optional
        // raw pointers. It has no user hooks or complete-record decoder.
        if !persistent { if err := declaring.ValidateArgs(args); err != nil { return fail([]codec.DecodeError{{path: cmd.CommandPath(), message: err.Error()}}) } }
        bind := declaring.PreRunE
        if persistent { bind = declaring.PersistentPreRunE }
        if bind != nil { if err := bind(cmd, args); err != nil { return fail([]codec.DecodeError{{path: cmd.CommandPath(), message: err.Error()}}) } }
        collected := collect(args, true)
        if failure, bad := collected.(Error); bad { return fail(failure.errors) }
        input := collected.(inputCollection)
        snapshot := map[string]any{}
        for _, field := range schema { snapshot[field.field] = Missing{field: field.field} }
        for _, entry := range input.fields {
          for _, field := range schema { if entry.name == field.field { snapshot[entry.name] = partialEntry{value: entry.value, validate: field.validate}; break } }
        }
        for _, failure := range input.errors {
          for _, field := range schema {
            path := "."+field.field
            if failure.path == path || strings.HasPrefix(failure.path, path+"[") || strings.HasPrefix(failure.path, path+".") { snapshot[field.field] = failure; break }
          }
        }
        response := invoke(completion, CompletionRequest{field: spec.field, prefix: prefix, arguments: append([]string{}, args...), partial: Partial{read: func(field string) any { value, known := snapshot[field]; if !known { return codec.DecodeError{path: "."+field, message: "unknown CLI field"} }; return value }}})
        if failure, bad := response.(Error); bad { return fail(failure.errors) }
        suggestions := response.(Suggestions)
        if suggestions.files && suggestions.directories { return fail([]codec.DecodeError{{path: spec.field, message: "choose files or directories, not both"}}) }
        directive := cobra.ShellCompDirectiveNoFileComp
        if suggestions.files { directive = cobra.ShellCompDirectiveDefault }
        if suggestions.directories { directive = cobra.ShellCompDirectiveFilterDirs }
        if suggestions.keepOrder { directive |= cobra.ShellCompDirectiveKeepOrder }
        candidates := []string{}
        seen := map[string]bool{}
        for _, choice := range suggestions.choices {
          if choice.value == "" || strings.ContainsAny(choice.value+choice.description, "\t\n\r") { return fail([]codec.DecodeError{{path: spec.field, message: "completion choices must be nonempty and contain no tabs or newlines"}}) }
          if !strings.HasPrefix(choice.value, prefix) || seen[choice.value] { continue }
          seen[choice.value] = true
          candidate := choice.value
          if choice.description != "" { candidate += "\t"+choice.description }
          candidates = append(candidates, candidate)
        }
        return candidates, directive
      }
      directive := cobra.ShellCompDirectiveNoFileComp
      if spec.files { directive = cobra.ShellCompDirectiveDefault }
      if spec.directories { directive = cobra.ShellCompDirectiveFilterDirs }
      if spec.keepOrder { directive |= cobra.ShellCompDirectiveKeepOrder }
      choices := []string{}
      seen := map[string]bool{}
      if !spec.hidden && spec.deprecated == "" {
        for _, choice := range spec.choices {
          if !strings.HasPrefix(choice.value, prefix) || seen[choice.value] { continue }
          seen[choice.value] = true
          value := choice.value
          if choice.description != "" { value += "\t" + choice.description }
          choices = append(choices, value)
        }
      }
      return choices, directive
    }
    if spec.positional {
      index := positionalIndex(spec)
      positionalCompletions[index] = complete
      if strings.HasPrefix(kinds[spec.field], "list:") { listPosition = index }
      continue
    }
    if long == "" { continue }
    if err := cmd.RegisterFlagCompletionFunc(long, complete); err != nil { return Error{errors: []codec.DecodeError{{path: spec.field, message: err.Error()}}} }

    if spec.hidden { if err := configuredFlags.MarkHidden(long); err != nil { return Error{errors: []codec.DecodeError{{path: spec.field, message: err.Error()}}} } }
    if spec.deprecated != "" { if err := configuredFlags.MarkDeprecated(long, spec.deprecated); err != nil { return Error{errors: []codec.DecodeError{{path: spec.field, message: err.Error()}}} } }
  }
  if len(positionalCompletions) != 0 {
    cmd.ValidArgsFunction = func(cmd *cobra.Command, args []string, prefix string) ([]string, cobra.ShellCompDirective) {
      index := len(args)
      if listPosition >= 0 && index >= listPosition { index = listPosition }
      if complete, exists := positionalCompletions[index]; exists { return complete(cmd, args, prefix) }
      return nil, cobra.ShellCompDirectiveNoFileComp
    }
  }
  return adapter{native: nativeCommand{handle: cmd, owner: s.Own(func() {})}, result: func() any { return result }}
}

fn evaluate(prepared: adapter, args: List[String], completion: Bool, configure: (nativeCommand, List[String], Bool) => Error | Ok) uses io: parsedInput | Error | Help unsafe go {
  import "bytes"
  import "strings"
  import "github.com/spf13/cobra"
  cmd := prepared.native.handle.(*cobra.Command)
  var output, diagnostics bytes.Buffer
  if failure, bad := configure(prepared.native, args, completion).(Error); bad { return failure }
  cmd.SetArgs(append([]string{}, args...))
  cmd.SetOut(&output)
  cmd.SetErr(&diagnostics)
  cmd.Flags().SetOutput(&diagnostics)
  cmd.SilenceUsage = true
  cmd.SilenceErrors = true
  warningLines := func() []string {
    lines := []string{}
    for _, line := range strings.Split(strings.TrimSpace(diagnostics.String()), "\n") { if line != "" { lines = append(lines, line) } }
    return lines
  }
  if err := cmd.Execute(); err != nil {
    failures := []codec.DecodeError{{path: cmd.CommandPath(), message: err.Error()}}
    for _, warning := range warningLines() { failures = append(failures, codec.DecodeError{path: cmd.CommandPath(), message: warning}) }
    return Error{errors: failures}
  }
  result := prepared.result()
  if _, waiting := result.(pending); waiting { return Help{text: output.String(), diagnostics: diagnostics.String()} }
  warnings := warningLines()
  if failure, ok := result.(Error); ok {
    for _, warning := range warnings { failure.errors = append(failure.errors, codec.DecodeError{path: cmd.CommandPath(), message: warning}) }
    return failure
  }
  return parsedInput{value: result.(codec.Value), warnings: warnings, path: cmd.CommandPath()}
}
fn withWarnings(error: Error, warnings: List[String], path: String): Error {
  error.copy(errors: error.errors.concat(warnings.map(warning => codec.DecodeError { path: path, message: warning })))
}

// Let Cobra recognize disabled protocol requests before it installs its endpoint.
fn configureCompletion(native: nativeCommand, args: List[String], enabled: Bool): Error | Ok unsafe go {
  import "fmt"
  import "github.com/spf13/cobra"
  cmd := native.handle.(*cobra.Command)
  cmd.CompletionOptions.DisableDefaultCmd = !enabled
  if enabled { return _Ok{} }
  sentinel := &cobra.Command{Use: "__complete", Aliases: []string{"__completeNoDesc"}, Hidden: true}
  cmd.AddCommand(sentinel)
  selected, _, err := cmd.Find(args)
  cmd.RemoveCommand(sentinel)
  if err != nil { return Error{errors: []codec.DecodeError{{path: cmd.CommandPath(), message: err.Error()}}} }
  if selected == sentinel { return Error{errors: []codec.DecodeError{{path: cmd.CommandPath(), message: fmt.Sprintf("unknown command %q", selected.CalledAs())}}} }
  return _Ok{}
}
