import "bork/codec"
use codec.Defaults

type nestedGroup = { field: String, key: String, optional: Bool, path: List[String], aliases: List[List[String]], defaultValue: Option[codec.Value] = Option.None }
type nestedLeaf = { field: String, path: List[String], aliases: List[List[String]], defaultValue: Option[codec.Value] = Option.None }
type cliSchema = { record: Option[codec.RecordSchema], groups: List[nestedGroup], leaves: List[nestedLeaf] }

// Preserve provider-only inputs while canonicalizing advertised aliases, so a
// child overlay replaces its default rather than introducing a duplicate name.
fn canonicalDefaultInput(input: codec.Value, record: codec.RecordSchema): codec.Value unsafe go {
  object, ok := input.(codec.Value_Object)
  if !ok { return input }
  fields := append([]codec.Field{}, object.fields...)
  for i, entry := range fields { for _, field := range record.fields {
    key := field.wireName
    if key == "" { key = field.name }
    accepted := entry.name == key
    for _, alias := range field.aliases { if entry.name == alias { accepted = true; break } }
    if accepted { fields[i].name = key; break }
  } }
  return codec.Value_Object{fields:fields}
}

// Flatten only the selected decoder's advertised record inputs. Source paths
// stay distinct from wire paths and each naming override affects one segment.
fn flattenRecordSchema(recordSchema: Option[codec.RecordSchema], name: String): cliSchema | Error unsafe go {
  record, found := _borkOptionGet(recordSchema)
  if !found { return cliSchema{record: recordSchema, groups: []nestedGroup{}, leaves: []nestedLeaf{}} }
  result := []codec.RecordField{}
  groups := []nestedGroup{}
  leaves := []nestedLeaf{}
  failures := []codec.DecodeError{}
  join := func(parent, child string) string { if parent == "" { return child }; return parent + "." + child }
  var visit func(codec.RecordSchema, string, string, []string, []string, []string, [][]string, Option[codec.Value], int)
  visit = func(record codec.RecordSchema, source, key string, aliases, words, path []string, aliasPaths [][]string, baseline Option[codec.Value], depth int) {
    if depth > 32 { failures = append(failures, codec.DecodeError{path: source, message: "nested CLI record exceeds 32 levels"}); return }
    for _, original := range record.fields {
      field := original
      localKey := field.wireName
      if localKey == "" { localKey = field.name }
      field.name = join(source, field.name)
      field.wireName = join(key, localKey)
      field.words = append(append([]string{}, words...), field.words...)
      if len(original.words) == 0 { field.words = append(append([]string{}, words...), _borkCodecWords(localKey)... ) }
      field.aliases = []string{}
      parents := append([]string{key}, aliases...)
      children := append([]string{localKey}, original.aliases...)
      if len(parents) > 256/len(children) { failures = append(failures, codec.DecodeError{path: field.name, message: "nested CLI field exceeds 256 accepted name paths"}); continue }
      for p, parent := range parents { for c, child := range children { if p != 0 || c != 0 { field.aliases = append(field.aliases, join(parent, child)) } } }
      nextPath := append(append([]string{}, path...), localKey)
      nextAliases := [][]string{}
      for p, parent := range append([][]string{path}, aliasPaths...) { for c, child := range children { if p != 0 || c != 0 { nextAliases = append(nextAliases, append(append([]string{}, parent...), child)) } } }
      var inherited Option[codec.Value] = Option_None[codec.Value]{}
      if parent, present := _borkOptionGet(baseline); present {
        if object, ok := parent.(codec.Value_Object); ok { for _, entry := range object.fields { if entry.name == localKey { inherited = Option_Some[codec.Value]{E0:entry.value}; break } } }
      }
      options := fieldTagOptions(original)
      if failure, bad := options.(codec.DecodeError); bad { failures = append(failures, codec.DecodeError{path: field.name, message: "invalid cli tag group: " + failure.message}); continue }
      var nested Option[codec.RecordSchema] = Option_None[codec.RecordSchema]{}
      if provider, present := _borkOptionGet(original.recordSchema); present { nested = provider() }
      child, nestedRecord := _borkOptionGet(nested)
      if nestedRecord && options.(FieldTags).flatten {
        if _, repeat := options.(FieldTags).collection.(Collection_Repeat); !repeat { failures = append(failures, codec.DecodeError{path: field.name, message: "collection mode applies to leaves, not a flattened record group"}); continue }
        if _, present := _borkOptionGet(inherited); !present && field.hasDefault {
          if provider, found := _borkOptionGet(original.defaultInput); found {
            input := provider()
            if failure, bad := input.(codec.DecodeError); bad { failures = append(failures, codec.DecodeError{path:field.name+failure.path, message:failure.message}); continue }
            inherited = Option_Some[codec.Value]{E0:input.(codec.Value)}
          } else { failures = append(failures, codec.DecodeError{path:field.name, message:"flattened parent default requires codec.RecordField.defaultInput"}); continue }
        }
        if input, present := _borkOptionGet(inherited); present {
          if _, object := input.(codec.Value_Object); !object { if _, null := input.(codec.Value_Null); !null || !field.optional { failures = append(failures, codec.DecodeError{path:field.name, message:"flattened parent default input must be an object or null for an optional record"}); continue } }
          inherited = Option_Some[codec.Value]{E0:canonicalDefaultInput(input, child)}
        }
        groups = append(groups, nestedGroup{field: field.name, key: field.wireName, optional: field.optional, path: nextPath, aliases: nextAliases, defaultValue:inherited})
        if len(child.fields) != 0 { visit(child, field.name, field.wireName, field.aliases, field.words, nextPath, nextAliases, inherited, depth+1); continue }
        if !field.optional {
          field.hasDefault = true
          field.defaultValue = Option_Some[func() codec.DefaultSchema]{E0: func() codec.DefaultSchema { return codec.DefaultSchema{display:"{}", configPath:Option_None[string]{}, choices:[]string{}} }}
        }
      }
      validate := original.validate
      parentKey := key
      field.validate = func(input codec.Value) any {
        checked := validate(input)
        if failure, bad := checked.(codec.DecodeError); bad && parentKey != "" { failure.path = "." + parentKey + failure.path; return failure }
        return checked
      }
      result = append(result, field)
      leaves = append(leaves, nestedLeaf{field: field.name, path: nextPath, aliases: nextAliases, defaultValue:inherited})
    }
  }
  visit(record, "", "", nil, nil, nil, nil, Option_None[codec.Value]{}, 0)
  if len(failures) != 0 { return Error{errors: failures} }
  return cliSchema{record: Option_Some[codec.RecordSchema]{E0:codec.RecordSchema{fields:result}}, groups:groups, leaves:leaves}
}

type flatConfigEntry = { field: String, key: String, value: codec.Value, group: Bool, extra: Bool = false, path: List[String] = [] }
fn flattenConfigFields(fields: List[codec.Field], schema: List[inputField]): List[flatConfigEntry] | Error unsafe go {
  import "reflect"
  import "strings"
  result := []flatConfigEntry{}
  groups := []nestedGroup{}
  if len(schema) != 0 { groups = schema[0].groups }
  var visit func([]codec.Field, []string) *codec.DecodeError
  visit = func(fields []codec.Field, prefix []string) *codec.DecodeError {
    seen := map[string]string{}
    for _, entry := range fields {
      path := append(append([]string{}, prefix...), entry.name)
      owner := ""
      group := false
      for _, field := range schema {
        for _, candidate := range append([][]string{field.path}, field.aliasPaths...) { if reflect.DeepEqual(candidate, path) { owner = field.field; break } }
        if owner != "" { break }
      }
      if owner == "" { for _, candidate := range groups {
        for _, accepted := range append([][]string{candidate.path}, candidate.aliases...) { if reflect.DeepEqual(accepted, path) { owner, group = candidate.field, true; break } }
        if owner != "" { break }
      } }
      key := strings.Join(path, ".")
      if owner == "" {
        for _, parent := range groups { for _, accepted := range append([][]string{parent.path}, parent.aliases...) { if reflect.DeepEqual(accepted, prefix) {
          result = append(result, flatConfigEntry{field: parent.field+"."+entry.name, key:key, value:entry.value, extra:true, path:append(append([]string{}, parent.path...), entry.name)})
          owner = parent.field
          break
        } }; if owner != "" { break } }
        if owner != "" { continue }
        return &codec.DecodeError{path:key, message:"unknown CLI config field"}
      }
      if first, duplicate := seen[owner]; duplicate { return &codec.DecodeError{path:key, message:"CLI config field is the same field as " + first} }
      seen[owner] = key
      result = append(result, flatConfigEntry{field:owner, key:key, value:entry.value, group:group})
      if group {
        if object, ok := entry.value.(codec.Value_Object); ok { if failure := visit(object.fields, path); failure != nil { return failure } } else if _, null := entry.value.(codec.Value_Null); !null { return &codec.DecodeError{path:key, message:"nested CLI config requires an object or null"} }
      }
    }
    return nil
  }
  if failure := visit(fields, nil); failure != nil { return Error{errors:[]codec.DecodeError{*failure}} }
  return result
}

fn rebuildNestedFields(fields: List[codec.Field], schema: List[inputField], active: List[String], nulls: List[String], cleared: List[String], extras: List[flatConfigEntry]): List[codec.Field] unsafe go {
  import "strings"
  result := []codec.Field{}
  var set func([]codec.Field, []string, codec.Value) []codec.Field
  set = func(fields []codec.Field, path []string, value codec.Value) []codec.Field {
    if len(path) == 0 { return fields }
    fields = append([]codec.Field{}, fields...)
    index := len(fields)
    for i, field := range fields { if field.name == path[0] { index = i; break } }
    if index == len(fields) { fields = append(fields, codec.Field{name:path[0], value:codec.Value_Object{fields:[]codec.Field{}}}) }
    if len(path) == 1 { fields[index].value = value; return fields }
    child, ok := fields[index].value.(codec.Value_Object)
    if !ok { child = codec.Value_Object{fields:[]codec.Field{}} }
    child.fields = set(child.fields, path[1:], value)
    fields[index].value = child
    return fields
  }
  if len(schema) != 0 { for _, group := range schema[0].groups { for _, source := range active { if source == group.field {
    var value codec.Value = codec.Value_Object{fields:[]codec.Field{}}
    blocked := false
    for _, parent := range cleared { if group.field == parent || strings.HasPrefix(group.field, parent+".") { blocked = true; break } }
    if baseline, present := _borkOptionGet(group.defaultValue); present && !blocked { if _, object := baseline.(codec.Value_Object); object { value = baseline } }
    result = set(result, group.path, value)
    break
  } } } }
  if len(schema) != 0 { for _, group := range schema[0].groups { for _, source := range nulls { if source == group.field { result = set(result, group.path, codec.Value_Null{}); break } } } }
  for _, entry := range fields { for _, field := range schema { if entry.name == field.wireName || entry.name == field.field { result = set(result, field.path, entry.value); break }; for _, alias := range field.aliases { if entry.name == alias { result = set(result, field.path, entry.value); break } } } }
  for _, entry := range extras { result = set(result, entry.path, entry.value) }
  return result
}
