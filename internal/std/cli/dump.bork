import "bork/codec"
import "bork/json"
import "bork/yaml"

type ConfigFormat = sealed { Json, Yaml }

// Dump writes a complete effective options value, including defaults, through
// its selected Encode instance. The encoded value must be an object.
fn Dump[T: codec.Encode](value: T, format: ConfigFormat = .Json): String | Error {
  encoded = codec.encode(value)
  match (encoded) {
    codec.Value.Object { fields: _ } => renderConfig(encoded, format)
    _ => Error { errors: [codec.DecodeError { path: "", message: "CLI config dump requires an encoded object" }] }
  }
}

// Both renderer indentation predicates accept 2. Keep that fixed native value
// here so importing CLI does not evaluate external predicates during Go-free
// type checking. The renderers still validate the encoded values at runtime.
fn renderConfig(value: codec.Value, format: ConfigFormat): String | Error unsafe go {
  if _, yamlFormat := format.(ConfigFormat_Yaml); yamlFormat { return renderYamlConfig(value, 2) }
  return renderJsonConfig(value, 2)
}
fn renderJsonConfig(value: codec.Value, spaces: json.Indent): String | Error {
  match (json.Pretty(value, spaces)) {
    text: String => text
    error: json.JsonError => Error { errors: [codec.DecodeError { path: "", message: error.message }] }
  }
}
fn renderYamlConfig(value: codec.Value, spaces: yaml.Indent): String | Error {
  match (yaml.Render(value, spaces)) {
    text: String => text
    error: yaml.Error => Error { errors: [codec.DecodeError { path: "", message: error.message }] }
  }
}

// DumpFile chooses YAML for .yaml/.yml (case insensitive), JSON otherwise,
// matching config loading. Encoding finishes before the destination is opened.
fn DumpFile[T: codec.Encode](path: String, value: T) uses io: Ok | Error {
  text = Dump(value, dumpFormat(path))?
  writeConfig(path, text)
}
fn dumpFormat(path: String): ConfigFormat unsafe go {
  import "path/filepath"
  import "strings"
  ext := strings.ToLower(filepath.Ext(path))
  if ext == ".yaml" || ext == ".yml" { return ConfigFormat_Yaml{} }
  return ConfigFormat_Json{}
}
fn writeConfig(path: String, text: String) uses io: Ok | Error unsafe go {
  import "os"
  if err := os.WriteFile(path, []byte(text), 0600); err != nil { return Error{errors: []codec.DecodeError{{path: path, message: err.Error()}}} }
  return _borkOk()
}
