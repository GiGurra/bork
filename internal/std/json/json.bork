import codec "bork/codec"
use codec.Defaults

// JsonError is returned for text that is not valid JSON.
type JsonError = { message: String }

// Package json queries dynamic JSON values and streams JSON Lines. Typed
// codecs use the bork/codec Decode and Encode classes.

// Field returns the first matching object field. None also covers other kinds.
fn Field(value: codec.Value, name: String): Option[codec.Value] {
  match (value) {
    codec.Value.Object { fields } => (fields.find(field => field.name == name)).map(field => field.value)
    _ => Option.None
  }
}
// Index returns an array element; negative or out-of-range indices give None.
fn Index(value: codec.Value, index: Int): Option[codec.Value] {
  match (value) {
    codec.Value.Array { items } => items.get(index)
    _ => Option.None
  }
}
// At follows object names and array indices. An empty path returns the input;
// a JSON null remains Some(Null), distinct from a missing path.
fn At(value: codec.Value, path: List[String | Int]): Option[codec.Value] {
  match (path) {
    [] => Option.Some { value: value }
    [step, ...rest] => match (match (step) {
      name: String => Field(value, name)
      index: Int => Index(value, index)
    }) {
      Option.Some { value: next } => At(next, rest)
      Option.None => Option.None
    }
  }
}

pred ValidIndent(spaces: Int) { spaces >= 0 && spaces <= 8 }
type Indent = Int where ValidIndent
// Pretty preserves field order and exact number text. Invalid manually
// constructed number values give JsonError. Zero adds newlines with no indent.
fn Pretty(value: codec.Value, spaces: Indent = 2): String | JsonError {
  validateNumbers(value)?
  indentJson(Render(value), spaces)
}
fn indentJson(text: String, spaces: Indent): String | JsonError unsafe go {
  import "bytes"
  import "encoding/json"
  import "strings"
  var result bytes.Buffer
  if err := json.Indent(&result, []byte(text), "", strings.Repeat(" ", int(spaces))); err != nil { return JsonError{message: err.Error()} }
  return result.String()
}

// Check each number token before rendering: an invalid token must not inject
// additional array elements or turn a number into another JSON kind.
fn validateNumbers(value: codec.Value): Ok | JsonError unsafe go {
  var check func(codec.Value) *JsonError
  check = func(value codec.Value) *JsonError {
    switch value := value.(type) {
    case codec.Value_Number:
      parsed := Parse(value.text)
      if failure, failed := parsed.(JsonError); failed { return &failure }
      if _, number := parsed.(codec.Value_Number); !number { return &JsonError{message: "expected a JSON number"} }
    case codec.Value_Array:
      for _, item := range value.items { if failure := check(item); failure != nil { return failure } }
    case codec.Value_Object:
      for _, field := range value.fields { if failure := check(field.value); failure != nil { return failure } }
    }
    return nil
  }
  if failure := check(value); failure != nil { return *failure }
  return _borkOk()
}
