      Json.String { value } => match (ParseDecimal(value)) {
        parsed: Decimal => parsed
        error: ParseError => DecodeError { path: "", message: error.message }
      }
      _ => DecodeError { path: "", message: "expected a Decimal string" }
    }
  }
}
instances Codecs { EncodeBigInt, DecodeBigInt, EncodeBigRat, DecodeBigRat, EncodeDecimal, DecodeDecimal }
