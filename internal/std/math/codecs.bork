import codec "bork/codec"
use codec.Defaults

// Exact values encode as JSON strings so consumers cannot lose precision.
instance EncodeBigInt: codec.Encode[BigInt] {
  fn encode(value: BigInt): codec.Value { codec.Value.String { value: value.ToString() } }
}
instance DecodeBigInt: codec.Decode[BigInt] {
  fn decode(json: codec.Value): BigInt | codec.DecodeError {
    match (json) {
      codec.Value.String { value } => match (ParseInteger(value)) {
        parsed: BigInt => parsed
        error: ParseError => codec.DecodeError { path: "", message: error.message }
      }
      _ => codec.DecodeError { path: "", message: "expected a BigInt string" }
    }
  }
}
instance EncodeBigRat: codec.Encode[BigRat] {
  fn encode(value: BigRat): codec.Value { codec.Value.String { value: value.ToString() } }
}
instance DecodeBigRat: codec.Decode[BigRat] {
  fn decode(json: codec.Value): BigRat | codec.DecodeError {
    match (json) {
      codec.Value.String { value } => match (ParseRational(value)) {
        parsed: BigRat => parsed
        error: ParseError => codec.DecodeError { path: "", message: error.message }
      }
      _ => codec.DecodeError { path: "", message: "expected a BigRat string" }
    }
  }
}
instance EncodeDecimal: codec.Encode[Decimal] {
  fn encode(value: Decimal): codec.Value { codec.Value.String { value: value.ToString() } }
}
instance DecodeDecimal: codec.Decode[Decimal] {
  fn decode(json: codec.Value): Decimal | codec.DecodeError {
    match (json) {
      codec.Value.String { value } => match (ParseDecimal(value)) {
        parsed: Decimal => parsed
        error: ParseError => codec.DecodeError { path: "", message: error.message }
      }
      _ => codec.DecodeError { path: "", message: "expected a Decimal string" }
    }
  }
}
instances Codecs { EncodeBigInt, DecodeBigInt, EncodeBigRat, DecodeBigRat, EncodeDecimal, DecodeDecimal }
