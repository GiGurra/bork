import codec "bork/codec"

import codecs "bork/json"
import urls "bork/url"
use codec.Defaults

// Body decodes JSON into a proven value, including derived field constraints.
fn Body[T: codec.Decode](request: Request): T | codecs.JsonError | codec.DecodeError {
  codecs.Decode[T](request.body)
}

// Query parses URL query values and preserves repeated keys.
fn Query(request: Request): Headers | IoError {
  match (urls.ParseQuery(request.query)) {
    values: urls.Query => values
    error: ParseError => IoError { path: request.path, message: error.message }
  }
}

// QueryAs and PathAs decode derived records. Strings are literal; other fields
// use JSON syntax. Missing Option fields become None. Repeated query fields
// are rejected rather than silently selecting an untrusted value.
fn QueryAs[T: codec.Decode](request: Request): T | IoError | codec.DecodeError {
  values = Query(request)?
  fieldsAs[T](values)
}
fn PathAs[T: codec.Decode](request: Request): T | codec.DecodeError {
  fieldsAs[T](request.params.mapValues(value => [value]))
}
fn fieldsAs[T: codec.Decode](values: Headers): T | codec.DecodeError {
  json = fieldsJson[T](values)?
  codec.decode[T](json)
}
fn fieldsJson[T: codec.Decode](values: Headers): codec.Value | codec.DecodeError {
  fieldsJsonWithSchema[T](codec.Schema[T](), values)
}
fn fieldsJsonWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], values: Headers): codec.Value | codec.DecodeError unsafe go {
  record, supported := _borkOptionGet(recordSchema)
  schema := record.fields
  if !supported { return codec.DecodeError{path: "", message: "expected a derived record decoder"} }
  fields := []codec.Field{}
  owners := map[string]int{}
  for index, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    for _, name := range append([]string{key}, field.aliases...) {
      if _, duplicate := owners[name]; duplicate { return codec.DecodeError{path: "."+name, message: "duplicate schema field name"} }
      owners[name] = index
    }
  }
  seen := map[int]string{}
  var failure codec.DecodeError
  failed := false
  _borkMapEach(values, func(name string, raw []string) bool {
    index, known := owners[name]
    // Retain unknown keys so the selected decoder applies its unknown policy.
    if !known {
      var value codec.Value = codec.Value_Null{}
      if len(raw) == 1 { value = codec.Value_String{value: raw[0]} } else if len(raw) > 1 {
        items := []codec.Value{}
        for _, text := range raw { items = append(items, codec.Value_String{value: text}) }
        value = codec.Value_Array{items: items}
      }
      fields = append(fields, codec.Field{name: name, value: value})
      return true
    }
    if first, duplicate := seen[index]; duplicate {
      failure, failed = codec.DecodeError{path: "."+name, message: "same field as ."+first}, true
      return false
    }
    seen[index] = name
    if len(raw) != 1 { failure, failed = codec.DecodeError{path: "."+name, message: "expected exactly one value"}, true; return false }
    field := schema[index]
    var value codec.Value = codec.Value_String{value: raw[0]}
    if field.kind != "string" {
      parsed := parseJsonValue(raw[0])
      if error, bad := parsed.(codecs.JsonError); bad { failure, failed = codec.DecodeError{path: "."+name, message: error.message}, true; return false }
      value = parsed.(codec.Value)
    }
    fields = append(fields, codec.Field{name: name, value: value})
    return true
  })
  if failed { return failure }
  for index, field := range schema {
    if _, found := seen[index]; !found && !field.optional && !field.hasDefault {
      key := field.wireName
      if key == "" { key = field.name }
      return codec.DecodeError{path: "."+key, message: "is missing"}
    }
  }
  return codec.Value_Object{fields: fields}
}

// Form parses an application/x-www-form-urlencoded body, independently of
// query parameters. Multipart files are copied into immutable Bytes.
fn Form(request: Request): Headers | IoError {
  Query(request.copy(query: request.body))
}
type Upload = { field: String, filename: String, contentType: String, data: Bytes }
type MultipartForm = { values: Headers, files: List[Upload] }
fn Multipart(request: Request, maxBodyBytes: BodyLimit = 16777216): MultipartForm | IoError unsafe go {
  import "io"
  import "mime"
  import "mime/multipart"
  import "sort"
  import "strings"
  if int64(len(request.body)) > maxBodyBytes { return IoError{path: request.path, message: "multipart body exceeds configured limit"} }
  header, found := _borkOptionGet(HeaderOf(request.headers, "Content-Type"))
  if !found { return IoError{path: request.path, message: "missing Content-Type"} }
  media, parameters, err := mime.ParseMediaType(header)
  if err != nil || media != "multipart/form-data" || parameters["boundary"] == "" { return IoError{path: request.path, message: "expected multipart/form-data with boundary"} }
  reader := multipart.NewReader(strings.NewReader(request.body), parameters["boundary"])
  form, err := reader.ReadForm(maxBodyBytes)
  if err != nil { return IoError{path: request.path, message: err.Error()} }
  defer form.RemoveAll()
  keys, values := []string{}, [][]string{}
  for key := range form.Value { keys = append(keys, key) }
  sort.Strings(keys)
  for _, key := range keys { values = append(values, append([]string(nil), form.Value[key]...)) }
  names := []string{}
  for name := range form.File { names = append(names, name) }
  sort.Strings(names)
  files := []Upload{}
  for _, name := range names {
    for _, header := range form.File[name] {
      file, err := header.Open()
      if err != nil { return IoError{path: request.path, message: err.Error()} }
      data, err := io.ReadAll(file)
      file.Close()
      if err != nil { return IoError{path: request.path, message: err.Error()} }
      files = append(files, Upload{field: name, filename: header.Filename, contentType: header.Header.Get("Content-Type"), data: _borkBytesFrom(data)})
    }
  }
  return MultipartForm{values: _borkMapOf(keys, values), files: files}
}

fn parseJsonValue(text: String): codec.Value | codecs.JsonError { codecs.Parse(text) }
