// Package http serves and sends HTTP requests:
//
//   import "bork/http"
//
// A server runs while its scope is open: closing the scope stops it, and
// waits for it to finish. Each request runs its handler on its own
// goroutine; bork values are immutable, so handlers share nothing that
// can change.

import "bork/time"

// ValidStatus holds for the status codes HTTP defines (100 to 599).
pred ValidStatus(code: Int) { code >= 100 && code <= 599 }

type Status = Int where ValidStatus

// Headers keep every value of each header; names are canonicalized on receipt.
type Headers = Map[String, List[String]]

// TimeoutMs is a nonnegative timeout that fits Go's nanosecond duration.
pred ValidTimeout(ms: Int) { ms >= 0 && ms <= 9223372036854 }
type TimeoutMs = Int where ValidTimeout

// BodyLimit is a nonnegative byte limit; zero rejects nonempty bodies.
pred ValidBodyLimit(bytes: Int) { bytes >= 0 }
type BodyLimit = Int where ValidBodyLimit

// Admission bounds application work before request bodies are buffered.
pred ValidInFlight(limit: Int) { limit > 0 }
pred ValidQueueLimit(limit: Int) { limit >= 0 }
pred ValidAdmissionStatus(status: Int) { status == 429 || status == 503 }
type InFlightLimit = Int where ValidInFlight
type QueueLimit = Int where ValidQueueLimit
type AdmissionStatus = Int where ValidAdmissionStatus
type Admission = {
  maxInFlight: InFlightLimit,
  maxQueued: QueueLimit = 0,
  queueTimeoutMs: TimeoutMs = 0,
  retryAfterMs: TimeoutMs = 0,
  status: AdmissionStatus = 503,
} derive (Decode)

type Request = {
  method: String,
  path: String,
  query: String,
  params: Map[String, String],
  headers: Headers,
  body: String,
}

type Response = { status: Status, headers: Headers, body: String }
// Overloaded retains the complete 429/503 response and a safely parsed hint.
type Overloaded = { retryAfter: Option[time.Duration], response: Response }
type DeadlineExceeded = { message: String }
type Result = Response | Overloaded | DeadlineExceeded | Cancelled | IoError

type Handler = (Request, Scope) uses io + net + clock + random + state => Response
type Route = { pattern: String, handler: Handler }

// Server is a running server, stopped when its scope closes.
type Server = resource
type AdmissionLoad = { inFlight: Int, queued: Int }

// Text is a plain text response.
fn Text(status: Status, body: String): Response {
  .{ status: status, headers: { "Content-Type": ["text/plain; charset=utf-8"] }, body: body }
}

// JsonReply is a response with a JSON body (already rendered, as codecs.Encode
// gives it).
fn JsonReply(status: Status, body: String): Response {
  .{ status: status, headers: { "Content-Type": ["application/json"] }, body: body }
}

// Segments are the non-empty parts of a path: "/users/42/" gives
// ["users", "42"], to match on.
fn Segments(path: String): List[String] {
  (path.split("/")).filter(part => part != "")
}

// HeaderOf is the value of the first header with the given name,
// compared without regard to case.
fn HeaderOf(headers: Headers, name: String): Option[String] {
  match ((headers.entries()).find(entry => entry.key.toLower() == name.toLower())) {
    Option.Some { value } => value.value.get(0)
    Option.None => Option.None
  }
}

// Listen starts a server on addr (host:port; port 0 picks a free one)
// that answers every request with handler. It runs until s closes.
// Each request gets a scope of its own, closed when the handler
// returns, and cancelled if the client goes away or s closes: the
// handler can open resources in it and spawn tasks in it.
// maxBodyBytes defaults to 16 MiB; oversized requests receive HTTP 413.
// requestTimeoutMs caps incoming budgets; zero adds no server deadline.
fn Listen(addr: String, s: Scope, handler: (Request, Scope) => Response, drainTimeoutMs: TimeoutMs = 0, maxBodyBytes: BodyLimit = 16777216, admission: Option[Admission] = Option.None, requestTimeoutMs: TimeoutMs = 0) uses net + clock + state: Server | IoError unsafe go {
  return start(addr, s, []Route{{pattern: "/", handler: handler}}, _borkNone[Certificate](), drainTimeoutMs, maxBodyBytes, admission, requestTimeoutMs)
}

// ListenRoutes serves Go ServeMux patterns with their handlers. A GET
// pattern also accepts HEAD; wildcards are available in request.params.
// Invalid or conflicting patterns return IoError before opening a socket.
// Zero drain timeout inherits cleanupTimeout; with no policy, drain is unbounded.
fn ListenRoutes(addr: String, s: Scope, routes: List[Route], drainTimeoutMs: TimeoutMs = 0, maxBodyBytes: BodyLimit = 16777216, admission: Option[Admission] = Option.None, requestTimeoutMs: TimeoutMs = 0) uses io + net + clock + random + state: Server | IoError unsafe go {
  return start(addr, s, routes, _borkNone[Certificate](), drainTimeoutMs, maxBodyBytes, admission, requestTimeoutMs)
}

// ListenTLS loads a certificate and private key before opening the listener.
fn ListenTLS(addr: String, s: Scope, routes: List[Route], certFile: String, keyFile: String, drainTimeoutMs: TimeoutMs = 0, maxBodyBytes: BodyLimit = 16777216, admission: Option[Admission] = Option.None, requestTimeoutMs: TimeoutMs = 0) uses io + net + clock + random + state: Server | IoError unsafe go {
  pair := LoadCertificate(certFile, keyFile)
  if failure, failed := pair.(IoError); failed { return failure }
  return start(addr, s, routes, _borkSome(pair.(Certificate)), drainTimeoutMs, maxBodyBytes, admission, requestTimeoutMs)
}

// Certificate keeps validated immutable PEM bytes in a private variant.
// Its renderer never exposes the key material.
type Certificate = sealed { certificate { certificatePem: Bytes, keyPem: Bytes } }
instance ShowCertificate: Show[Certificate] {
  fn show(certificate: Certificate): String { "http.Certificate" }
}

// ParseCertificate validates a PEM certificate chain and its private key.
fn ParseCertificate(certificatePem: Bytes, keyPem: Bytes): Certificate | IoError unsafe go {
  import "crypto/tls"
  if _, err := tls.X509KeyPair(_borkBytesData(certificatePem), _borkBytesData(keyPem)); err != nil {
    return IoError{path: "", message: err.Error()}
  }
  return Certificate_certificate{certificatePem: certificatePem, keyPem: keyPem}
}

// LoadCertificate reads and validates a PEM certificate chain and its private key.
fn LoadCertificate(certFile: String, keyFile: String) uses io: Certificate | IoError unsafe go {
  import "os"
  cert, err := os.ReadFile(certFile)
  if err != nil { return IoError{path: certFile, message: err.Error()} }
  key, err := os.ReadFile(keyFile)
  if err != nil { return IoError{path: keyFile, message: err.Error()} }
  pair := ParseCertificate(_borkBytesFrom(cert), _borkBytesFrom(key))
  if failure, failed := pair.(IoError); failed { failure.path = certFile; return failure }
  return pair
}

fn start(addr: String, s: Scope, routes: List[Route], certificate: Option[Certificate], drainTimeoutMs: TimeoutMs, maxBodyBytes: BodyLimit, admission: Option[Admission], requestTimeoutMs: TimeoutMs) uses net + clock + state: Server | IoError unsafe go {
  import "context"
  import "crypto/tls"
  import "errors"
  import "fmt"
  import "io"
  import "net"
  import "net/http"
  import "sort"
  import "strconv"
  import "strings"
  import "sync"
  import "time"
  policy := _borkScopeCleanupTimeout(s)
  drain := time.Duration(drainTimeoutMs)*time.Millisecond
  if policy > 0 && drain > policy { return IoError{path: addr, message: "drain timeout exceeds scope cleanup timeout"} }
  if drain == 0 { drain = policy }
  reject := func(w http.ResponseWriter, r *http.Request, status int, message string) {
    if r.ProtoMajor == 1 { w.Header().Set("Connection", "close") }
    http.Error(w, message, status)
  }
  expired := func(ctx context.Context) bool {
    deadline, found := ctx.Deadline()
    return errors.Is(context.Cause(ctx), context.DeadlineExceeded) || (found && !deadline.After(time.Now()))
  }
  mux := http.NewServeMux()
  register := func() (err error) {
    defer func() { if failure := recover(); failure != nil { err = fmt.Errorf("%v", failure) } }()
    for _, route := range routes {
      pattern := route.pattern
      mux.HandleFunc(pattern, func(w http.ResponseWriter, r *http.Request) {
        ctx := r.Context()
        if expired(ctx) { reject(w, r, 504, "request deadline exceeded"); return }
        if ctx.Err() != nil { return }
        var finishRead func()
        if r.Body != http.NoBody {
          controller := http.NewResponseController(w)
          deadline, _ := ctx.Deadline()
          if err := controller.SetReadDeadline(deadline); err != nil {
            reject(w, r, 500, "request body cancellation is unsupported")
            return
          }
          finished := make(chan struct{})
          stop := context.AfterFunc(ctx, func() {
            controller.SetReadDeadline(time.Now())
            close(finished)
          })
          finishRead = func() {
            if !stop() { <-finished }
            if !expired(ctx) && ctx.Err() == nil { controller.SetReadDeadline(time.Time{}) }
          }
        }
        body, readErr := func() ([]byte, error) {
          if finishRead != nil { defer finishRead() }
          return io.ReadAll(http.MaxBytesReader(w, r.Body, maxBodyBytes))
        }()
        if expired(ctx) { reject(w, r, 504, "request deadline exceeded"); return }
        if ctx.Err() != nil { return }
        if readErr != nil {
          var limit *http.MaxBytesError
          if errors.As(readErr, &limit) { http.Error(w, "request body exceeds configured limit", http.StatusRequestEntityTooLarge) } else { http.Error(w, "could not read request body", http.StatusBadRequest) }
          return
        }
        keys, values := []string{}, [][]string{}
        for name := range r.Header { keys = append(keys, name) }
        sort.Strings(keys)
        for _, name := range keys { values = append(values, append([]string(nil), r.Header[name]...)) }
        names, params := []string{}, []string{}
        for _, part := range strings.Split(pattern, "/") {
          if strings.HasPrefix(part, "{") && strings.HasSuffix(part, "}") && part != "{$}" {
            name := strings.TrimSuffix(strings.TrimSuffix(strings.TrimPrefix(part, "{"), "}"), "...")
            names = append(names, name); params = append(params, r.PathValue(name))
          }
        }
        rs := _borkScopeWith(r.Context())
        // Keep later listener-scope deadline updates visible, independently of
        // request ownership and the Go context's creation-time deadline.
        rs.deadlineParent = s
        defer _borkScopeAbort(rs)
        resp := route.handler(Request{method: r.Method, path: r.URL.Path, query: r.URL.RawQuery, params: _borkMapOf(names, params), headers: _borkMapOf(keys, values), body: string(body)}, rs)
        _borkScopeClose(rs)
        _borkMapEach(resp.headers, func(name string, values []string) bool {
          for _, value := range values { w.Header().Add(name, value) }
          return true
        })
        w.WriteHeader(int(resp.status))
        io.WriteString(w, resp.body)
      })
    }
    return nil
  }
  if err := register(); err != nil { return IoError{path: addr, message: err.Error()} }
  handler := http.Handler(mux)
  load := func() Option[AdmissionLoad] { return _borkNone[AdmissionLoad]() }
  if value, limited := _borkOptionGet(admission); limited {
    config := value
    type waiter struct {
      ready   chan struct{}
      ctx     context.Context
      granted bool
    }
    var mu sync.Mutex
    var inFlight int64
    var queued []*waiter
    load = func() Option[AdmissionLoad] {
      mu.Lock()
      snapshot := AdmissionLoad{inFlight: inFlight, queued: int64(len(queued))}
      mu.Unlock()
      return _borkSome(snapshot)
    }
    release := func() {
      mu.Lock()
      inFlight--
      for len(queued) > 0 {
        next := queued[0]
        queued[0] = nil
        queued = queued[1:]
        if next.ctx.Err() != nil {
          continue
        }
        next.granted = true
        inFlight++
        close(next.ready)
        break
      }
      mu.Unlock()
    }
    acquire := func(ctx context.Context) bool {
      if ctx.Err() != nil {
        return false
      }
      mu.Lock()
      if inFlight < config.maxInFlight && len(queued) == 0 {
        inFlight++
        mu.Unlock()
        return true
      }
      if config.maxQueued == 0 || config.queueTimeoutMs == 0 || int64(len(queued)) >= config.maxQueued {
        mu.Unlock()
        return false
      }
      next := &waiter{ready: make(chan struct{}), ctx: ctx}
      queued = append(queued, next)
      mu.Unlock()
      timer := time.NewTimer(time.Duration(config.queueTimeoutMs) * time.Millisecond)
      defer timer.Stop()
      select {
      case <-next.ready:
        if ctx.Err() == nil {
          return true
        }
      case <-ctx.Done():
      case <-timer.C:
      }
      mu.Lock()
      granted := next.granted
      if !granted {
        for index, item := range queued {
          if item == next {
            copy(queued[index:], queued[index+1:])
            queued[len(queued)-1] = nil
            queued = queued[:len(queued)-1]
            break
          }
        }
      }
      mu.Unlock()
      if granted {
        release()
      }
      return false
    }
    seconds := config.retryAfterMs / 1000
    if config.retryAfterMs%1000 != 0 {
      seconds++
    }
    handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
      if !acquire(r.Context()) {
        if expired(r.Context()) { reject(w, r, 504, "request deadline exceeded"); return }
        if r.Context().Err() == nil {
          // Avoid net/http draining an unfinished request body before sending rejection.
          w.Header().Set("Connection", "close")
          w.Header().Set("Retry-After", strconv.FormatInt(seconds, 10))
          http.Error(w, "server overloaded", int(config.status))
        }
        return
      }
      defer release()
      mux.ServeHTTP(w, r)
    })
  }
  inner := handler
  handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
    now := time.Now()
    var warned map[string]bool
    warn := func(name string) {
      name = http.CanonicalHeaderKey(name)
      if warned == nil { warned = map[string]bool{} }
      if !warned[name] { warned[name] = true; warnPropagationHeader(name) }
    }
    parent := func() (string, bool) {
      values := r.Header.Values("traceparent")
      if len(values) == 0 { return "", false }
      if len(values) != 1 || !traceParentValid(values[0]) { warn("traceparent"); return "", false }
      return values[0], true
    }
    restore := _borkBindPropagated(func(name string) (string, bool) {
      switch strings.ToLower(name) {
      case "bork-timeout-ns": return "", false
      case "traceparent": return parent()
      case "tracestate":
        if _, valid := parent(); !valid { return "", false }
        values := r.Header.Values(name)
        if len(values) == 0 { return "", false }
        text := strings.Join(values, ",")
        if !traceStateValid(text) { warn(name); return "", false }
        return text, true
      default:
        values := r.Header.Values(name)
        if len(values) == 0 { return "", false }
        if len(values) != 1 { warn(name); return "", false }
        return values[0], true
      }
    })
    defer restore()
    ctx := r.Context()
    deadline, bounded := ctx.Deadline()
    shorten := func(duration time.Duration) {
      candidate := now.Add(duration)
      if !bounded || candidate.Before(deadline) { deadline, bounded = candidate, true }
    }
    if requestTimeoutMs > 0 { shorten(time.Duration(requestTimeoutMs)*time.Millisecond) }
    if values, found := r.Header[http.CanonicalHeaderKey("Bork-Timeout-Ns")]; found {
      valid := len(values) == 1 && len(values[0]) > 0 && len(values[0]) <= 19
      text := ""
      if valid {
        text = values[0]
        for _, character := range text { if character < '0' || character > '9' { valid = false; break } }
      }
      nanos, err := strconv.ParseInt(text, 10, 64)
      if !valid || err != nil { reject(w, r, 400, "invalid Bork-Timeout-Ns"); return }
      shorten(time.Duration(nanos))
    }
    if bounded {
      if !deadline.After(time.Now()) { reject(w, r, 504, "request deadline exceeded"); return }
      var stop context.CancelFunc
      ctx, stop = context.WithDeadline(ctx, deadline)
      defer stop()
      r = r.WithContext(ctx)
    }
    if ctx.Err() != nil { return }
    inner.ServeHTTP(w, r)
  })
  ln, err := net.Listen("tcp", addr)
  if err != nil { return IoError{path: addr, message: err.Error()} }
  if pair, secure := _borkOptionGet(certificate); secure {
    pem := pair.(Certificate_certificate)
    cert, err := tls.X509KeyPair(_borkBytesData(pem.certificatePem), _borkBytesData(pem.keyPem))
    if err != nil { panic("http: validated certificate became invalid") }
    ln = tls.NewListener(ln, &tls.Config{Certificates: []tls.Certificate{cert}, MinVersion: tls.VersionTLS12})
  }
  srv := &http.Server{BaseContext: func(net.Listener) context.Context { return _borkScopeContext(s) }, Handler: handler, ReadHeaderTimeout: 10*time.Second}
  state := struct { addr string; done chan struct{}; cancelled <-chan struct{}; failure *error; load func() Option[AdmissionLoad] }{ln.Addr().String(), make(chan struct{}), _borkScopeContext(s).Done(), new(error), load}
  go func() { *state.failure = srv.Serve(ln); close(state.done) }()
  return Server{handle: state, owner: s.Own(func() {
    ctx := context.Background()
    if drain > 0 { var stop context.CancelFunc; ctx, stop = context.WithTimeout(ctx, drain); defer stop() }
    if err := srv.Shutdown(ctx); err != nil { srv.Close() }
    <-state.done
  })}
}

// Address is the address the server listens on, as host:port.
fn Address(server: Server): String unsafe go {
  return server.handle.(struct {
    addr string
    done chan struct{}
    cancelled <-chan struct{}
    failure *error
    load func() Option[AdmissionLoad]
  }).addr
}

// AdmissionState is a consistent counter snapshot, or None when no policy is set.
fn AdmissionState(server: Server) uses state: Option[AdmissionLoad] unsafe go {
  return server.handle.(struct { addr string; done chan struct{}; cancelled <-chan struct{}; failure *error; load func() Option[AdmissionLoad] }).load()
}

// Wait blocks until the server stops or its scope is cancelled, for
// example by Ctrl+C. Closing the scope then shuts the server down.
fn Wait(server: Server) uses net unsafe go {
  state := server.handle.(struct {
    addr string
    done chan struct{}
    cancelled <-chan struct{}
    failure *error
    load func() Option[AdmissionLoad]
  })
  select {
  case <-state.done:
  case <-state.cancelled:
  }
}

// WaitAny blocks until the first server stops: an app with several
// listeners (an API, metrics, debug) can watch them all at once. It returns
// Ok when a server's scope is cancelled, for example by Ctrl+C, and IoError
// naming the address when a server stops on its own. Closing the scope then
// shuts the remaining servers down. An empty list returns Ok at once.
fn WaitAny(servers: List[Server]) uses net: Ok | IoError unsafe go {
  failures := waitServers(servers, 1)
  if len(failures) > 0 { return failures[0] }
  return _borkOk()
}

// WaitAll blocks until every server has stopped or its scope is cancelled.
// It returns the first IoError among servers that stopped on their own, in
// list order, or Ok. An empty list returns Ok at once.
fn WaitAll(servers: List[Server]) uses net: Ok | IoError unsafe go {
  failures := waitServers(servers, int64(len(servers)))
  if len(failures) > 0 { return failures[0] }
  return _borkOk()
}

// waitServers waits until count servers have stopped or been cancelled,
// and returns IoErrors for those that stopped on their own, in list order.
fn waitServers(servers: List[Server], count: Int): List[IoError] unsafe go {
  if len(servers) == 0 { return nil }
  type serverState = struct {
    addr string
    done chan struct{}
    cancelled <-chan struct{}
    failure *error
    load func() Option[AdmissionLoad]
  }
  type ended struct { index int; failed bool }
  results := make(chan ended, len(servers))
  stop := make(chan struct{})
  defer close(stop)
  for index, server := range servers {
    state := server.handle.(serverState)
    go func() {
      select {
      case <-state.done:
        results <- ended{index, *state.failure != http.ErrServerClosed}
      case <-state.cancelled:
        // Preserve a completed Serve failure even if cancellation came later.
        select {
        case <-state.done: results <- ended{index, *state.failure != http.ErrServerClosed}
        default: results <- ended{index, false}
        }
      case <-stop:
      }
    }()
  }
  failed := make([]bool, len(servers))
  for i := int64(0); i < count; i++ {
    if result := <-results; result.failed { failed[result.index] = true }
  }
  var failures []IoError
  for index, server := range servers {
    if !failed[index] { continue }
    state := server.handle.(serverState)
    message := "server stopped"
    if err := *state.failure; err != nil { message = err.Error() }
    failures = append(failures, IoError{path: state.addr, message: message})
  }
  return failures
}

// Get sends a GET request cancelled with s. timeoutMs bounds the entire request,
// including reading the body; zero uses only the scope's cancellation/deadline.
fn Get(url: String, s: Scope, timeoutMs: TimeoutMs = 0) uses net + clock + state: Result {
  Send("GET", url, {:}, "", s, timeoutMs)
}

// Post sends a POST request with the given content type.
fn Post(url: String, contentType: String, body: String, s: Scope, timeoutMs: TimeoutMs = 0) uses net + clock + state: Result {
  Send("POST", url, { "Content-Type": [contentType] }, body, s, timeoutMs)
}

// Send reads the entire response. Overload, deadline and cancellation are typed;
// other HTTP statuses remain responses and transport failures remain IoError.
// Effective scope/timeout budgets propagate through Bork-Timeout-Ns, refreshed
// on redirects; manually supplied values of that header are replaced or removed.
fn Send(method: String, url: String, headers: Headers, body: String, s: Scope, timeoutMs: TimeoutMs = 0) uses net + clock + state: Result unsafe go {
  import "context"
  import "errors"
  import "io"
  import "net/http"
  import "sort"
  import "strconv"
  import "strings"
  import "time"
  scopeContext := _borkScopeContext(s)
  ctx := scopeContext
  if timeoutMs > 0 {
    var stop context.CancelFunc
    ctx, stop = context.WithTimeout(ctx, time.Duration(timeoutMs)*time.Millisecond)
    defer stop()
  }
  deadline := func() (time.Time, bool) {
    limit, bounded := ctx.Deadline()
    if inherited, found := scopeContext.Deadline(); found && (!bounded || inherited.Before(limit)) {
      limit, bounded = inherited, true
    }
    return limit, bounded
  }
  failure := func(err error) any {
    if errors.Is(err, context.DeadlineExceeded) || errors.Is(context.Cause(ctx), context.DeadlineExceeded) { return DeadlineExceeded{message: err.Error()} }
    if errors.Is(err, context.Canceled) || ctx.Err() != nil {
      if errors.Is(ctx.Err(), context.DeadlineExceeded) { return DeadlineExceeded{message: ctx.Err().Error()} }
      cause := context.Cause(ctx)
      if cause == nil { cause = err }
      return Cancelled{reason: cause.Error()}
    }
    return IoError{path: url, message: err.Error()}
  }
  if limit, ok := deadline(); ok && !limit.After(time.Now()) {
    return DeadlineExceeded{message: "request deadline exceeded"}
  }
  if err := ctx.Err(); err != nil { return failure(err) }
  req, err := http.NewRequestWithContext(ctx, method, url, strings.NewReader(body))
  if err != nil { return IoError{path: url, message: err.Error()} }
  _borkMapEach(headers, func(name string, values []string) bool {
    for _, value := range values { req.Header.Add(name, value) }
    return true
  })
  for _, header := range _borkPropagated() {
    if !strings.EqualFold(header.Name, "Bork-Timeout-Ns") { req.Header.Set(header.Name, header.Value) }
  }
  prepare := func(request *http.Request) error {
    if err := ctx.Err(); err != nil { return err }
    parent := request.Header.Values("traceparent")
    if len(parent) != 1 || !traceParentValid(parent[0]) {
      request.Header.Del("traceparent")
      request.Header.Del("tracestate")
    } else if values := request.Header.Values("tracestate"); len(values) > 0 {
      text := strings.Join(values, ",")
      if traceStateValid(text) { request.Header.Set("tracestate", text) } else { request.Header.Del("tracestate") }
    }
    request.Header.Del("Bork-Timeout-Ns")
    if limit, found := deadline(); found {
      remaining := time.Until(limit)
      if remaining <= 0 { return context.DeadlineExceeded }
      request.Header.Set("Bork-Timeout-Ns", strconv.FormatInt(int64(remaining), 10))
    }
    return nil
  }
  if err := prepare(req); err != nil { return failure(err) }
  client := *http.DefaultClient
  redirect := client.CheckRedirect
  client.CheckRedirect = func(request *http.Request, via []*http.Request) error {
    if redirect != nil {
      if err := redirect(request, via); err != nil { return err }
    } else if len(via) >= 10 { return errors.New("stopped after 10 redirects") }
    return prepare(request)
  }
  resp, err := client.Do(req)
  if err != nil { return failure(err) }
  defer resp.Body.Close()
  data, err := io.ReadAll(resp.Body)
  if err != nil { return failure(err) }
  keys, values := []string{}, [][]string{}
  for name := range resp.Header { keys = append(keys, name) }
  sort.Strings(keys)
  for _, name := range keys { values = append(values, append([]string(nil), resp.Header[name]...)) }
  response := Response{status: int64(resp.StatusCode), headers: _borkMapOf(keys, values), body: string(data)}
  if resp.StatusCode == 429 || resp.StatusCode == 503 {
    return Overloaded{retryAfter: readRetryAfter(response.headers), response: response}
  }
  return response
}

// RetryAfter parses exactly one Retry-After field against an explicit clock
// reading. Invalid, repeated, or unrepresentable hints are None; past dates are zero.
fn RetryAfter(headers: Headers, now: time.Instant): Option[time.Duration] unsafe go {
  import "net/http"
  import "strconv"
  import "strings"
  import "time"
  count := 0
  text := ""
  _borkMapEach(headers, func(name string, values []string) bool {
    if strings.EqualFold(name, "Retry-After") {
      for _, value := range values { count++; text = value }
    }
    return true
  })
  if count != 1 { return noRetryDelay() }
  text = strings.Trim(text, " \t")
  if text == "" { return noRetryDelay() }
  decimal := true
  for _, digit := range text { if digit < '0' || digit > '9' { decimal = false; break } }
  if decimal {
    seconds, err := strconv.ParseUint(text, 10, 64)
    if err != nil || seconds > uint64(9223372036854775807/int64(time.Second)) { return noRetryDelay() }
    return retryDelay(int64(seconds)*int64(time.Second))
  }
  date, err := http.ParseTime(text)
  if err != nil { return noRetryDelay() }
  current := time.Unix(0, now.unixNanos)
  // RFC 9110 resolves RFC850's two-digit year relative to this clock,
  // not Go's fixed 1969/2068 split. Choose the latest matching year
  // no more than 50 calendar years ahead of the supplied instant.
  if old, oldErr := time.Parse(time.RFC850, text); oldErr == nil {
    cutoff := current.AddDate(50, 0, 0)
    year := cutoff.Year()/100*100 + old.Year()%100
    date = time.Date(year, old.Month(), old.Day(), old.Hour(), old.Minute(), old.Second(), 0, time.UTC)
    if date.After(cutoff) {
      year -= 100
      date = time.Date(year, old.Month(), old.Day(), old.Hour(), old.Minute(), old.Second(), 0, time.UTC)
    }
    if date.Month() != old.Month() || date.Day() != old.Day() { return noRetryDelay() }
  }
  if !date.After(current) { return retryDelay(0) }
  wait := date.Sub(current)
  if !current.Add(wait).Equal(date) { return noRetryDelay() }
  return retryDelay(int64(wait))
}
fn retryDelay(nanos: Int): Option[time.Duration] { Option.Some { value: time.Nanoseconds(nanos) } }
fn noRetryDelay(): Option[time.Duration] { Option.None }
fn readRetryAfter(headers: Headers) uses clock: Option[time.Duration] { RetryAfter(headers, time.Now()) }
