// BodyReader is a scope-owned stream of immutable binary chunks.
type BodyReader = resource
type Eof = {}
pred ValidReadSize(size: Int) { size > 0 && size <= 16777216 }
type ReadSize = Int where ValidReadSize
type ReadResult = Bytes | Eof | BodyTooLarge | DeadlineExceeded | Cancelled | IoError
type StreamResponse = { status: Status, headers: Headers, body: BodyReader }
type StreamResult = StreamResponse | BodyTooLarge | DeadlineExceeded | Cancelled | IoError

// Read returns up to size bytes. Concurrent reads serialize. Eof and failures
// are terminal; a total byte limit is checked with a separate overflow probe.
fn Read(body: BodyReader, size: ReadSize = 4096) uses net + clock + state: ReadResult unsafe go {
  import "context"
  import "io"
  import "sync"
  handle := body.handle.(*_borkResourceHandle)
  source := handle.Value.(struct {
    reader io.ReadCloser
    ctx context.Context
    failure func(error) any
    close func()
    end func()
    mu *sync.Mutex
    remaining *int64
    limit int64
    terminal *any
  })
  source.mu.Lock()
  defer source.mu.Unlock()
  if *source.terminal != nil { return *source.terminal }
  finish := func(result any) any {
    *source.terminal = result
    if _, eof := result.(Eof); eof { source.end() } else { source.close() }
    return result
  }
  if err := source.ctx.Err(); err != nil { return finish(source.failure(err)) }
  if source.remaining != nil && *source.remaining == 0 {
    var probe [1]byte
    n, err := io.ReadFull(source.reader, probe[:])
    if n > 0 { return finish(BodyTooLarge{limit: source.limit}) }
    if err == io.EOF { return finish(Eof{}) }
    return finish(source.failure(err))
  }
  count := size
  if source.remaining != nil { count = min(count, *source.remaining) }
  data := make([]byte, int(count))
  n, err := source.reader.Read(data)
  if n > 0 {
    if source.remaining != nil { *source.remaining -= int64(n) }
    if err == io.EOF { finish(Eof{}) } else if err != nil { finish(source.failure(err)) }
    return _borkBytesFrom(data[:n])
  }
  if err == io.EOF { return finish(Eof{}) }
  if err != nil { return finish(source.failure(err)) }
  return _borkBytesFrom(nil)
}

// Close abandons a body early. Scope cleanup also closes it; either is safe
// more than once and interrupts a pending Read.
fn Close(body: BodyReader) uses net + state unsafe go {
  import "context"
  import "io"
  import "sync"
  handle := body.handle.(*_borkResourceHandle)
  source := handle.Value.(struct {
    reader io.ReadCloser
    ctx context.Context
    failure func(error) any
    close func()
    end func()
    mu *sync.Mutex
    remaining *int64
    limit int64
    terminal *any
  })
  source.close()
}

// OpenBody runs a chunk producer anchored to s with no queued chunks. The
// callback receives a child scope cancelled on Close or when s ends. Attaching
// its reader does not extend producer work or the lifetime of its captures.
fn OpenBody(s: Scope, next: (Scope) => ReadResult in s) uses net + clock + state: BodyReader unsafe go {
  import "context"
  import "errors"
  import "fmt"
  import "io"
  import "sync"
  reader, writer := io.Pipe()
  handle := _borkNewResourceHandle(nil, s)
  ctx, cancelProducer := context.WithCancelCause(_borkScopeContext(s))
  stopHandle := context.AfterFunc(handle.Context(), func() { cancelProducer(context.Cause(handle.Context())) })
  var once sync.Once
  var failureMu sync.Mutex
  var producerFailure any
  done := make(chan struct{})
  stop := context.AfterFunc(ctx, func() { reader.CloseWithError(context.Cause(ctx)); writer.CloseWithError(context.Cause(ctx)) })
  finish := func() {
    once.Do(func() {
      cancelProducer(context.Canceled)
      handle.Close()
      reader.Close()
      writer.Close()
      <-done
      stop()
      stopHandle()
    })
    reader.Close()
  }
  end := func() {
    once.Do(func() {
      stop()
      writer.Close()
      cancelProducer(context.Canceled)
      handle.Close()
      <-done
      stopHandle()
    })
  }
  fail := func(err error) any {
    failureMu.Lock()
    failed := producerFailure
    failureMu.Unlock()
    if failed != nil { return failed }
    if cause := context.Cause(ctx); cause != nil {
      if errors.Is(cause, context.DeadlineExceeded) { return DeadlineExceeded{message: cause.Error()} }
      return Cancelled{reason: cause.Error()}
    }
    return IoError{path: "", message: err.Error()}
  }
  handle.Value = struct {
    reader io.ReadCloser
    ctx context.Context
    failure func(error) any
    close func()
    end func()
    mu *sync.Mutex
    remaining *int64
    limit int64
    terminal *any
  }{reader, ctx, fail, finish, end, new(sync.Mutex), nil, 0, new(any)}
  go func() {
    defer close(done)
    defer writer.Close()
    defer func() {
      if caught := recover(); caught != nil {
        err := fmt.Errorf("HTTP body producer panicked: %v", caught)
        failureMu.Lock()
        producerFailure = IoError{path: "", message: err.Error()}
        failureMu.Unlock()
        writer.CloseWithError(err)
      }
    }()
    producer := _borkScopeWith(ctx)
    defer _borkScopeAbort(producer)
    for {
      if ctx.Err() != nil { return }
      result := next(producer)
      switch chunk := result.(type) {
      case _Bytes:
        if _, err := writer.Write(_borkBytesData(chunk)); err != nil { return }
      case Eof:
        _borkScopeClose(producer)
        return
      default:
        failureMu.Lock()
        producerFailure = result
        failureMu.Unlock()
        writer.CloseWithError(errors.New("HTTP body producer failed"))
        return
      }
    }
  }()
  // Producer work stays in s even if another scope retains the body handle.
  // Join it before s releases resources captured by next.
  s.Own(finish)
  return BodyReader{handle: handle, owner: s.Own(finish)}
}

// GetStream returns once response headers arrive. Its timeout covers subsequent
// body reads. No total byte limit is imposed unless maxBodyBytes is supplied.
fn GetStream(url: String, s: Scope, timeoutMs: TimeoutMs = 0, maxBodyBytes: Option[BodyLimit] = .None) uses net + clock + state: StreamResult {
  SendStream("GET", url, {:}, s, timeoutMs: timeoutMs, maxBodyBytes: maxBodyBytes)
}

// SendStream consumes/closes its upload before returning final response headers.
// An early response ends an unfinished upload; this is not a full-duplex client.
// Streaming uploads are not replayable;
// redirects follow Go's policy for requests without GetBody.
fn SendStream(method: String, url: String, headers: Headers, s: Scope, body: Option[BodyReader] in s = .None, timeoutMs: TimeoutMs = 0, maxBodyBytes: Option[BodyLimit] = .None) uses net + clock + state: StreamResult {
  upload: Option[BodyReader] = match (body) {
    .Some(source) => .Some(forwardBody(s, source))
    .None => .None
  }
  sendStream(method, url, headers, s, upload, timeoutMs, maxBodyBytes)
}

// Cancel an upload's source as well as its pipe, so a blocked source Read
// cannot retain the forwarding task after the request has been abandoned.
fn forwardBody(s: Scope, source: BodyReader in s) uses net + clock + state: BodyReader unsafe go {
  import "context"
  upload := OpenBody(s, func(producer *_Scope) any { return Read(source, 4096) })
  handle := upload.handle.(*_borkResourceHandle)
  stop := context.AfterFunc(handle.Context(), func() { Close(source) })
  s.Own(func() { stop(); Close(source) })
  return upload
}

fn sendStream(method: String, url: String, headers: Headers, s: Scope, body: Option[BodyReader] in s, timeoutMs: TimeoutMs, maxBodyBytes: Option[BodyLimit]) uses net + clock + state: StreamResult unsafe go {
  import "context"
  import "errors"
  import "io"
  import "net/http"
  import "net/http/httptrace"
  import "sort"
  import "sync"
  import "strconv"
  import "strings"
  import "time"
  scopeContext := _borkScopeContext(s)
  handle := _borkNewResourceHandle(nil, s)
  ctx := handle.Context()
  stop := func() {}
  if timeoutMs > 0 { ctx, stop = context.WithTimeout(ctx, time.Duration(timeoutMs)*time.Millisecond) }
  stopUpload := func() bool { return true }
  if upload, ok := _borkOptionGet(body); ok { stopUpload = context.AfterFunc(ctx, func() { Close(upload) }) }
  wroteRequest := make(chan struct{})
  var wroteOnce sync.Once
  if _, ok := _borkOptionGet(body); ok {
    ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{WroteRequest: func(httptrace.WroteRequestInfo) { wroteOnce.Do(func() { close(wroteRequest) }) }})
  }
  requestContext, cancelTransport := context.WithCancel(ctx)
  retained := false
  defer func() {
    if !retained {
      cancelTransport()
      stopUpload()
      stop()
      handle.Close()
      if upload, ok := _borkOptionGet(body); ok { Close(upload) }
    }
  }()
  deadline := func() (time.Time, bool) {
    limit, bounded := ctx.Deadline()
    if inherited, found := scopeContext.Deadline(); found && (!bounded || inherited.Before(limit)) {
      limit, bounded = inherited, true
    }
    return limit, bounded
  }
  uploadComplete := false
  failure := func(err error) any {
    if errors.Is(err, context.DeadlineExceeded) || errors.Is(context.Cause(ctx), context.DeadlineExceeded) { return DeadlineExceeded{message: err.Error()} }
    if errors.Is(err, context.Canceled) || ctx.Err() != nil {
      if errors.Is(ctx.Err(), context.DeadlineExceeded) { return DeadlineExceeded{message: ctx.Err().Error()} }
      cause := context.Cause(ctx)
      if cause == nil { cause = err }
      return Cancelled{reason: cause.Error()}
    }
    if upload, ok := _borkOptionGet(body); ok && !uploadComplete {
      source := upload.handle.(*_borkResourceHandle).Value.(struct {
        reader io.ReadCloser
        ctx context.Context
        failure func(error) any
        close func()
        end func()
        mu *sync.Mutex
        remaining *int64
        limit int64
        terminal *any
      })
      return source.failure(err)
    }
    return IoError{path: url, message: err.Error()}
  }
  if limit, ok := deadline(); ok && !limit.After(time.Now()) {
    return DeadlineExceeded{message: "request deadline exceeded"}
  }
  if err := ctx.Err(); err != nil { return failure(err) }
  var input io.Reader
  if upload, ok := _borkOptionGet(body); ok {
    source := upload.handle.(*_borkResourceHandle).Value.(struct {
      reader io.ReadCloser
      ctx context.Context
      failure func(error) any
      close func()
      end func()
      mu *sync.Mutex
      remaining *int64
      limit int64
      terminal *any
    })
    input = source.reader
  }
  req, err := http.NewRequestWithContext(requestContext, method, url, input)
  if err != nil { return IoError{path: url, message: err.Error()} }
  _borkMapEach(headers, func(name string, values []string) bool {
    for _, value := range values { req.Header.Add(name, value) }
    return true
  })
  for _, header := range _borkPropagated() {
    if !strings.EqualFold(header.Name, "Bork-Timeout-Ns") { req.Header.Set(header.Name, header.Value) }
  }
  prepare := func(request *http.Request) error {
    if err := ctx.Err(); err != nil { return err }
    parent := request.Header.Values("traceparent")
    if len(parent) != 1 || !traceParentValid(parent[0]) {
      request.Header.Del("traceparent")
      request.Header.Del("tracestate")
    } else if values := request.Header.Values("tracestate"); len(values) > 0 {
      text := strings.Join(values, ",")
      if traceStateValid(text) { request.Header.Set("tracestate", text) } else { request.Header.Del("tracestate") }
    }
    request.Header.Del("Bork-Timeout-Ns")
    if limit, found := deadline(); found {
      remaining := time.Until(limit)
      if remaining <= 0 { return context.DeadlineExceeded }
      request.Header.Set("Bork-Timeout-Ns", strconv.FormatInt(int64(remaining), 10))
    }
    return nil
  }
  if err := prepare(req); err != nil { return failure(err) }
  client := *http.DefaultClient
  redirect := client.CheckRedirect
  client.CheckRedirect = func(request *http.Request, via []*http.Request) error {
    if redirect != nil {
      if err := redirect(request, via); err != nil { return err }
    } else if len(via) >= 10 { return errors.New("stopped after 10 redirects") }
    return prepare(request)
  }
  resp, err := client.Do(req)
  if err != nil { return failure(err) }
  if upload, ok := _borkOptionGet(body); ok {
    source := upload.handle.(*_borkResourceHandle).Value.(struct {
      reader io.ReadCloser
      ctx context.Context
      failure func(error) any
      close func()
      end func()
      mu *sync.Mutex
      remaining *int64
      limit int64
      terminal *any
    })
    stopUpload()
    source.end()
    // A peer may reject an upload without reading it. Do not wait for socket
    // writes: cancel that transport request, retaining the received metadata.
    select {
    case <-wroteRequest:
    default: cancelTransport()
    }
    Close(upload)
    uploadComplete = true
  }
  var once sync.Once
  var stopWatch func() bool
  finish := func() {
    once.Do(func() {
      if stopWatch != nil { stopWatch() }
      stopUpload()
      cancelTransport()
      handle.Close()
      stop()
      if upload, ok := _borkOptionGet(body); ok { Close(upload) }
      resp.Body.Close()
    })
  }
  stopWatch = context.AfterFunc(ctx, func() { resp.Body.Close() })
  var remaining *int64
  limit := int64(0)
  if configured, ok := _borkOptionGet(maxBodyBytes); ok { limit = configured; remaining = new(int64); *remaining = configured }
  handle.Value = struct {
    reader io.ReadCloser
    ctx context.Context
    failure func(error) any
    close func()
    end func()
    mu *sync.Mutex
    remaining *int64
    limit int64
    terminal *any
  }{resp.Body, ctx, failure, finish, finish, new(sync.Mutex), remaining, limit, new(any)}
  reader := BodyReader{handle: handle, owner: s.Own(finish)}
  keys, values := []string{}, [][]string{}
  for name := range resp.Header { keys = append(keys, name) }
  sort.Strings(keys)
  for _, name := range keys { values = append(values, append([]string(nil), resp.Header[name]...)) }
  retained = true
  return StreamResponse{status: int64(resp.StatusCode), headers: _borkMapOf(keys, values), body: reader}
}
