// Package shape describes a target during typed derive expansion. Descriptors
// cannot escape into runtime values; compile-time controls consume them.
type Kind = sealed {
  Record
  Sealed
  Other
}
// During expansion a field has Type (with independent facts), RawType
// (without its field facts), and validate(value), which returns the checked
// field value or ValidationError. check(value) returns Ok or ValidationError
// and also supports heads which might equal the failure type. Sibling and owner
// invariants remain deferred.
type Field[T] = private {
  name: String
  positional: Bool
  index: Int
  doc: String
  computed: Bool
  hasDefault: Bool
  tags: List[Tag]
  facts: List[Fact[T]]
}
// Tag is one ordered `go { name: "value" }` tag declared on a field.
type Tag = { name: String, value: String }
// Fact keeps the resolved obligation identity during expansion. Its text is
// display metadata, not a predicate to parse or a promise of validation.
type Fact[T] = private {
  text: String
  path: String
  independent: Bool
}
type Variant[T] = private {
  name: String
  positional: Bool
  index: Int
  fields: List[Field[T]]
  facts: List[Fact[T]]
}
// fields exposes record fields in declaration order during derive expansion.
fn fields[T](): List[Field[T]] unsafe go { panic("shape.fields requires a derive template") }
// variants exposes sealed alternatives in declaration order.
fn variants[T](): List[Variant[T]] unsafe go { panic("shape.variants requires a derive template") }
// kind identifies the target representation during derive expansion.
fn kind[T](): Kind unsafe go { panic("shape.kind requires a derive template") }
// name returns the target's source type name during derive expansion.
fn name[T](): String unsafe go { panic("shape.name requires a derive template") }
// typeName preserves type arguments in the target's display name.
fn typeName[T](): String unsafe go { panic("shape.typeName requires a derive template") }
// owner returns the target's defining package path during derive expansion.
fn owner[T](): String unsafe go { panic("shape.owner requires a derive template") }
// facts exposes the target's invariants and constrained head obligations.
fn facts[T](): List[Fact[T]] unsafe go { panic("shape.facts requires a derive template") }
// fail rejects the target at its derive request with a compile-time message.
fn fail(message: String): Never unsafe go { panic("shape.fail requires a derive template") }

// Obligation identifies a resolved source fact, including its resolved owner.
// It is diagnostic provenance, never a value proof or a callable predicate.
type Obligation = private { owner: String, variant: String, field: String, index: Int, source: String }
// Missing and duplicate inputs have no source fact; predicate failures retain it.
type ValidationError = { path: String, message: String, obligation: Option[Obligation] = Option.None }
// builder has a dependent private storage result during derive expansion.
fn builder[T](): Never unsafe go { panic("shape.builder requires a derive template") }

// positional identifies the ordered slots of a structural tuple target.
fn positional[T](): Bool unsafe go { panic("shape.positional requires a derive template") }

// metadata reads associated metadata from the selected instance. C is a class
// handle, and M is the resolved type key. Missing metadata returns None.
fn metadata[T, C, M](): Option[M] unsafe go { panic("shape.metadata requires compiler dictionary selection") }

// exhausted closes a complete sequence of returning projections of one owner.
fn exhausted[T](value: T): Never unsafe go { panic("shape.exhausted requires certified derive projections") }

// ForeignRecord is an ordered foreign (Go struct) layout of a record. A derive
// template that declares `metadata shape.ForeignRecord` asks the compiler for
// a generated Go struct with this layout, plus checked conversions. The
// template's expression is evaluated during expansion, so it may only use
// compile-time values: literals of these layout types, comptime lists,
// descriptor properties and String case operations.
type ForeignRecord = { fields: List[ForeignField] }
// ForeignField places the stored field at slot (a field index) in the layout,
// with an exported Go name, ordered struct tags and an Option mapping policy.
type ForeignField = { slot: Int, name: String, tags: List[Tag], option: ForeignOption }
type ForeignOption = sealed {
  // Pointer maps Option[A] to *A, or to A when A's Go type is already nillable.
  Pointer
  // Reject refuses Option fields.
  Reject
}
