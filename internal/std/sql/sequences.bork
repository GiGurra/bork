// Rows requires explicitly unsafe query text and decodes each row while
// traversing, keeping errors as explicit elements.
// Every traversal executes a fresh query; stopping closes its active rows.
fn Rows[T: Decode](connection: Connection | Transaction, query: UnsafeQuery, params: List[Value]): Seq[T | Error | DecodeError] uses io + net {
  RowsJson(connection, query, params).map(value => decodeRow[T](value))
}
fn decodeRow[T: Decode](value: Json | Error): T | Error | DecodeError {
  match (value) { json: Json => decode[T](json), error: Error => error }
}

// RowsJson converts one row at a time, copying all borrowed driver buffers.
fn RowsJson(connection: Connection | Transaction, query: UnsafeQuery, params: List[Value]): Seq[Json | Error] uses io + net unsafe go {
  import "database/sql"
  import "context"
  import "fmt"
  import "math"
  import "strconv"
  import "strings"
  import "time"
  return _Seq[any]{run: func(yield func(any) bool) {
  type executor interface {
    ExecContext(context.Context, string, ...any) (sql.Result, error)
    QueryContext(context.Context, string, ...any) (*sql.Rows, error)
  }
  var db executor
  var ctx context.Context
  switch connection := connection.(type) {
  case Connection:
    state := connection.handle.(*_borkResourceHandle)
    db, ctx = state.Value.(executor), state.Context()
  case Transaction:
    state := connection.handle.(*_borkResourceHandle)
    db, ctx = state.Value.(executor), state.Context()
  default: panic("sql: invalid connection")
  }
  args := make([]any, len(params))
  for i, param := range params {
    switch param := param.(type) {
    case Null: args[i] = nil
    case _Bytes: args[i] = _borkBytesData(param)
    default: args[i] = param
    }
  }
  rows, err := db.QueryContext(ctx, query.text, args...)
  if err != nil { yield(Error{operation: "query", message: err.Error()}); return }
  defer rows.Close()
  columns, err := rows.Columns()
  if err != nil { yield(Error{operation: "query", message: err.Error()}); return }
  types, err := rows.ColumnTypes()
  if err != nil { yield(Error{operation: "query", message: err.Error()}); return }
  seen := map[string]bool{}
  for _, name := range columns {
    if seen[name] { yield(Error{operation: "query", message: "duplicate column name: " + name}); return }
    seen[name] = true
  }
  for rows.Next() {
    values := make([]any, len(columns))
    targets := make([]any, len(columns))
    for i := range values { targets[i] = &values[i] }
    if err := rows.Scan(targets...); err != nil { yield(Error{operation: "query", message: err.Error()}); return }
    fields := make([]JsonField, len(columns))
    for i, value := range values {
      var json Json
      switch value := value.(type) {
      case nil: json = Json_Null{}
      case string: json = Json_String{value: value}
      case int64:
        kind := strings.ToUpper(types[i].DatabaseTypeName())
        if kind == "BOOL" || kind == "BOOLEAN" {
          if value != 0 && value != 1 { yield(Error{operation: "query", message: "invalid boolean in column " + columns[i]}); return }
          json = Json_Bool{value: value == 1}
        } else { json = Json_Number{text: strconv.FormatInt(value, 10)} }
      case float64:
        if math.IsNaN(value) || math.IsInf(value, 0) { yield(Error{operation: "query", message: "non-finite number in column " + columns[i]}); return }
        json = Json_Number{text: strconv.FormatFloat(value, 'g', -1, 64)}
      case bool: json = Json_Bool{value: value}
      case []byte:
        items := make([]Json, len(value))
        for i, b := range value { items[i] = Json_Number{text: strconv.Itoa(int(b))} }
        json = Json_Array{items: items}
      case time.Time: json = Json_String{value: value.Format(time.RFC3339Nano)}
      default: yield(Error{operation: "query", message: fmt.Sprintf("unsupported value in column %s: %T", columns[i], value)}); return
      }
      fields[i] = JsonField{name: columns[i], value: json}
    }
    if !yield(Json_Object{fields: fields}) { return }
  }
  if err := rows.Err(); err != nil { yield(Error{operation: "query", message: err.Error()}); return }
  if err := rows.Close(); err != nil { yield(Error{operation: "query", message: err.Error()}); return }

  }}
}
