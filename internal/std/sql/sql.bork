// Package sql owns database pools and transactions in scopes, and decodes rows
// through Decode. Use SQL placeholders for values rather than interpolating SQL.
type Connection = resource
type Transaction = resource
type Error = { operation: String, message: String }
type Null = {}
type Value = String | Int | Float | Bool | Bytes | Null
type Result = { rowsAffected: Int, lastInsertId: Option[Int] }
type outcome = sealed { Rows { values: List[Json] }, Changed { result: Result } }

// Open connects using "sqlite" or "pgx" (Postgres), and pings with s's context.
// SQLite pools use one connection, preserving :memory: databases and serializing
// access. The pool closes when its scope's last resource owner closes.
fn Open(driver: String, dataSource: String, s: Scope): Connection | Error unsafe go {
  import "database/sql"
  import "context"
  import "modernc.org/sqlite"
  import "github.com/jackc/pgx/v5/stdlib"
  _ = sqlite.Driver{}
  _ = stdlib.GetDefaultDriver()
  db, err := sql.Open(driver, dataSource)
  if err != nil { return Error{operation: "open", message: err.Error()} }
  if driver == "sqlite" { db.SetMaxOpenConns(1); db.SetMaxIdleConns(1) }
  if err := db.PingContext(_borkScopeContext(s)); err != nil {
    db.Close()
    return Error{operation: "open", message: err.Error()}
  }
  state := struct { db any; ctx context.Context }{db, _borkScopeContext(s)}
  return Connection{handle: state, owner: s.Own(func() { if err := db.Close(); err != nil { panic(err) } })}
}
fn OpenSqlite(dataSource: String, s: Scope): Connection | Error { Open("sqlite", dataSource, s) }
fn OpenPostgres(dataSource: String, s: Scope): Connection | Error { Open("pgx", dataSource, s) }

// Begin opens a transaction in s. Unless Commit succeeds, closing s rolls it
// back. Every operation uses the transaction's scope context.
fn Begin(connection: Connection, s: Scope): Transaction | Error unsafe go {
  import "database/sql"
  import "context"
  import "errors"
  tx, err := connection.handle.(struct { db any; ctx context.Context }).db.(*sql.DB).BeginTx(_borkScopeContext(s), nil)
  if err != nil { return Error{operation: "begin", message: err.Error()} }
  state := struct { db any; ctx context.Context }{tx, _borkScopeContext(s)}
  return Transaction{handle: state, owner: s.Own(func() {
    if err := tx.Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) { panic(err) }
  })}
}
fn Commit(transaction: Transaction): Unit | Error unsafe go {
  import "database/sql"
  import "context"
  if err := transaction.handle.(struct { db any; ctx context.Context }).db.(*sql.Tx).Commit(); err != nil { return Error{operation: "commit", message: err.Error()} }
  return _Unit{}
}
// Rollback is harmless after a transaction has already committed or rolled back.
fn Rollback(transaction: Transaction): Unit | Error unsafe go {
  import "database/sql"
  import "context"
  import "errors"
  if err := transaction.handle.(struct { db any; ctx context.Context }).db.(*sql.Tx).Rollback(); err != nil && !errors.Is(err, sql.ErrTxDone) { return Error{operation: "rollback", message: err.Error()} }
  return _Unit{}
}

// Exec binds params to the driver's placeholders (? for SQLite, $1 for
// Postgres), uses the owner's cancellation context, and returns the changed row count and optional generated ID.
fn Exec(connection: Connection | Transaction, query: String, params: List[Value]): Result | Error {
  match (run(connection, query, params, false)) {
    outcome.Changed { result } => result
    outcome.Rows { values } => panic("sql: unexpected query result")
    error: Error => error
  }
}

// Query materializes rows as records decoded from column-name JSON objects.
// SQL NULL maps to Option.None; facts are checked before any rows are returned.
fn Query[T: Decode](connection: Connection | Transaction, query: String, params: List[Value]): List[T] | Error | DecodeError {
  json = QueryJson(connection, query, params)?
  decode[List[T]](json)
}

// QueryJson returns the first result set as a JSON array of column-name objects.
// Integers retain exact digits, NULL is null, timestamps are RFC3339 strings,
// and binary columns are arrays of byte integers. Alias columns to record fields.
fn QueryJson(connection: Connection | Transaction, query: String, params: List[Value]): Json | Error {
  match (run(connection, query, params, true)) {
    outcome.Rows { values } => Json.Array { items: values }
    outcome.Changed { result } => panic("sql: unexpected exec result")
    error: Error => error
  }
}

fn run(connection: Connection | Transaction, query: String, params: List[Value], read: Bool): outcome | Error unsafe go {
  import "context"
  import "database/sql"
  import "fmt"
  import "math"
  import "strconv"
  import "strings"
  import "time"
  type executor interface {
    ExecContext(context.Context, string, ...any) (sql.Result, error)
    QueryContext(context.Context, string, ...any) (*sql.Rows, error)
  }
  var db executor
  var ctx context.Context
  switch connection := connection.(type) {
  case Connection:
    state := connection.handle.(struct { db any; ctx context.Context })
    db, ctx = state.db.(executor), state.ctx
  case Transaction:
    state := connection.handle.(struct { db any; ctx context.Context })
    db, ctx = state.db.(executor), state.ctx
  default: panic("sql: invalid connection")
  }
  args := make([]any, len(params))
  for i, param := range params {
    switch param := param.(type) {
    case Null: args[i] = nil
    case _Bytes: args[i] = _borkBytesData(param)
    default: args[i] = param
    }
  }
  if !read {
    result, err := db.ExecContext(ctx, query, args...)
    if err != nil { return Error{operation: "exec", message: err.Error()} }
    affected, err := result.RowsAffected()
    if err != nil { return Error{operation: "exec", message: err.Error()} }
    id := _borkNone[int64]()
    if value, err := result.LastInsertId(); err == nil { id = _borkSome(value) }
    return outcome_Changed{result: Result{rowsAffected: affected, lastInsertId: id}}
  }
  rows, err := db.QueryContext(ctx, query, args...)
  if err != nil { return Error{operation: "query", message: err.Error()} }
  defer rows.Close()
  columns, err := rows.Columns()
  if err != nil { return Error{operation: "query", message: err.Error()} }
  types, err := rows.ColumnTypes()
  if err != nil { return Error{operation: "query", message: err.Error()} }
  seen := map[string]bool{}
  for _, name := range columns {
    if seen[name] { return Error{operation: "query", message: "duplicate column name: " + name} }
    seen[name] = true
  }
  output := []Json{}
  for rows.Next() {
    values := make([]any, len(columns))
    targets := make([]any, len(columns))
    for i := range values { targets[i] = &values[i] }
    if err := rows.Scan(targets...); err != nil { return Error{operation: "query", message: err.Error()} }
    fields := make([]JsonField, len(columns))
    for i, value := range values {
      var json Json
      switch value := value.(type) {
      case nil: json = Json_Null{}
      case string: json = Json_String{value: value}
      case int64:
        kind := strings.ToUpper(types[i].DatabaseTypeName())
        if kind == "BOOL" || kind == "BOOLEAN" {
          if value != 0 && value != 1 { return Error{operation: "query", message: "invalid boolean in column " + columns[i]} }
          json = Json_Bool{value: value == 1}
        } else { json = Json_Number{text: strconv.FormatInt(value, 10)} }
      case float64:
        if math.IsNaN(value) || math.IsInf(value, 0) { return Error{operation: "query", message: "non-finite number in column " + columns[i]} }
        json = Json_Number{text: strconv.FormatFloat(value, 'g', -1, 64)}
      case bool: json = Json_Bool{value: value}
      case []byte:
        items := make([]Json, len(value))
        for i, b := range value { items[i] = Json_Number{text: strconv.Itoa(int(b))} }
        json = Json_Array{items: items}
      case time.Time: json = Json_String{value: value.Format(time.RFC3339Nano)}
      default: return Error{operation: "query", message: fmt.Sprintf("unsupported value in column %s: %T", columns[i], value)}
      }
      fields[i] = JsonField{name: columns[i], value: json}
    }
    output = append(output, Json_Object{fields: fields})
  }
  if err := rows.Err(); err != nil { return Error{operation: "query", message: err.Error()} }
  if err := rows.Close(); err != nil { return Error{operation: "query", message: err.Error()} }
  return outcome_Rows{values: output}
}
