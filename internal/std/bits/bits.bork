// Package bits provides width-aware operations on integer bit patterns.
// Import bork/bits to make these methods available. Signed values use their
// fixed-width two's-complement representation; bit zero is the least significant.

pred Count8(value: Int) { value >= 0 && value <= 8 }

pred Count16(value: Int) { value >= 0 && value <= 16 }

pred Count32(value: Int) { value >= 0 && value <= 32 }

pred Count64(value: Int) { value >= 0 && value <= 64 }

// Int8 operations use 8 bits.

fn (value: Int8) OnesCount(): Int where Count8 unsafe go {
  import gobits "math/bits"
  return int64(gobits.OnesCount8(uint8(value)))
}

fn (value: Int8) LeadingZeros(): Int where Count8 unsafe go {
  import gobits "math/bits"
  return int64(gobits.LeadingZeros8(uint8(value)))
}

fn (value: Int8) TrailingZeros(): Int where Count8 unsafe go {
  import gobits "math/bits"
  return int64(gobits.TrailingZeros8(uint8(value)))
}

fn (value: Int8) RotateLeft(count: Int): Int8 unsafe go {
  import gobits "math/bits"
  return int8(gobits.RotateLeft8(uint8(value), int(count % 8)))
}

fn (value: Int8) Reverse(): Int8 unsafe go {
  import gobits "math/bits"
  return int8(gobits.Reverse8(uint8(value)))
}

fn (value: Int8) ReverseBytes(): Int8 { value }

fn (value: Int8) TestBit(index: Int): Bool | OutOfRange unsafe go {
  import "strconv"
  if index < 0 || index >= 8 {
    return OutOfRange{value: strconv.FormatInt(index, 10), target: "bit index [0,8)"}
  }
  return uint8(value) & (uint8(1) << uint(index)) != 0
}

fn (value: Int8) SetBit(index: Int): Int8 | OutOfRange unsafe go {
  import "strconv"
  if index < 0 || index >= 8 {
    return OutOfRange{value: strconv.FormatInt(index, 10), target: "bit index [0,8)"}
  }
  return int8(uint8(value) | (uint8(1) << uint(index)))
}

fn (value: Int8) ClearBit(index: Int): Int8 | OutOfRange unsafe go {
  import "strconv"
  if index < 0 || index >= 8 {
    return OutOfRange{value: strconv.FormatInt(index, 10), target: "bit index [0,8)"}
  }
  return int8(uint8(value) &^ (uint8(1) << uint(index)))
}

fn (value: Int8) Extract(offset: Int, width: Int): Int8 | OutOfRange unsafe go {
  import "fmt"
  if offset < 0 || width < 0 || offset > 8 || width > 8 - offset {
    return OutOfRange{value: fmt.Sprintf("%d:%d", offset, width), target: "Int8 bit field"}
  }
  mask := (uint8(1) << uint(width)) - 1
  return int8((uint8(value) >> uint(offset)) & mask)
}
fn (value: Int8) Insert(offset: Int, width: Int, field: Int8): Int8 | OutOfRange unsafe go {
  import "fmt"
  if offset < 0 || width < 0 || offset > 8 || width > 8 - offset {
    return OutOfRange{value: fmt.Sprintf("%d:%d", offset, width), target: "Int8 bit field"}
  }
  mask := (uint8(1) << uint(width)) - 1
  if uint8(field) &^ mask != 0 {
    return OutOfRange{value: fmt.Sprint(field), target: fmt.Sprintf("%d-bit field", width)}
  }
  return int8((uint8(value) &^ (mask << uint(offset))) | (uint8(field) << uint(offset)))
}

