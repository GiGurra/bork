// Package process runs argv commands without a shell, owned by a scope.
import "bork/signal"
import "bork/time"

type Process = resource

// Reader reads a child's piped stdout or stderr as it is written. It belongs
// to the scope that started the child.
type Reader = resource

// Writer writes a child's piped stdin incrementally.
type Writer = resource

// Input is where a child's stdin comes from. Empty is /dev/null; Data and
// Text are written by bork and then closed; File is opened for reading; Pipe
// is written with child.Stdin(); From connects another child's piped output.
type Input = sealed {
  Empty
  Inherit
  Data { data: Bytes }
  Text { text: String }
  File { path: String }
  Pipe
  From { reader: Reader }
}

// Output is where a child's stdout goes. Capture keeps it in Result;
// Inherit forwards it to the parent's stdout; Discard is /dev/null; File
// creates or truncates, Append creates or appends; Pipe streams it through
// child.Stdout().
type Output = sealed {
  Capture
  Inherit
  Discard
  File { path: String }
  Append { path: String }
  Pipe
}

// ErrorOutput is where a child's stderr goes: an Output, or Stdout to share
// stdout's destination (2>&1). Shared capture keeps the child's write order.
type ErrorOutput = sealed {
  Capture
  Inherit
  Discard
  File { path: String }
  Append { path: String }
  Pipe
  Stdout
}

// ExitStatus is how a child ended: with an exit code, or killed by a signal
// (Unix only).
type ExitStatus = sealed {
  Exited { code: Int }
  Signaled { number: Int, name: String }
}

// Result is a finished child. code is the exit code, or -1 when a signal
// killed it. Streams that were not captured are empty.
type Result = { code: Int, status: ExitStatus, stdout: Bytes, stderr: Bytes }

// ExitError is a Result that Check rejected; message describes the exit and
// ends with the last line of captured stderr, if any.
type ExitError = { code: Int, status: ExitStatus, stdout: Bytes, stderr: Bytes, message: String }

type stream = { kind: String, path: String, data: Bytes, text: String }
type rawResult = { code: Int, signaled: Bool, signal: Int, signalName: String, stdout: Bytes, stderr: Bytes }
type running = {}

// Args is the program's command-line arguments (without its name).
fn Args() uses io: List[String] unsafe go {
  import "os"
  return os.Args[1:]
}

// Exit ends the program with the given status code, without closing
// scopes.
fn Exit(code: Int) uses io: Never unsafe go {
  import "os"
  os.Exit(int(code))
}

// Run starts a child and waits for it. A nonzero exit or a signal death is a
// Result, not an I/O error. None environment inherits the parent environment;
// Some([]) clears it. Inherited output pipes are bounded to one second (plus
// cancelGrace) after exit/cancellation. A successful exit with open pipes is
// IoError; nonzero Result output may truncate.
fn Run(s: Scope, name: String, arguments: List[String] = [], environment: Option[List[String]] = Option.None, directory: String = "", stdin: Input in s = .Empty, stdout: Output = .Capture, stderr: ErrorOutput = .Capture, cancelGrace: time.Duration = time.Duration { nanos: 0 }) uses io + state: Result | IoError | Cancelled {
  child = Start(s, name, arguments, environment, directory, runInput(stdin), runOutput(stdout), runErrorOutput(stderr), cancelGrace)?
  child.Wait()
}

// Run has no handle to stream through, so a piped stdin is empty and piped
// output is captured.
fn runInput(input: Input): Input {
  match (input) {
    Input.Pipe => .Empty
    _ => input
  }
}

fn runOutput(output: Output): Output {
  match (output) {
    Output.Pipe => .Capture
    _ => output
  }
}

fn runErrorOutput(output: ErrorOutput): ErrorOutput {
  match (output) {
    ErrorOutput.Pipe => .Capture
    _ => output
  }
}

// Start starts a subprocess in its own Unix process group, killed on
// cancellation: at once, or after SIGTERM and cancelGrace when it is positive.
// Group cancellation applies while the direct child is running; descendants
// that leave the group or outlive its normal exit are outside its ownership.
// Other targets kill only the direct child. Closing the scope cancels and
// reaps it even if Wait was never called. Captured output drains in the
// background whether or not anyone waits.
fn Start(s: Scope, name: String, arguments: List[String] = [], environment: Option[List[String]] = Option.None, directory: String = "", stdin: Input in s = .Empty, stdout: Output = .Capture, stderr: ErrorOutput = .Capture, cancelGrace: time.Duration = time.Duration { nanos: 0 }) uses io + state: Process | IoError | Cancelled {
  start(s, name, arguments, environment, directory, inputStream(stdin), source(stdin), outputStream(stdout), errorStream(stderr), cancelGrace.nanos)
}

fn inputStream(input: Input): stream {
  match (input) {
    Input.Empty => stream { kind: "empty", path: "", data: noBytes(), text: "" }
    Input.Inherit => stream { kind: "inherit", path: "", data: noBytes(), text: "" }
    Input.Data { data } => stream { kind: "data", path: "", data: data, text: "" }
    Input.Text { text } => stream { kind: "text", path: "", data: noBytes(), text: text }
    Input.File { path } => stream { kind: "file", path: path, data: noBytes(), text: "" }
    Input.Pipe => named("pipe", "")
    Input.From { reader: _ } => named("from", "")
  }
}

fn source(input: Input): Option[Reader] {
  match (input) {
    Input.From { reader } => .Some(reader)
    _ => .None
  }
}

fn outputStream(output: Output): stream {
  match (output) {
    Output.Capture => named("capture", "")
    Output.Inherit => named("inherit", "")
    Output.Discard => named("discard", "")
    Output.File { path } => named("file", path)
    Output.Append { path } => named("append", path)
    Output.Pipe => named("pipe", "")
  }
}

fn errorStream(output: ErrorOutput): stream {
  match (output) {
    ErrorOutput.Capture => named("capture", "")
    ErrorOutput.Inherit => named("inherit", "")
    ErrorOutput.Discard => named("discard", "")
    ErrorOutput.File { path } => named("file", path)
    ErrorOutput.Append { path } => named("append", path)
    ErrorOutput.Pipe => named("pipe", "")
    ErrorOutput.Stdout => named("stdout", "")
  }
}

fn named(kind: String, path: String): stream { stream { kind: kind, path: path, data: noBytes(), text: "" } }

fn noBytes(): Bytes unsafe go { return _borkBytesFrom(nil) }

// The resource value is one dispatcher over the child's operations, so each
// method below names a single Go type.
fn start(s: Scope, name: String, arguments: List[String], environment: Option[List[String]], directory: String, stdin: stream, from: Option[Reader], stdout: stream, stderr: stream, graceNanos: Int) uses io + state: Process | IoError | Cancelled unsafe go {
  import "bytes"
  import "context"
  import "errors"
  import "fmt"
  import "io"
  import "os"
  import "os/exec"
  import "reflect"
  import "runtime"
  import "bufio"
  import "strings"
  import "sync"
  import "sync/atomic"
  import "syscall"
  import "time"
  handle := _borkNewResourceHandle(nil, s)
  ctx, cancelChild := context.WithCancel(handle.Context())
  cmd := exec.CommandContext(ctx, name, arguments...)
  done := make(chan struct{})
  // Setpgid exists on Unix; other targets signal only the direct child.
  grouped := false
  attributes := &syscall.SysProcAttr{}
  if group := reflect.ValueOf(attributes).Elem().FieldByName("Setpgid"); group.IsValid() {
    group.SetBool(true)
    cmd.SysProcAttr = attributes
    grouped = true
  }
  // signalAll reaches the group only while the direct child is unreaped: after
  // Process.Wait the leader probe reports done, so a reused group ID is never
  // signalled and descendants that outlive the child are left alone.
  signalAll := func(sig os.Signal) error {
    if err := cmd.Process.Signal(syscall.Signal(0)); errors.Is(err, os.ErrProcessDone) { return nil }
    if !grouped { return cmd.Process.Signal(sig) }
    processGroup, err := os.FindProcess(-cmd.Process.Pid)
    if err != nil { return err }
    defer processGroup.Release()
    return processGroup.Signal(sig)
  }
  // terminate sends SIGTERM, then SIGKILL after grace if the child still runs.
  // Targets without SIGTERM are killed at once.
  terminate := func(grace time.Duration) {
    if grace <= 0 { signalAll(os.Kill); return }
    if signalAll(syscall.SIGTERM) != nil { signalAll(os.Kill); return }
    time.AfterFunc(grace, func() {
      select {
      case <-done:
      default: signalAll(os.Kill)
      }
    })
  }
  grace := time.Duration(graceNanos)
  // A child that exited on its own keeps its Result even if the scope is
  // cancelled while its output drains; only a cancellation that reached the
  // child reports Cancelled.
  var cancelled atomic.Bool
  cmd.Cancel = func() error { cancelled.Store(true); terminate(grace); return nil }
  // Bound inherited output pipes after child exit or cancellation.
  cmd.WaitDelay = time.Second
  if grace > 0 { cmd.WaitDelay += grace }
  cmd.Dir = directory
  if values, present := _borkOptionGet(environment); present { cmd.Env = append([]string{}, values...) }
  // files are the child's ends, closed in the parent once it has started;
  // kept are the parent's pipe ends, closed only if Start fails.
  var files, kept []*os.File
  closeFiles := func() { for _, file := range files { file.Close() } }
  fail := func(path string, err error) any {
    closeFiles()
    for _, file := range kept { file.Close() }
    cancelChild()
    handle.Close()
    if scopeContext := _borkScopeContext(s); scopeContext.Err() != nil { return Cancelled{reason: context.Cause(scopeContext).Error()} }
    return IoError{path: path, message: err.Error()}
  }
  var stdinPipe *os.File
  switch stdin.kind {
  case "inherit": cmd.Stdin = os.Stdin
  case "data": cmd.Stdin = bytes.NewReader(_borkBytesData(stdin.data))
  case "text": cmd.Stdin = strings.NewReader(stdin.text)
  case "file":
    file, err := os.Open(stdin.path)
    if err != nil { return fail(stdin.path, err) }
    files = append(files, file)
    cmd.Stdin = file
  case "pipe":
    childEnd, parentEnd, err := os.Pipe()
    if err != nil { return fail(name, err) }
    files, kept, stdinPipe = append(files, childEnd), append(kept, parentEnd), parentEnd
    cmd.Stdin = childEnd
  }
  var stdoutBuffer, stderrBuffer bytes.Buffer
  // A nil writer is /dev/null; a shared writer gives the child one pipe.
  var stdoutPipe, stderrPipe *os.File
  destination := func(spec stream, buffer *bytes.Buffer, parent *os.File, pipe **os.File) (io.Writer, error) {
    switch spec.kind {
    case "pipe":
      parentEnd, childEnd, err := os.Pipe()
      if err != nil { return nil, err }
      files, kept, *pipe = append(files, childEnd), append(kept, parentEnd), parentEnd
      return childEnd, nil
    case "capture": return buffer, nil
    case "inherit": return parent, nil
    case "file", "append":
      flags := os.O_WRONLY | os.O_CREATE | os.O_TRUNC
      if spec.kind == "append" { flags = os.O_WRONLY | os.O_CREATE | os.O_APPEND }
      file, err := os.OpenFile(spec.path, flags, 0o666)
      if err != nil { return nil, err }
      files = append(files, file)
      return file, nil
    }
    return nil, nil
  }
  out, err := destination(stdout, &stdoutBuffer, os.Stdout, &stdoutPipe)
  if err != nil { return fail(stdout.path, err) }
  cmd.Stdout = out
  if stderr.kind == "stdout" {
    cmd.Stderr = cmd.Stdout
  } else {
    errOut, err := destination(stderr, &stderrBuffer, os.Stderr, &stderrPipe)
    if err != nil { return fail(stderr.path, err) }
    cmd.Stderr = errOut
  }
  // A From Reader is taken after every open that can fail. Bytes it already
  // buffered go first, through a pipe of our own fed by a goroutine that stops
  // when the child is done, so exec never waits on the producer.
  var forward func()
  if reader, present := _borkOptionGet(from); present && stdin.kind == "from" {
    taken := reader.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("take", 0).(struct { file *os.File; prefix []byte })
    switch {
    case taken.file == nil:
    case len(taken.prefix) == 0:
      files = append(files, taken.file)
      cmd.Stdin = taken.file
    default:
      childEnd, parentEnd, err := os.Pipe()
      if err != nil {
        taken.file.Close()
        return fail(name, err)
      }
      files, kept = append(files, childEnd), append(kept, parentEnd, taken.file)
      cmd.Stdin = childEnd
      forward = func() {
        go func() {
          if _, err := parentEnd.Write(taken.prefix); err == nil { io.Copy(parentEnd, taken.file) }
          parentEnd.Close()
          taken.file.Close()
        }()
        go func() {
          <-done
          taken.file.Close()
          parentEnd.Close()
        }()
      }
    }
  }
  if err := cmd.Start(); err != nil { return fail(name, err) }
  // The child holds its own copies of file descriptors.
  closeFiles()
  if forward != nil { forward() }
  // sigName follows the conventional SIG names; others give "signal N".
  sigName := func(sig syscall.Signal) string {
    names := map[syscall.Signal]string{syscall.SIGHUP: "SIGHUP", syscall.SIGINT: "SIGINT", syscall.SIGQUIT: "SIGQUIT", syscall.SIGILL: "SIGILL", syscall.SIGTRAP: "SIGTRAP", syscall.SIGABRT: "SIGABRT", syscall.SIGBUS: "SIGBUS", syscall.SIGFPE: "SIGFPE", syscall.SIGKILL: "SIGKILL", syscall.SIGSEGV: "SIGSEGV", syscall.SIGPIPE: "SIGPIPE", syscall.SIGALRM: "SIGALRM", syscall.SIGTERM: "SIGTERM"}
    for _, user := range []string{"User1", "User2"} {
      if number, err := _borkSignalNumber(user); err == nil { names[syscall.Signal(number)] = "SIGUSR" + user[4:] }
    }
    if label, known := names[sig]; known { return label }
    return fmt.Sprintf("signal %d", int(sig))
  }
  var result any
  go func() {
    defer cancelChild()
    defer close(done)
    err := cmd.Wait()
    // Nothing reads stdin any more; later writes give Closed.
    if stdinPipe != nil { stdinPipe.Close() }
    if cancelled.Load() {
      // The cause names the current owner's reason, such as a deadline, also
      // after attach.
      result = Cancelled{reason: context.Cause(ctx).Error()}
      return
    }
    var exitError *exec.ExitError
    if err != nil && !errors.As(err, &exitError) {
      result = IoError{path: name, message: err.Error()}
      return
    }
    raw := rawResult{code: int64(cmd.ProcessState.ExitCode()), stdout: _borkBytesFrom(stdoutBuffer.Bytes()), stderr: _borkBytesFrom(stderrBuffer.Bytes())}
    if status, ok := cmd.ProcessState.Sys().(syscall.WaitStatus); ok && status.Signaled() {
      raw.signaled, raw.signal, raw.signalName = true, int64(status.Signal()), sigName(status.Signal())
    }
    result = raw
  }()
  // Readers and writers own their pipe ends; cancelling their scope closes the
  // end, which unblocks a pending read or write. A Reader releases its end at
  // the end of the stream.
  newReader := func(file *os.File) Reader {
    readerHandle := _borkNewResourceHandle(nil, s)
    var mu sync.Mutex
    var buffered *bufio.Reader
    // Each closer closes the file when its context is done: the handle's,
    // and those added with "closer". stopCloser stops them all once the
    // file is finished or taken; it is false if one has begun closing it.
    var closersMu sync.Mutex
    var stops []func() bool
    detached := false
    addCloser := func(context.Context) {}
    if file != nil {
      buffered = bufio.NewReaderSize(file, 32768)
      origin := file
      addCloser = func(ctx context.Context) {
        closersMu.Lock()
        defer closersMu.Unlock()
        if !detached { stops = append(stops, context.AfterFunc(ctx, func() { origin.Close() })) }
      }
      addCloser(readerHandle.Context())
    }
    stopCloser := func() bool {
      closersMu.Lock()
      defer closersMu.Unlock()
      detached = true
      stopped := true
      for _, stop := range stops { stopped = stop() && stopped }
      return stopped
    }
    failure := func(err error) any {
      if readerContext := readerHandle.Context(); readerContext.Err() != nil { return Cancelled{reason: context.Cause(readerContext).Error()} }
      if errors.Is(err, os.ErrClosed) { return Closed{} }
      return IoError{path: name, message: err.Error()}
    }
    finish := func() {
      if stopCloser() { file.Close() }
      file = nil
    }
    readerHandle.Value = func(operation string, limit int64) any {
      // Not under mu, which a blocked read holds.
      if operation == "closer" { return addCloser }
      mu.Lock()
      defer mu.Unlock()
      if file == nil {
        switch operation {
        case "all": return _borkBytesFrom(nil)
        case "take": return struct { file *os.File; prefix []byte }{}
        }
        return Closed{}
      }
      switch operation {
      case "line":
        line, err := buffered.ReadString('\n')
        if len(line) > 0 { return strings.TrimSuffix(strings.TrimSuffix(line, "\n"), "\r") }
        if errors.Is(err, io.EOF) {
          finish()
          return Closed{}
        }
        return failure(err)
      case "chunk":
        // The buffer never holds more, so a larger chunk gains nothing.
        limit = min(max(limit, 1), 32768)
        chunk := make([]byte, limit)
        n, err := buffered.Read(chunk)
        if n > 0 { return _borkBytesFrom(chunk[:n]) }
        if errors.Is(err, io.EOF) {
          finish()
          return Closed{}
        }
        return failure(err)
      case "all":
        data, err := io.ReadAll(buffered)
        if err == nil {
          finish()
        } else if failed := failure(err); failed != (Closed{}) {
          return failed
        }
        return _borkBytesFrom(data)
      case "take":
        // After cancellation has begun closing the file there is nothing to move.
        if !stopCloser() {
          file = nil
          return struct { file *os.File; prefix []byte }{}
        }
        prefix, _ := buffered.Peek(buffered.Buffered())
        taken := struct { file *os.File; prefix []byte }{file, append([]byte(nil), prefix...)}
        file = nil
        return taken
      }
      return Closed{}
    }
    return Reader{handle: readerHandle, owner: s.Own(func() { readerHandle.Close() })}
  }
  newWriter := func(file *os.File) Writer {
    writerHandle := _borkNewResourceHandle(nil, s)
    var mu sync.Mutex
    var closed atomic.Bool
    closeFile := func() { if file != nil && !closed.Swap(true) { file.Close() } }
    if file != nil { context.AfterFunc(writerHandle.Context(), closeFile) }
    brokenPipe := func(err error) bool {
      if errors.Is(err, syscall.EPIPE) || errors.Is(err, os.ErrClosed) { return true }
      // ERROR_BROKEN_PIPE and ERROR_NO_DATA.
      return runtime.GOOS == "windows" && (errors.Is(err, syscall.Errno(109)) || errors.Is(err, syscall.Errno(232)))
    }
    writerHandle.Value = func(operation string, data []byte) any {
      if operation == "close" {
        closeFile()
        return _borkOk()
      }
      mu.Lock()
      defer mu.Unlock()
      if file == nil || closed.Load() { return Closed{} }
      if _, err := file.Write(data); err != nil {
        if writerContext := writerHandle.Context(); writerContext.Err() != nil { return Cancelled{reason: context.Cause(writerContext).Error()} }
        if brokenPipe(err) { return Closed{} }
        return IoError{path: name, message: err.Error()}
      }
      return _borkOk()
    }
    return Writer{handle: writerHandle, owner: s.Own(func() { writerHandle.Close(); closeFile() })}
  }
  // Streams that are not piped get closed stand-ins, made only when asked for.
  var stdinOnce, stdoutOnce, stderrOnce sync.Once
  var stdinWriter Writer
  var stdoutReader, stderrReader Reader
  if stdinPipe != nil { stdinOnce.Do(func() { stdinWriter = newWriter(stdinPipe) }) }
  if stdoutPipe != nil { stdoutOnce.Do(func() { stdoutReader = newReader(stdoutPipe) }) }
  if stderrPipe != nil { stderrOnce.Do(func() { stderrReader = newReader(stderrPipe) }) }
  pid := cmd.Process.Pid
  handle.Value = func(operation string, argument int64) any {
    switch operation {
    case "wait":
      <-done
      return result
    case "poll":
      select {
      case <-done: return result
      default: return running{}
      }
    case "pid":
      return int64(pid)
    case "stdin":
      stdinOnce.Do(func() { stdinWriter = newWriter(nil) })
      return stdinWriter
    case "stdout":
      stdoutOnce.Do(func() { stdoutReader = newReader(nil) })
      return stdoutReader
    case "stderr":
      stderrOnce.Do(func() { stderrReader = newReader(nil) })
      return stderrReader
    }
    select {
    case <-done: return _borkOk()
    default:
    }
    switch operation {
    case "signal":
      if err := signalAll(syscall.Signal(argument)); err != nil && !errors.Is(err, syscall.ESRCH) { return IoError{path: name, message: err.Error()} }
    case "stop":
      terminate(time.Duration(argument))
    }
    return _borkOk()
  }
  return Process{handle: handle, owner: s.Own(func() { cancelChild(); handle.Close(); <-done })}
}

fn operate(child: Process, operation: String, argument: Int) uses io + state: rawResult | IoError | Cancelled | running | Int | Ok unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)(operation, argument)
}

fn finished(outcome: rawResult | IoError | Cancelled): Result | IoError | Cancelled {
  match (outcome) {
    raw: rawResult => {
      status: ExitStatus = if (raw.signaled) { .Signaled { number: raw.signal, name: raw.signalName } } else { .Exited { code: raw.code } }
      Result { code: raw.code, status: status, stdout: raw.stdout, stderr: raw.stderr }
    }
    error: IoError => error
    stopped: Cancelled => stopped
  }
}

// Wait waits for the child to finish. It may be called repeatedly; every call
// returns the same immutable result. Cancelled means the owning scope was
// cancelled; Stop and Kill give a Result. Wait leaves a piped stdin open, so
// waiting on a child that reads stdin to the end hangs until Stdin().Close().
fn (child: Process) Wait() uses io + state: Result | IoError | Cancelled {
  match (operate(child, "wait", 0)) {
    raw: rawResult => finished(raw)
    error: IoError => error
    stopped: Cancelled => stopped
    _ => panic("process: unexpected wait outcome")
  }
}

// TryWait is Wait without blocking: None while the child is running.
fn (child: Process) TryWait() uses io + state: Option[Result | IoError | Cancelled] {
  match (operate(child, "poll", 0)) {
    raw: rawResult => .Some(finished(raw))
    error: IoError => .Some(error)
    stopped: Cancelled => .Some(stopped)
    _ => .None
  }
}

// Pid is the child's process ID.
fn (child: Process) Pid(): Int unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("pid", 0).(int64)
}

// Signal sends a signal to the child's process group (the direct child on
// targets without groups). After the child has finished it does nothing.
// Signals the target does not support give IoError.
fn (child: Process) Signal(value: signal.Signal) uses io + state: Ok | IoError {
  match (signalNumber(signalName(value))) {
    number: Int => sendSignal(child, number)
    error: IoError => error
  }
}

fn sendSignal(child: Process, number: Int) uses io + state: Ok | IoError unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("signal", number)
}

fn signalName(value: signal.Signal): String {
  match (value) {
    signal.Signal.Interrupt => "Interrupt"
    signal.Signal.Terminate => "Terminate"
    signal.Signal.Hangup => "Hangup"
    signal.Signal.User1 => "User1"
    signal.Signal.User2 => "User2"
  }
}

fn signalNumber(name: String): Int | IoError unsafe go {
  number, err := _borkSignalNumber(name)
  if err != nil { return IoError{path: "", message: err.Error()} }
  return int64(number)
}

// Stop ends the child gracefully: SIGTERM to its process group, then SIGKILL
// if it still runs after grace. Wait then gives the child's Result (Signaled,
// or the exit code it chose on SIGTERM). Targets without SIGTERM kill at once.
// Stop does not cancel sibling tasks or the scope.
fn (child: Process) Stop(grace: time.Duration = time.Duration { nanos: 5_000_000_000 }) uses io + state {
  _ = operate(child, "stop", grace.nanos)
}

// Kill ends the child and its process group at once with SIGKILL.
fn (child: Process) Kill() uses io + state {
  _ = operate(child, "stop", 0)
}

// Stdin writes to a child started with stdin: .Pipe. Close it when done, or a
// child that reads to the end waits forever. For any other stdin it is a
// Writer whose writes give Closed.
fn (child: Process) Stdin(): Writer unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("stdin", 0).(Writer)
}

// Stdout reads a child started with stdout: .Pipe. For any other stdout it is
// a Reader already at its end (Closed). Every call gives the same Reader.
fn (child: Process) Stdout(): Reader unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("stdout", 0).(Reader)
}

// Stderr reads a child started with stderr: .Pipe, like Stdout.
fn (child: Process) Stderr(): Reader unsafe go {
  return child.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("stderr", 0).(Reader)
}

// NextLine gives the next line without its line ending, a final unterminated
// line, then Closed at the end of the stream. It waits while the child has
// written nothing new; cancelling the scope gives Cancelled.
fn (output: Reader) NextLine() uses io + state: String | Closed | Cancelled | IoError unsafe go {
  return output.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("line", 0)
}

// NextChunk gives the bytes available now, at most limit, waiting for at least
// one; Closed at the end of the stream.
fn (output: Reader) NextChunk(limit: Int = 32768) uses io + state: Bytes | Closed | Cancelled | IoError unsafe go {
  return output.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("chunk", limit)
}

// ReadAll reads to the end of the stream.
fn (output: Reader) ReadAll() uses io + state: Bytes | Cancelled | IoError unsafe go {
  return output.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("all", 0)
}

// Lines reads the stream line by line as it is consumed; it ends at the end of
// the stream, and Cancelled or IoError are final elements.
fn (output: Reader) Lines() uses io + state: Seq[String | Cancelled | IoError] unsafe go {
  next := output.handle.(*_borkResourceHandle).Value.(func(string, int64) any)
  return _Seq[any]{run: func(yield func(any) bool) {
    for {
      item := next("line", 0)
      if _, end := item.(Closed); end { return }
      if !yield(item) { return }
      if _, line := item.(string); !line { return }
    }
  }}
}

// LinesChannel pumps the stream's lines into a channel of scope s holding up
// to capacity lines, from a task of s, and closes it at the end of the
// stream. A read failure is sent as the last element. Use it to wait on
// process output together with other channels.
fn (output: Reader) LinesChannel(s: Scope, capacity: Int where validCapacity = 64) uses io + state: Channel[String | IoError] {
  lines: Channel[String | IoError] = channel(s, capacity)
  owned = attach(output, s)
  // attach shares the Reader; the pump must still stop when s is cancelled.
  closeWhenDone(owned, s)
  launch(s, () => {
    for (item in owned.Lines()) {
      match (item) {
        line: String => {
          match (lines.send(s, line)) {
            _: Ok => {}
            _ => break
          }
        }
        error: IoError => {
          _ = lines.send(s, error)
          break
        }
        _: Cancelled => break
      }
    }
    lines.close()
  })
  lines
}

// closeWhenDone closes the Reader's pipe once s is cancelled or ends,
// for every owner, which ends a read pending in a task of s.
fn closeWhenDone(output: Reader, s: Scope) unsafe go {
  output.handle.(*_borkResourceHandle).Value.(func(string, int64) any)("closer", 0).(func(context.Context))(s.ctx)
}

// Write writes data to the child's stdin, waiting while the child is not
// reading. Closed means stdin was closed or the child stopped reading.
fn (input: Writer) Write(data: Bytes) uses io + state: Ok | Closed | Cancelled | IoError unsafe go {
  return input.handle.(*_borkResourceHandle).Value.(func(string, []byte) any)("write", _borkBytesData(data))
}

// WriteText writes text to the child's stdin.
fn (input: Writer) WriteText(text: String) uses io + state: Ok | Closed | Cancelled | IoError unsafe go {
  return input.handle.(*_borkResourceHandle).Value.(func(string, []byte) any)("write", []byte(text))
}

// Close sends end of input to the child. Closing again does nothing.
fn (input: Writer) Close() uses io + state unsafe go {
  input.handle.(*_borkResourceHandle).Value.(func(string, []byte) any)("close", nil)
}

// Success reports whether the child exited with code 0.
fn (result: Result) Success(): Bool { result.code == 0 }

// Check gives the Result when it succeeded, and an ExitError otherwise, like
// Python's check=True: process.Run(s, "git", ["status"])?.Check()?.
fn (result: Result) Check(): Result | ExitError {
  if (result.Success()) {
    result
  } else {
    ExitError { code: result.code, status: result.status, stdout: result.stdout, stderr: result.stderr, message: exitMessage(result.status, result.stderr) }
  }
}

fn exitMessage(status: ExitStatus, stderr: Bytes): String {
  summary = match (status) {
    ExitStatus.Exited { code } => s"exit status $code"
    ExitStatus.Signaled { name } => s"killed by $name"
  }
  last = lastLine(stderr)
  if (last == "") { summary } else { s"$summary: $last" }
}

fn lastLine(data: Bytes): String unsafe go {
  import "strings"
  text := strings.TrimRight(string(_borkBytesData(data)), "\r\n")
  if i := strings.LastIndexByte(text, '\n'); i >= 0 { text = text[i+1:] }
  return strings.TrimSpace(text)
}

// StdoutText is the captured stdout as a String, byte for byte; use
// encoding.ParseUtf8 to validate it.
fn (result: Result) StdoutText(): String { bytesText(result.stdout) }

// StderrText is the captured stderr as a String, byte for byte.
fn (result: Result) StderrText(): String { bytesText(result.stderr) }

fn bytesText(data: Bytes): String unsafe go { return string(_borkBytesData(data)) }
