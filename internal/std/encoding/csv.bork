import codec "bork/codec"

import codecs "bork/json"
use codec.Defaults
// CsvError locates a failure. Rows are one-based (header is row 1).
// For syntax errors column is a byte position; for records it is a field name.
type CsvError = { row: Int, column: String, message: String }
type CsvErrors = { errors: List[CsvError] }

// CsvRows reads comma-separated rows, allowing quoted newlines and ragged rows.
fn CsvRows(text: String): List[List[String]] | CsvError unsafe go {
  import "encoding/csv"
  import "errors"
  import "strconv"
  import "strings"
  reader := csv.NewReader(strings.NewReader(text))
  reader.FieldsPerRecord = -1
  rows, err := reader.ReadAll()
  if err != nil {
    var detail *csv.ParseError
    if errors.As(err, &detail) {
      return CsvError{row: int64(detail.Line), column: strconv.Itoa(detail.Column), message: detail.Err.Error()}
    }
    return CsvError{row: 0, column: "", message: err.Error()}
  }
  return rows
}

// Csv writes rows with commas, quoting as needed and ending each row with LF.
fn Csv(rows: List[List[String]]): String unsafe go {
  import "encoding/csv"
  import "strings"
  var text strings.Builder
  writer := csv.NewWriter(&text)
  for _, row := range rows {
    // Go's writer emits a sole empty field as a blank line, which its
    // reader skips. Quote that field so an empty record survives.
    if len(row) == 1 && row[0] == "" {
      writer.Flush()
      text.WriteString("\"\"\n")
    } else {
      writer.Write(row)
    }
  }
  writer.Flush()
  return text.String()
}

// DecodeCsv reads header-named fields using a derived record's codec.Decode schema.
// Strings are literal; other fields use JSON syntax. Empty optional cells
// and missing optional columns become None; nonempty cells become Some.
// Nonempty null cells are rejected for optional non-String fields.
// Every bad field is collected, with no partial records returned.
fn DecodeCsv[T: codec.Decode](text: String): List[T] | CsvError | CsvErrors {
  rows = CsvRows(text)?
  decodeCsvRows[T](rows, csvValue, json => codec.decode[T](json))
}

fn csvValue(raw: String, kind: String, optional: Bool): codec.Value | codecs.JsonError {
  if (optional && raw == "") { return codec.Value.Null }
  if (kind == "string") { return codec.Value.String { value: raw } }
  parsed = codecs.Parse(raw)?
  match (parsed) {
    codec.Value.Null => if (optional) {
      codecs.JsonError { message: "nonempty optional cell cannot be null; use an empty cell for None" }
    } else { parsed }
    _ => parsed
  }
}

fn decodeCsvRows[T: codec.Decode](rows: List[List[String]], parse: (String, String, Bool) => (codec.Value | codecs.JsonError), decodeRow: (codec.Value) => (T | codec.DecodeError)): List[T] | CsvErrors {
  decodeCsvRowsWithSchema[T](codec.Schema[T](), rows, parse, decodeRow)
}
fn decodeCsvRowsWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], rows: List[List[String]], parse: (String, String, Bool) => (codec.Value | codecs.JsonError), decodeRow: (codec.Value) => (T | codec.DecodeError)): List[T] | CsvErrors unsafe go {
  import "fmt"
  import "strings"
  record, supported := _borkOptionGet(recordSchema)
  schema := record.fields
  if !supported { return CsvErrors{errors: []CsvError{{row: 1, column: "", message: "expected a derived record decoder"}}} }
  if len(schema) == 0 { return CsvErrors{errors: []CsvError{{row: 1, column: "", message: "expected a record with at least one field"}}} }
  if len(rows) == 0 { return []T{} }
  headers := map[int]int{}
  supplied := map[int]string{}
  owners := map[string]int{}
  failures := []CsvError{}
  for index, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    for _, name := range append([]string{key}, field.aliases...) {
      if _, duplicate := owners[name]; duplicate { failures = append(failures, CsvError{row: 1, column: name, message: "duplicate schema field name"}) }
      owners[name] = index
    }
  }
  seenHeaders := map[string]bool{}
  for column, name := range rows[0] {
    if seenHeaders[name] { failures = append(failures, CsvError{row: 1, column: name, message: "duplicate column"}); continue }
    seenHeaders[name] = true
    index, known := owners[name]
    if !known { failures = append(failures, CsvError{row: 1, column: name, message: "unknown column"}); continue }
    if first, duplicate := supplied[index]; duplicate {
      message := "duplicate column"
      if first != name { message = "same field as " + first }
      failures = append(failures, CsvError{row: 1, column: name, message: message})
    } else { headers[index], supplied[index] = column, name }
  }
  for index, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    if _, found := headers[index]; !found && !field.optional && !field.hasDefault {
      failures = append(failures, CsvError{row: 1, column: key, message: "required column is missing"})
    }
  }
  if len(failures) != 0 { return CsvErrors{errors: failures} }
  values := []T{}
  for index, row := range rows[1:] {
    number := int64(index + 2)
    if len(row) != len(rows[0]) {
      failures = append(failures, CsvError{row: number, column: "", message: fmt.Sprintf("expected %d columns, found %d", len(rows[0]), len(row))})
      continue
    }
    fields := []codec.Field{}
    bad := false
    for fieldIndex, field := range schema {
      key := field.wireName
      if key == "" { key = field.name }
      name := key
      if actual, found := supplied[fieldIndex]; found { name = actual }
      var json codec.Value = codec.Value_Null{}
      if column, found := headers[fieldIndex]; found {
        parsed := parse(row[column], field.kind, field.optional)
        if failure, failed := parsed.(codecs.JsonError); failed {
          failures = append(failures, CsvError{row: number, column: name, message: failure.message})
          bad = true
          continue
        }
        json = parsed.(codec.Value)
      } else if field.hasDefault { continue }
      if failure, failed := field.validate(json).(codec.DecodeError); failed {
        failures = append(failures, CsvError{row: number, column: name + strings.TrimPrefix(failure.path, "." + key), message: failure.message})
        bad = true
        continue
      }
      fields = append(fields, codec.Field{name: name, value: json})
    }
    if bad { continue }
    decoded := decodeRow(codec.Value_Object{fields: fields})
    if failure, failed := decoded.(codec.DecodeError); failed {
      failures = append(failures, CsvError{row: number, column: strings.TrimPrefix(failure.path, "."), message: failure.message})
      continue
    }
    values = append(values, decoded.(T))
  }
  if len(failures) != 0 { return CsvErrors{errors: failures} }
  return values
}

// EncodeCsv writes records in schema field order. None and Some("") both
// write empty cells, which decode as None. Empty input gives empty text.
fn EncodeCsv[T: codec.Encode + codec.Decode](values: List[T]): String | CsvError {
  rows = encodeCsvRowsWithSchema[T](codec.Schema[T](), values, value => codec.encode[T](value), codecs.Render, codec.Encoding[T]())?
  Csv(rows)
}

fn encodeCsvRows[T: codec.Decode](values: List[T], encodeRow: (T) => codec.Value, render: (codec.Value) => String): List[List[String]] | CsvError {
  encodeCsvRowsWithSchema[T](codec.Schema[T](), values, encodeRow, render)
}
fn encodeCsvRowsWithSchema[T: codec.Decode](recordSchema: Option[codec.RecordSchema], values: List[T], encodeRow: (T) => codec.Value, render: (codec.Value) => String, recordEncoding: Option[codec.RecordEncoding[T]] = Option.None): List[List[String]] | CsvError unsafe go {
  record, supported := _borkOptionGet(recordSchema)
  schema := record.fields
  if !supported { return CsvError{row: 1, column: "", message: "expected a derived record decoder"} }
  if len(schema) == 0 { return CsvError{row: 1, column: "", message: "expected a record with at least one field"} }
  if len(values) == 0 { return [][]string{} }
  headers := []string{}
  seenHeaders := map[string]bool{}
  for _, field := range schema {
    key := field.wireName
    if key == "" { key = field.name }
    if seenHeaders[key] { return CsvError{row: 1, column: key, message: "duplicate schema field name"} }
    seenHeaders[key] = true
    headers = append(headers, key)
  }
  rows := [][]string{headers}
  completion, canComplete := _borkOptionGet(recordEncoding)
  for index, value := range values {
    object, supported := encodeRow(value).(codec.Value_Object)
    if !supported { return CsvError{row: int64(index + 2), column: "", message: "expected an encoded record object"} }
    fields := map[string]codec.Value{}
    for _, field := range object.fields {
      if _, duplicate := fields[field.name]; duplicate {
        return CsvError{row: int64(index + 2), column: field.name, message: "duplicate encoded field"}
      }
      fields[field.name] = field.value
    }
    row := []string{}
    for _, field := range schema {
      key := field.wireName
      if key == "" { key = field.name }
      json, found := fields[key]
      if !found && canComplete {
        json, found = _borkOptionGet(completion.omittedField(value, key))
      }
      if !found { return CsvError{row: int64(index + 2), column: key, message: "encoded field is missing; CSV requires every column (use codec.Omit.Never or publish codec.RecordEncoding)"} }
      delete(fields, key)
      if _, absent := json.(codec.Value_Null); field.optional && absent {
        row = append(row, "")
      } else if field.kind == "string" {
        text, valid := json.(codec.Value_String)
        if !valid { return CsvError{row: int64(index + 2), column: key, message: "expected an encoded string"} }
        row = append(row, text.value)
      } else {
        row = append(row, render(json))
      }
    }
    if len(fields) != 0 { return CsvError{row: int64(index + 2), column: "", message: "encoded fields do not match the record schema"} }
    rows = append(rows, row)
  }
  return rows
}
