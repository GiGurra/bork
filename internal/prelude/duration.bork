// Duration is a signed span of nanoseconds. Constructors and arithmetic saturate
// at the signed 64-bit limits. Use 0.seconds() for a zero duration.
type Duration = { nanos: Int }

fn (n: Int) nanos(): Duration { Duration { nanos: n } }
fn (n: Int) micros(): Duration { n.nanos().multiply(1000) }
fn (n: Int) millis(): Duration { n.nanos().multiply(1000000) }
fn (n: Int) seconds(): Duration { n.nanos().multiply(1000000000) }
fn (n: Int) minutes(): Duration { n.nanos().multiply(60000000000) }
fn (n: Int) hours(): Duration { n.nanos().multiply(3600000000000) }

// add and subtract saturate instead of wrapping at the duration limits.
fn (duration: Duration) add(other: Duration): Duration unsafe go {
  a, b := duration.nanos, other.nanos
  if b > 0 && a > 9223372036854775807-b { return Duration{nanos: 9223372036854775807} }
  if b < 0 && a < -9223372036854775808-b { return Duration{nanos: -9223372036854775808} }
  return Duration{nanos: a+b}
}
fn (duration: Duration) subtract(other: Duration): Duration unsafe go {
  a, b := duration.nanos, other.nanos
  if b < 0 && a > 9223372036854775807+b { return Duration{nanos: 9223372036854775807} }
  if b > 0 && a < -9223372036854775808+b { return Duration{nanos: -9223372036854775808} }
  return Duration{nanos: a-b}
}
// multiply saturates for every signed factor, including the minimum Int.
fn (duration: Duration) multiply(factor: Int): Duration unsafe go {
  a, b := duration.nanos, factor
  if a == 0 || b == 0 { return Duration{nanos: 0} }
  if a > 0 {
    if b > 0 && a > 9223372036854775807/b { return Duration{nanos: 9223372036854775807} }
    if b < 0 && b < -9223372036854775808/a { return Duration{nanos: -9223372036854775808} }
  } else {
    if b > 0 && a < -9223372036854775808/b { return Duration{nanos: -9223372036854775808} }
    if b < 0 && a < 9223372036854775807/b { return Duration{nanos: 9223372036854775807} }
  }
  return Duration{nanos: a*b}
}
instance ShowDuration: Show[Duration] {
  fn show(value: Duration): String { durationText(value) }
}
instance OrdDuration: Ord[Duration] {
  fn compare(a: Duration, b: Duration): Int { if (a.nanos < b.nanos) { -1 } else if (a.nanos > b.nanos) { 1 } else { 0 } }
}

fn durationText(value: Duration): String unsafe go {
  import "time"
  return time.Duration(value.nanos).String()
}
