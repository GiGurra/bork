// Concurrency is structured: a task runs on its own goroutine, and the
// scope that started it waits for it before it closes (and before its
// finalizers run), so a task can use the scope's resources. When the
// scope ends, it cancels itself first: how a task stops (at once, after
// cleaning up, or after finishing its work) is up to the task. A task
// that panics panics await, or, if no one awaited it, the scope's
// routine when the scope closes.

// Task is a running computation of a T, started with fork. A Task[Ok] is
// work with no value: it may be dropped like an Ok, and its scope still
// waits for it.
// Native completion handles are implementation details of tasks and channels.
type TaskHandle = resource
type ChannelHandle = resource

// A computation started with fork and owned by its scope; await retrieves its result.
type Task[T] = private { wait: () => T, native: TaskHandle }

// fork starts work on its own goroutine, as a task of scope s, which waits
// for it before it closes.
fn fork[T](s: Scope, work: () => T): Task[T] unsafe go {
  t := s.Go(func() any { return work() })
  return Task[T]{wait: func() T { return t.Await().(T) }, native: TaskHandle{handle: t, owner: s.Own(func() {})}}
}

// await waits for a task to finish, and gives its result.
fn await[T](task: Task[T]): T unsafe go {
  return task.wait()
}

// Cancelled is what a cancellation-aware operation gives when its scope
// is cancelled; reason says why ("cancelled", "context deadline exceeded", ...).
type Cancelled = { reason: String }

// cancel cancels the scope s: its tasks see it at their next
// cancellation point (delay, checkpoint, channels), and so do scopes
// nested in it. The scope still waits for them before it closes. (A
// scope is also cancelled when it ends.)
fn cancel(s: Scope) uses state unsafe go {
  s.cancel(_errCancelled)
}

// cancelled reports whether s has been cancelled.
fn cancelled(s: Scope) uses state: Bool unsafe go {
  return s.ctx.Err() != nil
}

// cancelAfter sets an observable deadline and only ever shortens it. Existing
// children see later ancestor deadlines too. Nonpositive ms cancels immediately;
// huge positive values saturate rather than overflowing the Go duration.
fn cancelAfter(s: Scope, ms: Int) uses clock + state unsafe go {
  s.cancelAfter(ms)
}

// checkpoint gives Cancelled if s has been cancelled: a cancellation
// point for work that does not otherwise wait, as in checkpoint(s)?.
fn checkpoint(s: Scope) uses state: Ok | Cancelled unsafe go {
  if r := s._cancelReason(); r != "" {
    return Cancelled{reason: r}
  }
  return _borkOk()
}

// delay pauses for ms milliseconds, or until s is cancelled.
fn delay(s: Scope, ms: Int) uses clock + state: Ok | Cancelled unsafe go {
  import "time"
  if !s._sleep(time.Duration(ms) * time.Millisecond) {
    return Cancelled{reason: s._cancelReason()}
  }
  return _borkOk()
}

// Closed is what sending to or receiving from a closed channel gives
// (once its buffered values are received).
type Closed = {}

// Atom holds a value that tasks share and replace, as Clojure's atom:
// the value itself never changes, but update swaps in a new one,
// atomically. With persistent maps and lists it is how a server keeps
// state between requests:
//
//   store = atom({:})
//   update(store, users => users.put(id, user))
//
// update may call f more than once (when another task updated the atom
// in between), so f should do nothing but compute the new value.
type Atom[T] = {
  currentFn: () uses state => T,
  updateFn: ((T) uses nothing => T) uses state => T,
  swapFn: ((T) uses nothing => T) uses state => T,
}

// atom makes an atom holding initial.
fn atom[T](initial: T): Atom[T] unsafe go {
  import "sync/atomic"
  var p atomic.Pointer[T]
  p.Store(&initial)
  // change gives the old value and the new one.
  change := func(f func(T) T) (T, T) {
    for {
      old := p.Load()
      next := f(*old)
      if p.CompareAndSwap(old, &next) {
        return *old, next
      }
    }
  }
  return Atom[T]{
    currentFn: func() T { return *p.Load() },
    updateFn: func(f func(T) T) T { _, next := change(f); return next },
    swapFn: func(f func(T) T) T { old, _ := change(f); return old },
  }
}

// current is the value a holds now.
fn current[T](a: Atom[T]) uses state: T {
  a.currentFn()
}

// update replaces a's value x with f(x), atomically, and gives the new
// value.
fn update[T](a: Atom[T], f: (T) uses nothing => T) uses state: T {
  a.updateFn(f)
}

// swap is update, but gives the value it replaced: what the change was
// made to, so the caller can tell what it did (`old = swap(store, s =>
// remove(s, id))`, then whether old had id).
fn swap[T](a: Atom[T], f: (T) uses nothing => T) uses state: T {
  a.swapFn(f)
}

// Channel passes values of type T between tasks, in the order they were
// sent. It belongs to the scope it was made in, which closes it when it
// closes. Operations that wait take the scope they wait in, and give
// Cancelled when it, or the channel's scope, is cancelled.
type Channel[T] = private { native: ChannelHandle }

// Full is what trySend gives when the channel has no room.
type Full = {}

// validCapacity holds for the capacities a channel can have.
pred validCapacity(capacity: Int) { capacity >= 0 }

// channel makes a channel in scope s that holds up to capacity values
// that are not received yet; with capacity 0 (the default), a sender
// waits for a receiver.
fn channel[T](s: Scope, capacity: Int where validCapacity = 0): Channel[T] unsafe go {
  c := _borkNewChan(s, int(capacity))
  return Channel[T]{native: ChannelHandle{handle: c, owner: s.Own(c.release)}}
}

// unboundedChannel makes a channel in scope s whose buffer grows as
// needed, so a send never waits. Its memory is bounded only by how far
// the receivers fall behind.
fn unboundedChannel[T](s: Scope): Channel[T] unsafe go {
  c := _borkNewChan(s, -1)
  return Channel[T]{native: ChannelHandle{handle: c, owner: s.Own(c.release)}}
}

// send passes x to the channel, waiting in s while it is full (or, for
// an unbuffered channel, until a receiver takes it).
fn (ch: Channel[T]) send[T](s: Scope, x: T) uses state: Ok | Closed | Cancelled unsafe go {
  return _borkChanSend(s, ch.native.handle.(*_borkChan), x)
}

// receive takes the next value from the channel, waiting in s until
// there is one. A closed channel gives the values still buffered, then
// Closed.
fn (ch: Channel[T]) receive[T](s: Scope) uses state: T | Closed | Cancelled unsafe go {
  value, _ := _borkChanReceive(s, ch.native.handle.(*_borkChan))
  return value
}

// trySend sends x if that needs no waiting.
fn (ch: Channel[T]) trySend[T](x: T) uses state: Ok | Full | Closed unsafe go {
  _, status, _ := _borkChanSelect([]_borkChanArm{{ch: ch.native.handle.(*_borkChan), send: true, value: x}}, false)
  switch status {
  case _borkChanClosed:
    return Closed{}
  case _borkChanNotReady:
    return Full{}
  }
  return _borkOk()
}

// tryReceive receives a value if one is ready: None when none is.
fn (ch: Channel[T]) tryReceive[T]() uses state: Option[T] | Closed unsafe go {
  _, status, value := _borkChanSelect([]_borkChanArm{{ch: ch.native.handle.(*_borkChan)}}, false)
  switch status {
  case _borkChanClosed:
    return Closed{}
  case _borkChanNotReady:
    return Option_None[T]{}
  }
  x, _ := value.(T)
  return Option_Some[T]{E0: x}
}

// close closes the channel: sends give Closed, and receives give the
// values still buffered, then Closed. Closing it again does nothing.
fn (ch: Channel[T]) close[T]() uses state unsafe go {
  ch.native.handle.(*_borkChan).close()
}

// length is how many values are buffered now.
fn (ch: Channel[T]) length[T]() uses state: Int unsafe go {
  return int64(ch.native.handle.(*_borkChan).length())
}

// capacity is how many values the channel buffers: None when unbounded.
fn (ch: Channel[T]) capacity[T](): Option[Int] unsafe go {
  if limit := ch.native.handle.(*_borkChan).limit; limit >= 0 {
    return Option_Some[int64]{E0: int64(limit)}
  }
  return Option_None[int64]{}
}

// values receives values until the channel is closed, or s is
// cancelled: for (x in ch.values(s)) { ... }. Traversing it again goes
// on receiving.
fn (ch: Channel[T]) values[T](s: Scope): Seq[T] uses state unsafe go {
  c := ch.native.handle.(*_borkChan)
  return _Seq[T]{run: func(yield func(T) bool) {
    for {
      value, ok := _borkChanReceive(s, c)
      if !ok {
        return
      }
      x, _ := value.(T)
      if !yield(x) {
        return
      }
    }
  }}
}

// toList receives values until the channel is closed, and gives them in
// order; Cancelled if s is cancelled first.
fn (ch: Channel[T]) toList[T](s: Scope) uses state: List[T] | Cancelled unsafe go {
  c := ch.native.handle.(*_borkChan)
  out := []T{}
  for {
    value, ok := _borkChanReceive(s, c)
    if !ok {
      if cancelled, is := value.(Cancelled); is {
        return cancelled
      }
      return out
    }
    x, _ := value.(T)
    out = append(out, x)
  }
}

// produce makes a channel in s and runs work with it as a task of s,
// closing the channel when work returns, so receivers' loops end. (If
// work panics, s is cancelled, which stops them too.) A producer written
// as a named function can stop with out.send(s, x)? when the channel is
// closed or s is cancelled.
fn produce[T](s: Scope, capacity: Int where validCapacity, work: (Channel[T]) => Ok | Closed | Cancelled in s) uses state: Channel[T] {
  out = channel[T](s, capacity)
  fork(s, () => {
    _ = work(out)
    out.close()
  })
  out
}

// merge receives from every source and passes the values on to one
// unbuffered channel, which is closed when every source is closed: the
// fan-in of a list of channels. If the merged channel is closed or s is
// cancelled, each source loses at most the one value it was passing on.
fn merge[T](s: Scope, sources: List[Channel[T]] in s) uses state: Channel[T] unsafe go {
  import "sync/atomic"
  out := _borkNewChan(s, 0)
  owner := s.Own(out.release)
  var remaining atomic.Int64
  remaining.Store(int64(len(sources)))
  if len(sources) == 0 {
    out.close()
  }
  for _, source := range sources {
    in := source.native.handle.(*_borkChan)
    s.Go(func() any {
      defer func() {
        if remaining.Add(-1) == 0 {
          out.close()
        }
      }()
      for {
        value, ok := _borkChanReceive(s, in)
        if !ok {
          return nil
        }
        if _, sent := _borkChanSend(s, out, value).(_Ok); !sent {
          return nil
        }
      }
    })
  }
  return Channel[T]{native: ChannelHandle{handle: out, owner: owner}}
}

// Handoff passes resources between tasks, one owner at a time: what is
// handed over belongs to the handoff's scope, and whoever receives it is
// its only holder, who may move it on (to a session's scope, say). It
// belongs to the scope it was made in, which closes it, and the resources
// nobody received, when it closes.
type Handoff[R] = private { native: ChannelHandle }

// handoff makes a handoff of resources R in scope s that holds up to
// capacity resources that are not received yet; with capacity 0 (the
// default), a sender waits for a receiver.
fn handoff[R](s: Scope, capacity: Int where validCapacity = 0): Handoff[R] unsafe go {
  c := _borkNewChan(s, int(capacity))
  return Handoff[R]{native: ChannelHandle{handle: c, owner: s.Own(c.release)}}
}

// handOver hands r over to whoever receives it, waiting in s while the
// handoff is full (or, if it is unbuffered, until a receiver takes it):
// r moves to the handoff's scope, and r, and every value holding it,
// cannot be used after it. If it gives Closed or Cancelled, nobody
// received r, and it is released: it closes, unless it is attached to
// other scopes. r must be movable here, as for move.
fn (h: Handoff[R]) handOver[R](s: Scope, r: R) uses state: Ok | Closed | Cancelled unsafe go {
  // Compiled to _borkHandOver, given the scope r is moved from.
  _ = h.native.handle.(*_borkChan)
  panic("bork: handOver is compiled by the compiler")
}

// receive takes the next resource, waiting in s until there is one. The
// receiver is its only holder: it belongs to the handoff's scope until
// it is moved on. A closed handoff gives the resources still buffered,
// then Closed.
fn (h: Handoff[R]) receive[R](s: Scope) uses state: R | Closed | Cancelled unsafe go {
  value, _ := _borkChanReceive(s, h.native.handle.(*_borkChan))
  return value
}

// tryReceive receives a resource if one is ready: None when none is.
fn (h: Handoff[R]) tryReceive[R]() uses state: Option[R] | Closed unsafe go {
  _, status, value := _borkChanSelect([]_borkChanArm{{ch: h.native.handle.(*_borkChan)}}, false)
  switch status {
  case _borkChanClosed:
    return Closed{}
  case _borkChanNotReady:
    return Option_None[R]{}
  }
  x, _ := value.(R)
  return Option_Some[R]{E0: x}
}

// close closes the handoff: handOver gives Closed, and receives give the
// resources still buffered, then Closed. Closing it again does nothing.
fn (h: Handoff[R]) close[R]() uses state unsafe go {
  h.native.handle.(*_borkChan).close()
}

// length is how many resources are buffered now.
fn (h: Handoff[R]) length[R]() uses state: Int unsafe go {
  return int64(h.native.handle.(*_borkChan).length())
}

// capacity is how many resources the handoff buffers.
fn (h: Handoff[R]) capacity[R](): Int unsafe go {
  return int64(h.native.handle.(*_borkChan).limit)
}

// values receives resources until the handoff is closed, or s is
// cancelled: for (c in h.values(s)) { ... }, where the loop's body is
// the only holder of each c, and may move it on.
fn (h: Handoff[R]) values[R](s: Scope): Seq[R] uses state unsafe go {
  c := h.native.handle.(*_borkChan)
  return _Seq[R]{run: func(yield func(R) bool) {
    for {
      value, ok := _borkChanReceive(s, c)
      if !ok {
        return
      }
      x, _ := value.(R)
      if !yield(x) {
        return
      }
    }
  }}
}
