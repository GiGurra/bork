import "bork/shape"

// GoStruct exposes a record to Go reflection through checked conversions.
class GoStruct[T] {}

// The layout keeps stored fields in declaration order, capitalizes their
// names, keeps their declared tags, and maps Option to a nil pointer.
derive instance goStruct[T]: GoStruct[T] {
  metadata shape.ForeignRecord = shape.ForeignRecord {
    fields: comptime for { field in shape.fields[T](); if !field.computed } yield shape.ForeignField { slot: field.index, name: field.name.capitalize(), tags: field.tags, option: shape.ForeignOption.Pointer }
  }
}
