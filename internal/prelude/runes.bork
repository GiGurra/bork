// Runes (Unicode code points). These count and index runes, not bytes.

// runeToString gives the character; Rune currently aliases numeric Int32.
fn runeToString(r: Rune): String unsafe go {
  return string(r)
}

fn (r: Rune) isDigit(): Bool unsafe go {
  import "unicode"
  return unicode.IsDigit(r)
}

fn (r: Rune) isLetter(): Bool unsafe go {
  import "unicode"
  return unicode.IsLetter(r)
}

fn (r: Rune) isSpace(): Bool unsafe go {
  import "unicode"
  return unicode.IsSpace(r)
}

fn (r: Rune) isUpper(): Bool unsafe go {
  import "unicode"
  return unicode.IsUpper(r)
}

fn (r: Rune) isLower(): Bool unsafe go {
  import "unicode"
  return unicode.IsLower(r)
}
