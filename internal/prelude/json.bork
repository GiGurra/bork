// JSON.

// Json is a JSON value. A number keeps its text, so that whole numbers
// of any size decode exactly.
type Json = sealed {
  Null
  Bool { value: Bool }
  Number { text: String }
  String { value: String }
  Array { items: List[Json] }
  Object { fields: List[JsonField] }
}

type JsonField = { name: String, value: Json }

// JsonError is returned for text that is not valid JSON.
type JsonError = { message: String }

// parseJson reads a JSON value; object fields keep their order.
fn parseJson(text: String): Json | JsonError unsafe go {
  import "encoding/json"
  import "fmt"
  import "strings"
  // A small parser of its own, so that messages are the same in every Go
  // version: "invalid JSON at line 1, column 2: expected a value".
  pos := 0
  fail := func(what string) JsonError {
    line := 1 + strings.Count(text[:pos], "\n")
    col := pos - strings.LastIndex(text[:pos], "\n")
    if pos >= len(text) {
      return JsonError{message: "unexpected end of JSON: expected " + what}
    }
    return JsonError{message: fmt.Sprintf("invalid JSON at line %d, column %d: expected %s", line, col, what)}
  }
  space := func() {
    for pos < len(text) && strings.IndexByte(" \t\r\n", text[pos]) >= 0 {
      pos++
    }
  }
  digits := func() int {
    start := pos
    for pos < len(text) && text[pos] >= '0' && text[pos] <= '9' {
      pos++
    }
    return pos - start
  }
  str := func() (string, *JsonError) {
    start := pos
    pos++
    for pos < len(text) && text[pos] != '"' {
      if text[pos] == '\\' {
        pos++
      }
      pos++
    }
    if pos >= len(text) {
      e := fail("the end of a string")
      return "", &e
    }
    pos++
    var s string
    if json.Unmarshal([]byte(text[start:pos]), &s) != nil {
      pos = start
      e := fail("a valid string")
      return "", &e
    }
    return s, nil
  }
  var value func() (Json, *JsonError)
  value = func() (Json, *JsonError) {
    space()
    if pos >= len(text) {
      e := fail("a value")
      return nil, &e
    }
    for word, j := range map[string]Json{"null": Json_Null{}, "true": Json_Bool{value: true}, "false": Json_Bool{value: false}} {
      if strings.HasPrefix(text[pos:], word) {
        pos += len(word)
        return j, nil
      }
    }
    switch c := text[pos]; {
    case c == '"':
      s, e := str()
      return Json_String{value: s}, e
    case c == '-' || c >= '0' && c <= '9':
      start := pos
      if c == '-' {
        pos++
      }
      if n := digits(); n == 0 || n > 1 && text[pos-n] == '0' {
        pos = start
        e := fail("a number")
        return nil, &e
      }
      if pos < len(text) && text[pos] == '.' {
        pos++
        if digits() == 0 {
          e := fail("a digit")
          return nil, &e
        }
      }
      if pos < len(text) && (text[pos] == 'e' || text[pos] == 'E') {
        pos++
        if pos < len(text) && (text[pos] == '+' || text[pos] == '-') {
          pos++
        }
        if digits() == 0 {
          e := fail("a digit")
          return nil, &e
        }
      }
      return Json_Number{text: text[start:pos]}, nil
    case c == '[':
      pos++
      items := []Json{}
      space()
      if pos < len(text) && text[pos] == ']' {
        pos++
        return Json_Array{items: items}, nil
      }
      for {
        item, e := value()
        if e != nil {
          return nil, e
        }
        items = append(items, item)
        space()
        if pos < len(text) && text[pos] == ',' {
          pos++
          continue
        }
        if pos < len(text) && text[pos] == ']' {
          pos++
          return Json_Array{items: items}, nil
        }
        e2 := fail("',' or ']'")
        return nil, &e2
      }
    case c == '{':
      pos++
      fields := []JsonField{}
      space()
      if pos < len(text) && text[pos] == '}' {
        pos++
        return Json_Object{fields: fields}, nil
      }
      for {
        space()
        if pos >= len(text) || text[pos] != '"' {
          e := fail("a field name")
          return nil, &e
        }
        name, e := str()
        if e != nil {
          return nil, e
        }
        space()
        if pos >= len(text) || text[pos] != ':' {
          e := fail("':'")
          return nil, &e
        }
        pos++
        v, e := value()
        if e != nil {
          return nil, e
        }
        fields = append(fields, JsonField{name: name, value: v})
        space()
        if pos < len(text) && text[pos] == ',' {
          pos++
          continue
        }
        if pos < len(text) && text[pos] == '}' {
          pos++
          return Json_Object{fields: fields}, nil
        }
        e2 := fail("',' or '}'")
        return nil, &e2
      }
    }
    e := fail("a value")
    return nil, &e
  }
  j, e := value()
  if e != nil {
    return *e
  }
  space()
  if pos < len(text) {
    return fail("the end of the text")
  }
  return j
}

// renderJson writes a JSON value as compact text.
fn renderJson(j: Json): String unsafe go {
  import "encoding/json"
  import "strings"
  var b strings.Builder
  var render func(j Json)
  render = func(j Json) {
    switch j := j.(type) {
    case Json_Null:
      b.WriteString("null")
    case Json_Bool:
      if j.value {
        b.WriteString("true")
      } else {
        b.WriteString("false")
      }
    case Json_Number:
      b.WriteString(j.text)
    case Json_String:
      s, _ := json.Marshal(j.value)
      b.Write(s)
    case Json_Array:
      b.WriteString("[")
      for i, item := range j.items {
        if i > 0 {
          b.WriteString(",")
        }
        render(item)
      }
      b.WriteString("]")
    case Json_Object:
      b.WriteString("{")
      for i, f := range j.fields {
        if i > 0 {
          b.WriteString(",")
        }
        s, _ := json.Marshal(f.name)
        b.Write(s)
        b.WriteString(":")
        render(f.value)
      }
      b.WriteString("}")
    }
  }
  render(j)
  return b.String()
}

// jsonKind names the kind of a JSON value, for messages.
fn jsonKind(j: Json): String {
  match (j) {
    Json.Null => "null"
    Json.Bool { value } => "a boolean"
    Json.Number { text } => "a number"
    Json.String { value } => "a string"
    Json.Array { items } => "an array"
    Json.Object { fields } => "an object"
  }
}

// DecodeError says where in a JSON value decoding failed (a path like
// ".items[2].name", "" for the whole value), and why. Transparent invariant
// comparisons name the first failed condition and its primary field path;
// other fields read by that condition appear in the message.
type DecodeError = { path: String, message: String }

// Decode reads values of a type from JSON. `derive (Decode)` on a record
// or sealed type gives it an instance that also checks every field's
// where clause, so decoded values arrive already proven.
class Decode[T] {
  fn decode(json: Json): T | DecodeError
}

// Encode writes values of a type as JSON; `derive (Encode)` gives
// records and sealed types an instance.
class Encode[T] {
  fn encode(x: T): Json
}

// decodeJson parses text and decodes it.
fn decodeJson[T: Decode](text: String): T | JsonError | DecodeError {
  json = parseJson(text)?
  decode[T](json)
}

// encodeJson encodes a value and renders it as compact JSON text.
fn encodeJson[T: Encode](x: T): String {
  renderJson(encode(x))
}

fn decodeMismatch(expected: String, json: Json): DecodeError {
  DecodeError { path: "", message: s"expected $expected, found ${jsonKind(json)}" }
}

// atPath puts an error found inside a value under the given step of
// its path (".name", "[2]").
fn atPath(e: DecodeError, step: String): DecodeError {
  DecodeError { path: step + e.path, message: e.message }
}

instance decodeInt: Decode[Int] {
  fn decode(json: Json): Int | DecodeError {
    match (json) {
      Json.Number { text } => match (parseInt(text)) {
        n: Int => n
        e: ParseError => DecodeError { path: "", message: s"expected a whole number, found $text" }
      }
      other => decodeMismatch("a whole number", other)
    }
  }
}

instance decodeFloat: Decode[Float] {
  fn decode(json: Json): Float | DecodeError {
    match (json) {
      Json.Number { text } => match (parseFloat(text)) {
        f: Float => f
        e: ParseError => DecodeError { path: "", message: s"expected a number, found $text" }
      }
      other => decodeMismatch("a number", other)
    }
  }
}

instance decodeString: Decode[String] {
  fn decode(json: Json): String | DecodeError {
    match (json) {
      Json.String { value } => value
      other => decodeMismatch("a string", other)
    }
  }
}

instance decodeBool: Decode[Bool] {
  fn decode(json: Json): Bool | DecodeError {
    match (json) {
      Json.Bool { value } => value
      other => decodeMismatch("a boolean", other)
    }
  }
}

// An Option is null (or a missing field) for None.
instance decodeOption[T: Decode]: Decode[Option[T]] {
  fn decode(json: Json): Option[T] | DecodeError {
    match (json) {
      Json.Null => Option.None
      other => {
        value = decode[T](other)?
        Option.Some { value: value }
      }
    }
  }
}

instance decodeList[T: Decode]: Decode[List[T]] {
  fn decode(json: Json): List[T] | DecodeError {
    match (json) {
      Json.Array { items } => decodeItems(items, 0, [])
      other => decodeMismatch("an array", other)
    }
  }
}

fn decodeItems[T: Decode](items: List[Json], index: Int, done: List[T]): List[T] | DecodeError {
  match (items.head()) {
    Option.None => done.reverse()
    Option.Some { value: item } => match (decode[T](item)) {
      e: DecodeError => atPath(e, s"[$index]")
      x: T => decodeItems(items.drop(1), index + 1, prepend(x, done))
    }
  }
}

// A Map with String keys is a JSON object; its fields keep their order.
instance decodeMap[V: Decode]: Decode[Map[String, V]] {
  fn decode(json: Json): Map[String, V] | DecodeError {
    match (json) {
      Json.Object { fields } => decodeFields(fields, {:})
      other => decodeMismatch("an object", other)
    }
  }
}

fn decodeFields[V: Decode](fields: List[JsonField], done: Map[String, V]): Map[String, V] | DecodeError {
  match (fields.head()) {
    Option.None => done
    Option.Some { value: field } => match (decode[V](field.value)) {
      e: DecodeError => atPath(e, s".${field.name}")
      x: V => decodeFields(fields.drop(1), jsonFieldPut(done, field.name, x))
    }
  }
}

fn jsonFieldPut[V](m: Map[String, V], name: String, value: V): Map[String, V] unsafe go {
  return m.put(name, value)
}

instance decodeJson: Decode[Json] {
  fn decode(json: Json): Json | DecodeError { json }
}

instance encodeInt: Encode[Int] {
  fn encode(x: Int): Json { Json.Number { text: toString(x) } }
}

instance encodeFloat: Encode[Float] {
  fn encode(x: Float): Json { Json.Number { text: toString(x) } }
}

instance encodeString: Encode[String] {
  fn encode(x: String): Json { Json.String { value: x } }
}

instance encodeBool: Encode[Bool] {
  fn encode(x: Bool): Json { Json.Bool { value: x } }
}

instance encodeOption[T: Encode]: Encode[Option[T]] {
  fn encode(x: Option[T]): Json {
    match (x) {
      Option.None => Json.Null
      Option.Some { value } => encode(value)
    }
  }
}

instance encodeList[T: Encode]: Encode[List[T]] {
  fn encode(xs: List[T]): Json { Json.Array { items: xs.map(encode) } }
}

instance encodeMap[V: Encode]: Encode[Map[String, V]] {
  fn encode(m: Map[String, V]): Json {
    Json.Object { fields: jsonFieldsOf(m).map(e => JsonField { name: e.key, value: encode(e.value) }) }
  }
}

fn jsonFieldsOf[V](m: Map[String, V]): List[Entry[String, V]] unsafe go {
  out := make([]Entry[string, V], 0, m.len())
  m.each(func(k string, v V) bool {
    out = append(out, Entry[string, V]{key: k, value: v})
    return true
  })
  return out
}

instance encodeJson: Encode[Json] {
  fn encode(x: Json): Json { x }
}
