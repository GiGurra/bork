// JSON.

// Json is a JSON value. A number keeps its text, so that whole numbers
// of any size decode exactly.
type Json = sealed {
  Null
  Bool { value: Bool }
  Number { text: String }
  String { value: String }
  Array { items: List[Json] }
  Object { fields: List[JsonField] }
}

type JsonField = { name: String, value: Json }

// JsonError is returned for text that is not valid JSON.
type JsonError = { message: String }

// _jsonKind names the kind of a JSON value, for messages.
fn _jsonKind (j: Json): String {
  match (j) {
    Json.Null => "null"
    Json.Bool { value } => "a boolean"
    Json.Number { text } => "a number"
    Json.String { value } => "a string"
    Json.Array { items } => "an array"
    Json.Object { fields } => "an object"
  }
}

// DecodeError says where in a JSON value decoding failed (a path like
// ".items[2].name", "" for the whole value), and why. Transparent invariant
// comparisons name the first failed condition and its primary field path;
// other fields read by that condition appear in the message.
type DecodeError = { path: String, message: String }

// Decode reads values of a type from JSON. `derive (Decode)` on a record
// or sealed type gives it an instance that also checks every field's
// where clause, so decoded values arrive already proven.
class Decode[T] {
  fn decode(json: Json): T | DecodeError
}

// Encode writes values of a type as JSON; `derive (Encode)` gives
// records and sealed types an instance.
class Encode[T] {
  fn encode(x: T): Json
}

fn _decodeMismatch (expected: String, json: Json): DecodeError {
  DecodeError { path: "", message: s"expected $expected, found ${_jsonKind(json)}" }
}

// _atPath puts an error found inside a value under the given step of
// its path (".name", "[2]").
fn _atPath (e: DecodeError, step: String): DecodeError {
  DecodeError { path: step + e.path, message: e.message }
}

instance decodeInt: Decode[Int] {
  fn decode(json: Json): Int | DecodeError {
    match (json) {
      Json.Number { text } => match (parseInt(text)) {
        n: Int => n
        e: ParseError => DecodeError { path: "", message: s"expected a whole number, found $text" }
      }
      other => _decodeMismatch ("a whole number", other)
    }
  }
}

instance decodeFloat: Decode[Float] {
  fn decode(json: Json): Float | DecodeError {
    match (json) {
      Json.Number { text } => match (parseFloat(text)) {
        f: Float => f
        e: ParseError => DecodeError { path: "", message: s"expected a number, found $text" }
      }
      other => _decodeMismatch ("a number", other)
    }
  }
}

instance decodeString: Decode[String] {
  fn decode(json: Json): String | DecodeError {
    match (json) {
      Json.String { value } => value
      other => _decodeMismatch ("a string", other)
    }
  }
}

instance decodeBool: Decode[Bool] {
  fn decode(json: Json): Bool | DecodeError {
    match (json) {
      Json.Bool { value } => value
      other => _decodeMismatch ("a boolean", other)
    }
  }
}

// An Option is null (or a missing field) for None.
instance decodeOption[T: Decode]: Decode[Option[T]] {
  fn decode(json: Json): Option[T] | DecodeError {
    match (json) {
      Json.Null => Option.None
      other => {
        value = decode[T](other)?
        Option.Some { value: value }
      }
    }
  }
}

instance decodeList[T: Decode]: Decode[List[T]] {
  fn decode(json: Json): List[T] | DecodeError {
    match (json) {
      Json.Array { items } => _decodeItems (items, 0, [])
      other => _decodeMismatch ("an array", other)
    }
  }
}

fn _decodeItems [T: Decode](items: List[Json], index: Int, done: List[T]): List[T] | DecodeError {
  match (items.head()) {
    Option.None => done.reverse()
    Option.Some { value: item } => match (decode[T](item)) {
      e: DecodeError => _atPath (e, s"[$index]")
      x: T => _decodeItems (items.drop(1), index + 1, prepend(x, done))
    }
  }
}

// A Map with String keys is a JSON object; its fields keep their order.
instance decodeMap[V: Decode]: Decode[Map[String, V]] {
  fn decode(json: Json): Map[String, V] | DecodeError {
    match (json) {
      Json.Object { fields } => _decodeFields (fields, {:})
      other => _decodeMismatch ("an object", other)
    }
  }
}

fn _decodeFields [V: Decode](fields: List[JsonField], done: Map[String, V]): Map[String, V] | DecodeError {
  match (fields.head()) {
    Option.None => done
    Option.Some { value: field } => match (decode[V](field.value)) {
      e: DecodeError => _atPath (e, s".${field.name}")
      x: V => _decodeFields (fields.drop(1), _jsonFieldPut (done, field.name, x))
    }
  }
}

fn _jsonFieldPut [V](m: Map[String, V], name: String, value: V): Map[String, V] unsafe go {
  return m.put(name, value)
}

instance decodeJson: Decode[Json] {
  fn decode(json: Json): Json | DecodeError { json }
}

instance encodeInt: Encode[Int] {
  fn encode(x: Int): Json { Json.Number { text: toString(x) } }
}

instance encodeFloat: Encode[Float] {
  fn encode(x: Float): Json { Json.Number { text: toString(x) } }
}

instance encodeString: Encode[String] {
  fn encode(x: String): Json { Json.String { value: x } }
}

instance encodeBool: Encode[Bool] {
  fn encode(x: Bool): Json { Json.Bool { value: x } }
}

instance encodeOption[T: Encode]: Encode[Option[T]] {
  fn encode(x: Option[T]): Json {
    match (x) {
      Option.None => Json.Null
      Option.Some { value } => encode(value)
    }
  }
}

instance encodeList[T: Encode]: Encode[List[T]] {
  fn encode(xs: List[T]): Json { Json.Array { items: xs.map(encode) } }
}

instance encodeMap[V: Encode]: Encode[Map[String, V]] {
  fn encode(m: Map[String, V]): Json {
    Json.Object { fields: _jsonFieldsOf (m).map(e => JsonField { name: e.key, value: encode(e.value) }) }
  }
}

fn _jsonFieldsOf [V](m: Map[String, V]): List[Entry[String, V]] unsafe go {
  out := make([]Entry[string, V], 0, m.len())
  m.each(func(k string, v V) bool {
    out = append(out, Entry[string, V]{key: k, value: v})
    return true
  })
  return out
}

instance encodeJson: Encode[Json] {
  fn encode(x: Json): Json { x }
}
