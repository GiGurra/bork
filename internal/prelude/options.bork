// Option is a value that may be missing.
type Option[T] = sealed { Some { value: T }, None }

fn (o: Option[T]) map[T, U](f: (T) => U): Option[U] {
  match (o) {
    Option.Some { value } => Option.Some { value: f(value) }
    Option.None => Option.None
  }
}

fn (o: Option[T]) flatMap[T, U](f: (T) => Option[U]): Option[U] {
  match (o) {
    Option.Some { value } => f(value)
    Option.None => Option.None
  }
}

fn (o: Option[T]) getOr[T](otherwise: T): T {
  match (o) {
    Option.Some { value } => value
    Option.None => otherwise
  }
}

fn (o: Option[T]) isSome[T](): Bool {
  match (o) {
    Option.Some { value: _ } => true
    Option.None => false
  }
}

fn (o: Option[T]) isNone[T](): Bool { !o.isSome() }
