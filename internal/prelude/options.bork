// Option is a value that may be missing.
type Option[T] = sealed { Some(T), None }

// Transforms a present value with f; None stays None.
fn (o: Option[T]) map[T, U](f: (T) => U): Option[U] {
  match (o) {
    Option.Some(value) => Option.Some(f(value))
    Option.None => Option.None
  }
}

// Applies f to a present value; None stays None.
fn (o: Option[T]) flatMap[T, U](f: (T) => Option[U]): Option[U] {
  match (o) {
    Option.Some(value) => f(value)
    Option.None => Option.None
  }
}

// Returns the present value, or otherwise for None; otherwise is evaluated
// before the call.
fn (o: Option[T]) getOr[T](otherwise: T): T {
  match (o) {
    Option.Some(value) => value
    Option.None => otherwise
  }
}

// Reports whether the option contains a value.
fn (o: Option[T]) isSome[T](): Bool {
  match (o) {
    Option.Some(_) => true
    Option.None => false
  }
}

// Reports whether the option is None.
fn (o: Option[T]) isNone[T](): Bool { !o.isSome() }
