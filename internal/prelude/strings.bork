// Reading numbers and Bools from Strings.

fn parseInt(text: String): Int | ParseError unsafe go {
  import "strconv"
  n, err := strconv.ParseInt(text, 10, 64)
  if err != nil {
    return ParseError{input: text, message: err.(*strconv.NumError).Err.Error()}
  }
  return n
}

fn parseFloat(text: String): Float | ParseError unsafe go {
  import "strconv"
  f, err := strconv.ParseFloat(text, 64)
  if err != nil {
    return ParseError{input: text, message: err.(*strconv.NumError).Err.Error()}
  }
  return f
}

fn parseBool(text: String): Bool | ParseError unsafe go {
  switch text {
  case "true":
    return true
  case "false":
    return false
  }
  return ParseError{input: text, message: "expected true or false"}
}

// String methods. Lengths and indexes count bytes (UTF-8), except
// runeCount(), runeAt(), and substring(), which count Unicode code points.

fn (s: String) byteLength(): Int unsafe go {
  return int64(len(s))
}
fn (s: String) runeCount(): Int unsafe go {
  import "unicode/utf8"
  return int64(utf8.RuneCountInString(s))
}
fn (s: String) contains(part: String): Bool unsafe go {
  import "strings"
  return strings.Contains(s, part)
}
fn (s: String) startsWith(prefix: String): Bool unsafe go {
  import "strings"
  return strings.HasPrefix(s, prefix)
}
fn (s: String) endsWith(suffix: String): Bool unsafe go {
  import "strings"
  return strings.HasSuffix(s, suffix)
}
// indexOf finds the first occurrence of part in s.
fn (s: String) indexOf(part: String): Option[Int] unsafe go {
  import "strings"
  i := strings.Index(s, part)
  if i < 0 {
    return Option_None[int64]{}
  }
  return Option_Some[int64]{E0: int64(i)}
}
fn (s: String) toUpper(): String unsafe go {
  import "strings"
  return strings.ToUpper(s)
}
fn (s: String) toLower(): String unsafe go {
  import "strings"
  return strings.ToLower(s)
}
// capitalize upper-cases the first Unicode character and keeps the rest.
fn (s: String) capitalize(): String unsafe go {
  import "unicode"
  import "unicode/utf8"
  first, size := utf8.DecodeRuneInString(s)
  if size == 0 { return s }
  return string(unicode.ToUpper(first)) + s[size:]
}
// trim removes leading and trailing white space.
fn (s: String) trim(): String unsafe go {
  import "strings"
  return strings.TrimSpace(s)
}
fn (s: String) replaceAll(old: String, replacement: String): String unsafe go {
  import "strings"
  return strings.ReplaceAll(s, old, replacement)
}
// repeat repeats s count times; a count below 1 gives "".
fn (s: String) repeat(count: Int): String unsafe go {
  import "strings"
  return strings.Repeat(s, int(max(count, 0)))
}
// runeAt is the rune at index (counting runes from 0), if there is one.
fn (s: String) runeAt(index: Int): Option[Rune] unsafe go {
  if index >= 0 {
    i := int64(0)
    for _, r := range s {
      if i == index {
        return Option_Some[_Rune]{E0: _Rune(r)}
      }
      i++
    }
  }
  return Option_None[_Rune]{}
}
// substring is the runes from index from up to (not including) index
// to. It is OutOfRange unless 0 <= from <= to <= s.runeCount().
fn (s: String) substring(from: Int, to: Int): String | OutOfRange unsafe go {
  import "fmt"
  runes := []rune(s)
  if from < 0 || to < from || to > int64(len(runes)) {
    return OutOfRange{value: fmt.Sprintf("%d to %d", from, to), target: fmt.Sprintf("a String of %d runes", len(runes))}
  }
  return string(runes[from:to])
}
// split always gives at least one part.
fn (s: String) split(separator: String): List[String] where notEmpty unsafe go {
  import "strings"
  return strings.Split(s, separator)
}
// fields splits s around runs of whitespace: " a  b ".fields() is ["a", "b"].
fn (s: String) fields(): List[String] unsafe go {
  import "strings"
  return strings.Fields(s)
}
// lines splits s into lines, without their line endings. A final line
// ending does not start another line.
fn (s: String) lines(): List[String] unsafe go {
  import "strings"
  if s == "" {
    return []string{}
  }
  out := strings.Split(strings.TrimSuffix(s, "\n"), "\n")
  for i, line := range out {
    out[i] = strings.TrimSuffix(line, "\r")
  }
  return out
}
