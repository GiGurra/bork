// The bork prelude: built-in types and functions available in every
// package. Functions are implemented in Go (`unsafe go`), in terms of
// how bork values look in Go:
//
//   Int, Int8, ... Uint64  int64, int8, ... uint64 (Rune is int32)
//   Float32, Float         float32, float64
//   String, Bool           string, bool
//   Bytes                  a distinct []byte; use _borkBytesFrom/Data to copy
//   a record               a struct with the same field names
//   Option[T]              Option[T]: Option_Some[T]{value: v} or Option_None[T]{}
//   a union                any, holding one of the member types
//   List[T]                []T, never modified once built
//   Map[K, V]              _Map[K, V], persistent: m.get(k), m.put(k, v),
//                          m.remove(k), m.len(), m.each(f), m.keys(),
//                          m.vals(), _mapOf(keys, values)
//   std Go helper API      see docs/std-go.md; use _bork helpers in std code
//   (A, B) => C            func(A, B) C (no result for Unit)
//   a type parameter T     a Go type parameter T (any)
//   Scope                  *_Scope; s.Defer(f) runs f when the scope closes
//   a resource type        a struct { handle any; owner *_Owner }, made as
//                          R{handle: h, owner: s.Own(func() { close h })}

// Option is a value that may be missing.
type Option[T] = sealed { Some { value: T }, None }

// Entry is a key of a Map with its value (bork/maps lists a map's
// entries).
type Entry[K, V] = { key: K, value: V }

// OutOfRange is returned by a conversion whose value does not fit the
// target type, such as toInt8(1000).
type OutOfRange = { value: String, target: String }

// ParseError is returned when a String cannot be read as a value.
type ParseError = { input: String, message: String }

// Scopes and resources. A resource is opened in a scope, and closed
// when the scope closes: finalizers run in reverse order of
// registration, when the scope's block ends or panics.

// Concurrency is structured: a task runs on its own goroutine, and the
// scope that started it waits for it before it closes (and before its
// finalizers run), so a task can use the scope's resources. When the
// scope ends, it cancels itself first: how a task stops (at once, after
// cleaning up, or after finishing its work) is up to the task. A task
// that panics panics await, or, if no one awaited it, the scope's
// routine when the scope closes.

// Task is a running computation of a T, started with spawn.
type Task[T] = { wait: () => T }

// spawn starts work on its own goroutine, as a task of scope s.
fn spawn[T](s: Scope, work: () => T): Task[T] unsafe go {
  t := s.Go(func() any { return work() })
  return Task[T]{wait: func() T { return t.Await().(T) }}
}

// await waits for a task to finish, and gives its result.
fn await[T](task: Task[T]): T unsafe go {
  return task.wait()
}

// launch starts work that gives no result on its own goroutine, as a
// task of scope s, which waits for it before it closes.
fn launch(s: Scope, work: () => Unit) unsafe go {
  s.Go(func() any { work(); return nil })
}

// Cancelled is what a cancellation-aware operation gives when its scope
// is cancelled; reason says why ("cancelled", "deadline exceeded", ...).
type Cancelled = { reason: String }

// cancel cancels the scope s: its tasks see it at their next
// cancellation point (delay, checkpoint, channels), and so do scopes
// nested in it. The scope still waits for them before it closes. (A
// scope is also cancelled when it ends.)
fn cancel(s: Scope) uses state unsafe go {
  s.cancel(_errCancelled)
}

// cancelled reports whether s has been cancelled.
fn cancelled(s: Scope) uses state: Bool unsafe go {
  return s.ctx.Err() != nil
}

// cancelAfter cancels s once ms milliseconds have passed, unless it has
// closed by then: a deadline.
fn cancelAfter(s: Scope, ms: Int) uses clock + state unsafe go {
  import "errors"
  import "time"
  t := time.AfterFunc(time.Duration(ms)*time.Millisecond, func() { s.cancel(errors.New("deadline exceeded")) })
  s.Defer(func() { t.Stop() })
}

// checkpoint gives Cancelled if s has been cancelled: a cancellation
// point for work that does not otherwise wait, as in checkpoint(s)?.
fn checkpoint(s: Scope) uses state: Unit | Cancelled unsafe go {
  if r := s._cancelReason(); r != "" {
    return Cancelled{reason: r}
  }
  return _Unit{}
}

// delay pauses for ms milliseconds, or until s is cancelled.
fn delay(s: Scope, ms: Int) uses clock + state: Unit | Cancelled unsafe go {
  import "time"
  if !s._sleep(time.Duration(ms) * time.Millisecond) {
    return Cancelled{reason: s._cancelReason()}
  }
  return _Unit{}
}

// Closed is what sending to or receiving from a closed channel gives
// (once its buffered values are received).
type Closed = {}

// Atom holds a value that tasks share and replace, as Clojure's atom:
// the value itself never changes, but update swaps in a new one,
// atomically. With persistent maps and lists it is how a server keeps
// state between requests:
//
//   store = atom({:})
//   update(store, users => maps.Put(users, id, user))
//
// update may call f more than once (when another task updated the atom
// in between), so f should do nothing but compute the new value.
type Atom[T] = {
  currentFn: () uses state => T,
  updateFn: ((T) uses nothing => T) uses state => T,
  swapFn: ((T) uses nothing => T) uses state => T,
}

// atom makes an atom holding initial.
fn atom[T](initial: T): Atom[T] unsafe go {
  import "sync/atomic"
  var p atomic.Pointer[T]
  p.Store(&initial)
  // change gives the old value and the new one.
  change := func(f func(T) T) (T, T) {
    for {
      old := p.Load()
      next := f(*old)
      if p.CompareAndSwap(old, &next) {
        return *old, next
      }
    }
  }
  return Atom[T]{
    currentFn: func() T { return *p.Load() },
    updateFn: func(f func(T) T) T { _, next := change(f); return next },
    swapFn: func(f func(T) T) T { old, _ := change(f); return old },
  }
}

// current is the value a holds now.
fn current[T](a: Atom[T]) uses state: T {
  a.currentFn()
}

// update replaces a's value x with f(x), atomically, and gives the new
// value.
fn update[T](a: Atom[T], f: (T) uses nothing => T) uses state: T {
  a.updateFn(f)
}

// swap is update, but gives the value it replaced: what the change was
// made to, so the caller can tell what it did (`old = swap(store, s =>
// remove(s, id))`, then whether old had id).
fn swap[T](a: Atom[T], f: (T) uses nothing => T) uses state: T {
  a.swapFn(f)
}

// Channel passes values of type T between tasks. It belongs to the
// scope it was made in, and closes when that scope closes; its
// operations stop with Cancelled when that scope is cancelled.
type Channel[T] = {
  sendFn: (T) uses state => Unit | Cancelled | Closed,
  receiveFn: () uses state => T | Cancelled | Closed,
  closeFn: () uses state => Unit,
}

// channel makes a channel in scope s that holds up to capacity values
// that are not received yet (0: a sender waits for a receiver).
fn channel[T](s: Scope, capacity: Int): Channel[T] unsafe go {
  import "sync"
  c := make(chan T, capacity)
  closed := make(chan struct{})
  var once sync.Once
  closeFn := func() { once.Do(func() { close(closed) }) }
  s.Defer(closeFn)
  // The Go channel is never closed, so a late send cannot panic.
  return Channel[T]{
    sendFn: func(x T) any {
      select {
      case <-closed:
        return Closed{}
      case <-s.ctx.Done():
        return Cancelled{reason: s._cancelReason()}
      default:
      }
      select {
      case c <- x:
        return _Unit{}
      case <-closed:
        return Closed{}
      case <-s.ctx.Done():
        return Cancelled{reason: s._cancelReason()}
      }
    },
    receiveFn: func() any {
      select {
      case x := <-c:
        return x
      case <-closed:
        select {
        case x := <-c:
          return x
        default:
          return Closed{}
        }
      case <-s.ctx.Done():
        return Cancelled{reason: s._cancelReason()}
      }
    },
    closeFn: closeFn,
  }
}

// send passes x to the channel, waiting while it is full.
fn send[T](ch: Channel[T], x: T) uses state: Unit | Cancelled | Closed unsafe go {
  return ch.sendFn(x)
}

// receive takes the next value from the channel, waiting until there
// is one.
fn receive[T](ch: Channel[T]) uses state: T | Cancelled | Closed unsafe go {
  return ch.receiveFn()
}

// closeChannel closes the channel: sends give Closed, and receives
// give the values still buffered, then Closed.
fn closeChannel[T](ch: Channel[T]) uses state unsafe go {
  ch.closeFn()
}

// received receives values until the channel closes (or its scope is
// cancelled), and gives them in order.
fn received[T](ch: Channel[T]) uses state: List[T] unsafe go {
  out := []T{}
  for {
    v, ok := ch.receiveFn().(T)
    if !ok {
      return out
    }
    out = append(out, v)
  }
}

// sleep pauses the routine for ms milliseconds.
fn sleep(ms: Int) uses clock unsafe go {
  import "time"
  time.Sleep(time.Duration(ms) * time.Millisecond)
}

// attach keeps a resource open until scope s closes too: it closes when
// the last of the scopes it is attached to closes. It gives the
// resource, as a value of s, to hand to tasks of s (which may outlive
// the scope the resource was opened in).
fn attach[R](r: R, s: Scope): R unsafe go {
  o, _ := any(r).(interface{ _ownerOf() *_Owner })
  if o == nil || o._ownerOf() == nil {
    panic("bork: attach: the resource was not opened with an owner (s.Own)")
  }
  if !o._ownerOf().attach(s) {
    panic("bork: attach: the resource is already closed")
  }
  return r
}

// ScopePolicy configures how a scope ends, chosen with
// `scope s with taskTimeout(100), cleanupTimeout(500), logFailures() { ... }`.
// When a scope ends, it cancels itself, waits for its tasks, and then
// runs its finalizers. By default it waits for each for as long as it
// takes, and raises failures (finalizers that panicked, and tasks that
// panicked without being awaited) as one panic once it is closed;
// every finalizer runs, even when others fail.
//   - TaskTimeout: wait at most ms milliseconds for the tasks to stop
//     (with whatever cleanup of their own they do). Tasks still running
//     then are orphaned: they keep running, the scope's finalizers still
//     run, and the tasks may find its resources closed.
//   - CleanupTimeout: wait at most ms milliseconds for each finalizer;
//     one that takes longer is orphaned, and the scope goes on closing.
//   - LogFailures: log failures (at error level) instead of raising them.
// Orphaning is logged at warning level.
type ScopePolicy = sealed {
  TaskTimeout { ms: Int },
  CleanupTimeout { ms: Int },
  LogFailures,
}

// taskTimeout is the policy that waits at most ms milliseconds for the
// scope's tasks to stop when it ends.
fn taskTimeout(ms: Int): ScopePolicy {
  ScopePolicy.TaskTimeout { ms: ms }
}

// cleanupTimeout is the policy that waits at most ms milliseconds for
// each finalizer.
fn cleanupTimeout(ms: Int): ScopePolicy {
  ScopePolicy.CleanupTimeout { ms: ms }
}

// logFailures is the policy that logs failures at the scope's end
// instead of raising them.
fn logFailures(): ScopePolicy {
  ScopePolicy.LogFailures
}

// setScopePolicy applies a policy to s (what `with` does).
fn setScopePolicy(s: Scope, policy: ScopePolicy) unsafe go {
  import "time"
  switch p := policy.(type) {
  case ScopePolicy_TaskTimeout:
    s.taskTimeout = time.Duration(p.ms) * time.Millisecond
  case ScopePolicy_CleanupTimeout:
    s.finalizerTimeout = time.Duration(p.ms) * time.Millisecond
  case ScopePolicy_LogFailures:
    s.logFailures = true
  }
}

// onClose runs f when the scope s closes.
fn onClose(s: Scope, f: () => Unit) unsafe go {
  s.Defer(f)
}

// IoError is returned when reading or writing outside the program fails.
type IoError = { path: String, message: String }

// File is an open file, closed when its scope closes.
type File = resource

fn openFile(path: String, s: Scope) uses io: File | IoError unsafe go {
  import "errors"
  import "os"
  f, err := os.Open(path)
  if err != nil {
    msg := err.Error()
    var pe *os.PathError
    if errors.As(err, &pe) {
      msg = pe.Err.Error()
    }
    return IoError{path: path, message: msg}
  }
  return File{handle: f, owner: s.Own(func() { f.Close() })}
}

// createFile creates (or empties) the file at path, for writing.
fn createFile(path: String, s: Scope) uses io: File | IoError unsafe go {
  import "errors"
  import "os"
  f, err := os.Create(path)
  if err != nil {
    msg := err.Error()
    var pe *os.PathError
    if errors.As(err, &pe) {
      msg = pe.Err.Error()
    }
    return IoError{path: path, message: msg}
  }
  return File{handle: f, owner: s.Own(func() { f.Close() })}
}

// readAll reads the rest of the file.
fn readAll(f: File) uses io: String | IoError unsafe go {
  import "errors"
  import "io"
  import "os"
  file := f.handle.(*os.File)
  data, err := io.ReadAll(file)
  if err != nil {
    msg := err.Error()
    var pe *os.PathError
    if errors.As(err, &pe) {
      msg = pe.Err.Error()
    }
    return IoError{path: file.Name(), message: msg}
  }
  return string(data)
}

// write writes text to the file, and returns the number of bytes written.
fn write(f: File, text: String) uses io: Int | IoError unsafe go {
  import "errors"
  import "os"
  file := f.handle.(*os.File)
  n, err := file.WriteString(text)
  if err != nil {
    msg := err.Error()
    var pe *os.PathError
    if errors.As(err, &pe) {
      msg = pe.Err.Error()
    }
    return IoError{path: file.Name(), message: msg}
  }
  return int64(n)
}

// The program's environment.

// args is the program's command-line arguments (without its name).
fn args() uses io: List[String] unsafe go {
  import "os"
  return os.Args[1:]
}

// exit ends the program with the given status code, without closing
// scopes.
fn exit(code: Int) uses io: Never unsafe go {
  import "os"
  os.Exit(int(code))
}

// eprintln prints text and a newline to standard error.
fn eprintln(text: String) uses io unsafe go {
  import "fmt"
  import "os"
  fmt.Fprintln(os.Stderr, text)
}

// Reading numbers and Bools from Strings.

fn parseInt(text: String): Int | ParseError unsafe go {
  import "strconv"
  n, err := strconv.ParseInt(text, 10, 64)
  if err != nil {
    return ParseError{input: text, message: err.(*strconv.NumError).Err.Error()}
  }
  return n
}

fn parseFloat(text: String): Float | ParseError unsafe go {
  import "strconv"
  f, err := strconv.ParseFloat(text, 64)
  if err != nil {
    return ParseError{input: text, message: err.(*strconv.NumError).Err.Error()}
  }
  return f
}

fn parseBool(text: String): Bool | ParseError unsafe go {
  switch text {
  case "true":
    return true
  case "false":
    return false
  }
  return ParseError{input: text, message: "expected true or false"}
}

// Strings. Lengths and indexes count bytes (UTF-8), as in Go.

// Runes (Unicode code points). These count and index runes, not bytes.

fn runeToString(r: Rune): String unsafe go {
  return string(r)
}

fn isDigit(r: Rune): Bool unsafe go {
  import "unicode"
  return unicode.IsDigit(r)
}

fn isLetter(r: Rune): Bool unsafe go {
  import "unicode"
  return unicode.IsLetter(r)
}

fn isSpace(r: Rune): Bool unsafe go {
  import "unicode"
  return unicode.IsSpace(r)
}

fn isUpper(r: Rune): Bool unsafe go {
  import "unicode"
  return unicode.IsUpper(r)
}

fn isLower(r: Rune): Bool unsafe go {
  import "unicode"
  return unicode.IsLower(r)
}

// Lists. A List is immutable: functions that "change" one build a new
// list.

// notEmpty holds for a list with at least one element.
pred notEmpty[T](xs: List[T]) { !xs.isEmpty() }

fn prepend[T](x: T, xs: List[T]): List[T] where notEmpty unsafe go {
  out := make([]T, 0, len(xs)+1)
  return append(append(out, x), xs...)
}

// range is the Ints from start up to (not including) end.
fn range(start: Int, end: Int): List[Int] unsafe go {
  var out []int64
  for i := start; i < end; i++ {
    out = append(out, i)
  }
  return out
}

// JSON.

// Json is a JSON value. A number keeps its text, so that whole numbers
// of any size decode exactly.
type Json = sealed {
  Null
  Bool { value: Bool }
  Number { text: String }
  String { value: String }
  Array { items: List[Json] }
  Object { fields: List[JsonField] }
}

type JsonField = { name: String, value: Json }

// JsonError is returned for text that is not valid JSON.
type JsonError = { message: String }

// parseJson reads a JSON value; object fields keep their order.
fn parseJson(text: String): Json | JsonError unsafe go {
  import "encoding/json"
  import "fmt"
  import "strings"
  // A small parser of its own, so that messages are the same in every Go
  // version: "invalid JSON at line 1, column 2: expected a value".
  pos := 0
  fail := func(what string) JsonError {
    line := 1 + strings.Count(text[:pos], "\n")
    col := pos - strings.LastIndex(text[:pos], "\n")
    if pos >= len(text) {
      return JsonError{message: "unexpected end of JSON: expected " + what}
    }
    return JsonError{message: fmt.Sprintf("invalid JSON at line %d, column %d: expected %s", line, col, what)}
  }
  space := func() {
    for pos < len(text) && strings.IndexByte(" \t\r\n", text[pos]) >= 0 {
      pos++
    }
  }
  digits := func() int {
    start := pos
    for pos < len(text) && text[pos] >= '0' && text[pos] <= '9' {
      pos++
    }
    return pos - start
  }
  str := func() (string, *JsonError) {
    start := pos
    pos++
    for pos < len(text) && text[pos] != '"' {
      if text[pos] == '\\' {
        pos++
      }
      pos++
    }
    if pos >= len(text) {
      e := fail("the end of a string")
      return "", &e
    }
    pos++
    var s string
    if json.Unmarshal([]byte(text[start:pos]), &s) != nil {
      pos = start
      e := fail("a valid string")
      return "", &e
    }
    return s, nil
  }
  var value func() (Json, *JsonError)
  value = func() (Json, *JsonError) {
    space()
    if pos >= len(text) {
      e := fail("a value")
      return nil, &e
    }
    for word, j := range map[string]Json{"null": Json_Null{}, "true": Json_Bool{value: true}, "false": Json_Bool{value: false}} {
      if strings.HasPrefix(text[pos:], word) {
        pos += len(word)
        return j, nil
      }
    }
    switch c := text[pos]; {
    case c == '"':
      s, e := str()
      return Json_String{value: s}, e
    case c == '-' || c >= '0' && c <= '9':
      start := pos
      if c == '-' {
        pos++
      }
      if n := digits(); n == 0 || n > 1 && text[pos-n] == '0' {
        pos = start
        e := fail("a number")
        return nil, &e
      }
      if pos < len(text) && text[pos] == '.' {
        pos++
        if digits() == 0 {
          e := fail("a digit")
          return nil, &e
        }
      }
      if pos < len(text) && (text[pos] == 'e' || text[pos] == 'E') {
        pos++
        if pos < len(text) && (text[pos] == '+' || text[pos] == '-') {
          pos++
        }
        if digits() == 0 {
          e := fail("a digit")
          return nil, &e
        }
      }
      return Json_Number{text: text[start:pos]}, nil
    case c == '[':
      pos++
      items := []Json{}
      space()
      if pos < len(text) && text[pos] == ']' {
        pos++
        return Json_Array{items: items}, nil
      }
      for {
        item, e := value()
        if e != nil {
          return nil, e
        }
        items = append(items, item)
        space()
        if pos < len(text) && text[pos] == ',' {
          pos++
          continue
        }
        if pos < len(text) && text[pos] == ']' {
          pos++
          return Json_Array{items: items}, nil
        }
        e2 := fail("',' or ']'")
        return nil, &e2
      }
    case c == '{':
      pos++
      fields := []JsonField{}
      space()
      if pos < len(text) && text[pos] == '}' {
        pos++
        return Json_Object{fields: fields}, nil
      }
      for {
        space()
        if pos >= len(text) || text[pos] != '"' {
          e := fail("a field name")
          return nil, &e
        }
        name, e := str()
        if e != nil {
          return nil, e
        }
        space()
        if pos >= len(text) || text[pos] != ':' {
          e := fail("':'")
          return nil, &e
        }
        pos++
        v, e := value()
        if e != nil {
          return nil, e
        }
        fields = append(fields, JsonField{name: name, value: v})
        space()
        if pos < len(text) && text[pos] == ',' {
          pos++
          continue
        }
        if pos < len(text) && text[pos] == '}' {
          pos++
          return Json_Object{fields: fields}, nil
        }
        e2 := fail("',' or '}'")
        return nil, &e2
      }
    }
    e := fail("a value")
    return nil, &e
  }
  j, e := value()
  if e != nil {
    return *e
  }
  space()
  if pos < len(text) {
    return fail("the end of the text")
  }
  return j
}

// renderJson writes a JSON value as compact text.
fn renderJson(j: Json): String unsafe go {
  import "encoding/json"
  import "strings"
  var b strings.Builder
  var render func(j Json)
  render = func(j Json) {
    switch j := j.(type) {
    case Json_Null:
      b.WriteString("null")
    case Json_Bool:
      if j.value {
        b.WriteString("true")
      } else {
        b.WriteString("false")
      }
    case Json_Number:
      b.WriteString(j.text)
    case Json_String:
      s, _ := json.Marshal(j.value)
      b.Write(s)
    case Json_Array:
      b.WriteString("[")
      for i, item := range j.items {
        if i > 0 {
          b.WriteString(",")
        }
        render(item)
      }
      b.WriteString("]")
    case Json_Object:
      b.WriteString("{")
      for i, f := range j.fields {
        if i > 0 {
          b.WriteString(",")
        }
        s, _ := json.Marshal(f.name)
        b.Write(s)
        b.WriteString(":")
        render(f.value)
      }
      b.WriteString("}")
    }
  }
  render(j)
  return b.String()
}

// jsonKind names the kind of a JSON value, for messages.
fn jsonKind(j: Json): String {
  match (j) {
    Json.Null => "null"
    Json.Bool { value } => "a boolean"
    Json.Number { text } => "a number"
    Json.String { value } => "a string"
    Json.Array { items } => "an array"
    Json.Object { fields } => "an object"
  }
}

// DecodeError says where in a JSON value decoding failed (a path like
// ".items[2].name", "" for the whole value), and why.
type DecodeError = { path: String, message: String }

// Decode reads values of a type from JSON. `derive (Decode)` on a record
// or sealed type gives it an instance that also checks every field's
// where clause, so decoded values arrive already proven.
class Decode[T] {
  fn decode(json: Json): T | DecodeError
}

// Encode writes values of a type as JSON; `derive (Encode)` gives
// records and sealed types an instance.
class Encode[T] {
  fn encode(x: T): Json
}

// Eq is built in: every type whose values can be compared (all but
// functions, scopes, and resources) has it, with structural ==. A bound
// [T: Eq] lets generic code compare values of T.
class Eq[T] {
  fn equals(a: T, b: T): Bool
}

// Show customizes text consistently, including generic and nested values.
// One universal instance may be declared in a record or sealed type's own
// package. Every value has a default renderer, so Show bounds always hold.
class Show[T] {
  fn show(x: T): String
}

// Ord orders the values of a type: compare(a, b) is negative when a
// comes before b, positive when it comes after, and 0 when they are
// equal (it must agree with ==). Numbers and Strings have instances
// (Strings compare by bytes); declare one for other types.
class Ord[T] {
  fn compare(a: T, b: T): Int
}

instance ordInt: Ord[Int] {
  fn compare(a: Int, b: Int): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordInt8: Ord[Int8] {
  fn compare(a: Int8, b: Int8): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordInt16: Ord[Int16] {
  fn compare(a: Int16, b: Int16): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordInt32: Ord[Int32] {
  fn compare(a: Int32, b: Int32): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordUint8: Ord[Uint8] {
  fn compare(a: Uint8, b: Uint8): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordUint16: Ord[Uint16] {
  fn compare(a: Uint16, b: Uint16): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordUint32: Ord[Uint32] {
  fn compare(a: Uint32, b: Uint32): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordUint64: Ord[Uint64] {
  fn compare(a: Uint64, b: Uint64): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordFloat: Ord[Float] {
  fn compare(a: Float, b: Float): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordFloat32: Ord[Float32] {
  fn compare(a: Float32, b: Float32): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

instance ordString: Ord[String] {
  fn compare(a: String, b: String): Int { if (a < b) { -1 } else if (a > b) { 1 } else { 0 } }
}

// decodeJson parses text and decodes it.
fn decodeJson[T: Decode](text: String): T | JsonError | DecodeError {
  json = parseJson(text)?
  decode[T](json)
}

// encodeJson encodes a value and renders it as compact JSON text.
fn encodeJson[T: Encode](x: T): String {
  renderJson(encode(x))
}

fn decodeMismatch(expected: String, json: Json): DecodeError {
  DecodeError { path: "", message: s"expected $expected, found ${jsonKind(json)}" }
}

// atPath puts an error found inside a value under the given step of
// its path (".name", "[2]").
fn atPath(e: DecodeError, step: String): DecodeError {
  DecodeError { path: step + e.path, message: e.message }
}

instance decodeInt: Decode[Int] {
  fn decode(json: Json): Int | DecodeError {
    match (json) {
      Json.Number { text } => match (parseInt(text)) {
        n: Int => n
        e: ParseError => DecodeError { path: "", message: s"expected a whole number, found $text" }
      }
      other => decodeMismatch("a whole number", other)
    }
  }
}

instance decodeFloat: Decode[Float] {
  fn decode(json: Json): Float | DecodeError {
    match (json) {
      Json.Number { text } => match (parseFloat(text)) {
        f: Float => f
        e: ParseError => DecodeError { path: "", message: s"expected a number, found $text" }
      }
      other => decodeMismatch("a number", other)
    }
  }
}

instance decodeString: Decode[String] {
  fn decode(json: Json): String | DecodeError {
    match (json) {
      Json.String { value } => value
      other => decodeMismatch("a string", other)
    }
  }
}

instance decodeBool: Decode[Bool] {
  fn decode(json: Json): Bool | DecodeError {
    match (json) {
      Json.Bool { value } => value
      other => decodeMismatch("a boolean", other)
    }
  }
}

// An Option is null (or a missing field) for None.
instance decodeOption[T: Decode]: Decode[Option[T]] {
  fn decode(json: Json): Option[T] | DecodeError {
    match (json) {
      Json.Null => Option.None
      other => {
        value = decode[T](other)?
        Option.Some { value: value }
      }
    }
  }
}

instance decodeList[T: Decode]: Decode[List[T]] {
  fn decode(json: Json): List[T] | DecodeError {
    match (json) {
      Json.Array { items } => decodeItems(items, 0, [])
      other => decodeMismatch("an array", other)
    }
  }
}

fn decodeItems[T: Decode](items: List[Json], index: Int, done: List[T]): List[T] | DecodeError {
  match (items.head()) {
    Option.None => done.reverse()
    Option.Some { value: item } => match (decode[T](item)) {
      e: DecodeError => atPath(e, s"[$index]")
      x: T => decodeItems(items.drop(1), index + 1, prepend(x, done))
    }
  }
}

// A Map with String keys is a JSON object; its fields keep their order.
instance decodeMap[V: Decode]: Decode[Map[String, V]] {
  fn decode(json: Json): Map[String, V] | DecodeError {
    match (json) {
      Json.Object { fields } => decodeFields(fields, {:})
      other => decodeMismatch("an object", other)
    }
  }
}

fn decodeFields[V: Decode](fields: List[JsonField], done: Map[String, V]): Map[String, V] | DecodeError {
  match (fields.head()) {
    Option.None => done
    Option.Some { value: field } => match (decode[V](field.value)) {
      e: DecodeError => atPath(e, s".${field.name}")
      x: V => decodeFields(fields.drop(1), jsonFieldPut(done, field.name, x))
    }
  }
}

fn jsonFieldPut[V](m: Map[String, V], name: String, value: V): Map[String, V] unsafe go {
  return m.put(name, value)
}

instance decodeJson: Decode[Json] {
  fn decode(json: Json): Json | DecodeError { json }
}

instance encodeInt: Encode[Int] {
  fn encode(x: Int): Json { Json.Number { text: toString(x) } }
}

instance encodeFloat: Encode[Float] {
  fn encode(x: Float): Json { Json.Number { text: toString(x) } }
}

instance encodeString: Encode[String] {
  fn encode(x: String): Json { Json.String { value: x } }
}

instance encodeBool: Encode[Bool] {
  fn encode(x: Bool): Json { Json.Bool { value: x } }
}

instance encodeOption[T: Encode]: Encode[Option[T]] {
  fn encode(x: Option[T]): Json {
    match (x) {
      Option.None => Json.Null
      Option.Some { value } => encode(value)
    }
  }
}

instance encodeList[T: Encode]: Encode[List[T]] {
  fn encode(xs: List[T]): Json { Json.Array { items: xs.map(encode) } }
}

instance encodeMap[V: Encode]: Encode[Map[String, V]] {
  fn encode(m: Map[String, V]): Json {
    Json.Object { fields: jsonFieldsOf(m).map(e => JsonField { name: e.key, value: encode(e.value) }) }
  }
}

fn jsonFieldsOf[V](m: Map[String, V]): List[Entry[String, V]] unsafe go {
  out := make([]Entry[string, V], 0, m.len())
  m.each(func(k string, v V) bool {
    out = append(out, Entry[string, V]{key: k, value: v})
    return true
  })
  return out
}

instance encodeJson: Encode[Json] {
  fn encode(x: Json): Json { x }
}

// Methods, for chaining: xs.filter(f).map(g), m.get(k), s.trim().
// Each List and String method is the function of the same name, with
// the receiver as its first argument.

fn (xs: List[T]) length[T](): Int unsafe go {
  return int64(len(xs))
}
fn (xs: List[T]) isEmpty[T](): Bool unsafe go {
  return len(xs) == 0
}
// first is the first element of a list known to have one: no Option
// needed. Check with if (notEmpty(xs)), or require it.
fn (xs: List[T] where notEmpty) first[T](): T unsafe go {
  return xs[0]
}
// get is the element at index (from 0), if there is one.
fn (xs: List[T]) get[T](index: Int): Option[T] unsafe go {
  if index < 0 || index >= int64(len(xs)) {
    return Option_None[T]{}
  }
  return Option_Some[T]{value: xs[index]}
}
fn (xs: List[T]) head[T](): Option[T] unsafe go {
  if len(xs) == 0 {
    return Option_None[T]{}
  }
  return Option_Some[T]{value: xs[0]}
}
fn (xs: List[T]) last[T](): Option[T] unsafe go {
  if len(xs) == 0 {
    return Option_None[T]{}
  }
  return Option_Some[T]{value: xs[len(xs)-1]}
}
fn (xs: List[A]) map[A, B](f: (A) => B): List[B] unsafe go {
  out := make([]B, len(xs))
  for i, x := range xs {
    out[i] = f(x)
  }
  return out
}
fn (xs: List[A]) flatMap[A, B](f: (A) => List[B]): List[B] unsafe go {
  var out []B
  for _, x := range xs {
    out = append(out, f(x)...)
  }
  return out
}
// filter keeps the elements keep is true for. What keep says about
// them is known afterwards: filter(xs, positive) is a
// List[Int where positive].
fn (xs: List[T]) filter[T](keep: (T) => Bool): List[T where keep] unsafe go {
  var out []T
  for _, x := range xs {
    if keep(x) {
      out = append(out, x)
    }
  }
  return out
}
// fold combines the elements from the first to the last, starting
// from initial: fold([1, 2, 3], 0, (sum, x) => sum + x) is 6.
fn (xs: List[T]) fold[T, A](initial: A, f: (A, T) => A): A unsafe go {
  acc := initial
  for _, x := range xs {
    acc = f(acc, x)
  }
  return acc
}
fn (xs: List[T]) find[T](matches: (T) => Bool): Option[T where matches] unsafe go {
  for _, x := range xs {
    if matches(x) {
      return Option_Some[T]{value: x}
    }
  }
  return Option_None[T]{}
}
fn (xs: List[T]) any[T](test: (T) => Bool): Bool unsafe go {
  for _, x := range xs {
    if test(x) {
      return true
    }
  }
  return false
}
fn (xs: List[T]) all[T](test: (T) => Bool): Bool unsafe go {
  for _, x := range xs {
    if !test(x) {
      return false
    }
  }
  return true
}
fn (xs: List[T]) count[T](test: (T) => Bool): Int unsafe go {
  n := int64(0)
  for _, x := range xs {
    if test(x) {
      n++
    }
  }
  return n
}
fn (xs: List[T]) forEach[T](f: (T) => Unit) unsafe go {
  for _, x := range xs {
    f(x)
  }
}
// take is the first n elements (all of them if there are fewer).
fn (xs: List[T]) take[T](n: Int): List[T] unsafe go {
  n = max(0, min(n, int64(len(xs))))
  return xs[:n:n]
}
// drop is all but the first n elements.
fn (xs: List[T]) drop[T](n: Int): List[T] unsafe go {
  n = max(0, min(n, int64(len(xs))))
  return xs[n:]
}
fn (xs: List[T]) reverse[T](): List[T] unsafe go {
  out := make([]T, len(xs))
  for i, x := range xs {
    out[len(xs)-1-i] = x
  }
  return out
}
fn (xs: List[T]) concat[T](ys: List[T]): List[T] unsafe go {
  out := make([]T, 0, len(xs)+len(ys))
  return append(append(out, xs...), ys...)
}
fn (xs: List[T]) append[T](x: T): List[T] where notEmpty unsafe go {
  out := make([]T, 0, len(xs)+1)
  return append(append(out, xs...), x)
}
// sortWith sorts by a comparison: less(a, b) says whether a goes
// before b. Equal elements keep their order.
fn (xs: List[T]) sortWith[T](less: (T, T) => Bool): List[T] unsafe go {
  import "sort"
  out := make([]T, len(xs))
  copy(out, xs)
  sort.SliceStable(out, func(i, j int) bool { return less(out[i], out[j]) })
  return out
}
// includes reports whether x is in xs.
fn (xs: List[T]) includes[T: Eq](x: T): Bool {
  xs.any(y => y == x)
}
// distinct keeps the first of each value in xs.
fn (xs: List[T]) distinct[T: Eq](): List[T] {
  xs.fold([], (seen: List[T], x: T) => if (seen.includes(x)) { seen } else { seen.append(x) })
}
fn (parts: List[String]) join(separator: String): String unsafe go {
  import "strings"
  return strings.Join(parts, separator)
}

// sorted is xs in the order of Ord, keeping equal elements in their
// order.
fn (xs: List[T]) sorted[T: Ord](): List[T] { xs.sortWith((a, b) => compare(a, b) < 0) }

// sortBy is xs in the order of what key gives for each element.
fn (xs: List[T]) sortBy[T, K: Ord](key: (T) => K): List[T] { xs.sortWith((a, b) => compare(key(a), key(b)) < 0) }

// groupBy puts the elements in lists by what key gives for them, in
// the order the keys first appear.
fn (xs: List[T]) groupBy[T, K: Eq](key: (T) => K): Map[K, List[T]] {
  xs.fold({:}, (groups, x) => groups.put(key(x), groups.getOr(key(x), []).append(x)))
}

// toMap makes a map of entries; a key given twice keeps the later value.
fn (entries: List[Entry[K, V]]) toMap[K: Eq, V](): Map[K, V] unsafe go {
  keys := make([]K, len(entries))
  vals := make([]V, len(entries))
  for i, e := range entries {
    keys[i], vals[i] = e.key, e.value
  }
  return _mapOf(keys, vals)
}

fn (s: String) byteLength(): Int unsafe go {
  return int64(len(s))
}
fn (s: String) runeCount(): Int unsafe go {
  import "unicode/utf8"
  return int64(utf8.RuneCountInString(s))
}
fn (s: String) contains(part: String): Bool unsafe go {
  import "strings"
  return strings.Contains(s, part)
}
fn (s: String) startsWith(prefix: String): Bool unsafe go {
  import "strings"
  return strings.HasPrefix(s, prefix)
}
fn (s: String) endsWith(suffix: String): Bool unsafe go {
  import "strings"
  return strings.HasSuffix(s, suffix)
}
// indexOf finds the first occurrence of part in s.
fn (s: String) indexOf(part: String): Option[Int] unsafe go {
  import "strings"
  i := strings.Index(s, part)
  if i < 0 {
    return Option_None[int64]{}
  }
  return Option_Some[int64]{value: int64(i)}
}
fn (s: String) toUpper(): String unsafe go {
  import "strings"
  return strings.ToUpper(s)
}
fn (s: String) toLower(): String unsafe go {
  import "strings"
  return strings.ToLower(s)
}
// trim removes leading and trailing white space.
fn (s: String) trim(): String unsafe go {
  import "strings"
  return strings.TrimSpace(s)
}
fn (s: String) replaceAll(old: String, replacement: String): String unsafe go {
  import "strings"
  return strings.ReplaceAll(s, old, replacement)
}
// repeat repeats s count times; a count below 1 gives "".
fn (s: String) repeat(count: Int): String unsafe go {
  import "strings"
  return strings.Repeat(s, int(max(count, 0)))
}
// runeAt is the rune at index (counting runes from 0), if there is one.
fn (s: String) runeAt(index: Int): Option[Rune] unsafe go {
  if index >= 0 {
    i := int64(0)
    for _, r := range s {
      if i == index {
        return Option_Some[int32]{value: r}
      }
      i++
    }
  }
  return Option_None[int32]{}
}
// substring is the runes from index from up to (not including) index
// to. It is OutOfRange unless 0 <= from <= to <= runeCount(s).
fn (s: String) substring(from: Int, to: Int): String | OutOfRange unsafe go {
  import "fmt"
  runes := []rune(s)
  if from < 0 || to < from || to > int64(len(runes)) {
    return OutOfRange{value: fmt.Sprintf("%d to %d", from, to), target: fmt.Sprintf("a String of %d runes", len(runes))}
  }
  return string(runes[from:to])
}
// split always gives at least one part.
fn (s: String) split(separator: String): List[String] where notEmpty unsafe go {
  import "strings"
  return strings.Split(s, separator)
}
// fields splits s around runs of whitespace: fields(" a  b ") is ["a", "b"].
fn (s: String) fields(): List[String] unsafe go {
  import "strings"
  return strings.Fields(s)
}
// lines splits s into lines, without their line endings. A final line
// ending does not start another line.
fn (s: String) lines(): List[String] unsafe go {
  import "strings"
  if s == "" {
    return []string{}
  }
  out := strings.Split(strings.TrimSuffix(s, "\n"), "\n")
  for i, line := range out {
    out[i] = strings.TrimSuffix(line, "\r")
  }
  return out
}

fn (o: Option[T]) map[T, U](f: (T) => U): Option[U] {
  match (o) {
    Option.Some { value } => Option.Some { value: f(value) }
    Option.None => Option.None
  }
}

fn (o: Option[T]) flatMap[T, U](f: (T) => Option[U]): Option[U] {
  match (o) {
    Option.Some { value } => f(value)
    Option.None => Option.None
  }
}

fn (o: Option[T]) getOr[T](otherwise: T): T {
  match (o) {
    Option.Some { value } => value
    Option.None => otherwise
  }
}

fn (o: Option[T]) isSome[T](): Bool {
  match (o) {
    Option.Some { value } => true
    Option.None => false
  }
}

fn (o: Option[T]) isNone[T](): Bool { !o.isSome() }

// Map methods. A map never changes: put and remove give a new one,
// sharing all but the changed path with it (see bork/maps).

fn (m: Map[K, V]) get[K: Eq, V](key: K): Option[V] unsafe go {
  if v, ok := m.get(key); ok {
    return Option_Some[V]{value: v}
  }
  return Option_None[V]{}
}

fn (m: Map[K, V]) getOr[K: Eq, V](key: K, otherwise: V): V unsafe go {
  if v, ok := m.get(key); ok {
    return v
  }
  return otherwise
}

fn (m: Map[K, V]) has[K: Eq, V](key: K): Bool unsafe go {
  _, ok := m.get(key)
  return ok
}

fn (m: Map[K, V]) put[K: Eq, V](key: K, value: V): Map[K, V] unsafe go {
  return m.put(key, value)
}

fn (m: Map[K, V]) remove[K: Eq, V](key: K): Map[K, V] unsafe go {
  return m.remove(key)
}

fn (m: Map[K, V]) size[K: Eq, V](): Int unsafe go {
  return int64(m.len())
}

fn (m: Map[K, V]) isEmpty[K: Eq, V](): Bool unsafe go {
  return m.len() == 0
}

fn (m: Map[K, V]) keys[K: Eq, V](): List[K] unsafe go {
  return m.keys()
}

fn (m: Map[K, V]) values[K: Eq, V](): List[V] unsafe go {
  return m.vals()
}

fn (m: Map[K, V]) entries[K: Eq, V](): List[Entry[K, V]] unsafe go {
  out := make([]Entry[K, V], 0, m.len())
  m.each(func(k K, v V) bool {
    out = append(out, Entry[K, V]{key: k, value: v})
    return true
  })
  return out
}

fn (a: Map[K, V]) merge[K: Eq, V](b: Map[K, V]): Map[K, V] unsafe go {
  out := a
  b.each(func(k K, v V) bool {
    out = out.put(k, v)
    return true
  })
  return out
}

fn (m: Map[K, V]) mapValues[K: Eq, V, W](f: (V) => W): Map[K, W] unsafe go {
  return _mapValues(m, f)
}

fn (m: Map[K, V]) filter[K: Eq, V](test: (K, V) => Bool): Map[K, V] unsafe go {
  out := m
  m.each(func(k K, v V) bool {
    if !test(k, v) {
      out = out.remove(k)
    }
    return true
  })
  return out
}

fn (m: Map[K, V]) forEach[K: Eq, V](f: (K, V) => Unit) unsafe go {
  m.each(func(k K, v V) bool {
    f(k, v)
    return true
  })
}

fn (m: Map[K, V]) sorted[K: Ord + Eq, V](): Map[K, V] { m.sortedBy((a, b) => compare(a, b) < 0) }

fn (m: Map[K, V]) sortedBy[K: Eq, V](less: (K, K) => Bool): Map[K, V] unsafe go {
  return _mapSortedBy(m, less)
}

fn (m: Map[K, V]) inOrder[K: Eq, V](): Map[K, V] unsafe go {
  return _mapInOrder(m)
}

fn (m: Map[K, V]) unordered[K: Eq, V](): Map[K, V] unsafe go {
  return _mapUnordered(m)
}

// Bytes is immutable binary data, distinct from List[Byte]. There is no
// byte literal: use bytes([toByte(65)]) or utf8Bytes("A").
fn bytes(values: List[Byte]): Bytes unsafe go {
  return _borkBytesFrom(values)
}

// utf8Bytes gives the UTF-8 bytes of text (including embedded zero bytes).
fn utf8Bytes(text: String): Bytes unsafe go {
  return _borkBytesFrom([]byte(text))
}

// utf8String validates before converting: invalid UTF-8 is an error.
fn utf8String(data: Bytes): String | ParseError unsafe go {
  import "unicode/utf8"
  if !utf8.Valid(data) { return ParseError{input: data.String(), message: "invalid UTF-8"} }
  return string(data)
}

fn (data: Bytes) length(): Int unsafe go { return int64(len(data)) }
fn (data: Bytes) isEmpty(): Bool unsafe go { return len(data) == 0 }
fn (data: Bytes) get(index: Int): Option[Byte] unsafe go {
  if index < 0 || index >= int64(len(data)) { return _borkNone[byte]() }
  return _borkSome(data[index])
}
fn (data: Bytes) toList(): List[Byte] unsafe go { return _borkBytesData(data) }
fn (data: Bytes) slice(from: Int, to: Int): Bytes | OutOfRange unsafe go {
  import "fmt"
  if from < 0 || to < from || to > int64(len(data)) {
    return OutOfRange{value: fmt.Sprintf("%d:%d", from, to), target: "Bytes slice"}
  }
  return _borkBytesFrom(data[from:to])
}
fn (data: Bytes) concat(other: Bytes): Bytes unsafe go {
  return append(_borkBytesFrom(data), other...)
}
