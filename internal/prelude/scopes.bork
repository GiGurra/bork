// Scopes and resources. A resource is opened in a scope, and closed
// when the scope closes: finalizers run in reverse order of
// registration, when the scope's block ends or panics.

// attach keeps a resource open until scope s closes too: it closes when
// the last of the scopes it is attached to closes. It gives the
// resource, as a value of s, to hand to tasks of s (which may outlive
// the scope the resource was opened in). Handles with a cancellation rebind
// hook add s as a cancellation source: they are cancelled once every scope
// they are attached to is cancelled.
fn attach[R](r: R, s: Scope): R unsafe go {
  o, _ := any(r).(interface{ _ownerOf() *_Owner })
  if o == nil || o._ownerOf() == nil {
    panic("bork: attach: the resource was not opened with an owner (s.Own)")
  }
  if why := o._ownerOf().attach(s); why != "" {
    panic("bork: attach: " + why)
  }
  if h, ok := any(r).(interface { _borkRebind(*_Scope) }); ok { h._borkRebind(s) }
  return r
}

// move hands r over from the scope it belongs to here to scope s: that
// scope no longer keeps it open, and it closes when s closes (or later,
// if it is attached to other scopes still open). It gives r as a value
// of s; r, and every value holding it, cannot be used after the move.
// Only a resource acquired in this function or lambda (not a parameter,
// or a value from a channel) that no task, channel or Go code may still
// use can be moved; attach keeps the source owning it too. Cancellation
// follows s instead of the source scope.
fn move[R](r: R, s: Scope): R unsafe go {
  panic("bork: move is compiled by the compiler")
}

// ScopePolicy configures how a scope ends, chosen with
// `scope s with taskTimeout(100), cleanupTimeout(500), logFailures() { ... }`.
// When a scope ends, it cancels itself, waits for its tasks, and then
// runs its finalizers. By default it waits for each for as long as it
// takes, and raises failures (finalizers that panicked, and tasks that
// panicked without being awaited) as one panic once it is closed;
// every finalizer runs, even when others fail.
//   - TaskTimeout: wait at most ms milliseconds for the tasks to stop
//     (with whatever cleanup of their own they do). Tasks still running
//     then are orphaned: they keep running, the scope's finalizers still
//     run, and the tasks may find its resources closed.
//   - CleanupTimeout: wait at most ms milliseconds for each finalizer;
//     one that takes longer is orphaned, and the scope goes on closing.
//   - LogFailures: log failures (at error level) instead of raising them.
// Orphaning is logged at warning level.
type ScopePolicy = sealed {
  TaskTimeout { ms: Int },
  CleanupTimeout { ms: Int },
  LogFailures,
}

// taskTimeout is the policy that waits at most ms milliseconds for the
// scope's tasks to stop when it ends.
fn taskTimeout(ms: Int): ScopePolicy {
  ScopePolicy.TaskTimeout { ms: ms }
}

// cleanupTimeout is the policy that waits at most ms milliseconds for
// each finalizer.
fn cleanupTimeout(ms: Int): ScopePolicy {
  ScopePolicy.CleanupTimeout { ms: ms }
}

// logFailures is the policy that logs failures at the scope's end
// instead of raising them.
fn logFailures(): ScopePolicy {
  ScopePolicy.LogFailures
}

// setScopePolicy applies a policy to s (what `with` does).
fn setScopePolicy(s: Scope, policy: ScopePolicy) unsafe go {
  import "time"
  switch p := policy.(type) {
  case ScopePolicy_TaskTimeout:
    s.taskTimeout = time.Duration(p.ms) * time.Millisecond
  case ScopePolicy_CleanupTimeout:
    s.finalizerTimeout = time.Duration(p.ms) * time.Millisecond
  case ScopePolicy_LogFailures:
    s.logFailures = true
  }
}

// OwnedScope is the right to end a child scope early: an explicit start
// (openScope) and end (closeScope), so that scope lifetimes can overlap
// without nesting, as when a connection is handed over to the next one
// before the old one is released. An owner is passed on, never copied:
// it is closed, given to a parameter of type OwnedScope, or returned,
// exactly once on every path, and the compiler rejects any use of the
// child's values after that. If its function ends early (by ?, return
// or a panic), the child is closed then. b.scope borrows the child's
// Scope, to open resources and start tasks in.
//
//   a = openScope(app)
//   old = connect(a.scope)?
//   b = openScope(app)
//   next = connect(b.scope)?
//   handOver(old, next)?
//   closeScope(a)                // old is released, b stays open
//
// A parameter can say which scope its value belongs to, so that a
// resource can be passed on with its owner:
//
//   fn roll(prev: OwnedScope in app, conn: Conn in prev, app: Scope)

// openScope opens a child scope of parent, owned by the caller, with
// the given policies. It is cancelled with parent; when parent closes,
// it closes any children still open (after its tasks, before its
// finalizers, oldest first).
fn openScope(parent: Scope, policies: List[ScopePolicy] = []): OwnedScope unsafe go {
  import "time"
  s := _openScope(parent)
  for _, policy := range policies {
    switch p := policy.(type) {
    case ScopePolicy_TaskTimeout:
      s.taskTimeout = time.Duration(p.ms) * time.Millisecond
    case ScopePolicy_CleanupTimeout:
      s.finalizerTimeout = time.Duration(p.ms) * time.Millisecond
    case ScopePolicy_LogFailures:
      s.logFailures = true
    }
  }
  return s
}

// closeScope ends the child scope owner, as the end of a scope block
// does: it cancels it, waits for its tasks, closes its own children,
// and runs its finalizers, raising their failures as one panic.
fn closeScope(owner: OwnedScope) uses state unsafe go {
  owner.close()
}

// scopeOf borrows the Scope of an owned child scope: b.scope is
// scopeOf(b).
fn scopeOf(owner: OwnedScope): Scope unsafe go {
  return owner
}

// onClose runs f when the scope s closes.
fn onClose(s: Scope, f: () => Ok) unsafe go {
  s.Defer(f)
}
